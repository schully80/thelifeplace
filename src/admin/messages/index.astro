---
import fs from "fs";
import path from "path";

const DATA_FILE = path.resolve("src/data/messages.json");
const PLACEHOLDER = `/mnt/data/A_placeholder_digital_graphic_for_"The_Life_Place".png`;

let messages = [];

try {
  messages = JSON.parse(fs.readFileSync(DATA_FILE, "utf-8"));
} catch (e) {
  messages = [];
}
---
<!-- 🔒 SIMPLE ADMIN SECURITY CHECK -->
{(() => {
  const query = Astro.url.searchParams.get("key");
  if (query !== "ComeSeeJesus2025") {   // ← choose your own key
    return Astro.redirect("/");
  }
})()}


<!DOCTYPE html>
<html lang="en">
<head>
  <title>Message Admin UI</title>
  <meta charset="UTF-8" />
  <script type="module" src="./admin.js"></script>

  <style>
    body { font-family: Inter, sans-serif; background:#f5f5f5; padding:40px; }
    .card { background:white; padding:20px; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,0.1); margin-bottom:20px; }
    input, select { width:100%; padding:8px; border:1px solid #ddd; border-radius:6px; margin-top:6px; }
    button { background:#B3282D; color:white; padding:10px 16px; border:none; border-radius:6px; cursor:pointer; }
    button:hover { opacity:0.9; }
  </style>
</head>

<body>
  <h1>Message Admin</h1>
  <p>Edit your messages.json file visually.</p>

  <div id="app"
       data-messages={JSON.stringify(messages)}
       data-placeholder={PLACEHOLDER}>
  </div>
</body>
</html>
