---
import { site } from "../../site.config.js";
import { getVisitLocation } from "../content/shared-content.js";

const churchName = site.name;
const email = site.contact.email;
const visitLocation = getVisitLocation();
const newsletterUrl = `${site.links.blogUrl.replace(/\/$/, "")}/subscribe`;

// Optional: add later if you want it public
const phoneDisplay = ""; // e.g. "+27 76 563 9460"
const phoneHref = ""; // e.g. "tel:+27765639460"
---

<footer class="relative w-full bg-gray-100
         border-t border-gray-300/40 mt-12 md:mt-52">
  
  <div class="max-w-6xl mx-auto px-4 py-4 md:py-16">

    <!-- BRAND BLOCK (CENTERED) -->
    <div class="text-center max-w-lg mx-auto space-y-2 md:space-y-4 mb-4 md:mb-16">
      <p class="text-gray-800 font-semibold tracking-wide text-lg md:text-2xl">
        Come. See. <span class="text-brand-red font-semibold">Jesus</span>
      </p>
    </div>

    <!-- FOOTER LINKS AND NEWSLETTER -->
    <div class="grid grid-cols-1 gap-8 text-center md:grid-cols-2 md:gap-12 lg:grid-cols-4">

      <!-- EXPLORE -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-2 md:mb-4 text-xs md:text-base uppercase tracking-wide">
          Explore
        </h3>
        <ul class="space-y-1 md:space-y-2 text-xs md:text-sm text-gray-600">
          <li><a href="/" class="hover:text-brand-red transition">About</a></li>
          <li><a href="/about-us/leadership/" class="hover:text-brand-red transition">Leadership</a></li>
          <li><a href="/events" class="hover:text-brand-red transition">Events</a></li>
          <!-- Ministries nav removed -->
        </ul>
      </div>

      <!-- NEXT STEPS -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-2 md:mb-4 text-xs md:text-base uppercase tracking-wide">
          Next Steps
        </h3>
        <ul class="space-y-1 md:space-y-2 text-xs md:text-sm text-gray-600">
          <li><a href="/give/" class="hover:text-brand-red transition">Giving</a></li>
          <li><a href="/prayer/" class="hover:text-brand-red transition">Prayer Requests</a></li>
          <li><a href="/devotionals" class="hover:text-brand-red transition">Devotionals</a></li>
          <li><a href="/visit/" class="hover:text-brand-red transition">Contact</a></li>
          <li class="flex items-center justify-center gap-2">
            <span>Get the App</span>
            <span class="text-gray-400 font-bold uppercase tracking-wider text-[0.7rem] md:text-xs cursor-not-allowed">
              Coming soon
            </span>
          </li>
        </ul>
      </div>

      <!-- LEGAL -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-2 md:mb-4 text-xs md:text-base uppercase tracking-wide">
          Legal
        </h3>
        <ul class="space-y-1 md:space-y-2 text-xs md:text-sm text-gray-600">
          <li><a href="/privacy-policy/" class="hover:text-brand-red transition">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-brand-red transition">Terms & Conditions</a></li>
          <li><a href="/cookies/" class="hover:text-brand-red transition">Cookie Policy</a></li>
        </ul>
      </div>

      <!-- NEWSLETTER SIGNUP -->
      <div class="mx-auto w-full max-w-sm text-left lg:mx-0">
        <p class="text-sm font-semibold leading-relaxed text-gray-700 md:text-base">
          <span class="text-brand-red">Subscribe</span> to our newsletter and receive posts that help you see <span class="text-brand-red">Jesus</span>.
        </p>

        <form
          action={newsletterUrl}
          method="get"
          target="_blank"
          aria-label="Subscribe to our newsletter on Substack"
          class="mt-4 space-y-3"
        >
          <label for="footer-newsletter-email" class="sr-only">Email address</label>
          <input
            id="footer-newsletter-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="Your email"
            class="min-h-12 w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-base text-gray-900 placeholder:text-gray-500 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red/40"
          />
          <button
            type="submit"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-red px-6 py-3 font-bold text-white shadow-sm transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-red-700 hover:shadow-md active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2 focus-visible:ring-offset-gray-100"
          >
            Subscribe
          </button>
        </form>
      </div>

    </div>

    <!-- CONTACT / MAP (CENTERED UNDER GRID) -->
    <div class="mt-4 md:mt-16 text-center">
      <div class="inline-block text-center">
        <h3 class="font-semibold text-gray-800 mb-2 md:mb-4 text-xs md:text-base uppercase tracking-wide">
          Contact
        </h3>

        <div class="space-y-1 md:space-y-2 text-xs md:text-sm text-gray-600">
          <p class="font-semibold text-gray-800 text-xs md:text-sm">{churchName}</p>
          {visitLocation.addressLines.map((line) => <p class="text-xs md:text-sm">{line}</p>)}

          <p class="flex items-center justify-center gap-1 md:gap-2 text-xs md:text-sm">
            <i class="fa-solid fa-envelope text-brand-red text-xs md:text-sm"></i>
            <a href={`mailto:${email}`} class="hover:text-brand-red transition">
              {email}
            </a>
          </p>

          {phoneDisplay && phoneHref && (
            <p class="flex items-center justify-center gap-1 md:gap-2 text-xs md:text-sm">
              <i class="fa-solid fa-phone text-gray-800 text-xs md:text-sm"></i>
              <a href={phoneHref} class="hover:text-brand-red transition">
                {phoneDisplay}
              </a>
            </p>
          )}

        </div>
      </div>
    </div>

    <!-- SOCIAL ICONS -->
    <div class="flex justify-center gap-2 md:gap-4 mt-4 md:mt-16">
      <a href={site.socials.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 md:w-12 md:h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition">
        <i class="fa-brands fa-facebook-f text-sm md:text-2xl text-white"></i>
      </a>

      <a href={site.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-9 h-9 md:w-12 md:h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition">
        <i class="fa-brands fa-instagram text-sm md:text-2xl text-white"></i>
      </a>

      <a href={site.socials.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="w-9 h-9 md:w-12 md:h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition">
        <i class="fa-brands fa-youtube text-sm md:text-2xl text-white"></i>
      </a>

      <a href={site.socials.spotify} target="_blank" rel="noopener" aria-label="Spotify" class="w-9 h-9 md:w-12 md:h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition">
        <i class="fa-brands fa-spotify text-sm md:text-2xl text-white"></i>
      </a>

      <a href={site.socials.applePodcasts} target="_blank" rel="noopener" aria-label="Apple Podcasts" class="w-9 h-9 md:w-12 md:h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition">
        <i class="fa-solid fa-podcast text-sm md:text-2xl text-white"></i>
      </a>
    </div>

    <!-- COPYRIGHT -->
    <p class="text-center text-gray-500 text-xs mt-3 md:mt-10">
© {new Date().getFullYear()} The Life Place. All rights reserved.
    </p>

  </div>
</footer>
