---
// No script required here
---
<footer class="bg-gray-100 mt-8">
  <div class="max-w-6xl mx-auto px-4 py-10 text-center text-sm space-y-6">

    <!-- Social Icons -->
    <div class="flex justify-center gap-4">
      <a
        href="https://facebook.com/thelifeplacesa"
        target="_blank"
        rel="noopener"
        aria-label="Facebook"
        class="w-12 h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition"
      >
        <i class="fa-brands fa-facebook-f text-2xl text-white"></i>
      </a>

      <a
        href="https://instagram.com/thelifeplacesa"
        target="_blank"
        rel="noopener"
        aria-label="Instagram"
        class="w-12 h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition"
      >
        <i class="fa-brands fa-instagram text-2xl text-white"></i>
      </a>

      <a
        href="https://youtube.com/@thelifeplacesa"
        target="_blank"
        rel="noopener"
        aria-label="YouTube"
        class="w-12 h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition"
      >
        <i class="fa-brands fa-youtube text-2xl text-white"></i>
      </a>

      <a
        href="https://open.spotify.com/show/31hbtgq5cvmqr4tyzs2faygvrzaa?si=61b073370e034f21"
        target="_blank"
        rel="noopener"
        aria-label="Spotify"
        class="w-12 h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition"
      >
        <i class="fa-brands fa-spotify text-2xl text-white"></i>
      </a>

      <a
        href="https://podcasts.apple.com/us/podcast/the-life-place/id1816955719"
        target="_blank"
        rel="noopener"
        aria-label="Apple Podcasts"
        class="w-12 h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition"
      >
        <i class="fa-solid fa-podcast text-2xl text-white"></i>
      </a>
    </div>

    <slot />
  </div>
</footer>
