---
import AddressFields from "../components/AddressFields.astro";
import Turnstile from "./ui/Turnstile.astro";
const {
  title = "Register",
  eventName = "General",
  formAction = "/register",
  ctaText = "Send Registration",

  // Flashing message controls
  showComingSoon = false,
  comingSoonMessage = "Registration will open soon…",
  instructionText = "Fill in your details below to reserve your spot. This information helps us plan and care for you on the day.",
  // Turnstile feature
  enableTurnstile = (import.meta.env.PUBLIC_ENABLE_TURNSTILE === 'true') || false,
  turnstileTheme = 'light',
  turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '',
} = Astro.props;


---

<section class="max-w-4xl mx-auto px-4 py-8 md:py-12">

  <!-- Heading -->
  <h2 class="text-xl md:text-4xl font-extrabold text-center mb-6">
    {title}
  </h2>

{instructionText && (
  <p 
    class="text-center text-[17px] md:text-[18px] text-gray-800 
           tracking-tight leading-snug mb-6 fade-in-soft"
  >
    {instructionText}
  </p>
)}

  <!-- Registration Form -->
  <form id="registrationForm" method="POST" action={formAction} class="space-y-8">

    <!-- Honeypot (spam trap) -->
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
    <input type="hidden" name="intent" value={eventName} />

    <!-- MAIN FORM BLOCK -->
    <AddressFields />

    <!-- CAPTCHA removed -->

    <!-- Submit Button + Flash Message -->
    <div class="text-center pt-4 md:pt-6">
      <button
        type="submit"
        id="tlpSubmitBtn"
        disabled
        class="px-8 py-3 md:px-10 md:py-4 bg-gradient-to-r from-brand-red to-red-600 text-white text-base md:text-lg font-bold rounded-2xl shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-300 hover:scale-105"
      >
        {ctaText}
      </button>

      {enableTurnstile && (
        <div class="mt-4 flex justify-center">
          <Turnstile name="cf-turnstile-response" theme={turnstileTheme} />
        </div>
      )}

      {showComingSoon && (
        <p class="mt-4 text-sm md:text-base text-brand-red font-medium">
          {comingSoonMessage}
        </p>
      )}
    </div>

  </form>

</section>

<!-- BUTTON + UI STYLES -->
<style>
  .btn-outline {
    border: 2px solid #B3282D;
    padding: 0.85rem 2.4rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1.1rem;
    color: #B3282D;
    transition: all .25s ease;
  }

  .btn-outline:hover:not(:disabled) {
    background: #B3282D;
    color: white;
    box-shadow: 0 4px 14px rgba(179, 40, 45, 0.25);
  }
  /* Soft fade-in for instruction text */
  .fade-in-soft {
    opacity: 0;
    animation: fadeInSoft 0.7s ease-out forwards;
  }

  @keyframes fadeInSoft {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Gentle pulsing for the “coming soon” message */
  .animate-pulse-soft {
    animation: pulseSoft 1.6s ease-in-out infinite;
  }

  @keyframes pulseSoft {
    0%   { opacity: 0.55; }
    50%  { opacity: 1; }
    100% { opacity: 0.55; }
  }


</style>

<!-- Turnstile UX initializer -->
<script>
  (function(){
    try {
      const form = document.getElementById('registrationForm');
      const btn = document.getElementById('tlpSubmitBtn');
      if (!form || !btn) return;

      const hasToken = () => {
        const e = form.querySelector('input[name="cf-turnstile-response"]');
        return !!(e && e.value && e.value.length > 0);
      };

      const setDisabled = (disabled) => {
        btn.disabled = disabled;
        if (disabled) {
          btn.classList.add('opacity-60', 'cursor-not-allowed');
          btn.setAttribute('aria-disabled', 'true');
        } else {
          btn.classList.remove('opacity-60', 'cursor-not-allowed');
          btn.removeAttribute('aria-disabled');
          try { btn.focus(); } catch {}
        }
      };

      setDisabled(!hasToken());

      form.addEventListener('turnstile:verified', function(){ setDisabled(false); });

      form.addEventListener('submit', function(e){
        if (!hasToken()) {
          e.preventDefault();
          setDisabled(true);
          alert('Please complete the verification before submitting.');
        } else {
          btn.setAttribute('aria-busy', 'true');
        }
      });

      // Graceful fallback for users who cannot load Turnstile
      setTimeout(function(){
        if (hasToken() || form.querySelector('[data-tlp-fallback]')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'mt-4 text-center';
        wrapper.setAttribute('data-tlp-fallback','1');
        wrapper.innerHTML = `
          <label class="sr-only" for="tlp_fallback_input">If you cannot verify, type human</label>
          <input id="tlp_fallback_input" name="tlp_fallback_answer" placeholder="Type 'human' here" class="px-4 py-2 rounded-md border w-64" />
          <input type="hidden" name="tlp_manual_review" value="1" />
        `;
        btn.parentElement?.insertAdjacentElement('afterend', wrapper);
        const input = wrapper.querySelector('#tlp_fallback_input');
        input && input.addEventListener('input', function(evt){
          if ((evt.target.value||'').toString().trim().toLowerCase() === 'human') setDisabled(false);
        });
      }, 5000);

    } catch (err) {
      console.warn('Turnstile UX init error', err);
    }
  })();
</script>
