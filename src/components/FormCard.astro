---
import AddressFields from "../components/AddressFields.astro";

const {
  title = "Register",
  eventName = "General",
  formAction = "/register",
  ctaText = "Send Registration",

  // Flashing message controls
  showComingSoon = false,
  comingSoonMessage = "Registration will open soon…",
  instructionText = "Fill in your details below to reserve your spot. This information helps us plan and care for you on the day.",
} = Astro.props;

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="max-w-4xl mx-auto px-4 py-8 md:py-12">

  <!-- Heading -->
  <h2 class="text-xl md:text-4xl font-extrabold text-center mb-6">
    {title}
  </h2>

{instructionText && (
  <p 
    class="text-center text-[17px] md:text-[18px] text-brand-warmgray-700 
           tracking-tight leading-snug mb-6 fade-in-soft"
  >
    {instructionText}
  </p>
)}




  <!-- Registration Form -->
  <form id="registrationForm" method="POST" action={formAction} class="space-y-8">

    <!-- Honeypot (spam trap) -->
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
    <input type="hidden" name="intent" value={eventName} />

    <!-- MAIN FORM BLOCK -->
    <AddressFields />

    <!-- Turnstile CAPTCHA -->
    <div class="flex justify-center pt-2">
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-callback="onTurnstileSuccess"
        data-expired-callback="onTurnstileExpired"
        data-error-callback="onTurnstileError"
      ></div>
    </div>

    <!-- Submit Button + Flash Message -->
    <div class="text-center pt-4 md:pt-6">
      <button
        type="submit"
        id="tlpSubmitBtn"
        disabled
        class="px-8 py-3 md:px-10 md:py-4 bg-gradient-to-r from-brand-red to-red-600 text-white text-base md:text-lg font-bold rounded-full shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-300 hover:scale-105"
      >
        {ctaText}
      </button>

      {showComingSoon && (
        <p class="mt-4 text-sm md:text-base text-brand-red font-medium">
          {comingSoonMessage}
        </p>
      )}
    </div>

  </form>

</section>

<!-- BUTTON + UI STYLES -->
<style>
  .btn-outline {
    border: 2px solid #B3282D;
    padding: 0.85rem 2.4rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1.1rem;
    color: #B3282D;
    transition: all .25s ease;
  }

  .btn-outline:hover:not(:disabled) {
    background: #B3282D;
    color: white;
    box-shadow: 0 4px 14px rgba(179, 40, 45, 0.25);
  }
  /* Soft fade-in for instruction text */
  .fade-in-soft {
    opacity: 0;
    animation: fadeInSoft 0.7s ease-out forwards;
  }

  @keyframes fadeInSoft {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Gentle pulsing for the “coming soon” message */
  .animate-pulse-soft {
    animation: pulseSoft 1.6s ease-in-out infinite;
  }

  @keyframes pulseSoft {
    0%   { opacity: 0.55; }
    50%  { opacity: 1; }
    100% { opacity: 0.55; }
  }


</style>

<!-- Turnstile -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<!-- Turnstile Logic -->
<script>
  function onTurnstileSuccess() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = false;
  }

  function onTurnstileExpired() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
  }

  function onTurnstileError() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
    console.error("Turnstile failed to load or validate.");
  }
</script>
