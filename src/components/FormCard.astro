---
const {
  title = "Register",
  eventName = "General",
  ctaText = "Save My Spot",
  formAction = "/register",

  // Per-page controls
  showAttendees = true,   // toggle attendees field per page
} = Astro.props;

const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<section class="max-w-3xl mx-auto px-4 py-8 md:py-12">
  <h2 class="text-xl md:text-2xl font-medium text-center mb-6">{title}</h2>

  <form id="registrationForm" method="POST" action={formAction} class="space-y-6">
    <!-- Honeypot -->
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
    <input type="hidden" name="intent" value={eventName} />

    <!-- Name + Contact -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input id="firstName" name="firstName" required class="form-field" placeholder="Name *" />
      <input id="contact" name="contact" type="tel" required class="form-field" placeholder="Contact Number *" />
    </div>

    <!-- Email + Attendees -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input id="email" name="email" type="email" required class="form-field" placeholder="Email Address *" />
      {showAttendees ? (
        <input id="attendees" name="attendees" type="number" min="1" required class="form-field" placeholder="Number of Persons Attending *" />
      ) : (
        <div class="hidden md:block"></div>
      )}
    </div>

    <!-- Slot for extras -->
    <slot />

    <!-- CAPTCHA (always present) -->
    <div class="pt-2 flex justify-center">
      <div class="cf-turnstile"
           data-sitekey={siteKey}
           data-callback="onTurnstileSuccess"
           data-expired-callback="onTurnstileExpired"
           data-error-callback="onTurnstileError"></div>
    </div>

    <!-- CTA -->
    <div class="text-center pt-2">
      <button
        type="submit"
        id="tlpSubmitBtn"
        disabled
        class="px-6 py-3 rounded-full font-semibold transition bg-gray-400 cursor-not-allowed opacity-60"
      >
        {ctaText}
      </button>
    </div>
  </form>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  function onTurnstileSuccess() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = false;
    btn.classList.remove("bg-gray-400","cursor-not-allowed","opacity-60");
    btn.classList.add("bg-brand-red","text-white","hover:bg-red-700");
  }
  function onTurnstileExpired() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
    btn.classList.remove("bg-brand-red","text-white","hover:bg-red-700");
    btn.classList.add("bg-gray-400","cursor-not-allowed","opacity-60");
  }
  function onTurnstileError() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
    btn.classList.remove("bg-brand-red","text-white","hover:bg-red-700");
    btn.classList.add("bg-gray-400","cursor-not-allowed","opacity-60");
    console.error("Turnstile failed to load or validate.");
  }
</script>