<section class="w-screen max-w-none left-1/2 -mx-[50vw] py-20 px-6">
  <div
    class="motion-leadership opacity-0 translate-y-6
           max-w-4xl mx-auto rounded-3xl overflow-hidden
           backdrop-blur-xl bg-white/10 border border-white/20
           shadow-[0_8px_40px_rgba(0,0,0,0.25)]
           p-10 md:p-14 text-center cine-zoom-apple-hover"
  >
    <p class="text-2xl md:text-2xl font-light text-gray-800 leading-relaxed">
      <slot />
    </p>
  </div>
</section>

<script>
document.addEventListener("scroll", () => {
  const quote = document.querySelector(".motion-leadership");
  if (!quote) return;
  const rect = quote.getBoundingClientRect();
  if (rect.top < window.innerHeight * 0.8) {
    quote.style.transition = "0.8s ease-out";
    quote.style.opacity = 1;
    quote.style.transform = "translateY(0)";
  }
});
</script>
