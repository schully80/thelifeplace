---
const { title, text, icon, href } = Astro.props;
---

<div class="rounded-3xl p-10 backdrop-blur-xl bg-white/10
            border border-white/20 shadow-xl text-center cine-zoom-apple-hover">

  <img src={icon} class="w-14 h-14 mx-auto mb-6" alt="" />

  <h3 class="heading-3 mb-3">{title}</h3>

  <p class="text-gray-600 mb-6">{text}</p>

  {href && (
    <a href={href} class="text-brand-red font-semibold hover:underline">
      Learn More →
    </a>
  )}
</div>
