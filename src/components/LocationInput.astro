---
interface Props {
  label?: string;
  name?: string;
  placeholder?: string;
  required?: boolean;
}
const {
  label = 'Location',
  name = 'location',
  placeholder = 'Enter your address or city',
  required = true,
} = Astro.props;

// Expose a lightweight config for strict attribute control
const ATTRIBUTION_IMG =
  'https://developers.google.com/maps/documentation/images/powered_by_google_on_white.png';
---

<div class="w-full">
  {label && (
    <label for={name} class="mb-1 block text-sm font-medium text-neutral-800">
      {label}
    </label>
  )}

  <div class="relative">
    <!-- Visible input for users -->
    <input
      id={name}
      name={name}
      type="text"
      placeholder={placeholder}
      class="w-full rounded-md border border-neutral-300 bg-white px-3.5 py-2.5 text-sm shadow-sm focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-500"
      {required ? { required: true } : {}}
      data-places-input
      autocomplete="off"
    />

    <!-- Hidden inputs for structured data (optional, useful for backend) -->
    <input type="hidden" name={`${name}_place_id`} data-place-id />
    <input type="hidden" name={`${name}_lat`} data-lat />
    <input type="hidden" name={`${name}_lng`} data-lng />
    <input type="hidden" name={`${name}_country`} data-country />
    <input type="hidden" name={`${name}_postal`} data-postal />
    <input type="hidden" name={`${name}_route`} data-route />
    <input type="hidden" name={`${name}_locality`} data-locality />
    <input type="hidden" name={`${name}_admin_area`} data-admin-area />

    <!-- “Powered by Google” attribution (compliant, visible, unobtrusive) -->
    <div class="pointer-events-none absolute -bottom-6 right-0 flex items-center gap-1 opacity-70 transition-opacity duration-200 hover:opacity-100">
      <img src={ATTRIBUTION_IMG} alt="Powered by Google" class="h-4" />
    </div>
  </div>

  <!-- Maps JavaScript with Places library; loaded once per page -->
  <script src={`https://maps.googleapis.com/maps/api/js?key=${import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY}&libraries=places`} defer></script>

  <!-- Client-side initialization -->
  <script is:inline>
    // Debounce utility to reduce API calls on fast typing
    function debounce(fn, delay = 250) {
      let t;
      return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => fn(...args), delay);
      };
    }

    function getField(selector) {
      return document.querySelector(selector);
    }

    function mapAddressComponents(components) {
      const get = (type) => components.find((c) => c.types.includes(type))?.long_name || '';
      return {
        route: get('route'),
        locality: get('locality'),                       // city/town
        adminArea: get('administrative_area_level_1'),   // province/state
        country: get('country'),
        postal: get('postal_code'),
      };
    }

    function initPlaces() {
      const input = document.querySelector('[data-places-input]');
      if (!input || !window.google || !google.maps?.places) return;

      // Autocomplete with bias (optional: you can set componentRestrictions for ZA)
      const autocomplete = new google.maps.places.Autocomplete(input, {
        fields: [
          'place_id',
          'geometry',
          'name',
          'formatted_address',
          'address_components',
        ],
        types: ['geocode'], // or ['establishment'] for businesses
        // componentRestrictions: { country: ['za'] }, // uncomment to bias South Africa
      });

      // Improve UX: hint users the field supports autocomplete
      input.setAttribute('aria-autocomplete', 'both');

      // Emit custom event when a place is selected (useful if you want to listen elsewhere)
      function emitPlaceSelected(detail) {
        input.dispatchEvent(new CustomEvent('place:selected', { detail }));
      }

      autocomplete.addListener('place_changed', () => {
        const place = autocomplete.getPlace();
        if (!place || !place.place_id) return;

        const lat = place.geometry?.location?.lat?.();
        const lng = place.geometry?.location?.lng?.();

        const comps = mapAddressComponents(place.address_components || []);
        const data = {
          placeId: place.place_id,
          formattedAddress: place.formatted_address || input.value,
          lat: lat ?? '',
          lng: lng ?? '',
          country: comps.country,
          postal: comps.postal,
          route: comps.route,
          locality: comps.locality,
          adminArea: comps.adminArea,
        };

        // Write to hidden inputs for server submission
        getField('[data-place-id]').value = data.placeId;
        getField('[data-lat]').value = data.lat;
        getField('[data-lng]').value = data.lng;
        getField('[data-country]').value = data.country;
        getField('[data-postal]').value = data.postal;
        getField('[data-route]').value = data.route;
        getField('[data-locality]').value = data.locality;
        getField('[data-admin-area]').value = data.adminArea;

        emitPlaceSelected(data);
      });

      // Optional: soft validation on blur to encourage selection from suggestions
      input.addEventListener(
        'blur',
        debounce(() => {
          const hasPlaceId = !!getField('[data-place-id]').value;
          input.classList.toggle('ring-2', !hasPlaceId);
          input.classList.toggle('ring-red-500', !hasPlaceId);
        }, 200)
      );
    }

    // Initialize once DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPlaces, { once: true });
    } else {
      initPlaces();
    }
  </script>
</div>