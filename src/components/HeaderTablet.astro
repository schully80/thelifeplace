---
const {
  title = "The Life Place",
  logoSrc = "/logo.png",
  class: className,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href) =>
  href === "/" ? path === "/" : path === href || (href !== "/" && path.startsWith(href));
---

<!-- Tablet Header: md–xl only -->
<header class:list={[
  "hidden md:block xl:hidden relative z-50 border-b bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70 h-20",
  className
]}>
  <div class="px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">
    
    <!-- LEFT: Logo -->
    <a href="/" class="flex items-center shrink-0">
      <img src={logoSrc} alt="Logo" class="h-12 w-auto" />
    </a>

    <!-- CENTER: Title + Slogan -->
    <a href="/" class="flex flex-col items-center text-center min-w-0">
      <span class="font-bold text-brand-red text-xl truncate">{title}</span>
      <span class="text-sm text-brand-warmgray-600">Come. See. Jesus</span>
    </a>

    <!-- RIGHT: Hamburger -->
    <button
      id="tabletMenuButton"
      type="button"
      aria-label="Open menu"
      aria-controls="tabletNavDrawer"
      aria-expanded="false"
      class="inline-flex items-center justify-center h-10 w-10 rounded-md border border-brand-red bg-white active:scale-[0.98]"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

  </div>

  <!-- Overlay (transparent black + blur) -->
  <div
    id="tabletNavOverlay"
    class="fixed inset-0 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity z-[9998]"
    data-overlay
  ></div>

  <!-- Drawer -->
  <aside
    id="tabletNavDrawer"
    class="fixed inset-y-0 right-0 w-[86%] sm:w-[80%] max-w-sm bg-white shadow-xl translate-x-full transition-transform will-change-transform z-[9999]"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    data-drawer
  >
    <!-- Drawer header -->
    <div class="h-20 px-4 flex items-center justify-end border-b">
      <button
        id="tabletMenuClose"
        type="button"
        aria-label="Close menu"
        class="h-10 w-10 inline-flex items-center justify-center rounded-md border border-brand-red bg-white active:scale-[0.98]"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6">
          <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Drawer body -->
    <nav
      class="px-2 py-2 overflow-y-auto max-h-[calc(100svh-5rem)]"
      aria-label="Tablet Navigation"
    >

      <a href="/what-to-expect/"
        class={`block px-4 py-3 rounded-lg text-base ${
          isActive("/what-to-expect/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"
        }`}
      >What to Expect</a>

      <!-- About Us accordion -->
      <section class="mt-1" data-accordion>
        <button
          type="button"
          class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-base text-brand-darkgray hover:bg-gray-50"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="acc-about-tab"
        >
          <span>About Us</span>
          <svg class="h-5 w-5 transition-transform" viewBox="0 0 24 24">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <div id="acc-about-tab"
          class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300"
          data-accordion-panel
        >
          <div class="overflow-hidden">
            <ul class="py-1">
              <li><a href="/about-us/" class="block px-6 py-2 text-[15px] hover:bg-gray-50">Our Mission</a></li>
              <li><a href="/about-us/our-values" class="block px-6 py-2 text-[15px] hover:bg-gray-50">Our Values</a></li>
              <li><a href="/about-us/leadership" class="block px-6 py-2 text-[15px] hover:bg-gray-50">Meet Schulter and Genevieve</a></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Generosity -->
      <a href="/give/"
        class="mt-3 inline-flex items-center justify-center px-4 py-2 rounded-full bg-brand-red text-white font-semibold shadow-md hover:bg-red-700 transition"
      >Generosity</a>

      <!-- Ministries accordion -->
      <section class="mt-3" data-accordion>
        <button
          type="button"
          class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-base text-brand-darkgray hover:bg-gray-50"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="acc-min-tab"
        >
          <span>Ministries</span>
          <svg class="h-5 w-5 transition-transform" viewBox="0 0 24 24">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <div id="acc-min-tab"
          class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300"
          data-accordion-panel
        >
          <div class="overflow-hidden">
            <ul class="py-1">
              <li><a href="/ministries/new-members/" class="block px-6 py-2">New @The Life Place</a></li>
              <li><a href="/ministries/bring-them-to-jesus/" class="block px-6 py-2">Bring Them To Jesus</a></li>
              <li><a href="/ministries/kids/" class="block px-6 py-2">Kids @The Life Place</a></li>
              <li><a href="/ministries/gen/" class="block px-6 py-2">ThisGen</a></li>
              <li><a href="/ministries/premarital-counseling/" class="block px-6 py-2">Premarital Counseling</a></li>
              <li><a href="/ministries/institute/" class="block px-6 py-2">The Life Place Institute</a></li>
              <li><a href="/ministries/faith-and-work/" class="block px-6 py-2">Faith & Work</a></li>
              <li><a href="/ministries/relief-center/" class="block px-6 py-2">Relief Center</a></li>
            </ul>
          </div>
        </div>
      </section>

      <a href="/visit/" class="mt-3 block px-4 py-3 rounded-lg text-base hover:bg-gray-50">
        Plan A Visit
      </a>

      <a href="https://schulteretyang.substack.com"
         target="_blank"
         class="mt-2 block px-4 py-3 rounded-lg text-base hover:bg-red-50 hover:text-brand-red"
      >Our Blog</a>

    </nav>
  </aside>

  <!-- Drawer Logic (identical to mobile.astro) -->
  <script is:inline>
    (function () {
      const body = document.documentElement;
      const btnOpen = document.getElementById("tabletMenuButton");
      const btnClose = document.getElementById("tabletMenuClose");
      const drawer = document.getElementById("tabletNavDrawer");
      const overlay = document.getElementById("tabletNavOverlay");

      if (!btnOpen || !btnClose || !drawer || !overlay) return;

      // Ensure overlay/drawer are on <body>
      if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
      if (drawer.parentElement !== document.body) document.body.appendChild(drawer);

      const open = () => {
        drawer.classList.remove("translate-x-full");
        overlay.classList.remove("pointer-events-none");
        overlay.classList.add("opacity-100");
        btnOpen.setAttribute("aria-expanded", "true");
        body.style.overflow = "hidden";
        drawer.focus();
      };

      const close = () => {
        drawer.classList.add("translate-x-full");
        overlay.classList.add("pointer-events-none");
        overlay.classList.remove("opacity-100");
        btnOpen.setAttribute("aria-expanded", "false");
        body.style.overflow = "";
        btnOpen.focus();
      };

      btnOpen.addEventListener("click", open);
      btnClose.addEventListener("click", close);
      overlay.addEventListener("click", close);

      // ESC closes drawer
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });

      // Accordions
      document.querySelectorAll("[data-accordion]").forEach((acc) => {
        const trigger = acc.querySelector("[data-accordion-trigger]");
        const panel = acc.querySelector("[data-accordion-panel]");
        if (!trigger || !panel) return;

        trigger.addEventListener("click", () => {
          const expanded = trigger.getAttribute("aria-expanded") === "true";
          trigger.setAttribute("aria-expanded", !expanded);

          const icon = trigger.querySelector("svg");
          if (icon) icon.style.transform = expanded ? "" : "rotate(180deg)";

          panel.style.gridTemplateRows = expanded ? "0fr" : "1fr";
        });
      });
    })();
  </script>

</header>
