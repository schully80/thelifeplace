<div class="space-y-5">

  <!-- Street Address (Google Autocomplete) -->
  <div>
    <input
      id="address-autocomplete"
      name="street_address"
      type="text"
      placeholder="Street Address *"
      required
      class="w-full rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-[15px] text-gray-900
             placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red/60 
             focus:border-brand-red transition"
      style="font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
      autocomplete="off"
    />
  </div>

  <!-- Suburb -->
  <div>
    <input
      id="sublocality"
      name="suburb"
      type="text"
      placeholder="Suburb"
      class="w-full rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-[15px] text-gray-900
             placeholder:text-gray-400 focus:outline-none transition"
      style="font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
      readonly
    />
  </div>

  <!-- City -->
  <div>
    <input
      id="locality"
      name="city"
      type="text"
      placeholder="City"
      class="w-full rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-[15px] text-gray-900
             placeholder:text-gray-400 focus:outline-none transition"
      style="font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
      readonly
    />
  </div>

  <!-- Province -->
  <div>
    <input
      id="administrative_area_level_1"
      name="province"
      type="text"
      placeholder="Province"
      class="w-full rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-[15px] text-gray-900
             placeholder:text-gray-400 focus:outline-none transition"
      style="font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
      readonly
    />
  </div>

  <!-- Postal Code -->
  <div>
    <input
      id="postal_code"
      name="postal_code"
      type="text"
      placeholder="Postal Code"
      class="w-full rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-[15px] text-gray-900
             placeholder:text-gray-400 focus:outline-none transition"
      style="font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
      readonly
    />
  </div>

  <!-- Country -->
  <div>
    <input
      id="country"
      name="country"
      type="text"
      placeholder="Country"
      class="w-full rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-[15px] text-gray-900
             placeholder:text-gray-400 focus:outline-none transition"
      style="font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
      readonly
    />
  </div>

</div>
