---
/* No keys needed — clean minimal validation version */
---

<style>
  /* Floating label wrapper */
  .field {
    position: relative;
  }

.field input {
    width: 100%;
    border: 1.5px solid #e5e7eb; /* gray-200 base */
    border-radius: 0.75rem;
    padding: 14px 12px;
    font-size: 15px;
    background: rgba(255, 255, 255, 0.7);
    outline: none;
    transition: all .25s ease;
    font-family: inherit;
  }

  .field input:focus {
    border-color: #e5e7eb;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 0 3px rgba(229, 231, 235, 0.6);
  }

  .field label {
    position: absolute;
    left: 12px;
    top: 14px;
    font-size: 15px;
    color: #9ca3af;
    pointer-events: none;
    transition: all .25s ease;
    font-weight: 500;
    origin: left top;
    background: white;
    padding: 0 4px;
  }

  .field .valid-icon {
    position: absolute;
    right: 10px;
    top: 14px;
    color: #B3282D;
    opacity: 0;
    transition: opacity .2s ease;
    font-size: 14px;
    pointer-events: none;
  }

  .field input:focus + label,
  .field input:not(:placeholder-shown) + label {
    transform: translateY(-30px) scale(0.85);
    font-size: 12px;
    color: #B3282D;
    font-weight: 600;
    background: white;
  }

  /* Error message */
  .error-text {
    font-size: 13px;
    color: #B3282D;
    margin-top: 6px;
    display: none;
    font-weight: 500;
  }

  .show-error .error-text {
    display: block;
  }

  .show-error .field input {
    border-color: #B3282D;
    background: rgba(179, 40, 45, 0.05);
  }

  .field.valid input {
    border-color: #B3282D;
    box-shadow: 0 0 0 3px rgba(179, 40, 45, 0.14);
  }

  .field.valid label {
    color: #B3282D;
  }

  .field.valid .valid-icon {
    opacity: 1;
  }


</style>

<section class="space-y-12 pb-8">

  <!-- USER INFO -->
  <h2 class="text-xl font-semibold mt-8 text-center">Your Details</h2>


<p class="text-sm text-gray-500 mt-3 mb-6">
  * Required fields
</p>


  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

    <div class="field">
      <input id="fullName" name="fullName" type="text" required placeholder=" " autocomplete="name" />
      <label>Name (First or First & Last) *</label>
      <p class="error-text">Required</p>
    </div>

    <div class="field" data-validate="phone">
      <input id="contact" name="contact" type="tel" required placeholder=" " aria-describedby="contact-help" autocomplete="tel" />
      <label>Contact Number *</label>
      <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
      <p class="error-text">Valid phone format</p>
    </div>

    <div class="field" data-validate="email">
      <input id="email" name="email" type="email" required placeholder=" " aria-describedby="email-help" autocomplete="email" />
      <label>Email Address *</label>
      <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
      <p class="error-text">Valid email format</p>
    </div>

    <div class="field">
      <input id="attendees" name="attendees" type="number" min="1" required placeholder=" " inputmode="numeric" />
      <label>Number of Persons Attending *</label>
      <p class="error-text">Required</p>
    </div>

  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Address fields removed for Visit form simplification -->
  </div>
</section>


<!-- MINIMAL VALIDATION SCRIPT -->
<script is:inline>
  (() => {
    if (window.__tlpAddressFieldsInit) return;
    window.__tlpAddressFieldsInit = true;

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const zaPhonePattern = /^(?:\+27|0)[0-9]{9}$/;

    function validateFieldWrapper(field) {
      const input = field?.querySelector('input');
      if (!field || !input) return true;

      const value = input.value.trim();
      let valid = true;

      if (input.required && !value) valid = false;

      if (valid && field.dataset.validate === 'email') {
        valid = emailPattern.test(value);
      }
      if (valid && field.dataset.validate === 'phone') {
        valid = zaPhonePattern.test(value.replace(/\s|-/g, ''));
      }
      if (valid && input.type === 'number' && value && input.min) {
        valid = Number(value) >= Number(input.min);
      }

      field.classList.toggle('show-error', !valid);
      field.classList.toggle('valid', valid && value.length > 0);
      return valid;
    }

    window.TLPAddressFields = {
      validateFieldWrapper,
      validateForm(form) {
        const fields = Array.from(form.querySelectorAll('.field')).filter((field) => field.querySelector('input'));
        let firstInvalid = null;
        const valid = fields.every((field) => {
          const ok = validateFieldWrapper(field);
          if (!ok && !firstInvalid) firstInvalid = field.querySelector('input');
          return ok;
        });
        return { valid, firstInvalid };
      },
    };

    document.addEventListener('input', (e) => {
      const field = e.target instanceof HTMLElement ? e.target.closest('.field') : null;
      if (!field) return;
      validateFieldWrapper(field);
    });
  })();
</script>
