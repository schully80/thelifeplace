---
// NOTE: Legacy/unused. BaseLayout renders src/components/Header.astro (includes mobile).
const {
  title = "The Life Place",
  logoSrc = "/logo4.svg",
  symbolSrc = "/symbol3.svg",
  class: className,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? path === "/"
    : path === href || (href !== "/" && path.startsWith(href) && path.charAt(href.length) === "/");
---

<header class:list={[
  "relative z-50 border-b bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70 h-20 sm:h-24 md:hidden",
  className,
]}>
  <!-- Top bar: 3-column grid -->
  <div class="relative flex h-20 items-center justify-center px-4">

    <!-- LEFT: Logo -->
    <div class="flex min-w-0 items-center justify-center">
      <a
        href="/"
        class="mx-14 flex min-w-0 items-center justify-center gap-2"
        aria-label={`${title} — Home`}
      >
        <img src={symbolSrc} alt="" class="h-9 w-9 flex-shrink-0 sm:h-12 sm:w-12" aria-hidden="true" />
        <img src={logoSrc} alt={title} class="h-12 w-auto max-w-[40vw] flex-shrink-0 sm:h-14 sm:max-w-[220px]" />
      </a>
    </div>

    <!-- RIGHT: Hamburger Menu Button -->
    <div class="absolute right-4 flex items-center gap-2 flex-shrink-0">
      <button
        id="mobileMenuButton"
        type="button"
        aria-label="Open menu"
        aria-controls="mobileNavDrawer"
        aria-expanded="false"
        class="p-2 rounded-md hover:bg-gray-100 transition"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6 text-gray-900" aria-hidden="true">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>

  <!-- OVERLAY -->
  <div
    id="mobileNavOverlay"
    class="fixed inset-0 bg-white opacity-0 pointer-events-none transition-opacity z-[9998] md:hidden"
    data-overlay
  ></div>

  <!-- DRAWER -->
  <aside
    id="mobileNavDrawer"
    class="fixed inset-y-0 right-0 w-[86%] max-w-sm bg-white shadow-xl transition-transform will-change-transform z-[9999] focus:outline-none md:hidden translate-x-full"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
    tabindex="-1"
    data-drawer
  >
    <!-- Drawer header -->
    <div class="h-16 px-4 flex items-center justify-end border-b">
      <button
        id="mobileMenuClose"
        type="button"
        aria-label="Close menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-gray-50 text-brand-red shadow-sm transition-colors hover:bg-brand-red hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-red/70 focus:ring-offset-2"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6l-12 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <span class="sr-only">Close menu</span>
      </button>
    </div>

        <!-- Drawer nav -->
    <nav
      class="px-4 py-3 overflow-y-auto max-h-[calc(100dvh-4rem)] space-y-2"
      aria-label="Mobile"
    >
      <!-- ...existing code... -->

      <!-- ABOUT US ACCORDION -->
      <section class="mt-2" data-accordion>
        <button
          type="button"
          class="w-full flex items-center justify-between px-4 py-3.5 rounded-full text-left text-base hover:bg-gray-50"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="acc-about"
        >
          <span>About Us</span>
          <svg class="h-6 w-6 transition-transform" viewBox="0 0 24 24">
            <path d="M5 10l7 7 7-7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
          </svg>
        </button>

        <div
          id="acc-about"
          class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out"
          data-accordion-panel
        >
          <div class="overflow-hidden">
            <ul class="py-1">
              <li>
                <a
                  href="/about-us/"
                  class={`block px-5 py-3 text-[15px] rounded-full ${
                    isActive("/about-us/")
                      ? "text-brand-red font-semibold bg-red-50"
                      : "text-brand-darkgray hover:bg-gray-50"
                  }`}
                >
                  What We Do
                </a>
              </li>
              
              <li>
                <a
                  href="/what-we-believe/"
                  class={`block px-5 py-3 text-[15px] rounded-full ${
                    isActive("/what-we-believe/")
                      ? "text-brand-red font-semibold bg-red-50"
                      : "text-brand-darkgray hover:bg-gray-50"
                  }`}
                >
                  What We Believe
                </a>
              </li>
              <li>
                <a
                  href="/about-us/leadership"
                  class={`block px-5 py-3 text-[15px] rounded-full ${
                    isActive("/about-us/leadership")
                      ? "text-brand-red font-semibold bg-red-50"
                      : "text-brand-darkgray hover:bg-gray-50"
                  }`}
                >
                  Schulter and Genevieve
                </a>
              </li>
            </ul>
          </div>
        </div>
      </section>

  
          <!-- Messages (TEMPORARILY DISABLED) -->
          <!--
          <a
            href="/messages/"
            class={`relative px-2 py-2 
              after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red
              ${isActive("/messages/") ? "after:w-full text-brand-red font-semibold" : "text-brand-darkgray hover:text-brand-red after:w-0"}
              hover:after:w-full after:transition-all after:duration-300`}
          >
            Messages
          </a>
          -->



 <!-- LIVE -->
<a
  href="/live/"
  class={`block px-4 py-3.5 rounded-full text-base ${
    isActive("/live/")
      ? "text-brand-red font-semibold bg-red-50"
      : "text-brand-darkgray hover:bg-gray-50"
  }`}
>
  <span class="flex items-center gap-2">
    <span data-live-mobile-text>Live</span>
    <span
      data-live-mobile-indicator
      class="hidden h-2 w-2 rounded-full bg-red-600"
    ></span>
  </span>
</a>



      <!-- Ministries nav removed from mobile drawer -->
      
      <!-- GENEROSITY (Give) — after Ministries in desktop, but in mobile we place BEFORE Ministries for UX clarity -->
      <a
        href="/give/"
        class={`mt-3 inline-flex items-center justify-center px-4 py-2 rounded-full bg-brand-red text-white font-semibold shadow-md hover:bg-red-700 hover:shadow-lg transition`}
      >
        Generosity
      </a>


      <!-- VISIT -->
      <a
        href="/visit/"
        class={`mt-4 block px-4 py-4 rounded-full text-base font-medium ${
          isActive("/visit/")
            ? "text-brand-red font-semibold bg-red-50"
            : "text-brand-darkgray hover:bg-gray-50"
        }`}
      >
        Plan A Visit
      </a>

        <!-- BLOG (last) -->
        <a
          href="https://schulteretyang.substack.com"
          target="_blank"
          rel="noopener noreferrer"
          class={`w-full text-left block px-4 py-3 rounded-full text-base text-brand-darkgray hover:bg-gray-50`}
        >Blog</a>
    </nav>

  </aside>

  <!-- Behaviour script -->
  <script is:inline>
    const btnOpen = document.getElementById("mobileMenuButton");
    const btnClose = document.getElementById("mobileMenuClose");
    const drawer = document.getElementById("mobileNavDrawer");
    const overlay = document.getElementById("mobileNavOverlay");
    const body = document.documentElement;

    if (btnOpen && btnClose && drawer && overlay) {
      const open = () => {
        drawer.classList.remove("translate-x-full");
        overlay.classList.remove("pointer-events-none");
        overlay.classList.add("opacity-100");
        btnOpen.setAttribute("aria-expanded", "true");
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        body.style.overflow = "hidden";
        body.style.paddingRight = scrollbarWidth + "px";
        drawer.focus();
      };

      const close = () => {
        drawer.classList.add("translate-x-full");
        overlay.classList.add("pointer-events-none");
        overlay.classList.remove("opacity-100");
        btnOpen.setAttribute("aria-expanded", "false");
        body.style.overflow = "";
        body.style.paddingRight = "";
      };

      btnOpen.addEventListener("click", open);
      btnClose.addEventListener("click", close);
      overlay.addEventListener("click", close);
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });

      drawer.querySelectorAll("a[href]").forEach((link) => {
        link.addEventListener("click", () => {
          const isInsideAccordion = link.closest("[data-accordion]");
          if (!isInsideAccordion) {
            drawer.querySelectorAll("[data-accordion]").forEach((acc) => {
              const trigger = acc.querySelector("[data-accordion-trigger]");
              const panel = acc.querySelector("[data-accordion-panel]");
              if (trigger && panel) {
                trigger.setAttribute("aria-expanded", "false");
                const icon = trigger.querySelector("svg");
                if (icon) icon.style.transform = "";
                panel.style.gridTemplateRows = "0fr";
              }
            });
          }
          close();
        });
      });

      drawer.querySelectorAll("[data-accordion]").forEach((acc) => {
        const trigger = acc.querySelector("[data-accordion-trigger]");
        const panel = acc.querySelector("[data-accordion-panel]");
        if (!trigger || !panel) return;

        const panelId = panel.id;

        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const expanded = trigger.getAttribute("aria-expanded") === "true";
          trigger.setAttribute("aria-expanded", !expanded);
          const icon = trigger.querySelector("svg");
          if (icon) icon.style.transform = expanded ? "" : "rotate(180deg)";
          panel.style.gridTemplateRows = expanded ? "0fr" : "1fr";
        });
      });
    }
  </script>

  <script is:inline>
  document.addEventListener("tlp-live-updated", (e) => {
    const text = document.querySelector("[data-live-mobile-text]");
    const dot = document.querySelector("[data-live-mobile-indicator]");
    const detail = e instanceof CustomEvent ? e.detail : false;

    if (!(text instanceof HTMLElement) || !(dot instanceof HTMLElement)) return;

    if (detail) {
      text.textContent = "Live Now";
      dot.classList.remove("hidden");
    } else {
      text.textContent = "Live";
      dot.classList.add("hidden");
    }
  });
</script>



</header>
