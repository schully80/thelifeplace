---
const {
  logoSrc = "/logo.png",
  title = "The Life Place",
  class: className,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href) =>
  href === "/" ? path === "/" : path === href || (href !== "/" && path.startsWith(href));
---

<!-- Laptop/iPad header: md → lg screens -->
<header class={`hidden md:block xl:hidden relative z-30 border-b bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex justify-between items-center gap-6">

    <!-- LEFT: Logo + Title -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-3 min-w-0"
      aria-label={`${title} — Home`}
    >
      <img src={logoSrc} alt={`${title} Logo`} class="h-10 md:h-14 w-auto" />

      <div class="flex flex-col min-w-0 items-center text-center">
        <span class="font-bold text-brand-red text-lg sm:text-xl md:text-2xl leading-tight truncate">
          {title}
        </span>
        <span class="text-sm text-gray-600 tracking-wide">
          Come. See. <span class="text-[#B3282D]">Jesus
        </span>
      </div>
    </a>

       <!-- RIGHT NAV -->
    <nav class="flex items-center gap-6 font-montserrat text-base">

      <!-- What to Expect -->
      <a
        href="/what-to-expect/"
        class={isActive("/what-to-expect/") ? "text-brand-red font-semibold" : "text-gray-800 hover:text-brand-red"}
      >What to Expect</a>

      <!-- About Us -->
      <a
        href="/about-us/"
        class={isActive("/about-us/") ? "text-brand-red font-semibold" : "text-gray-800 hover:text-brand-red"}
      >About Us</a>

          <!-- Messages (TEMPORARILY DISABLED) -->
          <!--
          <a
            href="/messages/"
            class={`relative px-2 py-2 
              after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red
              ${isActive("/messages/") ? "after:w-full text-brand-red font-semibold" : "text-brand-darkgray hover:text-brand-red after:w-0"}
              hover:after:w-full after:transition-all after:duration-300`}
          >
            Messages
          </a>
          -->


<!-- Live (Desktop / Laptop) -->
<a
  href="/live/"
  class={`relative px-2 py-2 flex items-center gap-1
    after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red
    ${isActive("/live/") ? "after:w-full text-brand-red font-semibold" : "text-brand-darkgray hover:text-brand-red after:w-0"}
    hover:after:w-full after:transition-all after:duration-300`}
>
  <span data-live-desktop-text>Live</span>

  <!-- Only shows when Live is TRUE -->
  <span
    data-live-desktop-indicator
    class="hidden h-2 w-2 rounded-full bg-red-600 animate-ping absolute -right-3 top-1/2 -translate-y-1/2"
  ></span>
</a>

      <!-- Ministries -->
      <a
        href="/ministries/"
        class={isActive("/ministries/") ? "text-brand-red font-semibold" : "text-gray-800 hover:text-brand-red"}
      >Ministries</a>

      <!-- Give (NOW after Ministries) -->
      <a
        href="/give/"
        class={`relative z-10 inline-flex items-center justify-center px-4 py-2 rounded-full font-semibold shadow-md transition ${
          isActive("/give/")
            ? "bg-brand-red text-white"
            : "bg-brand-red text-white hover:bg-red-700"
        }`}
        aria-current={isActive("/give/") ? "page" : undefined}
      >
        Generosity
      </a>

      <!-- Plan A Visit -->
      <a
        href="/visit/"
        class={isActive("/visit/") ? "text-brand-red font-semibold" : "text-gray-800 hover:text-brand-red"}
      >Plan A Visit</a>

      <!-- Blog (last) -->
      <a
        href="https://schulteretyang.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-800 hover:text-brand-red font-semibold transition"
      >
        Our Blog
      </a>

    </nav>

  </div>
</header>

<script is:inline>
  document.addEventListener("tlp-live-updated", (e) => {
    const text = document.querySelector("[data-live-desktop-text]");
    const dot = document.querySelector("[data-live-desktop-indicator]");

    if (!text || !dot) return;

    if (e.detail === true) {
      text.textContent = "Live Now";
      dot.classList.remove("hidden");
    } else {
      text.textContent = "Live";
      dot.classList.add("hidden");
    }
  });
</script>

<script is:inline>
async function updateLiveUI() {
  try {
    const res = await fetch('/live-status.json', { cache: 'no-store' });
    const data = res.ok ? await res.json() : { live: false };
    const live = !!data.live;

    document.querySelectorAll('[data-live-indicator]')
      .forEach(el => el.classList.toggle('hidden', !live));

    document.querySelectorAll('[data-live-text]')
      .forEach(el => el.textContent = live ? 'Live now' : 'Live');
  } catch (e) {
    // Fail-safe: hide indicator if anything goes wrong
    document.querySelectorAll('[data-live-indicator]')
      .forEach(el => el.classList.add('hidden'));
  }
}

// Run when the page loads (works with Astro client-side nav too)
addEventListener('astro:page-load', updateLiveUI);
// (Optional) Poll every 60s:
// setInterval(updateLiveUI, 60000);
</script>

