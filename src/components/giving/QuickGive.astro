---
const {
  subtitle = "Below is a simple, guided way to give generously — step by step.",
} = Astro.props;

const categories = ["Tithes", "Offerings", "Relief Center", "Other"];
const amounts = ["R100", "R250", "R500", "R1,000", "Custom"];
---

<section
  data-quick-give
>
  <!-- STEP 1: AMOUNT -->
  <div class="mb-6 md:mb-12">
    <p class="text-lg md:text-2xl font-bold text-gray-800 mb-4 md:mb-8">
      Step 1 · CHOOSE AMOUNT 
    </p>

    <div class="flex flex-wrap gap-3 md:gap-5">
      {amounts.map((a) => (
        <button
          type="button"
          class="amountBtn rounded-2xl px-5 sm:px-7 py-3 sm:py-4
                 bg-black/5 border border-black/10
                 text-base sm:text-lg md:text-xl font-extrabold text-gray-800 transition-all duration-300"
          data-amount={a}
        >
          {a}
        </button>
      ))}
    </div>
  </div>

  <!-- STEP 2: CATEGORY -->
  <div class="mb-0">
    <p class="text-lg md:text-2xl font-bold text-gray-800 mb-4 md:mb-8">
      Step 2 · PURPOSE
    </p>

    <div class="flex flex-wrap gap-3 md:gap-5">
      {categories.map((c) => (
        <button
          type="button"
          class="categoryBtn rounded-2xl px-5 sm:px-7 py-3 sm:py-4
                 bg-white border border-black/10
                 text-base sm:text-lg md:text-xl font-extrabold text-gray-800 transition-all duration-300 hover:shadow-md hover:border-brand-red"
          data-category={c}
        >
          {c}
        </button>
      ))}
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const root = document.querySelector("[data-quick-give]");
  if (!root) return;

  let amount = null;
  let category = null;

  const amountBtns = root.querySelectorAll(".amountBtn");
  const categoryBtns = root.querySelectorAll(".categoryBtn");

  function revealIfReady() {
    if (!amount || !category) return;

    // Scroll directly to giving methods section
    setTimeout(() => {
      document.querySelector("#giving-methods")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }, 100);
  }

  // AMOUNT
  amountBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      amount = btn.dataset.amount;
      // Reset all amount buttons to inactive state
      amountBtns.forEach(b => {
        b.classList.remove("bg-brand-red", "text-white", "border-brand-red");
        b.classList.remove("bg-black/5", "text-gray-800", "border-black/10");
        b.classList.add("bg-black/5", "text-gray-800", "border-black/10");
      });

      // Activate clicked button with clear contrast
      btn.classList.remove("bg-black/5", "text-gray-800", "border-black/10");
      btn.classList.add("bg-brand-red", "text-white", "border-brand-red");
      revealIfReady();
    });
  });

  // CATEGORY
  categoryBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      category = btn.dataset.category;
      // Reset all category buttons to inactive state
      categoryBtns.forEach(b => {
        b.classList.remove("bg-brand-red", "text-white", "border-brand-red");
        b.classList.remove("bg-white", "text-gray-800", "border-black/10");
        b.classList.add("bg-white", "text-gray-800", "border-black/10");
      });

      // Activate clicked button with clear contrast
      btn.classList.remove("bg-white", "text-gray-800", "border-black/10");
      btn.classList.add("bg-brand-red", "text-white", "border-brand-red");
      revealIfReady();
    });
  });
});
</script>
