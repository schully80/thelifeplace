---
const categories = ["Tithes", "Offerings", "Relief Center", "Other"];
const amounts = ["R100", "R250", "R500", "R1,000", "Custom"];
---

<section data-quick-give aria-labelledby="quick-give-title">
  <div class="grid gap-8 lg:grid-cols-[0.78fr_1fr] lg:gap-12">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Start here</p>
      <h2 id="quick-give-title" class="mt-3 text-3xl font-black leading-tight text-gray-900 sm:text-4xl md:text-5xl">
        A simple way to choose your gift.
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-gray-600 md:text-lg">
        Pick an amount and purpose, then choose the giving method that fits you best.
      </p>
    </div>

    <div class="space-y-8">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">Amount</p>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {amounts.map((amount) => (
            <button
              type="button"
              class="amountBtn min-h-12 rounded-2xl border border-black/10 bg-[oklch(97.5%_0.006_20)] px-4 py-3 text-base font-black text-gray-900 transition-[background-color,border-color,color,transform] duration-150 ease-out hover:border-brand-red/40 active:scale-[0.98]"
              data-amount={amount}
            >
              {amount}
            </button>
          ))}
        </div>
      </div>

      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">Purpose</p>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {categories.map((category) => (
            <button
              type="button"
              class="categoryBtn min-h-12 rounded-2xl border border-black/10 bg-[oklch(99%_0.004_20)] px-4 py-3 text-base font-black text-gray-900 transition-[background-color,border-color,box-shadow,color,transform] duration-150 ease-out hover:border-brand-red/40 hover:shadow-sm active:scale-[0.98]"
              data-category={category}
            >
              {category}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const root = document.querySelector("[data-quick-give]");
  if (!root) return;

  let amount = null;
  let category = null;

  const amountBtns = root.querySelectorAll(".amountBtn");
  const categoryBtns = root.querySelectorAll(".categoryBtn");

  function markSelected(buttons, selected, inactiveBg) {
    buttons.forEach((button) => {
      button.classList.remove("bg-brand-red", "text-white", "border-brand-red", "shadow-md");
      button.classList.add(inactiveBg, "text-gray-900", "border-black/10");
      button.setAttribute("aria-pressed", "false");
    });

    selected.classList.remove(inactiveBg, "text-gray-900", "border-black/10");
    selected.classList.add("bg-brand-red", "text-white", "border-brand-red", "shadow-md");
    selected.setAttribute("aria-pressed", "true");
  }

  function revealIfReady() {
    if (!amount || !category) return;

    setTimeout(() => {
      document.querySelector("#giving-methods")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }, 100);
  }

  amountBtns.forEach((button) => {
    button.setAttribute("aria-pressed", "false");
    button.addEventListener("click", () => {
      amount = button.dataset.amount;
      markSelected(amountBtns, button, "bg-[oklch(97.5%_0.006_20)]");
      revealIfReady();
    });
  });

  categoryBtns.forEach((button) => {
    button.setAttribute("aria-pressed", "false");
    button.addEventListener("click", () => {
      category = button.dataset.category;
      markSelected(categoryBtns, button, "bg-[oklch(99%_0.004_20)]");
      revealIfReady();
    });
  });
});
</script>
