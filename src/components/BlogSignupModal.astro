---
const blogUrl = "https://schulteretyang.substack.com";
import Turnstile from "./ui/Turnstile.astro";
---
<div id="blogSignupModal" class="fixed inset-0 z-50 items-center justify-center p-4" style="display: none;">
  <!-- Backdrop -->
  <div
    id="blogSignupBackdrop"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm"
  ></div>

  <!-- Modal -->
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full z-10 overflow-hidden animate-fadeIn">
    <!-- Close button -->
    <button
      id="blogSignupClose"
      type="button"
      aria-label="Close modal"
      class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition z-20"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Content -->
    <div class="p-8">
      <!-- Header -->
      <div class="mb-6">
        <h2 class="heading-2 text-center mb-2">
          Stay Updated
        </h2>
        <p class="text-gray-600 text-sm">
          Join our community for thoughtful insights, updates, and exclusive content delivered to your inbox.
        </p>
      </div>

      <!-- Form -->
      <form id="blogSignupForm" class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-600 mb-2">
            Email Address
          </label>
          <input
            id="email"
            type="email"
            placeholder="your@email.com"
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-transparent transition"
          />
        </div>


        <div class="pt-2 flex flex-col items-center gap-3">
          <Turnstile name="cf-turnstile-response-blog" />
        </div>
<script>
  (function(){
    const form = document.getElementById('blogSignupForm');
    const btn = document.getElementById('subscribeBtn');
    if (!form || !btn) return;
    const hasToken = () => {
      const e = form.querySelector('input[name="cf-turnstile-response-blog"]');
      return !!(e && e.value && e.value.length > 0);
    };
    const setDisabled = (disabled) => {
      btn.disabled = disabled;
      if (disabled) {
        btn.classList.add('opacity-60', 'cursor-not-allowed');
        btn.setAttribute('aria-disabled', 'true');
      } else {
        btn.classList.remove('opacity-60', 'cursor-not-allowed');
        btn.removeAttribute('aria-disabled');
      }
    };
    setDisabled(!hasToken());
    form.addEventListener('turnstile:verified', function(){ setDisabled(false); });
    form.addEventListener('submit', function(e){
      if (!hasToken()) {
        e.preventDefault();
        setDisabled(true);
        alert('Please complete the verification before submitting.');
      } else {
        btn.setAttribute('aria-busy', 'true');
      }
    });
  })();
</script>

        <button
          id="subscribeBtn"
          type="submit"
          class="w-full bg-brand-red hover:bg-red-700 text-white font-semibold py-3 rounded-2xl transition duration-200 transform hover:scale-105"
        >
          Subscribe on Substack
        </button>
      </form>

      <!-- Footer message -->
      <p class="text-xs text-gray-500 text-center mt-4">
        You'll be redirected to confirm your subscription. We respect your privacy.
      </p>

      <!-- Divider -->
      <div class="flex items-center my-6">
        <div class="flex-1 border-t border-gray-300"></div>
        <span class="px-3 text-sm text-gray-500">or</span>
        <div class="flex-1 border-t border-gray-300"></div>
      </div>

      <!-- Direct link -->
      <a
        href={blogUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-center px-4 py-3 rounded-2xl border border-brand-red text-brand-red hover:bg-red-50 font-semibold transition text-sm"
      >
        Visit Our Blog Directly
      </a>
    </div>
  </div>
</div>

<script is:inline>
    (() => {
      const modal = document.getElementById("blogSignupModal");
      const closeBtn = document.getElementById("blogSignupClose");
      const backdrop = document.getElementById("blogSignupBackdrop");
      const form = document.getElementById("blogSignupForm");
      const emailInput = document.getElementById("email");
      const subscribeBtn = document.getElementById("subscribeBtn");

      if (!modal || !closeBtn || !backdrop || !form || !subscribeBtn) return;

      const STORAGE_KEY = "tlp_blog_modal_seen_v1";
      const SCROLL_FRACTION = 0.75; // show after 75% of page height scrolled

      const openModal = () => {
        modal.style.display = "flex";
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        sessionStorage.setItem(STORAGE_KEY, "shown");
        setTimeout(() => emailInput?.focus(), 50);
      };

      const closeModal = () => {
        modal.style.display = "none";
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      window.openBlogSignupModal = openModal;

      // Open once per session when user scrolls past 75% of the page
      const onScroll = () => {
        if (sessionStorage.getItem(STORAGE_KEY)) {
          window.removeEventListener("scroll", onScroll);
          return;
        }
        const doc = document.documentElement;
        const scrollable = doc.scrollHeight - window.innerHeight;
        if (scrollable <= 0) return;
        const progress = window.scrollY / scrollable;
        if (progress >= SCROLL_FRACTION) {
          openModal();
          window.removeEventListener("scroll", onScroll);
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });

      // Attach manual triggers
      document.querySelectorAll("[data-blog-modal-trigger]").forEach((node) => {
        node.addEventListener("click", (event) => {
          event.preventDefault();
          openModal();
        });
      });

      // Close button
      closeBtn.addEventListener("click", closeModal);

      // Backdrop click
      backdrop.addEventListener("click", closeModal);

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal.style.display === "flex") {
          closeModal();
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput?.value || "";
        const originalText = subscribeBtn.textContent;

        // Show loading state
        subscribeBtn.disabled = true;
        subscribeBtn.textContent = "Redirecting to Substack...";
        subscribeBtn.classList.add("opacity-75");

        // Small delay for smooth UX
        setTimeout(() => {
          const subStackUrl = `https://schulteretyang.substack.com?email=${encodeURIComponent(email)}`;
          window.open(subStackUrl, "_blank");

          // Reset button state
          subscribeBtn.disabled = false;
          subscribeBtn.textContent = originalText;
          subscribeBtn.classList.remove("opacity-75");

          // Close modal and reset form
          closeModal();
          form.reset();
        }, 800);
      });
    })();
</script>

<style>
  @keyframes backdropFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes modalSlideUp {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.90);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  #blogSignupBackdrop {
    animation: backdropFadeIn 0.6s ease-out forwards;
  }

  #blogSignupModal > div:last-child {
    animation: modalSlideUp 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: 0.1s;
  }

  .animate-fadeIn {
    animation: modalSlideUp 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Show modal as flex when not hidden */
  #blogSignupModal[style*="display: flex"] {
    display: flex !important;
  }
</style>
