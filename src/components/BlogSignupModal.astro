---
const blogUrl = "https://schulteretyang.substack.com";
import Turnstile from "./ui/Turnstile.astro";
---
<div
  id="blogSignupModal"
  class="fixed inset-0 z-50 items-center justify-center p-3"
  style="display: none;"
>
  <!-- Backdrop -->
  <div
    id="blogSignupBackdrop"
    class="absolute inset-0 bg-black/10 backdrop-blur-sm transition-opacity"
  ></div>

  <!-- Modal -->
  <div class="relative bg-white rounded-xl shadow-xl max-w-xs sm:max-w-sm md:max-w-md w-full z-10 overflow-hidden animate-fadeIn border border-gray-100">
    <!-- Close button -->
    <button
      id="blogSignupClose"
      type="button"
      aria-label="Close modal"
      class="absolute top-3 right-3 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-brand-red/70 focus:ring-offset-2"
    >
      <i class="fa-solid fa-x text-sm" aria-hidden="true"></i>
    </button>

    <!-- Content -->
    <div class="p-5 md:p-6 space-y-4 md:space-y-5">
      <!-- Header -->
      <div class="space-y-2 text-center">
        <h2 class="text-lg md:text-2xl font-bold text-gray-900 leading-tight">SUBSCRIBE</h2>
        <p class="text-gray-600 text-[12px] md:text-sm">
          Subscribe and receive the latest updates directly in your inbox.
        </p>
      </div>

      <!-- Social / identity options -->
      <div class="space-y-2">
        <p class="text-[10px] md:text-[11px] font-semibold text-gray-600 uppercase tracking-[0.18em] text-center">Subscribe with</p>
        <div class="grid grid-cols-1 gap-2">
          <button
            type="button"
            data-provider-btn="google"
            class="w-full flex items-center justify-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2 md:px-3.5 text-[12px] md:text-sm font-semibold text-gray-800 shadow-sm transition hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-red/70"
            aria-label="Subscribe with Google"
            title="Subscribe with Google"
          >
            <i class="fa-brands fa-google text-lg md:text-xl text-gray-800" aria-hidden="true"></i>
            <span class="sr-only">Subscribe with Google</span>
          </button>

          <button
            type="button"
            data-provider-btn="apple"
            class="w-full flex items-center justify-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2 md:px-3.5 text-[12px] md:text-sm font-semibold text-gray-800 shadow-sm transition focus:outline-none focus:ring-2 focus:ring-brand-red/70"
            aria-label="Subscribe with Apple"
            title="Subscribe with Apple"
          >
            <i class="fa-brands fa-apple text-lg md:text-xl text-gray-800" aria-hidden="true"></i>
            <span class="sr-only">Subscribe with Apple</span>
          </button>

          <button
            type="button"
            data-provider-btn="facebook"
            class="w-full flex items-center justify-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2 md:px-3.5 text-[12px] md:text-sm font-semibold text-gray-800 shadow-sm transition focus:outline-none focus:ring-2 focus:ring-brand-red/70"
            aria-label="Subscribe with Facebook"
            title="Subscribe with Facebook"
          >
            <i class="fa-brands fa-facebook text-lg md:text-xl text-gray-800" aria-hidden="true"></i>
            <span class="sr-only">Subscribe with Facebook</span>
          </button>
        </div>
      </div>

      <!-- Divider to email form -->
      <div class="flex items-center my-4 text-gray-400">
        <div class="flex-1 border-t border-gray-200"></div>
        <span class="px-2 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-gray-500">
        Email</span>
        <div class="flex-1 border-t border-gray-200"></div>
      </div>

      <!-- Form -->
      <form id="blogSignupForm" class="space-y-3">
        <div>
         
          <input
            id="email"
            type="email"
            placeholder="your@email.com"
            required
            class="w-full px-3 py-2 md:px-3.5 md:py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-transparent transition text-[12px] md:text-sm"
          />
        </div>

        <div class="pt-1 flex flex-col items-center gap-2">
          <div class="w-full max-w-[200px] mx-auto text-center">
            <Turnstile name="cf-turnstile-response-blog" hideStatus={true} />
            <p class="mt-1 text-[11px] md:text-xs text-gray-500 text-center">Please complete the verification</p>
          </div>
        </div>
<script>
  (function(){
    const form = document.getElementById('blogSignupForm');
    const btn = document.getElementById('subscribeBtn');
    if (!form || !btn) return;
    const hasToken = () => {
      const e = form.querySelector('input[name="cf-turnstile-response-blog"]');
      return !!(e && e.value && e.value.length > 0);
    };
    const setDisabled = (disabled) => {
      btn.disabled = disabled;
      if (disabled) {
        btn.classList.add('opacity-60', 'cursor-not-allowed');
        btn.setAttribute('aria-disabled', 'true');
      } else {
        btn.classList.remove('opacity-60', 'cursor-not-allowed');
        btn.removeAttribute('aria-disabled');
      }
    };
    setDisabled(!hasToken());
    form.addEventListener('turnstile:verified', function(){ setDisabled(false); });
    form.addEventListener('submit', function(e){
      if (!hasToken()) {
        e.preventDefault();
        setDisabled(true);
        alert('Please complete the verification before submitting.');
      } else {
        btn.setAttribute('aria-busy', 'true');
      }
    });
  })();
</script>

        <button
          id="subscribeBtn"
          type="submit"
          class="w-full bg-brand-red hover:bg-red-700 text-white font-semibold py-2.5 rounded-xl transition duration-150"
        >
          Subscribe
        </button>
      </form>

      <p class="text-[11px] text-gray-500 text-center mt-2">
        You'll be redirected to confirm your subscription. Privacy respected.
      </p>
    </div>
  </div>
</div>

<script is:inline>
    (() => {
      const modal = document.getElementById("blogSignupModal");
      const hostname = window.location.hostname;
      const IS_DEV =
        hostname === "localhost" ||
        hostname === "127.0.0.1" ||
        hostname === "0.0.0.0" ||
        window.location.port === "4322";
      const closeBtn = document.getElementById("blogSignupClose");
      const backdrop = document.getElementById("blogSignupBackdrop");
      const form = document.getElementById("blogSignupForm");
      const emailInput = document.getElementById("email");
      const subscribeBtn = document.getElementById("subscribeBtn");
      const providerButtons = modal?.querySelectorAll("[data-provider-btn]") || [];

      if (!modal || !closeBtn || !backdrop || !form || !subscribeBtn) return;

      const STORAGE_KEY = "tlp_blog_modal_seen_v1";
      const SCROLL_FRACTION = 0.5; // show after 50% of page height scrolled

      const openModal = () => {
        modal.style.display = "flex";
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        if (!IS_DEV) {
          sessionStorage.setItem(STORAGE_KEY, "shown");
        }
        setTimeout(() => emailInput?.focus(), 50);
      };

      const closeModal = () => {
        modal.style.display = "none";
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      const providerAction = (provider) => {
        const handlerName = `onBlogSubscribeWith${provider.charAt(0).toUpperCase()}${provider.slice(1)}`;
        const handler = window[handlerName];
        const detail = { provider, email: emailInput?.value || "" };

        // Give priority to a named global hook if present
        if (typeof handler === "function") {
          handler(detail);
        }

        // Broadcast an event so other scripts can listen without globals
        window.dispatchEvent(new CustomEvent("blog:subscribe", { detail }));

        if (typeof handler !== "function") {
          console.info(
            `[BlogSignupModal] No handler named ${handlerName} found. Listen for 'blog:subscribe' to intercept provider clicks.`,
          );
        }
      };

      window.openBlogSignupModal = openModal;

      if (IS_DEV) {
        // In dev, always surface the modal immediately for design/QA
        sessionStorage.removeItem(STORAGE_KEY);
        openModal();
      } else {
        // Open once per session when user scrolls past 75% of the page
        const onScroll = () => {
          if (sessionStorage.getItem(STORAGE_KEY)) {
            window.removeEventListener("scroll", onScroll);
            return;
          }
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - window.innerHeight;
          if (scrollable <= 0) return;
          const progress = window.scrollY / scrollable;
          if (progress >= SCROLL_FRACTION) {
            openModal();
            window.removeEventListener("scroll", onScroll);
          }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // Attach manual triggers
      document.querySelectorAll("[data-blog-modal-trigger]").forEach((node) => {
        node.addEventListener("click", (event) => {
          event.preventDefault();
          openModal();
        });
      });

      // Provider buttons (Google/Apple/Facebook)
      providerButtons.forEach((btn) => {
        btn.addEventListener("click", (event) => {
          event.preventDefault();
          const provider = btn.getAttribute("data-provider-btn");
          if (!provider) return;
          providerAction(provider);
        });
      });

      // Close button
      closeBtn.addEventListener("click", closeModal);

      // Backdrop click
      backdrop.addEventListener("click", closeModal);

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal.style.display === "flex") {
          closeModal();
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput?.value || "";
        const originalText = subscribeBtn.textContent;

        // Show loading state
        subscribeBtn.disabled = true;
        subscribeBtn.textContent = "Redirecting to Substack...";
        subscribeBtn.classList.add("opacity-75");

        // Small delay for smooth UX
        setTimeout(() => {
          const subStackUrl = `https://schulteretyang.substack.com?email=${encodeURIComponent(email)}`;
          window.open(subStackUrl, "_blank");

          // Reset button state
          subscribeBtn.disabled = false;
          subscribeBtn.textContent = originalText;
          subscribeBtn.classList.remove("opacity-75");

          // Close modal and reset form
          closeModal();
          form.reset();
        }, 800);
      });
    })();
</script>

<style>
  @keyframes backdropFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes modalSlideUp {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.90);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  #blogSignupBackdrop { animation: backdropFadeIn 0.35s ease-out forwards; }
  #blogSignupModal > div:last-child { animation: modalSlideUp 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards; }
  .animate-fadeIn { animation: modalSlideUp 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
  #blogSignupModal[style*="display: flex"] { display: flex !important; }
  /* Hide default Turnstile status inside modal; we render our own helper */
  #blogSignupModal .tlp-turnstile-status { display: none; }
</style>
