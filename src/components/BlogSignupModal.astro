---
const blogUrl = "https://schulteretyang.substack.com";
---

<div id="blogSignupModal" class="fixed inset-0 z-50 items-center justify-center p-4" style="display: none;">
  <!-- Backdrop -->
  <div
    id="blogSignupBackdrop"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm"
  ></div>

  <!-- Modal -->
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full z-10 overflow-hidden animate-fadeIn">
    <!-- Close button -->
    <button
      id="blogSignupClose"
      type="button"
      aria-label="Close modal"
      class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition z-20"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Content -->
    <div class="p-8">
      <!-- Header -->
      <div class="mb-6">
        <h2 class="heading-2 text-center mb-2">
          Stay Updated
        </h2>
        <p class="text-gray-600 text-sm">
          Join our community for thoughtful insights, updates, and exclusive content delivered to your inbox.
        </p>
      </div>

      <!-- Form -->
      <form id="blogSignupForm" class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
            Email Address
          </label>
          <input
            id="email"
            type="email"
            placeholder="your@email.com"
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-transparent transition"
          />
        </div>

        <button
          id="subscribeBtn"
          type="submit"
          class="w-full bg-brand-red hover:bg-red-700 text-white font-semibold py-3 rounded-full transition duration-200 transform hover:scale-105"
        >
          Subscribe on Substack
        </button>
      </form>

      <!-- Footer message -->
      <p class="text-xs text-gray-500 text-center mt-4">
        You'll be redirected to confirm your subscription. We respect your privacy.
      </p>

      <!-- Divider -->
      <div class="flex items-center my-6">
        <div class="flex-1 border-t border-gray-300"></div>
        <span class="px-3 text-sm text-gray-500">or</span>
        <div class="flex-1 border-t border-gray-300"></div>
      </div>

      <!-- Direct link -->
      <a
        href={blogUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-center px-4 py-3 rounded-full border border-brand-red text-brand-red hover:bg-red-50 font-semibold transition text-sm"
      >
        Visit Our Blog Directly
      </a>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("blogSignupModal");
    const backdrop = document.getElementById("blogSignupBackdrop");
    const closeBtn = document.getElementById("blogSignupClose");
    const form = document.getElementById("blogSignupForm");

    // Open modal function
    window.openBlogSignupModal = () => {
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
    };

    // Close modal function
    const closeModal = () => {
      modal.style.display = "none";
      document.body.style.overflow = "";
    };

    // Close button
    closeBtn.addEventListener("click", closeModal);

    // Backdrop click
    backdrop.addEventListener("click", closeModal);

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.style.display === "flex") {
        closeModal();
      }
    });

    // Handle form submission
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = document.getElementById("email").value;
      const submitBtn = document.getElementById("subscribeBtn");
      const originalText = submitBtn.textContent;

      // Show loading state
      submitBtn.disabled = true;
      submitBtn.textContent = "Redirecting to Substack...";
      submitBtn.classList.add("opacity-75");

      // Small delay for smooth UX
      setTimeout(() => {
        // Redirect to Substack with email prefilled
        const subStackUrl = `https://schulteretyang.substack.com?email=${encodeURIComponent(email)}`;
        window.open(subStackUrl, "_blank");

        // Reset button state
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        submitBtn.classList.remove("opacity-75");

        // Close modal and reset form
        closeModal();
        form.reset();
      }, 800);
    });
  });
</script>

<style>
  @keyframes backdropFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes modalSlideUp {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.90);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  #blogSignupBackdrop {
    animation: backdropFadeIn 0.6s ease-out forwards;
  }

  #blogSignupModal > div:last-child {
    animation: modalSlideUp 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: 0.1s;
  }

  .animate-fadeIn {
    animation: modalSlideUp 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Show modal as flex when not hidden */
  #blogSignupModal[style*="display: flex"] {
    display: flex !important;
  }
</style>
