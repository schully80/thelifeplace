---
type Props = {
  speakers?: string[];
  activeSpeaker?: string;
};
const { speakers = [], activeSpeaker = "" } = Astro.props as Props;
---

<div class="flex flex-wrap gap-2 mt-4">

  <!-- ALL SPEAKERS -->
  <a
    href="/messages"
    class={`px-4 py-2 rounded-full text-sm border transition ${
      !activeSpeaker
        ? "bg-brand-red text-white border-brand-red"
        : "bg-white text-gray-600 hover:bg-gray-100 border-gray-300"
    }`}
  >
    All Speakers
  </a>

  <!-- EACH SPEAKER -->
  {speakers.map((sp: string) => (
    <a
      href={`/messages?speaker=${encodeURIComponent(sp)}`}
      class={`px-4 py-2 rounded-full text-sm border transition ${
        activeSpeaker === sp
          ? "bg-brand-red text-white border-brand-red"
          : "bg-white text-gray-600 hover:bg-gray-100 border-gray-300"
      }`}
    >
      {sp}
    </a>
  ))}
</div>
