---
const url = new URL(Astro.request.url);
const q = url.searchParams.get("q") || "";
---

<form
  method="GET"
  class="w-full"
>
  <input
    type="text"
    name="q"
    placeholder="Search messages..."
    value={q}
    class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-brand-red focus:ring-brand-red transition"
  />
</form>
