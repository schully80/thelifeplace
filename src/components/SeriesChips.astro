---
const { seriesList = [], activeSeries = "" } = Astro.props;
---

<div class="flex flex-wrap gap-2 mt-6">

  <!-- ALL SERIES -->
  <a
    href="/messages"
    class={`px-4 py-2 rounded-full text-sm border ${
      activeSeries === "" 
        ? "bg-brand-red text-white"
        : "bg-white text-gray-700 hover:border-brand-red hover:text-brand-red"
    }`}
  >
    All Series
  </a>

  <!-- EACH SERIES -->
  {seriesList.map((s) => (
    <a
      href={`/messages/?series=${encodeURIComponent(s)}`}
      class={`px-4 py-2 rounded-full text-sm border ${
        activeSeries === s
          ? "bg-brand-red text-white"
          : "bg-white text-gray-700 hover:border-brand-red hover:text-brand-red"
      }`}
    >
      {s}
    </a>
  ))}
</div>
