---
const {
  whatsapp = "27XXXXXXXXX",
  email = "hello@thelifeplace.org",
  mapsUrl = "https://www.google.com/maps/place/The+Life+Place/"
} = Astro.props;

const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent(
  "Hi The Life Place, I'd love to get in touch."
)}`;

const mailUrl = `mailto:${email}`;
---

<style>
  .dock-btn {
    @apply w-12 h-12 rounded-full flex items-center justify-center
           bg-transparent border border-brand-red/40
           shadow-sm hover:shadow-md
           transition transform hover:scale-105;
  }

.dock-tooltip {
  @apply absolute right-full top-1/2 -translate-y-1/2 mr-3 
         px-4 py-1 rounded-full   /* pill shape */
         text-sm font-medium bg-black text-white
         shadow-md whitespace-nowrap opacity-0 translate-x-2
         pointer-events-none transition-all duration-300 z-50;
}

.dock-item:hover .dock-tooltip {
  @apply opacity-100 translate-x-0;
}
</style>

<div class="fixed bottom-6 right-5 z-50 flex flex-col gap-4">
<!-- WhatsApp -->
<div class="dock-item relative flex items-center z-10">
  <div class="dock-tooltip">WhatsApp Us</div>

  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-12 h-12 rounded-full bg-black flex items-center justify-center
           hover:bg-brand-red transition"
  >
    <img 
      src="/whatsapp.svg" 
      alt="WhatsApp" 
      class="h-6 w-6 invert"
    />
  </a>
</div>


  <!-- Email -->
  <div class="dock-item relative flex items-center z-10">
    <div class="dock-tooltip">Email us</div>
    <a href={mailUrl}
       class="w-12 h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition">
      <svg xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 24 24"
           class="h-6 w-6 text-white" fill="currentColor">
        <path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
      </svg>
    </a>
  </div>

  <!-- Location -->
  <div class="dock-item relative flex items-center z-10">
    <div class="dock-tooltip">Find us</div>
    <a href={mapsUrl}
       target="_blank"
       rel="noopener noreferrer"
       class="w-12 h-12 rounded-full bg-black flex items-center justify-center hover:bg-brand-red transition">
      <svg xmlns="http://www.w3.org/2000/svg"
           class="h-7 w-7 text-white"
           viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5
                 c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/>
      </svg>
    </a>
  </div>

</div>