---
const {
  whatsapp = "27XXXXXXXXX",
  email = "hello@thelifeplace.org",
  mapsUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3587.123456789!2d28.0123456!3d-26.0123456!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1e9576543210abcd%3A0xabcdef123456789!2sThe%20Life%20Place!5e0!3m2!1sen!2sza!4v1724234567890!5m2!1sen!2sza"
} = Astro.props;

const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent(
  "Hi The Life Place, I'd love to get in touch."
)}`;

const mailUrl = `mailto:${email}`;
---

<style>
  .dock-btn {
    @apply w-12 h-12 rounded-full flex items-center justify-center 
           bg-white border border-brand-red/40
           shadow-md hover:shadow-lg 
           transition transform hover:scale-105;
  }

  .dock-tooltip {
    @apply absolute right-full mr-3 px-3 py-1 rounded-md 
           text-sm font-medium bg-black text-white
           shadow-md whitespace-nowrap opacity-0 translate-x-2
           pointer-events-none transition-all duration-200;
  }

  .dock-item:hover .dock-tooltip {
    @apply opacity-100 translate-x-0;
  }
</style>

<div class="fixed bottom-5 right-4 md:bottom-6 md:right-6 z-50 flex flex-col gap-3">

  <!-- WhatsApp -->
  <div class="dock-item relative hidden md:block">
    <div class="dock-tooltip">Chat with us</div>
    <a href={waUrl} target="_blank" rel="noopener noreferrer" class="dock-btn bg-[#25D366] border-brand-red/40">
      <svg xmlns="http://www.w3.org/2000/svg"
           class="h-6 w-6 text-white"
           fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.04 2C6.58 2 2.21 6.37 ..."></path>
      </svg>
    </a>
  </div>

  <!-- Email -->
  <div class="dock-item relative hidden md:block">
    <div class="dock-tooltip">Email us</div>
    <a href={mailUrl} class="dock-btn">
      <svg xmlns="http://www.w3.org/2000/svg"
           class="h-6 w-6 text-brand-red"
           fill="currentColor" viewBox="0 0 24 24">
        <path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
      </svg>
    </a>
  </div>

  <!-- Maps -->
  <div class="dock-item relative hidden md:block">
    <div class="dock-tooltip">Find us</div>
    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="dock-btn">
      <svg xmlns="http://www.w3.org/2000/svg"
           class="h-6 w-6 text-blue-600"
           fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C8.1 2 5 5.1..."></path>
      </svg>
    </a>
  </div>

</div>
