---
const {
  whatsapp = "27XXXXXXXXX",
  email = "hello@thelifeplace.org",
  mapsUrl = "https://www.google.com/maps/place/The+Life+Place/"
} = Astro.props;

const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent(
  "Hi The Life Place, I'd love to get in touch."
)}`;

const mailUrl = `mailto:${email}`;
---

<style>
  .dock-btn {
    @apply w-12 h-12 rounded-full flex items-center justify-center
           bg-transparent border border-brand-red/40
           shadow-sm hover:shadow-md
           transition transform hover:scale-105;
  }

  .dock-tooltip {
    @apply absolute right-full mr-3 px-3 py-1 rounded-md 
           text-sm font-medium bg-black text-white
           shadow-md whitespace-nowrap opacity-0 translate-x-2
           pointer-events-none transition-all duration-200;
  }

  .dock-item:hover .dock-tooltip {
    @apply opacity-100 translate-x-0;
  }
</style>

<div class="fixed bottom-6 right-5 z-50 flex flex-col gap-4">

  <!-- WhatsApp -->
  <div class="dock-item relative">
    <div class="dock-tooltip">Chat with us</div>

    <a href={waUrl}
       target="_blank"
       rel="noopener noreferrer"
       class="dock-btn">

      <!-- CLEAN WhatsApp icon (no white circle) -->
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"
     class="h-7 w-7 text-[#25D366]">
  <path fill="currentColor" d="M380.9 97.1C339-0.1 224.8-32 135.2 19.5 
    45.6 71-7.3 168.6 1.7 272c6.5 78.3 49.1 147.2 114.2 187.6v52.4l73.3-19.8
    c95.9 22.9 198.1-14.4 254.1-92.3 55.9-77.9 57.5-182.4 3.6-260.8zM232 
    407.4c-30.1 0-59.7-8-85.5-23.1l-6.1-3.6-50.6 13.7 13.5-49.4-3.9-6.4
    c-16.5-27.1-25.2-58.2-25.2-90.2 0-94.1 76.9-170.5 171.3-170.5 
    45.8 0 88.8 17.7 121.1 49.9 32.3 32.2 50.1 75.2 50.1 120.8 
    0 94.2-76.9 170.5-171.3 170.5z"/>
</svg>
    </a>
  </div>

  <!-- Email -->
  <div class="dock-item relative">
    <div class="dock-tooltip">Email us</div>

    <a href={mailUrl} class="dock-btn">
      <svg xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 24 24"
           class="h-6 w-6 text-brand-red">
        <path fill="currentColor"
          d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
      </svg>
    </a>
  </div>

  <!-- Location -->
  <div class="dock-item relative">
    <div class="dock-tooltip">Find us</div>

    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="dock-btn">
      <!-- CLEAN MAP PIN ICON ONLY -->
     <svg xmlns="http://www.w3.org/2000/svg"
     class="h-7 w-7 text-blue-600"
     viewBox="0 0 24 24">
  <path fill="currentColor"
    d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5
       c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/>
</svg>
    </a>
  </div>

</div>
