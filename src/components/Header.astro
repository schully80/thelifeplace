---
const {
  title = "The Life Place",
  logoSrc = "/logo.png",
  class: className,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href) =>
  href === "/"
    ? path === "/"
    : path === href || (href !== "/" && path.startsWith(href) && path.charAt(href.length) === "/");
---

<header class:list={[
  "relative z-50 border-b bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70",
  className,
]}>

  <!-- MOBILE: 0–md (flex layout with hamburger) -->
  <div class="md:hidden h-20 grid grid-cols-[1fr,auto] items-center px-4 gap-2">
    <!-- Logo + Title -->
    <div class="flex items-center gap-3 min-w-0">
      <img src={logoSrc} alt="Logo" class="h-14 w-14 flex-shrink-0" />
      <a
        href="/"
        class="flex flex-col items-center min-w-0"
        aria-label={`${title} — Home`}
      >
        <span class="font-bold text-brand-red text-[20px] sm:text-[24px] leading-tight text-center">
          {title}
        </span>
        <span class="text-[12px] sm:text-[13px] text-brand-warmgray-600 tracking-wide text-center">
          Come. See. <span class="text-[#B3282D]">Jesus</span>
        </span>
      </a>
    </div>

    <!-- Hamburger Button -->
    <button
      id="mobileMenuButton"
      type="button"
      aria-label="Open menu"
      aria-controls="mobileNavDrawer"
      aria-expanded="false"
      class="p-2 rounded-md hover:bg-gray-100 transition"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6 text-gray-900" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- TABLET + LAPTOP: md–xl (horizontal nav with optional drawer in portrait) -->
  <div class="hidden md:flex xl:hidden h-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 justify-between items-center gap-6">
    <!-- Logo + Title -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-3 min-w-0"
      aria-label={`${title} — Home`}
    >
      <img src={logoSrc} alt="Logo" class="h-12 w-auto" />
      <div class="flex flex-col min-w-0">
        <span class="font-bold text-brand-red text-xl md:text-2xl leading-tight truncate">{title}</span>
        <span class="text-sm text-gray-600 tracking-wide">Come. See. <span class="text-[#B3282D]">Jesus</span></span>
      </div>
    </a>

    <!-- Desktop-style nav (landscape) -->
    <nav class="nav-links hidden landscape:flex items-center gap-6 font-montserrat text-base">
      <!-- What to Expect -->
        <a
          href="/what-to-expect/"
          class={`px-1 py-2 ${
            isActive("/what-to-expect/")
              ? "text-brand-red font-semibold"
              : "text-brand-darkgray hover:text-brand-red"
          }`}
        >What to Expect</a>

      <!-- About Us Dropdown -->
      <div data-dropdown class="relative">
          <button
            data-trigger
            type="button"
            aria-expanded="false"
            class={`relative px-1 py-2 ${
              isActive("/about-us/")
                ? "text-brand-red font-semibold"
                : "text-brand-darkgray hover:text-brand-red"
            }`}
          >About Us</button>

        <div data-menu class="absolute left-0 top-full mt-1 w-56 rounded-md border bg-white shadow-lg hidden">
          <a href="/about-us/" class="block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red">What We Do</a>
          <a href="/about-us/our-values" class="block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red">Our Values</a>
          <a href="/about-us/leadership" class="block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red">Schulter & Genevieve</a>
        </div>
      </div>

      <!-- Live -->
        <a
          href="/live/"
          class={`px-2 py-2 flex items-center gap-1 ${
            isActive("/live/") ? "text-brand-red font-semibold" : "text-brand-darkgray hover:text-brand-red"
          }`}
        >
        <span data-live-mid-text>Live</span>
        <span data-live-mid-indicator class="hidden h-2 w-2 rounded-full bg-red-600 animate-ping absolute -right-3 top-1/2 -translate-y-1/2"></span>
      </a>

      <!-- Ministries Dropdown -->
      <div data-dropdown class="relative">
          <button
            data-trigger
            type="button"
            aria-expanded="false"
            class={`px-1 py-2 whitespace-nowrap ${
              isActive("/ministries/")
                ? "text-brand-red font-semibold"
                : "text-brand-darkgray hover:text-brand-red"
            }`}
          >Ministries</button>

        <div data-menu class="absolute left-0 top-full mt-1 w-64 rounded-md border bg-white shadow-lg hidden max-h-[70vh] overflow-y-auto">
          <a href="/ministries/new-members/" class="block px-3 py-2 text-sm hover:text-brand-red">New @The Life Place</a>
          <div class="px-3 pt-2 pb-1 text-[11px] uppercase text-gray-400">Family</div>
          <a href="/ministries/bring-them-to-jesus/" class="block px-3 py-2 text-sm hover:text-brand-red">Bring Them To Jesus</a>
          <a href="/ministries/kids/" class="block px-3 py-2 text-sm hover:text-brand-red">Kids @The Life Place</a>
          <a href="/ministries/gen/" class="block px-3 py-2 text-sm hover:text-brand-red">ThisGen</a>
          <div class="px-3 pt-2 pb-1 text-[11px] uppercase text-gray-400">Formation</div>
          <a href="/ministries/premarital-counseling/" class="block px-3 py-2 text-sm hover:text-brand-red">Premarital Counseling</a>
          <a href="/ministries/institute/" class="block px-3 py-2 text-sm hover:text-brand-red">The Life Place Institute</a>
          <div class="px-3 pt-2 pb-1 text-[11px] uppercase text-gray-400">Outreach</div>
          <a href="/ministries/relief-center/" class="block px-3 py-2 text-sm hover:text-brand-red">Relief Center</a>
        </div>
      </div>

      <!-- Generosity -->
      <a
        href="/give/"
        class="px-4 py-2 rounded-full bg-brand-red text-white font-semibold shadow-md hover:bg-red-700 transition"
      >Generosity</a>

      <!-- Plan A Visit -->
        <a
          href="/visit/"
          class={`px-1 py-2 ${
            isActive("/visit/")
              ? "text-brand-red font-semibold"
              : "text-brand-darkgray hover:text-brand-red"
          }`}
        >Plan A Visit</a>

      <!-- Blog (internal listing) -->
        <a
          href="/blog/"
          class={`px-1 py-2 ${
            isActive("/blog/") ? "text-brand-red font-semibold" : "text-brand-darkgray hover:text-brand-red"
          }`}
        >Our Blog</a>
    </nav>

    <!-- Hamburger (portrait) -->
    <button
      id="tabletMenuButton"
      type="button"
      aria-label="Open menu"
      aria-controls="tabletNavDrawer"
      aria-expanded="false"
      class="hamburger hidden portrait:flex items-center justify-center h-10 w-10 rounded-md border border-brand-red bg-white"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- DESKTOP: xl+ (full horizontal nav) -->
  <div class="hidden xl:flex max-w-8xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8 h-24 justify-between items-center gap-6 2xl:gap-4">
    <!-- Logo + Title -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-3 min-w-0 cine-zoom-apple-hover"
      aria-label={`${title} — Home`}
    >
      <img src={logoSrc} alt={`${title} Logo`} class="h-10 md:h-14 w-auto" />
      <div class="flex flex-col min-w-0 items-center text-center">
        <span class="font-bold text-brand-red text-lg sm:text-xl md:text-2xl leading-tight truncate">
          {title}
        </span>
        <span class="text-sm text-gray-600 tracking-wide">
          Come. See. <span class="text-[#B3282D]">Jesus</span>
        </span>
      </div>
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-8 font-montserrat text-base xl:text-lg">
      <!-- What to Expect -->
      <a
        href="/what-to-expect/"
        class={`relative px-2 py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
          isActive("/what-to-expect") ? "after:w-full text-brand-red font-semibold" : "text-brand-darkgray hover:text-brand-red after:w-0"
        }`}
      >What to Expect</a>

      <!-- About Us -->
      <div id="dd-about" data-dropdown class="relative focus-within:z-50">
        <button
          data-trigger
          type="button"
          class={`relative px-2 py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
            isActive("/about-us/") ? "text-brand-red after:w-full font-semibold" : "text-brand-warmgray-700 hover:text-brand-red"
          }`}
        >About Us</button>

        <div
          data-menu
          class="absolute left-0 top-full -mt-px w-56 rounded-md border bg-white shadow-lg z-50 hidden max-h-80 overflow-y-auto overscroll-contain pt-1"
        >
          <a href="/about-us/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">What We Do</span></a>
          <a href="/about-us/our-values" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Our Values</span></a>
          <a href="/about-us/leadership" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Schulter and Genevieve</span></a>
        </div>
      </div>

      <!-- Live -->
      <a
        href="/live/"
        class={`relative px-2 py-2 flex items-center gap-1 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
          isActive("/live/") ? "after:w-full text-brand-red font-semibold" : "text-brand-darkgray hover:text-brand-red after:w-0"
        }`}
      >
        <span data-live-text>Live</span>
        <span data-live-indicator class="hidden h-2 w-2 rounded-full bg-red-600 absolute -right-3 top-1/2 -translate-y-1/2"></span>
      </a>

      <!-- Ministries -->
      <div id="dd-ministries" data-dropdown class="relative">
        <button
          data-trigger
          type="button"
          class={`relative px-2 py-2 whitespace-nowrap after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
            isActive("/ministries/") ? "text-brand-red after:w-full font-semibold" : "text-brand-warmgray hover:text-brand-red"
          }`}
        >Ministries</button>

        <div
          data-menu
          class="absolute left-0 top-full -mt-px w-64 xl:w-72 2xl:w-80 rounded-md border bg-white shadow-lg z-50 hidden max-h-[75vh] xl:max-h-[85vh] overflow-y-auto overscroll-contain pt-1"
        >
          <a href="/ministries/new-members/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">New @The Life Place</span></a>
          <div class="px-3 pt-2 pb-1 text-[11px] uppercase tracking-wide text-gray-400">Family</div>
          <a href="/ministries/bring-them-to-jesus/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Bring Them To Jesus</span></a>
          <a href="/ministries/kids/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Kids @The Life Place</span></a>
          <a href="/ministries/gen/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">ThisGen</span></a>
          <a href="/ministries/premarital-counseling/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Premarital Counseling</span></a>
          <div class="px-3 pt-2 pb-1 text-[11px] uppercase tracking-wide text-gray-400">Formation</div>
          <a href="/ministries/institute/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">The Life Place Institute</span></a>
          <div class="px-3 pt-2 pb-1 text-[11px] uppercase tracking-wide text-gray-400">Outreach</div>
          <a href="/ministries/relief-center/" class="group block px-3 py-2 text-sm text-brand-darkgray hover:text-brand-red"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Relief Center</span></a>
        </div>
      </div>

      <!-- Generosity -->
      <a
        href="/give/"
        class="relative z-10 px-4 py-2 whitespace-nowrap rounded-full bg-brand-red text-white font-semibold shadow-md transition"
        aria-current={isActive("/give/") ? "page" : undefined}
      >Generosity</a>

      <!-- Plan A Visit -->
      <a
        href="/visit/"
        class={`relative px-2 py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
          isActive("/visit/") ? "text-brand-red after:w-full font-semibold" : "text-brand-darkgray hover:text-brand-red"
        }`}
      >Plan A Visit</a>

      <!-- Blog (internal listing) -->
      <a
        href="/blog/"
        class={`relative px-2 py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
          isActive("/blog/") ? "text-brand-red after:w-full font-semibold" : "text-brand-darkgray hover:text-brand-red"
        }`}
      >Our Blog</a>
    </nav>
  </div>

  <!-- OVERLAYS & DRAWERS (Mobile & Tablet Portrait) -->
  <div
    id="mobileNavOverlay"
    class="fixed inset-0 bg-white opacity-0 pointer-events-none transition-opacity z-[9998] md:hidden"
    data-overlay
  ></div>

  <aside
    id="mobileNavDrawer"
    class="fixed inset-y-0 right-0 w-[86%] max-w-sm bg-white shadow-xl transition-transform will-change-transform z-[9999] focus:outline-none md:hidden translate-x-full"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
    tabindex="-1"
    data-drawer
  >
    <div class="h-16 px-4 flex items-center justify-end border-b">
      <button id="mobileMenuClose" type="button" aria-label="Close menu">
        <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
          <path d="M6 6l12 12M18 6l-12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="px-4 py-3 overflow-y-auto max-h-[calc(100dvh-4rem)] space-y-2" aria-label="Mobile">
      <!-- What to Expect -->
      <a href="/what-to-expect/" class={`block px-4 py-3.5 rounded-full text-base ${isActive("/what-to-expect/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>
        What to Expect
      </a>

      <!-- About Us Accordion -->
      <section class="mt-2" data-accordion>
        <button type="button" class="w-full flex items-center justify-between px-4 py-3.5 rounded-full text-left text-base hover:bg-gray-50" data-accordion-trigger aria-expanded="false" aria-controls="acc-about">
          <span>About Us</span>
          <svg class="h-6 w-6 transition-transform" viewBox="0 0 24 24">
            <path d="M5 10l7 7 7-7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
          </svg>
        </button>
        <div id="acc-about" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out" data-accordion-panel>
          <div class="overflow-hidden">
            <ul class="py-1">
              <li><a href="/about-us/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/about-us/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>What We Do</a></li>
              <li><a href="/about-us/our-values" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/about-us/our-values") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>Our Values</a></li>
              <li><a href="/about-us/leadership" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/about-us/leadership") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>Schulter and Genevieve</a></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Live -->
      <a href="/live/" class={`block px-4 py-3.5 rounded-full text-base ${isActive("/live/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>
        <span class="flex items-center gap-2">
          <span data-live-mobile-text>Live</span>
          <span data-live-mobile-indicator class="hidden h-2 w-2 rounded-full bg-red-600"></span>
        </span>
      </a>

      <!-- Ministries Accordion -->
      <section class="mt-2" data-accordion>
        <button type="button" class="w-full flex items-center justify-between px-4 py-3.5 rounded-full text-left text-base hover:bg-gray-50" data-accordion-trigger aria-expanded="false" aria-controls="acc-ministries">
          <span>Ministries</span>
          <svg class="h-6 w-6 transition-transform" viewBox="0 0 24 24">
            <path d="M5 10l7 7 7-7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
          </svg>
        </button>
        <div id="acc-ministries" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out" data-accordion-panel>
          <div class="overflow-hidden">
            <ul class="py-1">
              <li><a href="/ministries/new-members/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/ministries/new-members/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>New @The Life Place</a></li>
              <li class="px-5 pt-2 pb-1 text-[11px] uppercase tracking-wide text-gray-400">Family</li>
              <li><a href="/ministries/bring-them-to-jesus/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/ministries/bring-them-to-jesus/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>Bring Them To Jesus</a></li>
              <li><a href="/ministries/kids/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/ministries/kids/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>Kids @The Life Place</a></li>
              <li><a href="/ministries/gen/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/ministries/gen/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>ThisGen</a></li>
              <li><a href="/ministries/premarital-counseling/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/ministries/premarital-counseling/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>Premarital Counseling</a></li>
              <li class="px-5 pt-2 pb-1 text-[11px] uppercase tracking-wide text-gray-400">Formation</li>
              <li><a href="/ministries/institute/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/ministries/institute/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>The Life Place Institute</a></li>
              <li class="px-5 pt-2 pb-1 text-[11px] uppercase tracking-wide text-gray-400">Outreach</li>
              <li><a href="/ministries/relief-center/" class={`block px-5 py-3 text-[15px] rounded-full ${isActive("/ministries/relief-center/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>Relief Center</a></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Generosity -->
      <a href="/give/" class={`mt-3 inline-flex items-center justify-center px-4 py-2 rounded-full bg-brand-red text-white font-semibold shadow-md hover:bg-red-700 hover:shadow-lg transition`}>
        Generosity
      </a>

      <!-- Plan A Visit -->
      <a href="/visit/" class={`mt-4 block px-4 py-4 rounded-full text-base font-medium ${isActive("/visit/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>
        Plan A Visit
      </a>

      <!-- Blog (internal listing) -->
      <a href="/blog/" class={`w-full text-left block px-4 py-3 rounded-full text-base ${isActive("/blog/") ? "text-brand-red font-semibold bg-red-50" : "text-brand-darkgray hover:bg-gray-50"}`}>
        Our Blog
      </a>
    </nav>
  </aside>

  <!-- Tablet Portrait Overlay & Drawer -->
  <div id="tabletNavOverlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-[9998]"></div>

  <aside id="tabletNavDrawer" class="fixed inset-y-0 right-0 w-[86%] sm:w-[80%] max-w-sm bg-white shadow-xl translate-x-full transition-transform will-change-transform z-[9999] hidden portrait:block" role="dialog" aria-modal="true" tabindex="-1">
    <div class="h-20 px-4 flex items-center justify-end border-b">
      <button id="tabletMenuClose" type="button" aria-label="Close menu" class="h-10 w-10 inline-flex items-center justify-center rounded-md border border-brand-red bg-white">
        <svg viewBox="0 0 24 24" class="h-6 w-6">
