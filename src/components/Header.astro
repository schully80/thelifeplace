---
const {
  title = "The Life Place",
  logoSrc = "/logo.png",
  class: className,
  navButtonVariant = "glass", // options: "glass" (default) or "solid"
} = Astro.props;

// Allow quick dev preview via ?navBtn=solid|glass
let resolvedNavVariant = navButtonVariant;
const queryVariant = Astro.url?.searchParams?.get("navBtn");
if (queryVariant === "solid" || queryVariant === "glass") {
  resolvedNavVariant = queryVariant;
}

const path = Astro.url.pathname;
const isActive = (href) =>
  href === "/"
    ? path === "/"
    : path === href || (href !== "/" && path.startsWith(href) && path.charAt(href.length) === "/");
---

  <header class:list={[
  "relative z-50 border-b bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70",
  className,
]}>

  <!-- MOBILE: 0–md (flex layout with hamburger) — primary mobile UI lives here -->
  <div class="md:hidden h-20 grid grid-cols-[1fr,auto] items-center px-4 gap-2">
    <!-- Logo + Title -->
    <div class="flex items-center gap-3 min-w-0">
      <img src={logoSrc} alt="Logo" class="h-14 w-14 flex-shrink-0" />
      <a
        href="/"
        class="flex flex-col items-center min-w-0"
        aria-label={`${title} — Home`}
      >
        <span class="font-bold text-brand-red text-[20px] sm:text-[24px] leading-tight text-center">
          {title}
        </span>
        <span class="text-[12px] sm:text-[13px] text-brand-warmgray-600 tracking-wide text-center">
          Come. See. <span class="text-[#B3282D]">Jesus</span>
        </span>
      </a>
    </div>

    <!-- Hamburger Button -->
    <button
      id="mobileMenuButton"
      type="button"
      aria-label="Open menu"
      aria-controls="mobileNavDrawer"
      aria-expanded="false"
      class={resolvedNavVariant === "solid"
        ? "relative inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-red text-white shadow-lg ring-0 transition hover:-translate-y-0.5 hover:shadow-[0_14px_34px_rgba(179,40,45,0.35)] active:translate-y-0"
        : "relative inline-flex h-11 w-11 items-center justify-center rounded-full bg-transparent text-gray-900 transition hover:-translate-y-0.5 active:translate-y-0"
      }
    >
      <svg viewBox="0 0 24 24" class={`h-7 w-7 ${resolvedNavVariant === "solid" ? "text-white" : "text-gray-800"}`} aria-hidden="true">
        <path d="M2 8.5h16M3 15.5h30" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- TABLET + LAPTOP: md–xl (horizontal nav with optional drawer in portrait) -->
  <div class="hidden md:flex xl:hidden h-20 sm:h-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 justify-between items-center gap-6">
    <!-- Logo + Title -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-3 min-w-0"
      aria-label={`${title} — Home`}
    >
      <img src={logoSrc} alt="Logo" class="h-14 w-auto" />
      <div class="flex flex-col min-w-0">
        <span class="font-bold text-brand-red text-xl md:text-2xl leading-tight truncate">{title}</span>
        <span class="text-center text-sm text-gray-600 tracking-wide">Come. See. <span class="text-[#B3282D]">Jesus</span></span>
      </div>
    </a>

    <!-- Desktop-style nav (landscape) -->
    <nav class="nav-links hidden landscape:flex items-center gap-6 font-montserrat text-base">

      <!-- About Us Dropdown -->
      <div data-dropdown class="relative">
          <button
            data-trigger
            type="button"
            aria-expanded="false"
            class={`relative px-2 py-2 rounded-full ${
              isActive("/about-us/")
                ? "text-brand-red font-semibold bg-red-50"
                : "text-gray-700 hover:bg-gray-50"
            }`}
          >About Us</button>

        <div data-menu class="absolute left-0 top-full mt-1 w-56 md:w-64 rounded-md border bg-white shadow-lg hidden">
          <a href="/about-us/" class="block px-3 py-2 text-sm text-gray-700 hover:text-gray-800">What We Do</a>
          <a href="/what-we-believe/" class="block px-3 py-2 text-sm text-gray-700 hover:text-gray-800">What We Believe</a>
          <a href="/about-us/leadership" class="block px-3 py-2 text-sm text-gray-700 hover:text-gray-800">Schulter & Genevieve</a>
        </div>
      </div>

      <!-- Live -->
        <a
          href="/live/"
          class={`px-2 py-2 flex items-center gap-1 rounded-full ${
            isActive("/live/") ? "text-brand-red font-semibold bg-red-50" : "text-gray-700 hover:bg-gray-50"
          }`}
        >
        <span data-live-mid-text>Live</span>
        <span data-live-mid-indicator class="hidden h-2 w-2 rounded-full bg-red-600"></span>
      </a>

      <!-- Ministries nav removed -->

      <!-- Generosity -->
      <a
        href="/give/"
        class="px-4 py-2 rounded-full bg-brand-red text-white font-semibold shadow-md hover:bg-red-700 transition"
      >Generosity</a>

      <!-- Plan A Visit -->
        <a
          href="/visit/"
          class={`px-2 py-2 rounded-full ${
            isActive("/visit/")
              ? "text-brand-red font-semibold bg-red-50"
              : "text-gray-700 hover:bg-gray-50"
          }`}
        >Plan A Visit</a>

      <!-- Blog (internal listing) -->
        <a
          href="/blog/"
          class={`px-2 py-2 rounded-full ${
            isActive("/blog/") ? "text-brand-red font-semibold bg-red-50" : "text-gray-700 hover:bg-gray-50"
          }`}
        >Our Blog</a>
    </nav>

    <!-- Hamburger (portrait) -->
    <button
      id="tabletMenuButton"
      type="button"
      aria-label="Open menu"
      aria-controls="tabletNavDrawer"
      aria-expanded="false"
      class={resolvedNavVariant === "solid"
        ? "hamburger hidden portrait:flex items-center justify-center h-11 w-11 rounded-full bg-brand-red text-white shadow-lg ring-0 transition hover:-translate-y-0.5 hover:shadow-[0_14px_34px_rgba(179,40,45,0.35)] active:translate-y-0"
        : "hamburger hidden portrait:flex items-center justify-center h-11 w-11 rounded-full bg-transparent text-gray-900 transition hover:-translate-y-0.5 active:translate-y-0"
      }
    >
      <svg viewBox="0 0 24 24" class={`h-7 w-7 ${resolvedNavVariant === "solid" ? "text-white" : "text-gray-800"}`}>
        <path d="M4 8.5h16M3 15.5h20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- DESKTOP: xl+ (full horizontal nav) -->
  <div class="hidden xl:flex max-w-8xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8 h-24 justify-between items-center gap-6 2xl:gap-4">
    <!-- Logo + Title -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-3 min-w-0 cine-zoom-apple-hover"
      aria-label={`${title} — Home`}
    >
      <img src={logoSrc} alt={`${title} Logo`} class="h-10 md:h-14 w-auto" />
      <div class="flex flex-col min-w-0 items-center text-center">
        <span class="font-bold text-brand-red text-lg sm:text-xl md:text-2xl leading-tight truncate">
          {title}
        </span>
        <span class="text-md text-gray-600 tracking-wide">
          Come. See. <span class="text-[#B3282D]">Jesus</span>
        </span>
      </div>
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-8 font-montserrat text-base xl:text-lg">
      <!-- ...existing code... -->

      <!-- About Us -->
      <div id="dd-about" data-dropdown class="relative focus-within:z-50">
        <button
          data-trigger
          type="button"
          class={`relative px-2 py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
            isActive("/about-us/") ? "text-brand-red after:w-full after:bg-brand-red font-semibold" : "text-gray-700 hover:text-gray-800 after:bg-brand-red"
          }`}
        >About Us</button>

        <div
          data-menu
          class="absolute left-0 top-full -mt-px w-56 rounded-md border bg-white shadow-lg z-50 hidden max-h-80 overflow-y-auto overscroll-contain pt-1"
        >
          <a href="/about-us/" class="group block px-3 py-2 text-sm text-gray-700 hover:text-gray-800"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">What We Do</span></a>
          <a href="/what-we-believe/" class="group block px-3 py-2 text-sm text-gray-700 hover:text-gray-800"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">What We Believe</span></a>
          <a href="/about-us/leadership" class="group block px-3 py-2 text-sm text-gray-700 hover:text-gray-800"><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Schulter and Genevieve</span></a>
        </div>
      </div>

      <!-- Live -->
      <a
        href="/live/"
        class={`relative px-2 py-2 flex items-center gap-1 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
          isActive("/live/") ? "after:w-full after:bg-brand-red text-brand-red font-semibold" : "text-gray-700 hover:text-gray-800 after:bg-brand-red"
        }`}
      >
        <span data-live-text>Live</span>
        <span data-live-indicator class="hidden h-2 w-2 rounded-full bg-red-600 absolute -right-3 top-1/2 -translate-y-1/2"></span>
      </a>

      <!-- Ministries nav removed -->

      <!-- Generosity -->
      <a
        href="/give/"
        class="relative z-10 px-4 py-2 whitespace-nowrap rounded-full bg-brand-red text-white font-semibold shadow-md transition"
        aria-current={isActive("/give/") ? "page" : undefined}
      >Generosity</a>

      <!-- Plan A Visit -->
      <a
        href="/visit/"
        class={`relative px-2 py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
          isActive("/visit/") ? "text-brand-red after:w-full after:bg-brand-red font-semibold" : "text-gray-700 hover:text-gray-800 after:bg-brand-red"
        }`}
      >Plan A Visit</a>

      <!-- Blog (internal listing) -->
      <a
        href="/blog/"
        class={`relative px-2 py-2 after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-0 hover:after:w-full after:transition-all after:duration-300 ${
          isActive("/blog/") ? "text-brand-red after:w-full after:bg-brand-red font-semibold" : "text-gray-700 hover:text-gray-800 after:bg-brand-red"
        }`}
      >Our Blog</a>
    </nav>
  </div>

  <!-- OVERLAYS & DRAWERS (Tablet Portrait Only) -->
  <!-- Tablet Portrait Overlay & Drawer -->
  <div id="tabletNavOverlay" class="fixed inset-0 bg-white opacity-0 pointer-events-none transition-opacity duration-500 ease-[cubic-bezier(0.19,1,0.22,1)] z-[9998]"></div>

  <aside
    id="tabletNavDrawer"
    class="fixed inset-x-0 top-0 w-full max-w-full bg-white shadow-xl transition-transform transition-opacity duration-500 ease-[cubic-bezier(0.19,1,0.22,1)] will-change-transform z-[9999] focus:outline-none hidden portrait:block -translate-y-full opacity-0 pointer-events-none"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
  >
    <div class="h-16 px-6 flex items-center justify-end border-b">
      <button id="tabletMenuClose" type="button" aria-label="Close menu" class={resolvedNavVariant === "solid"
        ? "inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-red text-white shadow-lg ring-0 transition hover:-translate-y-0.5 hover:shadow-[0_14px_34px_rgba(179,40,45,0.35)] active:translate-y-0"
        : "inline-flex h-11 w-11 items-center justify-center rounded-full bg-transparent text-gray-900 transition hover:-translate-y-0.5 active:translate-y-0"
      }>
        <svg viewBox="0 0 24 24" class={`h-7 w-7 ${resolvedNavVariant === "solid" ? "text-white" : "text-gray-800"}`}>
          <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="px-6 py-7 overflow-y-auto max-h-[calc(100dvh-4rem)] space-y-4 text-center items-center flex flex-col" aria-label="Tablet">
      <!-- ...existing code... -->

      <section class="mt-2" data-accordion>
        <button type="button" class="w-full flex items-center justify-center gap-3 px-6 py-5 rounded-full text-center text-xl font-extrabold uppercase tracking-wide hover:bg-gray-50" data-accordion-trigger aria-expanded="false" aria-controls="acc-about-tablet">
          <span>About Us</span>
          <svg class="h-8 w-8 transition-transform" viewBox="0 0 24 24">
            <path d="M7 9.2h10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
            <path d="M5 14.8h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
          </svg>
        </button>
        <div id="acc-about-tablet" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out" data-accordion-panel>
          <div class="overflow-hidden">
            <ul class="py-1">
              <li><a href="/about-us/" class={`block px-6 py-4 text-xl font-semibold rounded-full uppercase tracking-wide ${isActive("/about-us/") ? "text-brand-red bg-red-50" : "text-gray-700 hover:bg-gray-50"}`}>What We Do</a></li>
              
              <li><a href="/what-we-believe/" class={`block px-6 py-4 text-xl font-semibold rounded-full uppercase tracking-wide ${isActive("/what-we-believe/") ? "text-brand-red bg-red-50" : "text-gray-700 hover:bg-gray-50"}`}>What We Believe</a></li>
              <li><a href="/about-us/leadership" class={`block px-6 py-4 text-xl font-semibold rounded-full uppercase tracking-wide ${isActive("/about-us/leadership") ? "text-brand-red bg-red-50" : "text-gray-700 hover:bg-gray-50"}`}>Schulter and Genevieve</a></li>
            </ul>
          </div>
        </div>
      </section>

      <a href="/live/" class={`block w-full px-6 py-5 rounded-full text-xl font-extrabold uppercase tracking-wide ${isActive("/live/") ? "text-brand-red bg-red-50" : "text-gray-700 hover:bg-gray-50"}`}>
        <span class="flex items-center justify-center gap-3">
          <span data-live-tablet-text>Live</span>
          <span data-live-tablet-indicator class="hidden h-2 w-2 rounded-full bg-red-600"></span>
        </span>
      </a>

      <!-- Ministries nav removed from tablet drawer -->

      <a href="/give/" class={`mt-5 inline-flex items-center justify-center px-6 py-4 rounded-full bg-brand-red text-white text-xl font-extrabold uppercase tracking-wide shadow-md hover:bg-red-700 hover:shadow-lg transition`}>
        Generosity
      </a>

      <a href="/visit/" class={`mt-4 block w-full px-6 py-5 rounded-full text-xl font-extrabold uppercase tracking-wide ${isActive("/visit/") ? "text-brand-red bg-red-50" : "text-gray-700 hover:bg-gray-50"}`}>
        Plan A Visit
      </a>

      <a href="/blog/" class={`w-full block px-6 py-4 rounded-full text-xl font-extrabold uppercase tracking-wide ${isActive("/blog/") ? "text-brand-red bg-red-50" : "text-gray-700 hover:bg-gray-50"}`}>
        Our Blog
      </a>
    </nav>
  </aside>

  <!-- Scripts (drawer + accordions for mobile/tablet live here) -->
  <script is:inline>
    function initNavDrawer() {
      const tabletBtn = document.getElementById("tabletMenuButton");
      const mobileBtn = document.getElementById("mobileMenuButton");
      const btnClose = document.getElementById("tabletMenuClose");
      const drawer = document.getElementById("tabletNavDrawer");
      const overlay = document.getElementById("tabletNavOverlay");

      // Require core elements (drawer, overlay, close button). At least one open button is sufficient.
      if (!btnClose || !drawer || !overlay || (!tabletBtn && !mobileBtn)) {
        setTimeout(initNavDrawer, 50);
        return;
      }

      if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
      if (drawer.parentElement !== document.body) document.body.appendChild(drawer);

      const setExpanded = (value) => {
        if (tabletBtn) tabletBtn.setAttribute("aria-expanded", String(value));
        if (mobileBtn) mobileBtn.setAttribute("aria-expanded", String(value));
      };

      const open = () => {
        drawer.classList.remove("-translate-y-full", "opacity-0", "pointer-events-none");
        drawer.classList.add("opacity-100");
        overlay.classList.remove("pointer-events-none");
        overlay.classList.add("opacity-100");
        setExpanded(true);
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.overflow = "hidden";
        document.documentElement.style.paddingRight = scrollbarWidth + "px";
        drawer.focus();
      };

      const close = () => {
        drawer.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
        drawer.classList.remove("opacity-100");
        overlay.classList.add("pointer-events-none");
        overlay.classList.remove("opacity-100");
        setExpanded(false);
        document.documentElement.style.overflow = "";
        document.documentElement.style.paddingRight = "";
        if (tabletBtn) tabletBtn.blur();
        if (mobileBtn) mobileBtn.blur();
      };

      if (tabletBtn) tabletBtn.addEventListener("click", open);
      if (mobileBtn) mobileBtn.addEventListener("click", open);
      btnClose.addEventListener("click", close);
      overlay.addEventListener("click", close);
      window.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

      drawer.querySelectorAll("[data-accordion]").forEach((acc) => {
        const trigger = acc.querySelector("[data-accordion-trigger]");
        const panel = acc.querySelector("[data-accordion-panel]");
        if (!trigger || !panel) return;

        const panelId = panel.id;
        const storageKey = `accordion-tablet-${panelId}`;

        const hasActiveLink = Array.from(acc.querySelectorAll("a[href]")).some(link => {
          const href = link.getAttribute("href");
          if (!href || href.startsWith("http")) return false;
          const currentPath = window.location.pathname;
          return href === "/" ? currentPath === "/" : currentPath === href || (href !== "/" && currentPath.startsWith(href));
        });

        if (hasActiveLink) {
          trigger.classList.add("text-brand-red", "font-semibold", "bg-red-50");
          trigger.classList.remove("text-gray-700");
        } else {
          trigger.classList.add("text-gray-700");
          trigger.classList.remove("text-brand-red", "font-semibold", "bg-red-50");
        }

        const savedState = localStorage.getItem(storageKey) === "true";
        const shouldOpen = savedState || hasActiveLink;

        if (shouldOpen) {
          trigger.setAttribute("aria-expanded", "true");
          const icon = trigger.querySelector("svg");
          if (icon) icon.style.transform = "rotate(180deg)";
          panel.style.gridTemplateRows = "1fr";
        }

        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const expanded = trigger.getAttribute("aria-expanded") === "true";
          trigger.setAttribute("aria-expanded", !expanded);
          const icon = trigger.querySelector("svg");
          if (icon) icon.style.transform = expanded ? "" : "rotate(180deg)";
          panel.style.gridTemplateRows = expanded ? "0fr" : "1fr";
          localStorage.setItem(storageKey, !expanded);
        });
      });

      drawer.querySelectorAll("a[href]").forEach((link) => {
        link.addEventListener("click", () => {
          const isInsideAccordion = link.closest("[data-accordion]");
          if (!isInsideAccordion) {
            drawer.querySelectorAll("[data-accordion]").forEach((acc) => {
              const trigger = acc.querySelector("[data-accordion-trigger]");
              const panel = acc.querySelector("[data-accordion-panel]");
              if (trigger && panel) {
                trigger.setAttribute("aria-expanded", "false");
                const icon = trigger.querySelector("svg");
                if (icon) icon.style.transform = "";
                panel.style.gridTemplateRows = "0fr";
                localStorage.setItem(`accordion-tablet-${panel.id}`, "false");
              }
            });
          }
          close();
        });
      });
    }

    initNavDrawer();

    // Expose helper to open Ministries from other parts of the page (e.g., footer)
    window.openMinistries = function openMinistries(forceMode) {
      // Robust routine with retries to handle timing/race conditions across breakpoints
      // forceMode: 'force-drawer' will prefer opening the drawer even on large viewports
      const attemptOpen = (triesLeft = 10) => {
        try {
          // Debug trace
          console.debug('openMinistries: attempt, triesLeft=', triesLeft);
          // mark that we've attempted to open (helps debug when nothing else sets the dataset)
          try { document.body.dataset.openMinistries = 'attempting'; document.body.dataset.openMinistriesAttempt = String(Date.now()); } catch (e) { /* ignore */ }
          // Smooth scroll to top to reveal header/nav
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // 1) Desktop dropdown (only on large viewports)
          const dd = document.getElementById('dd-ministries');
          const desktopBtn = dd && dd.querySelector('[data-trigger]');
          const desktopMenu = dd && dd.querySelector('[data-menu]');
          const width = window.innerWidth || document.documentElement.clientWidth;
          const preferDesktop = (forceMode !== 'force-drawer') && (width >= 1280); // allow caller to force drawer
          // helper: is element visible in current layout (more robust)
          const isVisible = (el) => {
            if (!el) return false;
            const style = window.getComputedStyle(el);
            if (style.display === 'none' || style.visibility === 'hidden') return false;
            if (el.offsetParent === null) return false; // hidden by display:none or not in layout
            const rect = el.getBoundingClientRect();
            return !!(rect.width || rect.height || el.getClientRects().length);
          };
          if (preferDesktop && desktopMenu && desktopBtn && isVisible(desktopBtn)) {
            console.debug('openMinistries: opening desktop dropdown');
            // Trigger mouseenter to ensure any hover handlers run
            try { desktopBtn.dispatchEvent(new MouseEvent('mouseenter', { bubbles: true })); } catch (e) {}
            desktopMenu.classList.remove('hidden');
            desktopBtn.setAttribute('aria-expanded', 'true');
            desktopMenu.querySelector('a,button,[tabindex]:not([tabindex="-1"])')?.focus();
            document.body.dataset.openMinistries = 'desktop';

            // Keep removing hidden for a short window to avoid race with hide timers
            let keepCount = 0;
            const keepOpen = setInterval(() => {
              if (desktopMenu.classList.contains('hidden')) {
                desktopMenu.classList.remove('hidden');
                desktopBtn.setAttribute('aria-expanded', 'true');
              }
              keepCount += 1;
              if (keepCount > 80) { // ~4s (80 * 50ms)
                clearInterval(keepOpen);
              }
            }, 50);

            // Stop the keepOpen when user enters the menu
            const onMenuEnter = () => { clearInterval(keepOpen); desktopMenu.removeEventListener('mouseenter', onMenuEnter); };
            desktopMenu.addEventListener('mouseenter', onMenuEnter);

            return true;
          }

          // 2) Tablet / Mobile drawer
          const tabletBtn = document.getElementById('tabletMenuButton');
          const mobileBtn = document.getElementById('mobileMenuButton');
          const openBtn = tabletBtn || mobileBtn;
          const drawerElem = document.getElementById('tabletNavDrawer') || document.getElementById('mobileNavDrawer');
          const overlayElem = document.getElementById('tabletNavOverlay') || document.getElementById('mobileNavOverlay');

          if (openBtn) {
            console.debug('openMinistries: clicking openBtn', openBtn.id || openBtn);
            // Set dataset early so tests can see we attempted opening the drawer
            try { document.body.dataset.openMinistries = 'drawer-attempted'; } catch (e) {}
            openBtn.click();
          }

          if (drawerElem) {
            console.debug('openMinistries: programmatically opening drawer', drawerElem.id);
            drawerElem.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
            drawerElem.classList.add('opacity-100');
            if (overlayElem) {
              overlayElem.classList.remove('pointer-events-none');
              overlayElem.classList.add('opacity-100');
            }
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            document.documentElement.style.overflow = 'hidden';
            document.documentElement.style.paddingRight = scrollbarWidth + 'px';
            if (tabletBtn) tabletBtn.setAttribute('aria-expanded', 'true');
            if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'true');
            document.body.dataset.openMinistries = 'drawer';
            drawerElem.focus();

            // expand ministries accordion inside drawer
            const triggerSelector = '[data-accordion] [data-accordion-trigger]';
            const triggers = drawerElem.querySelectorAll(triggerSelector);
            let expanded = false;
            triggers.forEach(t => {
              const ctl = t.getAttribute('aria-controls') || '';
              const txt = (t.textContent || '').trim().toLowerCase();
              if (ctl.toLowerCase().includes('ministries') || /ministries/.test(txt)) {
                const panel = document.getElementById(ctl);
                t.setAttribute('aria-expanded', 'true');
                const icon = t.querySelector('svg'); if (icon) icon.style.transform = 'rotate(180deg)';
                if (panel) panel.style.gridTemplateRows = '1fr';
                panel?.querySelector('a,button')?.focus();
                // Safely compute panel id for dataset (avoid referencing undefined variables)
                const panelIdSafe = (panel && (panel.id || panel.getAttribute('id'))) || ctl || '';
                document.body.dataset.openMinistriesPanel = panelIdSafe;
                console.debug('openMinistries: expanded drawer panel', panelIdSafe);
                expanded = true;
              }
            });
            if (!expanded && triggers[0]) {
              // open first accordion as fallback
              const t = triggers[0];
              const ctl = t.getAttribute('aria-controls');
              const panel = document.getElementById(ctl);
              t.setAttribute('aria-expanded', 'true');
              const icon = t.querySelector('svg'); if (icon) icon.style.transform = 'rotate(180deg)';
              if (panel) panel.style.gridTemplateRows = '1fr';
              panel?.querySelector('a,button')?.focus();
              const panelIdSafe = (panel && (panel.id || panel.getAttribute('id'))) || ctl || '';
              document.body.dataset.openMinistriesPanel = panelIdSafe;
              console.debug('openMinistries: expanded fallback drawer panel', panelIdSafe);
            }
            return true;
          }

          // 3) Fallback: show any header dropdown matching ministries
          const anyMenu = Array.from(document.querySelectorAll('header [data-dropdown]')).map(w => ({wrap: w, btn: w.querySelector('[data-trigger]'), menu: w.querySelector('[data-menu]')})).find(x => (x.btn && /ministries/i.test(x.btn.textContent || '')) || (x.menu && /ministries/i.test(x.menu.textContent || '')));
          if (anyMenu && anyMenu.menu && anyMenu.btn) {
            anyMenu.menu.classList.remove('hidden');
            anyMenu.btn.setAttribute('aria-expanded', 'true');
            anyMenu.menu.querySelector('a,button')?.focus();
            return true;
          }

          return false;
        } catch (e) {
          console.warn('openMinistries attempt failed', e);
          return false;
        }
      };

      // Try immediately, then retry a few times to allow initNavDrawer to finish wiring listeners
      let tries = 0;
      const maxTries = 12;
      const retry = () => {
        const ok = attemptOpen(maxTries - tries);
        if (ok) return;
        tries += 1;
        if (tries <= maxTries) setTimeout(retry, 150);
        else console.warn('openMinistries: could not open ministries menu after retries');
      };
      retry();
    };

    // Desktop dropdowns
    (function () {
      const HIDE_DELAY = 220;
      document.querySelectorAll('header [data-dropdown]').forEach((wrap) => {
        const btn = wrap.querySelector('[data-trigger]');
        const menu = wrap.querySelector('[data-menu]');
        if (!btn || !menu) return;

        let hideTimer;
        const open = () => { clearTimeout(hideTimer); menu.classList.remove('hidden'); btn.setAttribute('aria-expanded', 'true'); };
        const close = () => { hideTimer = setTimeout(() => { menu.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); }, HIDE_DELAY); };

        btn.addEventListener('mouseenter', open);
        btn.addEventListener('mouseleave', close);
        menu.addEventListener('mouseenter', open);
        menu.addEventListener('mouseleave', close);

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const isHidden = menu.classList.contains('hidden');
          isHidden ? open() : close();
        });
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
            e.preventDefault(); open();
            menu.querySelector('a,button,[tabindex]:not([tabindex="-1"])')?.focus();
          }
          if (e.key === 'Escape') { close(); btn.focus(); }
        });
        menu.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); btn.focus(); } });
      });
    })();

    // Live status
    async function checkNavLive() {
      try {
        const res = await fetch("/api/live-status.json");
        const data = await res.json();

        document.querySelectorAll("[data-live-text], [data-live-mobile-text], [data-live-mid-text], [data-live-tablet-text]").forEach(el => {
          el.textContent = data.live ? "Live Now" : "Live";
        });

        document.querySelectorAll("[data-live-indicator], [data-live-mobile-indicator], [data-live-mid-indicator], [data-live-tablet-indicator]").forEach(el => {
          data.live ? el.classList.remove("hidden") : el.classList.add("hidden");
        });
      } catch (e) {
        console.warn("Live check failed", e);
      }
    }

    checkNavLive();
    setInterval(checkNavLive, 60000);
  </script>
</header>
