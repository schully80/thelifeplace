---
const {
  title = "The Life Place",
  logoSrc = "/logo4.svg",
  symbolSrc = "/symbol3.svg",
  class: className,
  navButtonVariant = "glass", // options: "glass" (default) or "solid"
} = Astro.props;

// Allow quick dev preview via ?navBtn=solid|glass
let resolvedNavVariant = navButtonVariant;
const queryVariant = Astro.url?.searchParams?.get("navBtn");
if (queryVariant === "solid" || queryVariant === "glass") {
  resolvedNavVariant = queryVariant;
}

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? path === "/"
    : path === href || (href !== "/" && path.startsWith(href) && path.charAt(href.length) === "/");

const isAboutActive =
  isActive("/about-us/") ||
  isActive("/what-we-believe/") ||
  isActive("/about-us/leadership");

const isHome = path === "/";
const desktopNavTracking = isHome ? "tracking-[-0.02em]" : "tracking-[-0.04em]";

const drawerPrimaryLinkBase =
  "drawer-fade-item block w-full py-2 text-left font-montserrat text-[2.2rem] font-black leading-[0.96] tracking-[-0.04em] transition-colors duration-300 md:py-3 md:text-[3rem]";
const drawerPrimaryLinkState = (href: string) =>
  isActive(href) ? "text-brand-red" : "text-brand-darkgray hover:text-brand-red";
const drawerSubLinkBase =
  "drawer-fade-subitem block w-full py-2 pl-5 text-left font-montserrat text-[1.35rem] font-bold leading-[1.02] tracking-[-0.03em] transition-colors duration-300 md:py-2.5 md:pl-8 md:text-[1.8rem]";
const drawerSubLinkState = (href: string) =>
  isActive(href) ? "text-brand-red" : "text-brand-darkgray/85 hover:text-brand-red";
const desktopNavLinkBase =
  `px-2 py-2 font-montserrat text-[1.5rem] font-black leading-none ${desktopNavTracking}`;
const desktopNavLinkState = (href: string) => (isActive(href) ? "text-brand-red" : "text-gray-700 hover:text-gray-800");
const desktopNavUnderlineBase =
  "relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-0 after:bg-brand-red after:transition-all after:duration-300 hover:after:w-full";
const desktopNavUnderlineState = (href: string) => (isActive(href) ? "after:w-full" : "");
const desktopAboutSubLinkBase =
  "desktop-about-subitem group block px-4 py-3 font-montserrat text-[1.15rem] font-black leading-none tracking-[-0.035em] text-gray-700 hover:text-gray-800";
---

  <header class:list={[
  "relative z-50 border-b bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70",
  className,
]}>

  <!-- MOBILE: 0–md (flex layout with hamburger) — primary mobile UI lives here -->
  <div class="md:hidden h-20 grid grid-cols-[1fr,auto] items-center px-4 gap-2">
    <!-- Logo -->
    <a
      href="/"
      class="flex min-w-0 items-center gap-2"
      aria-label={`${title} — Home`}
    >
      <img src={symbolSrc} alt="" class="h-10 w-10 flex-shrink-0 sm:h-12 sm:w-12" aria-hidden="true" />
      <img src={logoSrc} alt={title} class="h-12 w-auto max-w-[220px] flex-shrink-0 sm:h-14" />
    </a>

    <!-- Hamburger Button -->
    <button
      id="mobileMenuButton"
      type="button"
      aria-label="Open menu"
      aria-controls="mobileNavDrawer"
      aria-expanded="false"
      class="relative inline-flex h-11 w-11 items-center justify-center bg-transparent text-[#171717] transition-colors duration-200 hover:text-black focus:outline-none focus:ring-0 active:text-black"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- TABLET + LAPTOP: md–xl (horizontal nav with optional drawer in portrait) -->
  <div class="hidden md:flex xl:hidden h-20 sm:h-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 justify-between items-center gap-6">
    <!-- Logo -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-3 min-w-0"
      aria-label={`${title} — Home`}
    >
      <img src={symbolSrc} alt="" class="h-12 w-12 flex-shrink-0" aria-hidden="true" />
      <img src={logoSrc} alt={title} class="h-14 w-auto max-w-[260px]" />
    </a>

    <!-- Desktop-style nav (landscape) -->
    <nav class="nav-links hidden landscape:flex items-center gap-6 font-montserrat text-base">

      <!-- About Us Dropdown -->
      <div data-dropdown class="relative">
        <button
          data-trigger
          type="button"
          aria-expanded="false"
          class:list={[
            desktopNavLinkBase,
            isAboutActive ? "text-brand-red" : "text-gray-700 hover:text-gray-800",
          ]}
        ><span class:list={[desktopNavUnderlineBase, isAboutActive ? "after:w-full" : ""]}>About</span></button>

        <div
          data-menu
          data-about-menu
          class="absolute left-0 top-full mt-1 z-50 hidden max-h-80 w-72 overflow-y-auto overscroll-contain rounded-md border bg-white px-2 py-2 shadow-lg"
        >
          <a
            href="/about-us/"
            class:list={[desktopAboutSubLinkBase, isActive("/about-us/") ? "text-brand-red" : ""]}
            style="--desktop-sub-delay: 70ms"
          ><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">What We Do</span></a>
          <a
            href="/what-we-believe/"
            class:list={[desktopAboutSubLinkBase, isActive("/what-we-believe/") ? "text-brand-red" : ""]}
            style="--desktop-sub-delay: 150ms"
          ><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">What We Believe</span></a>
          <a
            href="/about-us/leadership"
            class:list={[desktopAboutSubLinkBase, isActive("/about-us/leadership") ? "text-brand-red" : ""]}
            style="--desktop-sub-delay: 230ms"
          ><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Schulter and Genevieve</span></a>
        </div>
      </div>

      <!-- Live -->
      <a
        href="/live/"
        class:list={[
          desktopNavLinkBase,
          desktopNavLinkState("/live/"),
          "flex items-center gap-2",
        ]}
      >
        <span class:list={[desktopNavUnderlineBase, desktopNavUnderlineState("/live/")]}>
          <span data-live-mid-text>Live</span>
        </span>
        <span data-live-mid-indicator class="hidden shrink-0" aria-hidden="true">
          <span class="relative inline-flex h-3 w-3 items-center justify-center">
            <span class="absolute inset-0 rounded-full bg-brand-red/25 animate-nav-live-ping"></span>
            <span class="relative h-2 w-2 rounded-full bg-brand-red shadow-[0_0_0_2px_rgba(255,255,255,0.92)]"></span>
          </span>
        </span>
      </a>

      <!-- Ministries nav removed -->

      <!-- Generosity -->
      <a
        href="/give/"
        class:list={[
          "relative z-10 px-4 py-2 whitespace-nowrap rounded-2xl bg-brand-red font-montserrat text-[1.5rem] font-black leading-none text-white shadow-md transition hover:bg-red-700",
          desktopNavTracking,
        ]}
      >Give</a>

      <!-- Plan A Visit -->
      <a
        href="/visit/"
        class:list={[desktopNavLinkBase, desktopNavLinkState("/visit/")]}
      ><span class:list={[desktopNavUnderlineBase, desktopNavUnderlineState("/visit/")]}>Visit Us</span></a>

      <!-- Blog (internal listing) -->
      <a
        href="/blog/"
        class:list={[desktopNavLinkBase, desktopNavLinkState("/blog/")]}
      ><span class:list={[desktopNavUnderlineBase, desktopNavUnderlineState("/blog/")]}>Blog</span></a>
    </nav>

    <!-- Hamburger (portrait) -->
    <button
      id="tabletMenuButton"
      type="button"
      aria-label="Open menu"
      aria-controls="tabletNavDrawer"
      aria-expanded="false"
      class="hamburger relative hidden h-11 w-11 items-center justify-center bg-transparent text-[#171717] transition-colors duration-200 hover:text-black focus:outline-none focus:ring-0 active:text-black portrait:flex"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
        
      </svg>
    </button>
  </div>

  <!-- DESKTOP: xl+ (full horizontal nav) -->
  <div class="hidden xl:flex max-w-8xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8 h-24 justify-between items-center gap-6 2xl:gap-4">
    <!-- Logo -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-3 min-w-0 cine-zoom-apple-hover"
      aria-label={`${title} — Home`}
    >
      <img src={symbolSrc} alt="" class="h-12 w-12 flex-shrink-0" aria-hidden="true" />
      <img src={logoSrc} alt={title} class="h-14 w-auto max-w-[280px]" />
    </a>

    <!-- Nav -->
    <nav class="xl:mr-4 2xl:mr-6 flex items-center gap-8 font-montserrat text-base xl:text-lg">
      <!-- ...existing code... -->

      <!-- About Us -->
      <div id="dd-about" data-dropdown class="relative focus-within:z-50">
        <button
          data-trigger
          type="button"
          class:list={[
            desktopNavLinkBase,
            isAboutActive ? "text-brand-red" : "text-gray-700 hover:text-gray-800",
          ]}
        ><span class:list={[desktopNavUnderlineBase, isAboutActive ? "after:w-full" : ""]}>About</span></button>

        <div
          data-menu
          data-about-menu
          class="absolute left-0 top-full -mt-px z-50 hidden max-h-80 w-72 overflow-y-auto overscroll-contain rounded-md border bg-white px-2 py-2 shadow-lg"
        >
          <a
            href="/about-us/"
            class:list={[desktopAboutSubLinkBase, isActive("/about-us/") ? "text-brand-red" : ""]}
            style="--desktop-sub-delay: 70ms"
          ><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">What We Do</span></a>
          <a
            href="/what-we-believe/"
            class:list={[desktopAboutSubLinkBase, isActive("/what-we-believe/") ? "text-brand-red" : ""]}
            style="--desktop-sub-delay: 150ms"
          ><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">What We Believe</span></a>
          <a
            href="/about-us/leadership"
            class:list={[desktopAboutSubLinkBase, isActive("/about-us/leadership") ? "text-brand-red" : ""]}
            style="--desktop-sub-delay: 230ms"
          ><span class="relative inline-block after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:bg-brand-red after:w-0 hover:after:w-full after:transition-all after:duration-300">Schulter and Genevieve</span></a>
        </div>
      </div>

      <!-- Live -->
      <a
        href="/live/"
        class:list={[
          desktopNavLinkBase,
          desktopNavLinkState("/live/"),
          "flex items-center gap-2",
        ]}
      >
        <span class:list={[desktopNavUnderlineBase, desktopNavUnderlineState("/live/")]}>
          <span data-live-text>Live</span>
        </span>
        <span data-live-indicator class="hidden shrink-0" aria-hidden="true">
          <span class="relative inline-flex h-3 w-3 items-center justify-center">
            <span class="absolute inset-0 rounded-full bg-brand-red/25 animate-nav-live-ping"></span>
            <span class="relative h-2 w-2 rounded-full bg-brand-red shadow-[0_0_0_2px_rgba(255,255,255,0.92)]"></span>
          </span>
        </span>
      </a>

      <!-- Ministries nav removed -->

      <!-- Generosity -->
      <a
        href="/give/"
        class:list={[
          "relative z-10 px-4 py-2 whitespace-nowrap rounded-2xl bg-brand-red font-montserrat text-[1.5rem] font-black leading-none text-white shadow-md transition",
          desktopNavTracking,
        ]}
        aria-current={isActive("/give/") ? "page" : undefined}
      >Give</a>

      <!-- Plan A Visit -->
      <a
        href="/visit/"
        class:list={[desktopNavLinkBase, desktopNavLinkState("/visit/")]}
      ><span class:list={[desktopNavUnderlineBase, desktopNavUnderlineState("/visit/")]}>Visit</span></a>

      <!-- Blog (internal listing) -->
      <a
        href="/blog/"
        class:list={[desktopNavLinkBase, desktopNavLinkState("/blog/")]}
      ><span class:list={[desktopNavUnderlineBase, desktopNavUnderlineState("/blog/")]}>Blog</span></a>
    </nav>
  </div>

  <!-- OVERLAYS & DRAWERS (Tablet Portrait Only) -->
  <!-- Tablet Portrait Overlay & Drawer -->
  <div id="tabletNavOverlay" class="fixed inset-0 bg-white opacity-0 pointer-events-none transition-opacity duration-500 ease-overlay z-[9998]"></div>

  <aside
    id="tabletNavDrawer"
    class="fixed inset-x-0 top-0 w-full max-w-full bg-white shadow-xl transition-all duration-500 ease-overlay will-change-transform z-[9999] focus:outline-none hidden portrait:block -translate-y-full opacity-0 pointer-events-none"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    data-drawer-state="closed"
  >
    <div class="h-16 px-6 flex items-center justify-end border-b">
      <button id="tabletMenuClose" type="button" aria-label="Close menu" class="relative inline-flex h-11 w-11 items-center justify-center rounded-full bg-gray-100 text-[#171717] transition-colors duration-200 hover:bg-gray-200 hover:text-black focus:outline-none focus:ring-0 active:bg-gray-200 active:text-black">
        <svg viewBox="0 0 24 24" class="h-7 w-7" aria-hidden="true">
          <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="flex max-h-[calc(100dvh-4rem)] flex-col items-start gap-3 overflow-y-auto px-6 py-8 md:gap-4 md:px-8 md:py-10" aria-label="Tablet">
      <!-- ...existing code... -->

      <section class="mt-1 w-full" data-accordion data-accordion-open="false">
        <button
          type="button"
          class:list={[
            drawerPrimaryLinkBase,
            isAboutActive ? "text-brand-red" : "text-brand-darkgray hover:text-brand-red",
            "flex items-center justify-between gap-4",
          ]}
          style="--drawer-delay: 120ms"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="acc-about-tablet"
        >
          <span>About</span>
          <svg class="h-7 w-7 shrink-0 transition-transform md:h-8 md:w-8" viewBox="0 0 24 24">
            <path d="M8 5l8 7-8 7" stroke="currentColor" stroke-width="2.3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div id="acc-about-tablet" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out" data-accordion-panel>
          <div class="overflow-hidden">
            <ul class="space-y-1 pt-1 pb-2">
              <li>
                <a
                  href="/about-us/"
                  class:list={[drawerSubLinkBase, drawerSubLinkState("/about-us/")]}
                  style="--drawer-delay: 300ms"
                >
                  What We Do
                </a>
              </li>
              <li>
                <a
                  href="/what-we-believe/"
                  class:list={[drawerSubLinkBase, drawerSubLinkState("/what-we-believe/")]}
                  style="--drawer-delay: 420ms"
                >
                  What We Believe
                </a>
              </li>
              <li>
                <a
                  href="/about-us/leadership"
                  class:list={[drawerSubLinkBase, drawerSubLinkState("/about-us/leadership")]}
                  style="--drawer-delay: 540ms"
                >
                  Schulter and Genevieve
                </a>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <a
        href="/live/"
        class:list={[drawerPrimaryLinkBase, drawerPrimaryLinkState("/live/")]}
        style="--drawer-delay: 240ms"
      >
        <span class="flex items-center gap-3">
          <span data-live-tablet-text>Live</span>
          <span data-live-tablet-indicator class="hidden shrink-0" aria-hidden="true">
            <span class="relative inline-flex h-3.5 w-3.5 items-center justify-center">
              <span class="absolute inset-0 rounded-full bg-brand-red/25 animate-nav-live-ping"></span>
              <span class="relative h-2.5 w-2.5 rounded-full bg-brand-red shadow-[0_0_0_2px_rgba(255,255,255,0.95)]"></span>
            </span>
          </span>
        </span>
      </a>

      <!-- Ministries nav removed from tablet drawer -->

      <a
        href="/give/"
        class="drawer-fade-item relative z-10 inline-flex w-auto self-start items-center justify-center rounded-2xl bg-brand-red px-4 py-2 font-montserrat text-[2.2rem] font-black leading-[0.96] tracking-[-0.04em] text-white transition-colors duration-300 hover:bg-red-700 md:py-3 md:text-[3rem]"
        style="--drawer-delay: 360ms"
        aria-current={isActive("/give/") ? "page" : undefined}
      >
        Give
      </a>

      <a
        href="/visit/"
        class:list={[drawerPrimaryLinkBase, drawerPrimaryLinkState("/visit/")]}
        style="--drawer-delay: 480ms"
      >
        Visit
      </a>

      <a
        href="/blog/"
        class:list={[drawerPrimaryLinkBase, drawerPrimaryLinkState("/blog/")]}
        style="--drawer-delay: 600ms"
      >
        Blog
      </a>
    </nav>
  </aside>

  <style>
    @keyframes nav-live-ping {
      0% {
        transform: scale(0.85);
        opacity: 0.7;
      }
      70% {
        transform: scale(1.9);
        opacity: 0;
      }
      100% {
        transform: scale(1.9);
        opacity: 0;
      }
    }

    .animate-nav-live-ping {
      animation: nav-live-ping 1.8s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }

    @keyframes nav-drawer-fade-left {
      0% {
        opacity: 0;
        transform: translate3d(-2rem, 0, 0);
      }
      100% {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .drawer-fade-item,
    .drawer-fade-subitem {
      opacity: 0;
      transform: translate3d(-2rem, 0, 0);
      will-change: opacity, transform;
    }

    #tabletNavDrawer[data-drawer-state="open"] .drawer-fade-item {
      animation: nav-drawer-fade-left 820ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--drawer-delay, 0ms);
    }

    #tabletNavDrawer[data-drawer-state="open"] [data-accordion][data-accordion-open="true"] .drawer-fade-subitem {
      animation: nav-drawer-fade-left 820ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--drawer-delay, 0ms);
    }

    @keyframes desktop-about-subnav-fade-left {
      0% {
        opacity: 0;
        transform: translate3d(-1rem, 0, 0);
      }
      100% {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .desktop-about-subitem {
      opacity: 0;
      transform: translate3d(-1rem, 0, 0);
      will-change: opacity, transform;
    }

    [data-about-menu]:not(.hidden) .desktop-about-subitem {
      animation: desktop-about-subnav-fade-left 420ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--desktop-sub-delay, 0ms);
    }
  </style>

  <!-- Scripts (drawer + accordions for mobile/tablet live here) -->
  <script is:inline>
    function initNavDrawer() {
      const tabletBtn = document.getElementById("tabletMenuButton");
      const mobileBtn = document.getElementById("mobileMenuButton");
      const btnClose = document.getElementById("tabletMenuClose");
      const drawer = document.getElementById("tabletNavDrawer");
      const overlay = document.getElementById("tabletNavOverlay");

      // Require core elements (drawer, overlay, close button). At least one open button is sufficient.
      if (!btnClose || !drawer || !overlay || (!tabletBtn && !mobileBtn)) {
        setTimeout(initNavDrawer, 50);
        return;
      }

      if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
      if (drawer.parentElement !== document.body) document.body.appendChild(drawer);

      const setExpanded = (value) => {
        if (tabletBtn) tabletBtn.setAttribute("aria-expanded", String(value));
        if (mobileBtn) mobileBtn.setAttribute("aria-expanded", String(value));
      };

      const open = () => {
        drawer.dataset.drawerState = "closed";
        void drawer.offsetWidth;
        drawer.classList.remove("-translate-y-full", "opacity-0", "pointer-events-none");
        drawer.classList.add("opacity-100");
        drawer.dataset.drawerState = "open";
        overlay.classList.remove("pointer-events-none");
        overlay.classList.add("opacity-100");
        setExpanded(true);
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.overflow = "hidden";
        document.documentElement.style.paddingRight = scrollbarWidth + "px";
        drawer.focus();
      };

      const close = () => {
        drawer.dataset.drawerState = "closed";
        drawer.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
        drawer.classList.remove("opacity-100");
        overlay.classList.add("pointer-events-none");
        overlay.classList.remove("opacity-100");
        setExpanded(false);
        document.documentElement.style.overflow = "";
        document.documentElement.style.paddingRight = "";
        if (tabletBtn) tabletBtn.blur();
        if (mobileBtn) mobileBtn.blur();
      };

      if (tabletBtn) tabletBtn.addEventListener("click", open);
      if (mobileBtn) mobileBtn.addEventListener("click", open);
      btnClose.addEventListener("click", close);
      overlay.addEventListener("click", close);
      window.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

      drawer.querySelectorAll("[data-accordion]").forEach((acc) => {
        const trigger = acc.querySelector("[data-accordion-trigger]");
        const panel = acc.querySelector("[data-accordion-panel]");
        if (!trigger || !panel) return;

        const panelId = panel.id;
        const storageKey = `accordion-tablet-${panelId}`;

        const hasActiveLink = Array.from(acc.querySelectorAll("a[href]")).some(link => {
          const href = link.getAttribute("href");
          if (!href || href.startsWith("http")) return false;
          const currentPath = window.location.pathname;
          return href === "/" ? currentPath === "/" : currentPath === href || (href !== "/" && currentPath.startsWith(href));
        });

        const savedState = localStorage.getItem(storageKey) === "true";
        const shouldOpen = savedState || hasActiveLink;
        acc.dataset.accordionOpen = shouldOpen ? "true" : "false";

        if (shouldOpen) {
          trigger.setAttribute("aria-expanded", "true");
          const icon = trigger.querySelector("svg");
          if (icon) icon.style.transform = "rotate(90deg)";
          panel.style.gridTemplateRows = "1fr";
        }

        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const expanded = trigger.getAttribute("aria-expanded") === "true";
          trigger.setAttribute("aria-expanded", !expanded);
          acc.dataset.accordionOpen = expanded ? "false" : "true";
          const icon = trigger.querySelector("svg");
          if (icon) icon.style.transform = expanded ? "" : "rotate(90deg)";
          panel.style.gridTemplateRows = expanded ? "0fr" : "1fr";
          localStorage.setItem(storageKey, !expanded);
        });
      });

      drawer.querySelectorAll("a[href]").forEach((link) => {
        link.addEventListener("click", () => {
          const isInsideAccordion = link.closest("[data-accordion]");
          if (!isInsideAccordion) {
            drawer.querySelectorAll("[data-accordion]").forEach((acc) => {
              const trigger = acc.querySelector("[data-accordion-trigger]");
              const panel = acc.querySelector("[data-accordion-panel]");
              if (trigger && panel) {
                trigger.setAttribute("aria-expanded", "false");
                const icon = trigger.querySelector("svg");
                acc.dataset.accordionOpen = "false";
                if (icon) icon.style.transform = "";
                panel.style.gridTemplateRows = "0fr";
                localStorage.setItem(`accordion-tablet-${panel.id}`, "false");
              }
            });
          }
          close();
        });
      });
    }

    initNavDrawer();

    // Expose helper to open Ministries from other parts of the page (e.g., footer)
    window.openMinistries = function openMinistries(forceMode) {
      // Robust routine with retries to handle timing/race conditions across breakpoints
      // forceMode: 'force-drawer' will prefer opening the drawer even on large viewports
      const attemptOpen = (triesLeft = 10) => {
        try {
          // Debug trace
          console.debug('openMinistries: attempt, triesLeft=', triesLeft);
          // mark that we've attempted to open (helps debug when nothing else sets the dataset)
          try { document.body.dataset.openMinistries = 'attempting'; document.body.dataset.openMinistriesAttempt = String(Date.now()); } catch (e) { /* ignore */ }
          // Smooth scroll to top to reveal header/nav
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // 1) Desktop dropdown (only on large viewports)
          const dd = document.getElementById('dd-ministries');
          const desktopBtn = dd && dd.querySelector('[data-trigger]');
          const desktopMenu = dd && dd.querySelector('[data-menu]');
          const width = window.innerWidth || document.documentElement.clientWidth;
          const preferDesktop = (forceMode !== 'force-drawer') && (width >= 1280); // allow caller to force drawer
          // helper: is element visible in current layout (more robust)
          const isVisible = (el) => {
            if (!el) return false;
            const style = window.getComputedStyle(el);
            if (style.display === 'none' || style.visibility === 'hidden') return false;
            if (el.offsetParent === null) return false; // hidden by display:none or not in layout
            const rect = el.getBoundingClientRect();
            return !!(rect.width || rect.height || el.getClientRects().length);
          };
          if (preferDesktop && desktopMenu && desktopBtn && isVisible(desktopBtn)) {
            console.debug('openMinistries: opening desktop dropdown');
            // Trigger mouseenter to ensure any hover handlers run
            try { desktopBtn.dispatchEvent(new MouseEvent('mouseenter', { bubbles: true })); } catch (e) {}
            desktopMenu.classList.remove('hidden');
            desktopBtn.setAttribute('aria-expanded', 'true');
            desktopMenu.querySelector('a,button,[tabindex]:not([tabindex="-1"])')?.focus();
            document.body.dataset.openMinistries = 'desktop';

            // Keep removing hidden for a short window to avoid race with hide timers
            let keepCount = 0;
            const keepOpen = setInterval(() => {
              if (desktopMenu.classList.contains('hidden')) {
                desktopMenu.classList.remove('hidden');
                desktopBtn.setAttribute('aria-expanded', 'true');
              }
              keepCount += 1;
              if (keepCount > 80) { // ~4s (80 * 50ms)
                clearInterval(keepOpen);
              }
            }, 50);

            // Stop the keepOpen when user enters the menu
            const onMenuEnter = () => { clearInterval(keepOpen); desktopMenu.removeEventListener('mouseenter', onMenuEnter); };
            desktopMenu.addEventListener('mouseenter', onMenuEnter);

            return true;
          }

          // 2) Tablet / Mobile drawer
          const tabletBtn = document.getElementById('tabletMenuButton');
          const mobileBtn = document.getElementById('mobileMenuButton');
          const openBtn = tabletBtn || mobileBtn;
          const drawerElem = document.getElementById('tabletNavDrawer') || document.getElementById('mobileNavDrawer');
          const overlayElem = document.getElementById('tabletNavOverlay') || document.getElementById('mobileNavOverlay');

          if (openBtn) {
            console.debug('openMinistries: clicking openBtn', openBtn.id || openBtn);
            // Set dataset early so tests can see we attempted opening the drawer
            try { document.body.dataset.openMinistries = 'drawer-attempted'; } catch (e) {}
            openBtn.click();
          }

          if (drawerElem) {
            console.debug('openMinistries: programmatically opening drawer', drawerElem.id);
            drawerElem.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
            drawerElem.classList.add('opacity-100');
            drawerElem.dataset.drawerState = 'open';
            if (overlayElem) {
              overlayElem.classList.remove('pointer-events-none');
              overlayElem.classList.add('opacity-100');
            }
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            document.documentElement.style.overflow = 'hidden';
            document.documentElement.style.paddingRight = scrollbarWidth + 'px';
            if (tabletBtn) tabletBtn.setAttribute('aria-expanded', 'true');
            if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'true');
            document.body.dataset.openMinistries = 'drawer';
            drawerElem.focus();

            // expand ministries accordion inside drawer
            const triggerSelector = '[data-accordion] [data-accordion-trigger]';
            const triggers = drawerElem.querySelectorAll(triggerSelector);
            let expanded = false;
            triggers.forEach(t => {
              const ctl = t.getAttribute('aria-controls') || '';
              const txt = (t.textContent || '').trim().toLowerCase();
              if (ctl.toLowerCase().includes('ministries') || /ministries/.test(txt)) {
                const panel = document.getElementById(ctl);
                t.setAttribute('aria-expanded', 'true');
                const icon = t.querySelector('svg'); if (icon) icon.style.transform = 'rotate(180deg)';
                if (panel) panel.style.gridTemplateRows = '1fr';
                panel?.querySelector('a,button')?.focus();
                // Safely compute panel id for dataset (avoid referencing undefined variables)
                const panelIdSafe = (panel && (panel.id || panel.getAttribute('id'))) || ctl || '';
                document.body.dataset.openMinistriesPanel = panelIdSafe;
                console.debug('openMinistries: expanded drawer panel', panelIdSafe);
                expanded = true;
              }
            });
            if (!expanded && triggers[0]) {
              // open first accordion as fallback
              const t = triggers[0];
              const ctl = t.getAttribute('aria-controls');
              const panel = document.getElementById(ctl);
              t.setAttribute('aria-expanded', 'true');
              const icon = t.querySelector('svg'); if (icon) icon.style.transform = 'rotate(180deg)';
              if (panel) panel.style.gridTemplateRows = '1fr';
              panel?.querySelector('a,button')?.focus();
              const panelIdSafe = (panel && (panel.id || panel.getAttribute('id'))) || ctl || '';
              document.body.dataset.openMinistriesPanel = panelIdSafe;
              console.debug('openMinistries: expanded fallback drawer panel', panelIdSafe);
            }
            return true;
          }

          // 3) Fallback: show any header dropdown matching ministries
          const anyMenu = Array.from(document.querySelectorAll('header [data-dropdown]')).map(w => ({wrap: w, btn: w.querySelector('[data-trigger]'), menu: w.querySelector('[data-menu]')})).find(x => (x.btn && /ministries/i.test(x.btn.textContent || '')) || (x.menu && /ministries/i.test(x.menu.textContent || '')));
          if (anyMenu && anyMenu.menu && anyMenu.btn) {
            anyMenu.menu.classList.remove('hidden');
            anyMenu.btn.setAttribute('aria-expanded', 'true');
            anyMenu.menu.querySelector('a,button')?.focus();
            return true;
          }

          return false;
        } catch (e) {
          console.warn('openMinistries attempt failed', e);
          return false;
        }
      };

      // Try immediately, then retry a few times to allow initNavDrawer to finish wiring listeners
      let tries = 0;
      const maxTries = 12;
      const retry = () => {
        const ok = attemptOpen(maxTries - tries);
        if (ok) return;
        tries += 1;
        if (tries <= maxTries) setTimeout(retry, 150);
        else console.warn('openMinistries: could not open ministries menu after retries');
      };
      retry();
    };

    // Desktop dropdowns
    (function () {
      const HIDE_DELAY = 220;
      const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      document.querySelectorAll('header [data-dropdown]').forEach((wrap) => {
        const btn = wrap.querySelector('[data-trigger]');
        const menu = wrap.querySelector('[data-menu]');
        if (!btn || !menu) return;

        let hideTimer;
        const open = () => {
          clearTimeout(hideTimer);
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        };
        const closeNow = () => {
          clearTimeout(hideTimer);
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        };
        const close = () => {
          clearTimeout(hideTimer);
          hideTimer = setTimeout(closeNow, HIDE_DELAY);
        };

        if (supportsHover) {
          btn.addEventListener('mouseenter', open);
          btn.addEventListener('mouseleave', close);
          menu.addEventListener('mouseenter', open);
          menu.addEventListener('mouseleave', close);
        }

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const isHidden = menu.classList.contains('hidden');
          isHidden ? open() : closeNow();
        });
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
            e.preventDefault(); open();
            menu.querySelector('a,button,[tabindex]:not([tabindex="-1"])')?.focus();
          }
          if (e.key === 'Escape') { closeNow(); btn.focus(); }
        });
        menu.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeNow(); btn.focus(); } });

        document.addEventListener('click', (e) => {
          if (!wrap.contains(e.target)) closeNow();
        });
      });
    })();

    // Live status
    async function checkNavLive() {
      try {
        const res = await fetch("/api/live-status.json");
        const data = await res.json();

        document.querySelectorAll("[data-live-indicator], [data-live-mobile-indicator], [data-live-mid-indicator], [data-live-tablet-indicator]").forEach(el => {
          data.live ? el.classList.remove("hidden") : el.classList.add("hidden");
        });
      } catch (e) {
        console.warn("Live check failed", e);
      }
    }

    checkNavLive();
    setInterval(checkNavLive, 60000);
  </script>
</header>
