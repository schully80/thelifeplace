---
const {
  title = "Register",
  description = "Fill in your details below to save your spot.",
  eventCode = "VISION2025",
} = Astro.props;

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<section class="max-w-2xl mx-auto px-4 py-12">
  <header class="text-center mb-8">
    <h2 class="text-2xl md:text-3xl font-semibold text-brand-red tracking-tight">
      {title}
    </h2>
    <p class="mt-2 text-sm md:text-base text-brand-warmgray-700">{description}</p>
  </header>

  <!-- Registration Form -->
  <form id="registrationForm" method="POST" action="/register" class="space-y-6">
    <!-- 👤 Tier 1: First Name + Contact Number -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input type="text" id="firstName" name="firstName" placeholder="Name *" required class="form-input" />
      <input type="tel" id="contact" name="contact" placeholder="Contact Number *" required class="form-input" />
    </div>

    <!-- 📧 Tier 2: Email + Attendees -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input type="email" id="email" name="email" placeholder="Email Address *" required class="form-input" />
      <input type="number" id="attendees" name="attendees" min="1" placeholder="Number of Persons Attending *" required class="form-input" />
    </div>

    <!-- 📍 Tier 3: Address Section -->
    <h3 class="text-lg font-semibold text-brand-red">Your Address</h3>
    <slot /> <!-- AddressFields.astro injected here -->

    <!-- 🐜 Honeypot -->
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- Hidden email subject/message -->
    <input type="hidden" name="_subject" value={`New ${eventCode} Registration`} />
    <input type="hidden" name="message" value={`Thank you for registering for ${eventCode}. We'll be in touch soon!`} />

    <!-- 🔒 Tier 4: reCAPTCHA -->
    <div class="pt-2 flex justify-center">
      <div class="g-recaptcha"
           data-sitekey={recaptchaSiteKey}
           data-callback="onRecaptchaSuccess"
           data-expired-callback="onRecaptchaExpired"
           data-error-callback="onRecaptchaError"></div>
    </div>

    <!-- 🚀 Tier 5: Submit -->
    <button
      type="submit"
      id="tlpSubmitBtn"
      disabled
      class="w-full rounded-full bg-gray-400 text-white text-lg font-semibold py-3
             disabled:opacity-60 disabled:cursor-not-allowed transition"
    >
      Save My Spot
    </button>
  </form>
</section>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
  function onRecaptchaSuccess() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = false;
    btn.classList.remove("bg-gray-400");
    btn.classList.add("bg-brand-red");
  }
  function onRecaptchaExpired() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
    btn.classList.remove("bg-brand-red");
    btn.classList.add("bg-gray-400");
  }
  function onRecaptchaError() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
    btn.classList.remove("bg-brand-red");
    btn.classList.add("bg-gray-400");
    console.error("reCAPTCHA failed to load or validate.");
  }
</script>

<style>
  .form-input {
    @apply w-full rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-[15px] text-gray-900
           placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red/60 
           focus:border-brand-red transition;
  }
</style>