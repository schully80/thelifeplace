---
const {
  title = "Register",
  description = "Fill in your details below.",
  eventCode = "DEFAULT_EVENT",
  eventName = "Your Event",
} = Astro.props;

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;

// Dynamic CTA wording based on eventCode
function getCTA(event) {
  switch (event) {
    case "VISION_NIGHT_2025": return "Reserve My Seat";
    case "PREMARITAL_2025": return "Register as a Couple";
    case "BABY_DEDICATION_2025": return "Register My Child";
    case "TLPI_2025": return "Enroll Now";
    default: return "Save My Spot";
  }
}

const ctaLabel = getCTA(eventCode);
---

<section class="max-w-2xl mx-auto px-4 py-12">
  <header class="text-center mb-10">
    <h2 class="heading-2 text-brand-red">{title}</h2>
    <p class="mt-2 text-gray-800">{description}</p>
  </header>

  <form id="registrationForm" method="POST" action="/register" class="space-y-8">

    <!-- USER FIELDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="field">
        <input type="text" name="fullName" placeholder=" " required />
        <label>Full Name</label>
      </div>

      <div class="field">
        <input type="tel" name="contact" placeholder=" " required />
        <label>Contact Number</label>
      </div>

      <div class="field">
        <input type="email" name="email" placeholder=" " required />
        <label>Email Address</label>
      </div>

      <div class="field">
        <input type="number" name="attendees" min="1" placeholder=" " required />
        <label>Number of Persons Attending</label>
      </div>
    </div>

    <!-- ADDRESS -->
    <h3 class="text-lg font-semibold text-brand-red mt-6">Your Address</h3>
    <slot /> <!-- AddressFields.astro injected here -->

    <!-- Hidden event info -->
    <input type="hidden" name="eventCode" value={eventCode} />
    <input type="hidden" name="eventName" value={eventName} />

    <!-- Honeypot -->
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- reCAPTCHA -->
    <div class="pt-4 flex justify-center">
      <div class="g-recaptcha"
           data-sitekey={recaptchaSiteKey}
           data-callback="onRecaptchaSuccess"
           data-expired-callback="onRecaptchaExpired"
           data-error-callback="onRecaptchaError">
      </div>
    </div>

    <!-- SUBMIT BUTTON -->
    <button
      type="submit"
      id="tlpSubmitBtn"
      disabled
      class="w-full rounded-full bg-gray-400 text-white text-lg font-semibold py-3
             disabled:opacity-60 disabled:cursor-not-allowed transition-all">
      {ctaLabel}
    </button>
  </form>
</section>

<!-- reCAPTCHA -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
  function onRecaptchaSuccess() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = false;
    btn.classList.remove("bg-gray-400");
    btn.classList.add("bg-brand-red");
  }
  function onRecaptchaExpired() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
    btn.classList.remove("bg-brand-red");
    btn.classList.add("bg-gray-400");
  }
  function onRecaptchaError() {
    const btn = document.getElementById("tlpSubmitBtn");
    btn.disabled = true;
    btn.classList.remove("bg-brand-red");
    btn.classList.add("bg-gray-400");
    console.error("reCAPTCHA failed to load.");
  }
</script>

<style>
  /* Floating label fields */
  .field {
    position: relative;
    padding-top: 1.2rem;
  }
  .field input {
    width: 100%;
    border: none;
    border-bottom: 1.5px solid #d1d5db;
    padding: 6px 2px;
    font-size: 15px;
    background: transparent;
    outline: none;
    transition: border-color .25s ease;
  }
  .field input:focus {
    border-bottom-color: #B3282D;
  }
  .field label {
    position: absolute;
    left: 2px;
    bottom: 6px;
    font-size: 15px;
    color: #9ca3af;
    pointer-events: none;
    transition: .25s ease;
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label {
    transform: translateY(-1.1rem);
    font-size: 12px;
    color: #B3282D;
  }
</style>
