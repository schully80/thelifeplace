---
import Turnstile from "./ui/Turnstile.astro";
const {
  title = "Register",
  description = "Fill in your details below.",
  eventCode = "DEFAULT_EVENT",
  eventName = "Your Event",
} = Astro.props;

 

// Dynamic CTA wording based on eventCode
function getCTA(event) {
  switch (event) {
    case "VISION_NIGHT_2025": return "Reserve My Seat";
    case "PREMARITAL_2025": return "Register as a Couple";
    case "BABY_DEDICATION_2025": return "Register My Child";
    case "TLPI_2025": return "Enroll Now";
    default: return "Save My Spot";
  }
}

const ctaLabel = getCTA(eventCode);
---

<section class="max-w-2xl mx-auto px-4 py-12">
  <header class="text-center mb-10">
    <h2 class="heading-2 text-brand-red">{title}</h2>
    <p class="mt-2 text-gray-800">{description}</p>
  </header>

  <form id="registrationForm" method="POST" action="/register" class="space-y-8">

    <!-- USER FIELDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="field">
        <input type="text" name="fullName" placeholder=" " required />
        <label>Full Name</label>
      </div>

      <div class="field">
        <input type="tel" name="contact" placeholder=" " required />
        <label>Contact Number</label>
      </div>

      <div class="field">
        <input type="email" name="email" placeholder=" " required />
        <label>Email Address</label>
      </div>

      <div class="field">
        <input type="number" name="attendees" min="1" placeholder=" " required />
        <label>Number of Persons Attending</label>
      </div>
    </div>

    <!-- ADDRESS -->
    <h3 class="text-lg font-semibold text-brand-red mt-6">Your Address</h3>
    <slot /> <!-- AddressFields.astro injected here -->

    <!-- Hidden event info -->
    <input type="hidden" name="eventCode" value={eventCode} />
    <input type="hidden" name="eventName" value={eventName} />

    <!-- Honeypot -->
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- Turnstile widget -->
    <div class="mt-4 flex justify-center">
      <Turnstile name="cf-turnstile-response" />
    </div>

    <!-- SUBMIT BUTTON -->
    <button
      type="submit"
      id="tlpSubmitBtn"
      class="w-full rounded-full bg-brand-red text-white text-lg font-semibold py-3 transition-all">
      {ctaLabel}
    </button>
  </form>
</section>

    

<style>
  /* Floating label fields */
  .field {
    position: relative;
    padding-top: 1.2rem;
  }
  .field input {
    width: 100%;
    border: none;
    border-bottom: 1.5px solid #d1d5db;
    padding: 6px 2px;
    font-size: 15px;
    background: transparent;
    outline: none;
    transition: border-color .25s ease;
  }
  .field input:focus {
    border-bottom-color: #B3282D;
  }
  .field label {
    position: absolute;
    left: 2px;
    bottom: 6px;
    font-size: 15px;
    color: #9ca3af;
    pointer-events: none;
    transition: .25s ease;
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label {
    transform: translateY(-1.1rem);
    font-size: 12px;
    color: #B3282D;
  }
</style>

<!-- Turnstile UX initializer for this form -->
<script>
  (function(){
    try {
      const form = document.getElementById('registrationForm');
      const btn = document.getElementById('tlpSubmitBtn');
      if (!form || !btn) return;

      const hasToken = () => {
        const e = form.querySelector('input[name="cf-turnstile-response"]');
        return !!(e && e.value && e.value.length > 0);
      };

      const setDisabled = (disabled) => {
        btn.disabled = disabled;
        if (disabled) {
          btn.classList.add('opacity-60', 'cursor-not-allowed');
          btn.setAttribute('aria-disabled', 'true');
        } else {
          btn.classList.remove('opacity-60', 'cursor-not-allowed');
          btn.removeAttribute('aria-disabled');
        }
      };

      setDisabled(!hasToken());

      form.addEventListener('turnstile:verified', function(){ setDisabled(false); });

      form.addEventListener('submit', function(e){
        if (!hasToken()) {
          e.preventDefault();
          setDisabled(true);
          alert('Please complete the verification before submitting.');
        } else {
          btn.setAttribute('aria-busy', 'true');
        }
      });

      // Fallback: allow manual review trigger
      setTimeout(function(){
        if (hasToken() || form.querySelector('[data-tlp-fallback]')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'mt-4 text-center';
        wrapper.setAttribute('data-tlp-fallback','1');
        wrapper.innerHTML = `
          <label class="sr-only" for="tlp_fallback_input">If you cannot verify, type human</label>
          <input id="tlp_fallback_input" name="tlp_fallback_answer" placeholder="Type 'human' here" class="px-4 py-2 rounded-md border w-64" />
          <input type="hidden" name="tlp_manual_review" value="1" />
        `;
        btn.parentElement?.insertAdjacentElement('afterend', wrapper);
        const input = wrapper.querySelector('#tlp_fallback_input');
        input && input.addEventListener('input', function(evt){
          if ((evt.target.value||'').toString().trim().toLowerCase() === 'human') setDisabled(false);
        });
      }, 5000);

    } catch (err) {
      console.warn('Turnstile UX init error', err);
    }
  })();
</script>
