---
const {
  title = "Register",
  description = "Fill in your details below to save your spot.",
  eventCode = "GEN2025",
  titleClass = "text-2xl font-bold text-brand-red",
  eventName = "Registration",
  successMessage = "Your registration has been received. We’ll be in touch soon.",
  ctaText = "Save My Spot",
  disabled = false,
  showNotice = false,
  fields = null, // optional dynamic fields array
} = Astro.props;

// Turnstile site key for the widget
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="max-w-2xl mx-auto px-4 py-12 animate-fade-in-up">
  <div class="bg-white p-6 rounded-xl shadow ring-1 ring-blue-200 space-y-6">
    <h2 class={titleClass}>{title}</h2>
    <p class="text-gray-700">{description}</p>

    <!-- Registration Form -->
    <form
      id="registrationForm"
      method="POST"
      action="/register"
      class="space-y-6"
    >
      <!-- Optional top notice when closed -->
      {showNotice && disabled && (
        <p class="mb-2 text-center text-sm md:text-base text-gray-500 italic">
          Registration will open soon. Stay tuned!
        </p>
      )}

      <!-- 👤 Fields -->
      {fields ? (
        // Dynamic fields passed from page (like in new-members.astro)
        <div class="space-y-4">
          {fields.map((field) => (
            <div class="space-y-2">
              <label
                for={field.id}
                class="text-sm font-medium text-gray-700"
              >
                {field.label}
                {field.required && " *"}
              </label>
              <input
                id={field.id}
                name={field.id}
                type={field.type || "text"}
                class="form-field"
                required={field.required}
                minlength={field.minlength}
                maxlength={field.maxlength}
                pattern={field.pattern}
                min={field.min}
                max={field.max}
              />
            </div>
          ))}
        </div>
      ) : (
        // Fallback hard-coded fields (if no fields prop is provided)
        <>
          <!-- Personal Info -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="firstName" class="text-sm font-medium text-gray-700">First Name *</label>
              <input type="text" id="firstName" name="firstName" class="form-field" required />
            </div>

            <div class="space-y-2">
              <label for="lastName" class="text-sm font-medium text-gray-700">Last Name *</label>
              <input type="text" id="lastName" name="lastName" class="form-field" required />
            </div>
          </div>

          <!-- Contact Info -->
          <div class="space-y-2">
            <label for="contact" class="text-sm font-medium text-gray-700">Contact Number *</label>
            <input type="tel" id="contact" name="contact" class="form-field" required />
          </div>

          <div class="space-y-2">
            <label for="email" class="text-sm font-medium text-gray-700">Email Address *</label>
            <input type="email" id="email" name="email" class="form-field" required />
          </div>

          <!-- Attendance -->
          <div class="space-y-2">
            <label for="attendees" class="text-sm font-medium text-gray-700">Number of Persons Attending *</label>
            <input type="number" id="attendees" name="attendees" class="form-field" min="1" required />
          </div>
        </>
      )}

      <!-- 📨 Hidden Fields -->
      <input type="hidden" name="_subject" value={`New ${eventCode} Registration`} />
      <input
        type="hidden"
        name="message"
        value={`Thank you for registering for ${eventCode}. We'll be in touch soon!`}
      />
      <input type="hidden" name="intent" value={eventName} />

      <!-- ✅ Turnstile widget -->
      <div>
        <div class="cf-turnstile" data-sitekey={siteKey}></div>
      </div>

      <!-- Error box (hidden by default) -->
      <div
        id="formError"
        class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-md px-3 py-2"
      ></div>

      <!-- 🚀 Submit Button -->
      <button
        type="submit"
        disabled={disabled}
        class={`btn-brand inline-flex items-center gap-2 ${
          disabled ? "bg-gray-400 cursor-not-allowed opacity-60" : ""
        }`}
      >
        <span>{ctaText}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 animate-pulse"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 17L17 7M7 7h10v10"
          />
        </svg>
      </button>
    </form>

    <!-- Inline Thank You Message -->
    <div id="thankYouMessage" class="hidden mt-10 text-center">
      <h2 class="text-2xl font-semibold text-brand-red mb-2">Thank You!</h2>
      <p class="text-lg text-brand-warmgray-700">
        {successMessage}
      </p>
    </div>
  </div>
</section>

<!-- Turnstile loader -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("registrationForm");
    const thankYou = document.getElementById("thankYouMessage");
    const errorBox = document.getElementById("formError");

    if (!form) return;

    const showError = (message) => {
      console.error("[Register form error]", message);
      if (!errorBox) {
        alert(message);
        return;
      }
      errorBox.textContent = message;
      errorBox.classList.remove("hidden");
    };

    const clearError = () => {
      if (!errorBox) return;
      errorBox.textContent = "";
      errorBox.classList.add("hidden");
    };

    form.addEventListener("submit", async (e) => {
      // If button is disabled, do nothing
      if (form.querySelector("button[disabled]")) {
        return;
      }

      e.preventDefault();
      clearError();

      const formData = new FormData(form);

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        const contentType = res.headers.get("content-type") || "";
        const isJson = contentType.includes("application/json");
        let data = null;

        if (isJson) {
          try {
            data = await res.json();
          } catch (err) {
            console.error("Failed to parse JSON:", err);
          }
        } else {
          const text = await res.text().catch(() => "");
          console.error("Non-JSON response from /register:", res.status, text);
        }

        if (res.ok && data && data.ok) {
          form.style.display = "none"; // Hide form
          if (thankYou) {
            thankYou.classList.remove("hidden"); // Show thank-you
          }
        } else {
          const message =
            (data && data.error) ||
            "Oops! Something went wrong. Please try again.";
          showError(message);
        }
      } catch (err) {
        console.error("Network/JS error:", err);
        showError("Network error. Please check your connection and try again.");
      }
    });
  });
</script>
