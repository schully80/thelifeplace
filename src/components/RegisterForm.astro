---
const {
  title = "Register",
  description = "Fill in your details below.",
  eventCode = "DEFAULT_EVENT",
  eventName = "Your Event",
  // Turnstile controls
  enableTurnstile = (import.meta.env.PUBLIC_ENABLE_TURNSTILE === 'true') || false,
  turnstileTheme = 'light',
  turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '',
} = Astro.props;

import Turnstile from './ui/Turnstile.astro';

 

// Dynamic CTA wording based on eventCode
function getCTA(event) {
  switch (event) {
    case "VISION_NIGHT_2025": return "Reserve My Seat";
    case "PREMARITAL_2025": return "Register as a Couple";
    case "BABY_DEDICATION_2025": return "Register My Child";
    case "TLPI_2025": return "Enroll Now";
    default: return "Save My Spot";
  }
}

const ctaLabel = getCTA(eventCode);
---

<section class="max-w-2xl mx-auto px-4 py-12">
  <header class="text-center mb-10">
    <h2 class="heading-2 text-brand-red">{title}</h2>
    <p class="mt-2 text-gray-800">{description}</p>
  </header>

  <form id="registrationForm" method="POST" action="/register" class="space-y-8">

    <!-- USER FIELDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="field">
        <input type="text" name="fullName" placeholder=" " required />
        <label>Full Name</label>
      </div>

      <div class="field">
        <input type="tel" name="contact" placeholder=" " required />
        <label>Contact Number</label>
      </div>

      <div class="field">
        <input type="email" name="email" placeholder=" " required />
        <label>Email Address</label>
      </div>

      <div class="field">
        <input type="number" name="attendees" min="1" placeholder=" " required />
        <label>Number of Persons Attending</label>
      </div>
    </div>

    <!-- ADDRESS -->
    <h3 class="text-lg font-semibold text-brand-red mt-6">Your Address</h3>
    <slot /> <!-- AddressFields.astro injected here -->

    <!-- Hidden event info -->
    <input type="hidden" name="eventCode" value={eventCode} />
    <input type="hidden" name="eventName" value={eventName} />

    <!-- Honeypot -->
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- CAPTCHA removed -->

    <!-- SUBMIT BUTTON -->
    <button
      type="submit"
      id="tlpSubmitBtn"
      disabled
      class="w-full rounded-full bg-gray-400 text-white text-lg font-semibold py-3
             disabled:opacity-60 disabled:cursor-not-allowed transition-all">
      {ctaLabel}
    </button>

    {enableTurnstile && (
      <div class="mt-4">
        <Turnstile sitekey={turnstileSiteKey} name="cf-turnstile-response" theme={turnstileTheme} />
      </div>
    )}
  </form>
</section>

{enableTurnstile && (
  <script>
    (function(){
      try {
        const form = document.getElementById('registrationForm');
        const btn = document.getElementById('tlpSubmitBtn');
        if (!form || !btn) return;

        function hasToken(){
          const input = form.querySelector('input[name="cf-turnstile-response"]');
          return input && input.value && input.value.length > 0;
        }

        const setBtn = (enabled) => {
          btn.disabled = !enabled;
          if (!enabled) {
            btn.classList.add('opacity-60','cursor-not-allowed');
            btn.setAttribute('aria-disabled','true');
          } else {
            btn.classList.remove('opacity-60','cursor-not-allowed');
            btn.removeAttribute('aria-disabled');
            try{ btn.focus(); } catch(e){}
          }
        };

        setBtn(hasToken());
        form.addEventListener('turnstile:verified', function(){ setBtn(true); });
        form.addEventListener('submit', function(e){ if (!hasToken()){ e.preventDefault(); setBtn(false); alert('Please complete the verification before submitting.'); } else { btn.setAttribute('aria-busy','true'); } });

        // Fallback: show manual-review input after short delay if no token
        setTimeout(() => {
          if (hasToken()) return;
          if (form.querySelector('[data-tlp-fallback]')) return;
          const fb = document.createElement('div');
          fb.className = 'mt-4 text-center';
          fb.setAttribute('data-tlp-fallback','1');
          fb.innerHTML = `
            <div class="text-sm text-gray-600 mb-2">Turnstile seems blocked — type <strong>human</strong> to request manual review</div>
            <input name="tlp_fallback_answer" placeholder="Type 'human'" class="px-4 py-2 rounded-md border w-64" />
            <input type="hidden" name="tlp_manual_review" value="1" />
          `;
          const container = form.querySelector('#tlpSubmitBtn')?.parentElement;
          container && container.insertAdjacentElement('afterend', fb);
          const inp = fb.querySelector('input[name="tlp_fallback_answer"]');
          inp && inp.addEventListener('input', (e) => { if ((e.target.value||'').toString().trim().toLowerCase() === 'human') setBtn(true); });
        }, 5000);
      } catch (err) { console.warn('Turnstile UX init error', err); }
    })();
  </script>
)}

<!-- Turnstile removed: submit enabled by default -->

<style>
  /* Floating label fields */
  .field {
    position: relative;
    padding-top: 1.2rem;
  }
  .field input {
    width: 100%;
    border: none;
    border-bottom: 1.5px solid #d1d5db;
    padding: 6px 2px;
    font-size: 15px;
    background: transparent;
    outline: none;
    transition: border-color .25s ease;
  }
  .field input:focus {
    border-bottom-color: #B3282D;
  }
  .field label {
    position: absolute;
    left: 2px;
    bottom: 6px;
    font-size: 15px;
    color: #9ca3af;
    pointer-events: none;
    transition: .25s ease;
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label {
    transform: translateY(-1.1rem);
    font-size: 12px;
    color: #B3282D;
  }
</style>
