---
const { url } = Astro.props;
---

<a
  href={url}
  class="fixed bottom-5 right-4 md:bottom-6 md:right-6
         z-50 rounded-full backdrop-blur-xl
         bg-white/10 border border-white/20
         shadow-lg hover:shadow-2xl
         p-3 md:p-4 transition transform hover:scale-105
         flex items-center justify-center"
  aria-label="Chat with us on WhatsApp"
  target="_blank"
  rel="noopener noreferrer"
>
  <!-- WhatsApp Icon (inline SVG, CSP-safe) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-6 w-6 md:h-8 md:w-8 text-[#25D366]"
    fill="currentColor"
    viewBox="0 0 24 24"
  >
    <path d="M12.04 2C6.58 2 2.21 6.37 2.21 11.82c0 2.09.62 4.02 1.69 5.65L2 22l4.69-1.85c1.58.87 3.4 1.37 5.35 1.37 5.46 0 9.83-4.37 9.83-9.82C21.87 6.37 17.5 2 12.04 2zm0 17.86c-1.72 0-3.32-.5-4.66-1.36l-.33-.2-2.78 1.1.74-2.89-.19-.3a8.5 8.5 0 0 1-1.32-4.47c0-4.7 3.83-8.52 8.54-8.52 4.7 0 8.53 3.82 8.53 8.52 0 4.7-3.83 8.52-8.53 8.52zm4.72-5.7c-.26-.13-1.53-.76-1.77-.84-.24-.09-.42-.13-.6.13-.18.26-.69.84-.84 1.02-.15.17-.31.19-.57.06-.26-.13-1.07-.4-2.04-1.26-.75-.67-1.26-1.5-1.41-1.75-.15-.26-.02-.4.11-.53.11-.1.26-.27.39-.4.13-.13.17-.22.26-.37.09-.15.04-.28-.02-.4-.06-.13-.6-1.43-.82-1.96-.22-.53-.45-.46-.6-.46h-.51c-.17 0-.4.06-.61.28-.2.22-.8.78-.8 1.9 0 1.12.82 2.2.94 2.36.11.17 1.62 2.62 3.95 3.67 2.33 1.06 2.33.71 2.75.66.42-.04 1.35-.55 1.54-1.08.19-.53.19-.99.13-1.09-.06-.09-.24-.15-.5-.28z"/>
