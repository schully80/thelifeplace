---
export interface Props {
  title: string;
  thumbnail: string;
  videoId: string;
  description?: string;
}

const { title, thumbnail, videoId, description = "" } = Astro.props;
const { message } = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 py-10">
  <a
    href={`/messages/watch/${videoId}`}
    class="group block rounded-3xl overflow-hidden shadow-lg bg-white border"
  >
    <div class="relative">
      <img
        src={thumbnail}
        alt={title}
        class="w-full h-[380px] object-cover transition-transform duration-500 group-hover:scale-105"
      />

      <!-- Overlay gradient -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>

      <!-- Text -->
      <div class="absolute bottom-6 left-6 text-white max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold mb-2">
          {title}
        </h2>
        <p class="hidden sm:block text-gray-200 text-lg line-clamp-2">
          {description}
        </p>
      </div>
    </div>
  </a>
<a href={`/messages/watch/${message.id}`} class="group block mt-10">
  <div class="overflow-hidden rounded-2xl shadow-lg bg-white border">
    <img src={message.thumbnail} alt={message.title} class="w-full h-72 object-cover group-hover:scale-105 transition" />
  </div>

  <h2 class="mt-4 text-2xl font-bold text-gray-900 group-hover:text-brand-red">
    {message.title}
  </h2>

  <p class="mt-2 text-gray-600">{message.preacher} — {new Date(message.date).toLocaleDateString()}</p>
</a>

</section>
