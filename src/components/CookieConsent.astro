<style>
  .cc-bar {
    position: fixed;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1.5rem);
    z-index: 45;
    display: none;
    width: min(calc(100vw - 3rem), 45rem);
    padding: 2rem;
    color: oklch(0.98 0.005 30);
    background: oklch(0.20 0.012 25);
    border: 1px solid oklch(0.35 0.012 25);
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(23, 23, 23, 0.24);
    transform: translateX(-50%);
  }

  .cc-bar.show { display: block; }
  .cc-inner { display: flex; align-items: center; gap: 3rem; }

  .cc-text {
    flex: 1;
    margin: 0;
    color: inherit;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .cc-link {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .cc-link:hover { color: oklch(0.98 0.005 30); }

  .cc-ok {
    flex: none;
    width: 7.125rem;
    min-height: 5.25rem;
    padding: 0.75rem 1rem;
    color: oklch(0.98 0.005 30);
    font: inherit;
    font-size: 1.25rem;
    font-weight: 800;
    cursor: pointer;
    background: var(--tlp-color-brand-red);
    border: 1px solid var(--tlp-color-brand-red);
    border-radius: 9999px;
    transition: background-color 180ms ease-out, border-color 180ms ease-out, transform 180ms ease-out;
  }

  .cc-ok:hover { background: var(--tlp-color-brand-red-hover); border-color: var(--tlp-color-brand-red-hover); }
  .cc-ok:active { transform: scale(0.98); }
  .cc-ok:focus-visible { outline: 2px solid var(--tlp-color-brand-red); outline-offset: 3px; }

  @media (max-width: 639px) {
    .cc-bar { bottom: calc(env(safe-area-inset-bottom, 0px) + 5.5rem); width: calc(100vw - 1.5rem); padding: 1.25rem; }
    .cc-inner { align-items: flex-end; gap: 1rem; }
    .cc-text { font-size: 0.9375rem; }
    .cc-ok { width: auto; min-width: 4rem; min-height: 3rem; font-size: 0.9375rem; }
  }

  @media (min-width: 640px) {
    .cc-bar {
      right: 1rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 6rem);
      left: auto;
      width: min(calc(100vw - 2rem), 32rem);
      padding: 1.25rem;
      transform: none;
    }

    .cc-inner { gap: 1.25rem; }
    .cc-text { font-size: clamp(0.9375rem, 1vw, 1rem); }
    .cc-ok { width: 4.5rem; min-height: 3.25rem; font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) { .cc-ok { transition: none; } }
</style>

<div id="cookie-consent" class="cc-bar" role="dialog" aria-live="polite" aria-label="Cookie notice">
  <div class="cc-inner">
    <p class="cc-text">
      We use cookies to personalize your experience. By using our website, you accept our use of cookies as described in our&nbsp;<a class="cc-link" href="/privacy-policy/">Privacy Policy</a>.
    </p>
    <button id="cc-ok" class="cc-ok" type="button">Ok</button>
  </div>
</div>

<script is:inline>
  (function () {
    const KEY = 'tlp_cookie_consent';
    const bar = document.getElementById('cookie-consent');
    if (!bar) return;

    try {
      const stored = localStorage.getItem(KEY);
      if (!stored) {
        bar.classList.add('show');
        document.documentElement.classList.add('cookie-consent-visible');
      } else {
        document.documentElement.dataset.cookieConsent = stored;
      }
    } catch (_) { /* Ignore unavailable storage. */ }

    function acceptCookies() {
      try {
        localStorage.setItem(KEY, 'accepted');
        document.documentElement.dataset.cookieConsent = 'accepted';
      } catch (_) { /* Ignore unavailable storage. */ }
      bar.classList.remove('show');
      document.documentElement.classList.remove('cookie-consent-visible');
      window.dispatchEvent(new CustomEvent('cookie-consent', { detail: 'accepted' }));
    }

    document.getElementById('cc-ok')?.addEventListener('click', acceptCookies);
  })();
</script>
