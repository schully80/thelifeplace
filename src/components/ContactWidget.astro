---
/**
 * ContactWidget.astro
 * Centralized widget settings for mobile, tablet, and desktop
 * Controls responsive layout and display logic
 */

const {
  whatsapp = "27765639460",
  email = "hello@thelifeplace.org",
  mapsUrl = "https://www.google.com/maps/place/The+Life+Place/",
  mobileStyle = "fab", // "fab" or "dock"
  tabletStyle = "dock", // "fab" or "dock" or "hidden"
  desktopStyle = "fab" // "fab" or "dock" or "hidden"
} = Astro.props;

const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent(
  "Hi The Life Place, I'd love to get in touch."
)}`;
const waAppUrl = `whatsapp://send?phone=${whatsapp}&text=${encodeURIComponent(
  "Hi The Life Place, I'd love to get in touch."
)}`;

const mailUrl = `mailto:${email}`;

// Determine visibility classes
const getMobileClass = (style: string) => style !== "hidden" ? "md:hidden" : "hidden md:block";
const getTabletClass = (style: string) => style !== "hidden" ? "hidden md:block xl:hidden" : "md:hidden";
const getDesktopClass = (style: string) => style !== "hidden" ? "hidden xl:block" : "xl:hidden";
---

<style>
  /* Tooltip Styles */
  .dock-tooltip {
    @apply absolute right-full top-1/2 -translate-y-1/2 mr-3 
           px-4 py-1 rounded-full
           text-sm font-medium bg-black text-white
           shadow-md whitespace-nowrap opacity-0 translate-x-2
           pointer-events-none transition-[opacity,transform] duration-300 z-50;
  }

  .dock-item:hover .dock-tooltip {
    @apply opacity-100 translate-x-0;
  }

  /* Contact Button Base Styles */
  .contact-btn {
    @apply flex h-12 w-12 items-center justify-center rounded-full
           bg-black shadow-md transition-[background-color,transform] duration-150 ease-out hover:bg-brand-red active:scale-[0.97];
  }

  .contact-item-label {
    @apply text-xs font-semibold text-gray-800 mt-1 text-center whitespace-nowrap;
  }

  /* FAB Styles */
  .fab-button {
    @apply w-14 h-14 rounded-full bg-brand-red flex items-center justify-center
           shadow-lg hover:shadow-xl transition-[box-shadow,transform] hover:scale-110 duration-300;
  }

  .fab-button.hidden {
    @apply opacity-0 pointer-events-none scale-0;
  }

  .fab-icon {
    @apply h-7 w-7 text-white transition-transform duration-300;
  }

  @media (max-width: 767px) {
    /* Smaller icon to balance the 48px mobile FAB */
    .fab-icon {
      @apply h-6 w-6;
    }
  }

  .fab-icon.open {
    @apply rotate-45;
  }

  /* Dock Styles */
  .dock-container {
    position: fixed;
    right: calc(env(safe-area-inset-right, 0px) + 1rem);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Contact Buttons Container for FAB */
  .contact-buttons {
    position: fixed;
    right: calc(env(safe-area-inset-right, 0px) + 1rem);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.75rem;
    transition:
      opacity 220ms var(--ease-out-strong),
      transform 220ms var(--ease-out-strong);
  }

  .contact-buttons.hidden {
    @apply opacity-0 pointer-events-none;
    transform: translateY(0.5rem) scale(0.98);
  }

  .contact-buttons.visible {
    @apply opacity-100 pointer-events-auto;
    transform: translateY(0) scale(1);
  }

  .chat-bubble.contact-fab-anchor {
    right: calc(env(safe-area-inset-right, 0px) + 1rem);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
  }
</style>

<!-- MOBILE: FAB + Expandable Buttons -->
<div class={`${getMobileClass(mobileStyle)} md:hidden`}>
  {mobileStyle === "fab" && (
    <Fragment>
      <!-- FAB Button -->
      <button
        id="contactFAB"
        type="button"
        aria-label="Open contact options"
        aria-controls="contactButtons"
        aria-expanded="false"
        class="chat-bubble contact-fab-anchor z-50"
      >
        <svg id="fabIcon" class="fab-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
        </svg>
      </button>

      <!-- Contact Buttons -->
      <div id="contactButtons" class="contact-buttons hidden" role="menu" aria-label="Contact options">
        <!-- WhatsApp -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-btn js-whatsapp-link"
            role="menuitem"
            aria-label="Chat on WhatsApp"
            data-wa-app-url={waAppUrl}
            data-wa-web-url={waUrl}
          >
            <img src="/whatsapp.svg" alt="WhatsApp" class="h-6 w-6 invert" />
          </a>
          <span class="contact-item-label">WhatsApp</span>
        </div>

        <!-- Email -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a href={mailUrl} class="contact-btn" role="menuitem" aria-label="Send an email">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="currentColor">
              <path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
            </svg>
          </a>
          <span class="contact-item-label">Email</span>
        </div>

        <!-- Location -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-btn" role="menuitem" aria-label="Get directions">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/>
            </svg>
          </a>
          <span class="contact-item-label">Find us</span>
        </div>
      </div>
    </Fragment>
  )}

  {mobileStyle === "dock" && (
    <div class="dock-container">
      <!-- WhatsApp -->
      <div class="dock-item relative flex items-center z-10">
        <div class="dock-tooltip">WhatsApp Us</div>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-btn js-whatsapp-link"
          data-wa-app-url={waAppUrl}
          data-wa-web-url={waUrl}
        >
          <img src="/whatsapp.svg" alt="WhatsApp" class="h-6 w-6 invert" />
        </a>
      </div>

      <!-- Email -->
      <div class="dock-item relative flex items-center z-10">
        <div class="dock-tooltip">Email us</div>
        <a href={mailUrl} class="contact-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="currentColor">
            <path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
          </svg>
        </a>
      </div>

      <!-- Location -->
      <div class="dock-item relative flex items-center z-10">
        <div class="dock-tooltip">Find us</div>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-btn">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/>
          </svg>
        </a>
      </div>
    </div>
  )}
</div>

<!-- TABLET: Dock or FAB -->
