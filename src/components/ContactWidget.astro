          class="fab-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"
          />
        </svg>
      </button>

      <!-- Contact Buttons -->
      <div id="contactButtonsTablet" class="contact-buttons hidden" role="menu" aria-label="Contact options">
        <!-- WhatsApp -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-btn js-whatsapp-link"
            role="menuitem"
            aria-label="Chat on WhatsApp"
            data-wa-app-url={waAppUrl}
            data-wa-web-url={waUrl}
          >
            <img src="/whatsapp.svg" alt="WhatsApp" class="h-6 w-6 invert" />
          </a>
          <span class="contact-item-label">WhatsApp</span>
        </div>

        <!-- Email -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a href={mailUrl} class="contact-btn" role="menuitem" aria-label="Send an email">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="currentColor">
              <path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
            </svg>
          </a>
          <span class="contact-item-label">Email</span>
        </div>

        <!-- Location -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-btn" role="menuitem" aria-label="Get directions">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/>
            </svg>
          </a>
          <span class="contact-item-label">Find us</span>
        </div>
      </div>
    </Fragment>
  )}

  {tabletStyle === "dock" && (
    <div class="dock-container">
      <!-- WhatsApp -->
      <div class="dock-item relative flex items-center z-10">
        <div class="dock-tooltip">WhatsApp Us</div>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-btn js-whatsapp-link"
          data-wa-app-url={waAppUrl}
          data-wa-web-url={waUrl}
        >
          <img src="/whatsapp.svg" alt="WhatsApp" class="h-6 w-6 invert" />
        </a>
      </div>

      <!-- Email -->
      <div class="dock-item relative flex items-center z-10">
        <div class="dock-tooltip">Email us</div>
        <a href={mailUrl} class="contact-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="currentColor">
            <path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
          </svg>
        </a>
      </div>

      <!-- Location -->
      <div class="dock-item relative flex items-center z-10">
        <div class="dock-tooltip">Find us</div>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-btn">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/>
          </svg>
        </a>
      </div>
    </div>
  )}
</div>

<!-- DESKTOP: FAB or Dock -->
<div class={`${getDesktopClass(desktopStyle)}`}>
  {desktopStyle === "fab" && (
    <Fragment>
      <!-- FAB Button -->
      <button
        id="contactFABDesktop"
        type="button"
        aria-label="Open contact options"
        aria-controls="contactButtonsDesktop"
        aria-expanded="false"
        class="chat-bubble contact-fab-anchor z-50"
      >
        <svg id="fabIconDesktop" class="fab-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
        </svg>
      </button>

      

      <!-- Contact Buttons -->
      <div id="contactButtonsDesktop" class="contact-buttons hidden" role="menu" aria-label="Contact options">
        <!-- WhatsApp -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-btn js-whatsapp-link"
            role="menuitem"
            aria-label="Chat on WhatsApp"
            data-wa-app-url={waAppUrl}
            data-wa-web-url={waUrl}
          >
            <img src="/whatsapp.svg" alt="WhatsApp" class="h-6 w-6 invert" />
          </a>
          <span class="contact-item-label">WhatsApp</span>
        </div>

        <!-- Email -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a href={mailUrl} class="contact-btn" role="menuitem" aria-label="Send an email">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="currentColor">
              <path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v12h16V6z"/>
            </svg>
          </a>
          <span class="contact-item-label">Email</span>
        </div>

        <!-- Location -->
        <div class="dock-item relative flex flex-col items-center z-10">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-btn" role="menuitem" aria-label="Get directions">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/>
            </svg>
          </a>
          <span class="contact-item-label">Find us</span>
        </div>
      </div>
    </Fragment>
  )}
</div>

<script is:inline>
  (function() {
    const isPhone = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent || "");
    if (!isPhone) return;

    document.querySelectorAll(".js-whatsapp-link").forEach((link) => {
      link.addEventListener("click", (event) => {
        const appUrl = link.getAttribute("data-wa-app-url");
        const webUrl = link.getAttribute("data-wa-web-url") || link.getAttribute("href");
        if (!appUrl || !webUrl) return;

        event.preventDefault();
        window.setTimeout(() => {
          window.location.href = webUrl;
        }, 900);
        window.location.href = appUrl;
      });
    });
  })();

  // Mobile FAB Handler
  (function() {
    const fab = document.getElementById("contactFAB");
    const fabIcon = document.getElementById("fabIcon");
    const buttons = document.getElementById("contactButtons");

    if (!fab || !buttons) return;

    let isOpen = false;
    let closeTimeout;

    const closeFAB = () => {
      isOpen = false;
      fab.setAttribute("aria-expanded", false);
      fabIcon.classList.remove("open");
      buttons.classList.add("hidden");
      fab.classList.remove("hidden");
      clearTimeout(closeTimeout);
    };

    const openFAB = () => {
      isOpen = true;
      fab.setAttribute("aria-expanded", true);
      fabIcon.classList.add("open");
      buttons.classList.remove("hidden");
      fab.classList.add("hidden");
      
      // Auto-close after 5 seconds
      clearTimeout(closeTimeout);
      closeTimeout = setTimeout(closeFAB, 5000);
    };

    fab.addEventListener("click", (e) => {
      e.stopPropagation();
      isOpen ? closeFAB() : openFAB();
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (isOpen && !buttons.contains(e.target) && !fab.contains(e.target)) {
        closeFAB();
      }
    });

    // Close on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeFAB();
      }
    });

    // Close on button click
    buttons.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeFAB);
    });
  })();

  // Tablet FAB Handler
  (function() {
    const fab = document.getElementById("contactFABTablet");
    const fabIcon = document.getElementById("fabIconTablet");
    const buttons = document.getElementById("contactButtonsTablet");

    if (!fab || !buttons) return;

    let isOpen = false;
    let closeTimeout;

    const closeFAB = () => {
      isOpen = false;
      fab.setAttribute("aria-expanded", false);
      fabIcon.classList.remove("open");
      buttons.classList.add("hidden");
      fab.classList.remove("hidden");
      clearTimeout(closeTimeout);
    };

    const openFAB = () => {
      isOpen = true;
      fab.setAttribute("aria-expanded", true);
      fabIcon.classList.add("open");
      buttons.classList.remove("hidden");
      fab.classList.add("hidden");
      
      // Auto-close after 5 seconds
      clearTimeout(closeTimeout);
      closeTimeout = setTimeout(closeFAB, 5000);
    };

    fab.addEventListener("click", (e) => {
      e.stopPropagation();
      isOpen ? closeFAB() : openFAB();
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (isOpen && !buttons.contains(e.target) && !fab.contains(e.target)) {
        closeFAB();
      }
    });

    // Close on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeFAB();
      }
    });

    // Close on button click
    buttons.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeFAB);
    });
  })();

  // Desktop FAB Handler
  (function() {
    const fab = document.getElementById("contactFABDesktop");
    const fabIcon = document.getElementById("fabIconDesktop");
    const buttons = document.getElementById("contactButtonsDesktop");

    if (!fab || !buttons) return;

    let isOpen = false;
    let closeTimeout;

    const closeFAB = () => {
      isOpen = false;
      fab.setAttribute("aria-expanded", false);
      fabIcon.classList.remove("open");
      buttons.classList.add("hidden");
      fab.classList.remove("hidden");
      clearTimeout(closeTimeout);
    };

    const openFAB = () => {
      isOpen = true;
      fab.setAttribute("aria-expanded", true);
      fabIcon.classList.add("open");
      buttons.classList.remove("hidden");
      fab.classList.add("hidden");
      
      // Auto-close after 5 seconds
      clearTimeout(closeTimeout);
      closeTimeout = setTimeout(closeFAB, 5000);
    };

    fab.addEventListener("click", (e) => {
      e.stopPropagation();
      isOpen ? closeFAB() : openFAB();
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (isOpen && !buttons.contains(e.target) && !fab.contains(e.target)) {
        closeFAB();
      }
    });

    // Close on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeFAB();
      }
    });

    // Close on button click
    buttons.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeFAB);
    });
  })();
</script>
