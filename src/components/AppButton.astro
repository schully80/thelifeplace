---
/**
 * SITE-WIDE FLOATING APP BUTTON
 * Appears on every page (once added to BaseLayout)
 */

const APP_READY = false; // Change to true when App Store links go live
---

<a
  href={APP_READY ? "/app" : "#"}
  class={`fixed bottom-6 right-6 z-50 px-5 py-3 rounded-full backdrop-blur-xl shadow-xl 
          cine-zoom-apple-hover border border-white/30 ring-1 ring-brand-red transition
          ${APP_READY 
            ? "bg-brand-red text-white hover:bg-red-700 cursor-pointer" 
            : "bg-gray-200/80 text-gray-600 cursor-not-allowed opacity-80"}`}
>
  {APP_READY ? "Get the App" : "App Coming Soon"}
</a>
