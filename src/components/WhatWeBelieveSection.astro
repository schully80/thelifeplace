<style>
  .accordion-item {
    display: flex;
    flex-direction: column;
  }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 260ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 200ms ease;
    display: block;
    opacity: 0;
  }

  .accordion-item.active .accordion-content {
    max-height: 600px;
    opacity: 1;
  }

  .accordion-item.active .accordion-icon::before {
    content: '-';
  }

  .accordion-icon::before {
    content: '+';
  }

  /* Accessible focus ring for keyboard users */
  .accordion-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.12);
    border-radius: 0.5rem;
  }
</style>

<script>
  function setupAccordions() {
    const items = document.querySelectorAll<HTMLElement>('.accordion-item');
    
    // Define accordion pairs
    const pairs: [string, string][] = [
      ['GOD', 'JESUS'],
      ['HOLY SPIRIT', 'CREATION'],
      ['HUMANITY', 'SIN'],
      ['THE BIBLE', 'SALVATION'],
      ['THE RESURRECTION OF JESUS', 'THE CHURCH'],
      ['MARRIAGE AND FAMILY', 'BAPTISM AND COMMUNION'],
      ['TITHES AND OFFERINGS', 'HEAVEN'],
      ['HELL', 'THE RETURN OF JESUS'],
      ['LAST THINGS', 'ALL THINGS MADE NEW']
    ];
    
    // Create a map of item name to pair items
    const pairMap = new Map<HTMLElement, HTMLElement[]>();
    pairs.forEach((pair) => {
      const item1 = Array.from(items).find((item) => item.querySelector('.accordion-btn span')?.textContent === pair[0]);
      const item2 = Array.from(items).find((item) => item.querySelector('.accordion-btn span')?.textContent === pair[1]);
      
      if (item1) pairMap.set(item1, [item1, item2].filter(Boolean) as HTMLElement[]);
      if (item2) pairMap.set(item2, [item1, item2].filter(Boolean) as HTMLElement[]);
    });
    
    items.forEach((item, idx) => {
      const btn = item.querySelector<HTMLButtonElement>('.accordion-btn');
      const content = item.querySelector<HTMLElement>('.accordion-content');
      if (!btn) return;

      // Ensure button behaves correctly and is keyboard accessible
      btn.type = 'button';

      // Assign accessible ids and attributes
      const contentId = content && content.id ? content.id : `accordion-content-${idx}`;
      if (content && !content.id) content.id = contentId;
      btn.setAttribute('aria-controls', contentId);
      btn.setAttribute('aria-expanded', 'false');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const pairedItems = pairMap.get(item);

        if (pairedItems) {
          const isActive = pairedItems[0].classList.contains('active');

          if (isActive) {
            // Close both
            pairedItems.forEach((paired) => {
              paired.classList.remove('active');
              const b = paired.querySelector<HTMLElement>('.accordion-btn');
              if (b) b.setAttribute('aria-expanded', 'false');
            });
          } else {
            // Open both
            pairedItems.forEach((paired) => {
              paired.classList.add('active');
              const b = paired.querySelector<HTMLElement>('.accordion-btn');
              if (b) b.setAttribute('aria-expanded', 'true');
            });
          }
        } else {
          // If no pair, toggle independently
          const willBeActive = !item.classList.contains('active');
          item.classList.toggle('active');
          btn.setAttribute('aria-expanded', willBeActive ? 'true' : 'false');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAccordions);
  } else {
    setupAccordions();
  }
</script>
