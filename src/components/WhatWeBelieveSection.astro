---
const beliefGroups = [
  {
    title: "God and Gospel",
    summary: "God is triune, Jesus is central, grace is the ground of salvation.",
    items: [
      {
        title: "God",
        body: "We believe in one God, eternally existing in three persons: Father, Son, and Holy Spirit. The Father is the source of all life, the Son is our Saviour and Lord, and the Holy Spirit gives new life and power. To Him alone belongs all honour, praise, and worship forever.",
        references: "Genesis 1:1; Deuteronomy 6:4; Matthew 28:19; John 1:1-3, 14; 2 Corinthians 13:14",
      },
      {
        title: "Jesus",
        body: "We believe the eternal Son became fully man without ceasing to be fully God. We affirm His virgin birth and His sinless life. We believe His incarnation is relevant to every culture, age, and human condition.",
        references: "John 1:14; Romans 1:3-4; Galatians 4:4; Isaiah 7:14; Luke 1:35",
      },
      {
        title: "Holy Spirit",
        body: "We believe the Holy Spirit is God, co-equal with the Father and the Son. He convicts of sin, regenerates hearts, indwells believers, produces spiritual fruit, and empowers the Church for witness and service.",
        references: "Romans 8:26-27; John 14:16-17, 26; 2 Corinthians 3:17-18; Galatians 5:22-23; Acts 1:8",
      },
      {
        title: "The Gospel",
        body: "We believe the gospel is the good news of Jesus Christ: that He lived a perfect life, died on the cross for our sins, rose from the dead, and offers salvation to all who repent and believe in Him.",
        references: "1 Corinthians 15:1-4; Romans 1:16; Mark 1:15; John 3:16",
      },
      {
        title: "The Bible",
        body: "We believe the Bible is God's written word, fully inspired, enduring forever, true, and without error. We believe it is understood by the Spirit's illumination and is relevant to every culture, age, and human condition.",
        references: "2 Timothy 3:16; Psalm 119:89; John 17:17; 1 Corinthians 2:12-13",
      },
      {
        title: "Salvation",
        body: "We believe salvation is by grace alone, through faith alone, in Christ alone. It is the free gift of God, not earned by works or human effort. All who repent and believe in Him are forgiven, justified, and given eternal life.",
        references: "Ephesians 2:8-9; Romans 3:28; Acts 4:12",
      },
      {
        title: "The Resurrection of Jesus",
        body: "We believe Jesus was crucified, buried, and rose bodily from the dead on the third day. His resurrection is the cornerstone of our faith and the assurance of our eternal hope.",
        references: "Luke 24:6-7; Romans 4:25; 1 Corinthians 15:3-4, 14",
      },
    ],
  },
  {
    title: "Church and Life",
    summary: "The gospel forms people, families, worship, generosity, and life together.",
    items: [
      {
        title: "Creation",
        body: "We believe God created the universe and affirm the historic truth of Genesis, including Adam and Eve, the fall, the flood, and the tower of Babel.",
        references: "Genesis 1-11",
      },
      {
        title: "Humanity",
        body: "We believe every human being is made in the image of God. We believe God created humanity as male and female. We believe all humanity is fallen through sin but redeemed through Christ's death and resurrection.",
        references: "Genesis 1:26-28; 5:1-3; Ephesians 4:22-23; Hebrews 4:12; 1 Thessalonians 5:23",
      },
      {
        title: "Sin",
        body: "We believe sin is the fallen state of creation. Through the disobedience of Adam and Eve, sin entered the world, and all humanity has been affected. Sin brings death, but through repentance and faith we are reconciled to God.",
        references: "Romans 3:23; Ephesians 2:13-14; 1 John 1:8-9",
      },
      {
        title: "The Church",
        body: "We believe all believers form one body, the Church. We believe the local church gathers for worship, teaching, and mission.",
        references: "Romans 12:4-5; 1 Corinthians 12:12, 27; Acts 2:46-47",
      },
      {
        title: "Marriage and Family",
        body: "We uphold the biblical and orthodox view of marriage between a man and a woman. We believe marriage is the foundation of any society and that sexual activity belongs within lawful matrimony.",
        references: "Genesis 2:21-25; Ephesians 5:28-33",
      },
      {
        title: "Baptism and Communion",
        body: "We believe baptism and communion are ordinances given by Christ. Baptism testifies to new life in Him. Communion remembers His body broken and His blood shed for our salvation.",
        references: "Matthew 28:19; Luke 22:19-20; 1 Corinthians 11:23-26",
      },
      {
        title: "Tithes and Offerings",
        body: "We believe giving is an act of worship. We believe tithes and offerings honour Jesus, support His work, and express gratitude for His provision.",
        references: "Proverbs 3:9-10; Malachi 3:10; 2 Corinthians 9:6-7",
      },
    ],
  },
  {
    title: "Hope and Future",
    summary: "Christ will return, evil will be judged, and God will make all things new.",
    items: [
      {
        title: "Heaven",
        body: "We believe Heaven is God's dwelling place and the eternal home of believers.",
        references: "Hebrews 11:6, 15-16; Ephesians 1:20; Hebrews 3:11",
      },
      {
        title: "Hell",
        body: "We believe Hell is the eternal place of punishment for satan, demons, and those who reject God's love.",
        references: "Matthew 13:42; Mark 9:43-47; Revelation 20:10, 14",
      },
      {
        title: "The Return of Jesus",
        body: "We believe Jesus will return personally, visibly, and gloriously to judge, rule, and reign.",
        references: "Acts 1:11; 1 Thessalonians 4:16-17; Revelation 22:12",
      },
      {
        title: "Last Things",
        body: "We believe God will bring history to its rightful conclusion with Christ's triumph over all evil, the final judgment, and the renewal of all things.",
        references: "Matthew 24:30-31; Revelation 20:11-15",
      },
      {
        title: "All Things Made New",
        body: "We believe God will make all things new, a new heavens and new earth where righteousness dwells. Believers will receive glorified, imperishable bodies, transformed into the likeness of Christ's glorious body.",
        references: "Isaiah 65:17; 2 Peter 3:13; Revelation 21:1-4",
      },
    ],
  },
];
---

<section class="bg-gray-50 py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Our Beliefs</p>
      <h2 class="mt-4 text-3xl md:text-5xl font-black leading-tight text-gray-800">A faith with a clear center.</h2>
      <p class="mt-5 text-lg md:text-xl leading-relaxed text-gray-600">
        Our worship, teaching, prayer, and mission have a doctrinal spine: Jesus at the center, grace as the story, and the Spirit at work today.
      </p>
    </div>

    <div class="mt-12 space-y-10">
      {beliefGroups.map((group, groupIndex) => (
        <section class="grid gap-5 lg:grid-cols-[minmax(0,0.42fr)_minmax(0,1fr)] lg:gap-10" aria-labelledby={`belief-group-${groupIndex}`}>
          <div class="lg:pt-4">
            <h3 id={`belief-group-${groupIndex}`} class="text-2xl md:text-3xl font-black text-gray-800">
              {group.title}
            </h3>
            <p class="mt-3 max-w-md text-base leading-relaxed text-gray-600">{group.summary}</p>
          </div>

          <div class="grid grid-cols-1 gap-3 items-start">
            {group.items.map((item, itemIndex) => {
              const contentId = `belief-${groupIndex}-${itemIndex}`;
              return (
                <article class="accordion-item overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-[border-color,box-shadow] duration-200 hover:border-brand-red/30 hover:shadow-md">
                  <button
                    class="accordion-btn flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-base md:text-lg font-bold text-gray-800 transition-colors duration-200 hover:text-brand-red"
                    type="button"
                    aria-controls={contentId}
                    aria-expanded="false"
                  >
                    <span>{item.title}</span>
                    <span class="accordion-icon text-2xl text-brand-red leading-none font-light" aria-hidden="true"></span>
                  </button>
                  <div id={contentId} class="accordion-content">
                    <div class="px-5 pb-5 pt-0 text-base leading-relaxed text-gray-600">
                      <p>{item.body}</p>
                      <p class="mt-4 text-sm leading-relaxed text-gray-500">{item.references}</p>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .accordion-content {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 260ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 200ms ease;
  }

  .accordion-item.active .accordion-content {
    max-height: 620px;
    opacity: 1;
  }

  .accordion-item.active .accordion-icon::before {
    content: '-';
  }

  .accordion-icon::before {
    content: '+';
  }

  .accordion-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 4px rgba(179, 40, 45, 0.16);
    border-radius: 0.75rem;
  }
</style>

<script>
  function setupAccordions() {
    const items = document.querySelectorAll<HTMLElement>('.accordion-item');

    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('.accordion-btn');
      if (!btn) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const willBeActive = !item.classList.contains('active');

        items.forEach((otherItem) => {
          const otherBtn = otherItem.querySelector<HTMLElement>('.accordion-btn');
          otherItem.classList.remove('active');
          otherBtn?.setAttribute('aria-expanded', 'false');
        });

        if (willBeActive) {
          item.classList.add('active');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAccordions);
  } else {
    setupAccordions();
  }
</script>
