---
import "../styles/global.css";
import "../styles/global-interactions.css";
import CookieConsent from "../components/CookieConsent.astro";
import HeaderMobile from "../components/HeaderMobile.astro";
import HeaderDesktop from "../components/HeaderDesktop.astro";
import HeaderLaptop from "../components/HeaderLaptop.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import HeaderTablet from "../components/HeaderTablet.astro";
import Footer from "../components/Footer.astro";
import AppButton from "../components/AppButton.astro";

const {
  title = "The Life Place — Come. See. Jesus. | Craigavon, Sandton",
  description = "The Life Place — Come. See. Jesus. A church in Craigavon AH, Sandton. Join us Sundays 9:00–11:00. Plan a visit, get directions, watch messages, and take your next step.",
  noindex = false, // set true on utility pages like /thank-you/, /search/, /register-error/
} = Astro.props;

const path = Astro.url.pathname;
const whatsappNumber = "27765639460";
const whatsappMessage = "Hi The Life Place, I'd love to get in touch.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  whatsappMessage
)}`;

const siteUrl = "https://thelifeplace.org";

const { pathname } = Astro.url;
const canonicalUrl =
  pathname === "/" ? "https://thelifeplace.org" : `https://thelifeplace.org${pathname}`;
---
<!DOCTYPE html>
<html lang="en" class="min-h-screen">

  <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />

    <!-- ✅ SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Open Graph (Social Sharing) -->
    <meta property="og:site_name" content="The Life Place" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://thelifeplace.org/logo.png" />
    <meta property="og:image:alt" content="The Life Place - Come. See. Jesus." />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://thelifeplace.org/logo.png" />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#B3282D" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicon & Web App -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />

  <!-- Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <!-- Icons -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    crossorigin="anonymous"
  />

<!-- Inject env variable for client scripts -->
<script is:inline>
  window.PUBLIC_GOOGLE_PLACES_KEY = "{import.meta.env.PUBLIC_GOOGLE_PLACES_KEY}";
</script>

<!-- Load Maps JS with Places + callback -->
<script
  src={`https://maps.googleapis.com/maps/api/js?key=${import.meta.env.PUBLIC_GOOGLE_PLACES_KEY}&callback=initMap&libraries=places&v=weekly`}
  async defer
></script>

<!-- ✅ Schema -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Church", "Organization"],
  "@id": "https://thelifeplace.org/#church",
  "name": "The Life Place",
  "url": "https://thelifeplace.org",
  "slogan": "Come. See. Jesus.",
  "description": "The Life Place is a church in Craigavon AH, Sandton. Join us Sundays 9:00–11:00 for worship, prayer, and community. Experience Jesus in our welcoming congregation.",
  "telephone": "+27 76 563 9460",
  "email": "hello@thelifeplace.org",
  "image": "https://thelifeplace.org/logo.png",
  "areaServed": ["Sandton", "Johannesburg", "South Africa"],
  "potentialAction": [
    {
      "@type": "JoinAction",
      "target": "https://thelifeplace.org/visit"
    },
    {
      "@type": "DonateAction",
      "target": "https://thelifeplace.org/give"
    }
  ],
  "sameAs": [
    "https://facebook.com/thelifeplacesa",
    "https://instagram.com/thelifeplacesa",
    "https://youtube.com/@thelifeplacesa"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1251 Villa Monte Catini, 1 Elm Avenue",
    "addressLocality": "Craigavon AH, Sandton",
    "postalCode": "2191",
    "addressCountry": "ZA"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Sunday",
      "opens": "09:00",
      "closes": "11:00"
    }
  ]
}
    </script>
</head>

  <body class="min-h-screen flex flex-col bg-white antialiased">

  <div
  id="tlpLiveRibbon"
  class="hidden fixed top-0 left-0 right-0 z-[99999]
         bg-red-600 text-white text-center py-2 font-semibold shadow-lg
         animate-[pulse_2s_ease-in-out_infinite]"
>
  🔴 We Are Live Now — <a href="/live/" class="underline">Join the Stream</a>
</div>

<script is:inline>
  document.addEventListener("tlp-live-updated", (e) => {
    const ribbon = document.getElementById("tlpLiveRibbon");
    ribbon.classList.toggle("hidden", !e.detail);
  });
</script>

<style>
@keyframes pulse {
  0% { opacity: .7; }
  50% { opacity: 1; }
  100% { opacity: .7; }
}
</style>


    <!-- ⭐ PREMIUM APPLE-STYLE SCROLL BARS -->
    <div id="scroll-progress-top"
         class="fixed top-2 left-0 h-[3px] w-0 z-[9999]
                rounded-full transition-all duration-200
                bg-gray-400"></div>

    <div id="scroll-progress-side-wrapper"
         class="fixed top-1/2 right-2 -translate-y-1/2 z-[9999] opacity-0 
                transition-opacity duration-300 pointer-events-none">
      <div id="scroll-progress-side"
           class="w-[3px] h-0 rounded-full bg-gray-400
                  transition-all duration-200"></div>
    </div>

    <!-- SPLASH SCREEN (homepage only) -->
    {path === "/" && (
      <div id="splash-screen"
           class="fixed inset-0 z-[9999] flex items-center justify-center 
                  bg-white pointer-events-none">
        <div id="splash-inner" class="relative flex items-center justify-center z-10">
          <div id="splash-flash"
               class="absolute inset-0 bg-brand-red opacity-0 rounded-full scale-75 z-0"></div>

          <img src="/logo.png"
               alt="The Life Place"
               class="relative h-28 w-auto opacity-0 z-20"
               id="splash-logo" />
        </div>
      </div>
    )}

    <!-- HEADERS -->
    <HeaderMobile class="md:hidden" />
    <HeaderTablet class="hidden md:block xl:hidden" />
    <HeaderDesktop class="hidden xl:block" />

    <!-- MAIN CONTENT -->
    <main class="flex-1 max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem]
                 mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <slot />
    </main>

    <!-- WIDGETS -->
    <WhatsAppWidget
      whatsapp={whatsappNumber}
      email="hello@thelifeplace.org"
      mapsUrl="https://maps.app.goo.gl/kWtzKtuyASu3qRxo7"
    />

    <CookieConsent />

    <!-- FOOTER -->
    <Footer />

    <!-- Site JS -->
    <script src="/js/search.js" defer></script>
    <script src="/js/dropdowns.js" defer></script>

    <!-- REMOVE THIS: <script src="/js/places-new.js" defer></script> -->
    <!-- It no longer exists after cleaning. -->

    <!-- SPLASH & SCROLL ANIMATIONS -->
    <style is:inline>
      #splash-screen.fade-out {
        opacity: 0;
        transition: opacity 0.8s ease-out;
      }

      @keyframes splash-logo-in {
        0% { opacity: 0; transform: scale(0.85); }
        60% { opacity: 1; transform: scale(1); }
        100% { opacity: 1; }
      }

      @keyframes splash-flash-pulse {
        0% { opacity: 0; transform: scale(0.7); }
        30% { opacity: 1; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.3); }
      }
    </style>

    {path === "/" && (
      <script is:inline>
        const splashAlreadyShown = sessionStorage.getItem("tlp_splash_shown");

        if (!splashAlreadyShown) {
          sessionStorage.setItem("tlp_splash_shown", "yes");

          window.addEventListener("load", () => {
            const screen = document.getElementById("splash-screen");
            const logo = document.getElementById("splash-logo");
            const flash = document.getElementById("splash-flash");

            setTimeout(() => {
              logo.style.animation = "splash-logo-in 0.9s ease-out forwards";
            }, 100);

            setTimeout(() => {
              flash.style.animation = "splash-flash-pulse 0.35s ease-out forwards";
            }, 700);

            setTimeout(() => {
              screen.style.opacity = "0";
            }, 1200);

            setTimeout(() => {
              screen.style.display = "none";
            }, 2000);
          });
        } else {
          const screen = document.getElementById("splash-screen");
          if (screen) screen.style.display = "none";
        }
      </script>
    )}

    <!-- Highlight “Jesus” -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        const regex = /\bJesus\b/g;

        let node;
        while ((node = walker.nextNode())) {
          if (regex.test(node.nodeValue)) {
            const span = document.createElement("span");
            span.innerHTML = node.nodeValue.replace(regex, '<span class="word-jesus">Jesus</span>');
            node.parentNode.replaceChild(span, node);
          }
        }
      });
    </script>

    <!-- Scroll progress logic -->
    <script is:inline>
      document.addEventListener("scroll", () => {
        const doc = document.documentElement;
        const scrollTop = doc.scrollTop;
        const scrollHeight = doc.scrollHeight - doc.clientHeight;
        const scrolled = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;

        const topBar = document.getElementById("scroll-progress-top");
        const sideWrapper = document.getElementById("scroll-progress-side-wrapper");
        const sideBar = document.getElementById("scroll-progress-side");

        if (topBar) topBar.style.width = scrolled + "%";
        if (sideBar) sideBar.style.height = scrolled + "vh";

        if (sideWrapper) {
          sideWrapper.style.opacity = scrollTop > 120 ? "1" : "0";
        }
      });
    </script>

    <!-- Fade-in + Parallax -->
    <script is:inline>
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add("is-visible");
          });
        },
        { threshold: 0.15 }
      );

      document.querySelectorAll(".fade-in").forEach(el => observer.observe(el));

      window.addEventListener("scroll", () => {
        document.querySelectorAll("[data-parallax]").forEach(el => {
          const speed = parseFloat(el.dataset.parallax) || 0.03;
          el.style.transform = `translateY(${window.scrollY * speed}px)`;
        });
      });
    </script>

    <!-- Micro-interactions -->
    <script is:inline>
      document.querySelectorAll(".rounded-xl, .rounded-2xl, .rounded-3xl")
        .forEach(card => {
          if (!card.classList.contains("no-hover")) card.classList.add("hover-elevate","fade-in");
        });

      document.querySelectorAll("button, a.button, a[href]")
        .forEach(btn => {
          if (!btn.classList.contains("no-press")) btn.classList.add("pressable");
        });

      document.querySelectorAll(".hero-img, .hero-bg")
        .forEach(el => {
          el.dataset.parallax = "0.03";
          el.classList.add("parallax", "fade-in");
        });

      const pastor = document.getElementById("pastorsPhoto");
      if (pastor) {
        pastor.dataset.parallax = "0.015";
        pastor.classList.add("parallax", "fade-in");
      }
    </script>

<script>
  async function checkGlobalLiveStatus() {
    const liveLabel = document.querySelector("[data-live-label]");
    const liveDot = document.querySelector("[data-live-indicator]");

    if (!liveLabel || !liveDot) return;

    try {
      // Replace with real API later
      const isLive = window.__TLP_IS_LIVE || false;

      if (isLive) {
        liveLabel.textContent = "LIVE NOW";
        liveLabel.classList.add("text-brand-red", "font-semibold");
        liveDot.classList.remove("hidden");
        liveDot.classList.add("inline-block");
      } else {
        liveLabel.textContent = "Live";
        liveLabel.classList.remove("text-brand-red", "font-semibold");
        liveDot.classList.add("hidden");
      }

    } catch (err) {
      console.error("Live status check failed:", err);
    }
  }

  // Auto-run every 20 seconds (NICE UX)
  checkGlobalLiveStatus();
  setInterval(checkGlobalLiveStatus, 20000);
</script>

<script is:inline>
  async function tlpGlobalLiveCheck() {
    try {
      const res = await fetch("/api/live-status.json");
      const data = await res.json();

      window.__TLP_LIVE__ = data.live;

      document.dispatchEvent(new CustomEvent("tlp-live-updated", { detail: data.live }));
    } catch (e) {
      console.warn("Global live detection failed", e);
    }
  }

  tlpGlobalLiveCheck();
  setInterval(tlpGlobalLiveCheck, 60000);
</script>

<script is:inline>
  document.addEventListener("tlp-live-updated", (e) => {
    const isLive = e.detail;

    // Prevent redirect loop on /live/
    if (window.location.pathname === "/live/") return;

    if (isLive) {
      window.location.href = "/live/";
    }
  });
</script>


  </body>
</html>
