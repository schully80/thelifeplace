---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import HeaderMobile from "../components/HeaderMobile.astro";
import HeaderDesktop from "../components/HeaderDesktop.astro";
import HeaderLaptop from "../components/HeaderLaptop.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import HeaderTablet from "../components/HeaderTablet.astro";

const {
  title = "The Life Place",
  description = "Come. See. Jesus.",
} = Astro.props;

const whatsappNumber = "27XXXXXXXXX";
const whatsappMessage = "Hi The Life Place, I'd love to get in touch.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  whatsappMessage
)}`;
---

<!DOCTYPE html>
<html lang="en" class="min-h-screen">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
    />

    <!-- Inject PUBLIC env vars into window -->
    <script is:inline>
      window.__GOOGLE_PLACES_KEY__ = import.meta.env.PUBLIC_GOOGLE_PLACES_KEY;
      console.log("Google Places Key Loaded:", window.__GOOGLE_PLACES_KEY__);
    </script>

    <!-- Load Google Maps JS API dynamically using the env key -->
 <script is:inline>
  const key = import.meta.env.PUBLIC_GOOGLE_PLACES_KEY;
  if (key) {
    const script = document.createElement("script");
    script.src = `https://maps.googleapis.com/maps/api/js?key=${key}&libraries=places&v=weekly`;
    script.defer = true;
    document.head.appendChild(script);
  }
</script>

    <!-- Load Google Web Components library -->
    <script src="https://unpkg.com/@googlemaps/extended-component-library/dist/index.min.js" defer>
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-white antialiased">

    <!-- Headers -->
    <HeaderMobile class="md:hidden" />
    <HeaderTablet class="hidden md:block xl:hidden" />
    <HeaderDesktop class="hidden xl:block" />

    <!-- Page Content -->
    <main class="flex-1 max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <slot />
    </main>

    <!-- WhatsApp Floating Widget -->
    <WhatsAppWidget
      whatsapp={whatsappNumber}
      email="hello@thelifeplace.org"
      mapsUrl="https://maps.app.goo.gl/kWtzKtuyASu3qRxo7"
    />

    <!-- Cookie Consent -->
    <CookieConsent />

    <!-- Footer -->
    <footer class="bg-black pt-12 pb-10">
      <div class="max-w-6xl mx-auto px-4 text-center space-y-10">

        <!-- Social Icons -->
        <div class="flex justify-center gap-6">
          <a href="https://facebook.com/thelifeplacesa" target="_blank" class="h-12 w-12 flex items-center justify-center rounded-full bg-neutral-800 hover:bg-brand-red transition">
            <i class="fab fa-facebook-f text-white text-xl"></i>
          </a>
          <a href="https://instagram.com/thelifeplacesa" target="_blank" class="h-12 w-12 flex items-center justify-center rounded-full bg-neutral-800 hover:bg-brand-red transition">
            <i class="fab fa-instagram text-white text-xl"></i>
          </a>
          <a href="https://youtube.com/@thelifeplacesa" target="_blank" class="h-12 w-12 flex items-center justify-center rounded-full bg-neutral-800 hover:bg-brand-red transition">
            <i class="fab fa-youtube text-white text-xl"></i>
          </a>
          <a href="https://open.spotify.com/show/31hbtgq5cvmqr4tyzs2faygvrzaa?si=61b073370e034f21" target="_blank" class="h-12 w-12 flex items-center justify-center rounded-full bg-neutral-800 hover:bg-brand-red transition">
            <i class="fab fa-spotify text-white text-xl"></i>
          </a>
          <a href="https://podcasts.apple.com/us/podcast/the-life-place/id1816955719" target="_blank" class="h-12 w-12 flex items-center justify-center rounded-full bg-neutral-800 hover:bg-brand-red transition">
            <i class="fas fa-podcast text-white text-xl"></i>
          </a>
        </div>

        <!-- Legal -->
        <div class="text-gray-400 text-sm flex flex-wrap justify-center gap-6">
          <a href="/privacy-policy/" class="hover:text-white transition">Privacy Policy</a>
          <a href="/cookies/" class="hover:text-white transition">Cookies</a>
          <a href="/terms/" class="hover:text-white transition">Terms</a>
        </div>

        <p class="text-gray-500 text-xs">© 2025 The Life Place. All Rights Reserved.</p>
      </div>
    </footer>

    <!-- External JS -->
    <script src="/js/search.js" defer></script>
    <script src="/js/dropdowns.js" defer></script>
    <script src="/js/places-new.js" defer></script>

  </body>
</html>
