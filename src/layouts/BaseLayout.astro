---
import "@fortawesome/fontawesome-free/css/all.min.css";
import "../styles/global.css";
import "../styles/global-interactions.css";
import CookieConsent from "../components/CookieConsent.astro";
import Header from "../components/Header.astro";
import ContactWidget from "../components/ContactWidget.astro";
import Footer from "../components/Footer.astro";
import AppButton from "../components/AppButton.astro";

const {
  title = "The Life Place — Come. See. Jesus. | Craigavon, Sandton",
  description = "The Life Place — Come. See. Jesus. A church in Craigavon AH, Sandton. Join us Sundays 9:00–11:00. Plan a visit, get directions, watch messages, and take your next step.",
  noindex = false, // set true on utility pages like /thank-you/ and /register-error/
  serviceName = null, // For ministry/service pages
  serviceDescription = null, // For ministry/service pages
  articleTitle = null, // For blog/article pages (e.g., messages)
  articleDescription = null, // For blog/article pages
  articleAuthor = null, // Author name
  articleDate = null, // Publication date (ISO format: YYYY-MM-DD)
  articleImage = null, // Featured image URL
  articleContent = null, // Article body text (for wordCount)
} = Astro.props;

const path = Astro.url.pathname;
const whatsappNumber = "27765639460";
const whatsappMessage = "Hi The Life Place, I'd love to get in touch.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  whatsappMessage
)}`;

const siteUrl = "https://thelifeplace.org";

const { pathname } = Astro.url;
const canonicalUrl =
  pathname === "/" ? "https://thelifeplace.org" : `https://thelifeplace.org${pathname}`;

// Generate breadcrumb data
const pathParts = pathname === "/" ? [] : pathname.split("/").filter(p => p);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://thelifeplace.org" }
];
let accumulatedPath = "";
pathParts.forEach((part, index) => {
  accumulatedPath += `/${part}`;
  const name = part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, " ");
  breadcrumbItems.push({
    "@type": "ListItem",
    position: index + 2,
    name: name,
    item: `https://thelifeplace.org${accumulatedPath}`
  });
});
---
<!DOCTYPE html>
<html lang="en" class="min-h-screen">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- ✅ SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Open Graph (Social Sharing) -->
    <meta property="og:site_name" content="The Life Place" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://thelifeplace.org/logo.png" />
    <meta property="og:image:alt" content="The Life Place - Come. See. Jesus." />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://thelifeplace.org/logo.png" />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#B3282D" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicon & Web App -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-K583CXSM0Y"></script>
    <script>
      const analyticsWindow = window as typeof window & { dataLayer?: unknown[][] };
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      function gtag(...args: unknown[]){analyticsWindow.dataLayer?.push(args);}
      gtag('js', new Date());
      gtag('config', 'G-K583CXSM0Y');
    </script>

  <!-- Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
    crossorigin="anonymous"
  />

<!-- ✅ Schema -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Church", "Organization"],
  "@id": "https://thelifeplace.org/#church",
  "name": "The Life Place",
  "url": "https://thelifeplace.org",
  "slogan": "Come. See. Jesus.",
  "description": "The Life Place is a church in Craigavon AH, Sandton. Join us Sundays 9:00–11:00 for worship, prayer, and community. Experience Jesus in our welcoming congregation.",
  "telephone": "+27 76 563 9460",
  "email": "hello@thelifeplace.org",
  "image": "https://thelifeplace.org/logo.png",
  "areaServed": ["Sandton", "Johannesburg", "South Africa"],
  "potentialAction": [
    {
      "@type": "JoinAction",
      "target": "https://thelifeplace.org/visit"
    },
    {
      "@type": "DonateAction",
      "target": "https://thelifeplace.org/give"
    }
  ],
  "sameAs": [
    "https://facebook.com/thelifeplacesa",
    "https://instagram.com/thelifeplacesa",
    "https://youtube.com/@thelifeplacesa"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "51 Villa Monte Catini\n1 Elm Avenue",
    "addressLocality": "Craigavon AH",
    "addressRegion": "Sandton",
    "postalCode": "2191",
    "addressCountry": "ZA"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Sunday",
      "opens": "09:00",
      "closes": "11:00"
    }
  ]
}
    </script>

    <!-- ✅ Event Schema (Sunday Service) -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": "https://thelifeplace.org/#sunday-service",
  "name": "Sunday Worship Service",
  "description": "Join The Life Place for worship, prayer, and community fellowship every Sunday morning.",
  "image": "https://thelifeplace.org/logo.png",
  "startDate": "2026-01-26T09:00:00+02:00",
  "endDate": "2026-01-26T11:00:00+02:00",
  "eventStatus": "EventScheduled",
  "eventAttendanceMode": "OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "@id": "https://thelifeplace.org/#church-location",
    "name": "The Life Place",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "51 Villa Monte Catini\n1 Elm Avenue",
      "addressLocality": "Craigavon AH",
      "addressRegion": "Sandton",
      "postalCode": "2191",
      "addressCountry": "ZA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "@id": "https://thelifeplace.org/#church",
    "name": "The Life Place",
    "url": "https://thelifeplace.org"
  },
  "url": "https://thelifeplace.org/visit",
  "offers": {
    "@type": "Offer",
    "url": "https://thelifeplace.org/visit",
    "price": "0",
    "priceCurrency": "ZAR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-01-26T00:00:00Z"
  }
}
    </script>

    <!-- ✅ Breadcrumb Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": "https://thelifeplace.org/breadcrumbs",
      "itemListElement": breadcrumbItems
    })}></script>

    {serviceName && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": `https://thelifeplace.org${pathname}#service`,
      "name": serviceName,
      "description": serviceDescription || description,
      "provider": {
        "@type": "Organization",
        "@id": "https://thelifeplace.org/#church",
        "name": "The Life Place",
        "url": "https://thelifeplace.org"
      },
      "areaServed": ["Sandton", "Johannesburg", "South Africa"],
      "url": `https://thelifeplace.org${pathname}`
    })}></script>}

    <!-- ✅ Article/Blog Schema -->
    {articleTitle && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": `https://thelifeplace.org${pathname}#article`,
      "headline": articleTitle,
      "description": articleDescription || description,
      "image": articleImage || "https://thelifeplace.org/logo.png",
      "datePublished": articleDate,
      "dateModified": articleDate,
      "author": {
        "@type": "Person",
        "name": articleAuthor || "The Life Place Team"
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://thelifeplace.org/#church",
        "name": "The Life Place",
        "image": "https://thelifeplace.org/logo.png"
      },
      "url": `https://thelifeplace.org${pathname}`,
      ...(articleContent && { "wordCount": Math.ceil(articleContent.split(/\s+/).length) })
    })}></script>}

  </head>

  <body class="min-h-screen flex flex-col overflow-x-clip bg-white antialiased">

    <!-- Live Banner -->
    <div
      id="tlpLiveBanner"
      class="pointer-events-none max-h-0 overflow-hidden opacity-0 transition-[max-height,opacity] duration-300 ease-out"
      aria-hidden="true"
    >
      <div class="border-b border-red-200/70 bg-[linear-gradient(135deg,rgba(179,40,45,0.08),rgba(255,255,255,0.96)_45%,rgba(179,40,45,0.12))] backdrop-blur-xl">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-3 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
          <div class="flex items-start gap-3">
            <span class="relative mt-1 inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center" aria-hidden="true">
              <span class="absolute inset-0 rounded-full bg-brand-red/25 animate-[tlpLiveBannerPing_1.8s_cubic-bezier(0.22,1,0.36,1)_infinite]"></span>
              <span class="relative h-2.5 w-2.5 rounded-full bg-brand-red shadow-[0_0_0_3px_rgba(255,255,255,0.92)]"></span>
            </span>
            <div class="space-y-1">
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-red">Live now</p>
              <p class="text-sm text-gray-700 sm:text-[15px]">
                We’re streaming right now. Join the service live when you’re ready.
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <a
              href="/live/"
              class="inline-flex items-center gap-2 rounded-full bg-brand-red px-4 py-2 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(179,40,45,0.18)] transition hover:bg-[#9f2429]"
            >
              <span>Watch live</span>
              <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
            </a>
            <button
              id="tlpLiveBannerDismiss"
              type="button"
              aria-label="Dismiss live banner"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-brand-red shadow-sm transition-colors hover:bg-brand-red hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-red/70 focus:ring-offset-2"
            >
              <i class="fa-solid fa-x text-sm" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <style>
      @keyframes tlpLiveBannerPing {
        0% {
          transform: scale(0.85);
          opacity: 0.72;
        }
        70% {
          transform: scale(1.95);
          opacity: 0;
        }
        100% {
          transform: scale(1.95);
          opacity: 0;
        }
      }
    </style>

    <!-- Scroll Progress Indicators -->
    <div
      id="scroll-progress-top"
      class="fixed top-2 left-0 h-[3px] w-0 z-[9999] rounded-full transition-all duration-200 bg-gray-400"
    ></div>

    <div
      id="scroll-progress-side-wrapper"
      class="fixed top-1/2 right-2 -translate-y-1/2 z-[9999] opacity-0 transition-opacity duration-300 pointer-events-none"
    >
      <div
        id="scroll-progress-side"
        class="w-[3px] h-0 rounded-full bg-gray-400 transition-all duration-200"
      ></div>
    </div>

    <!-- SPLASH SCREEN (homepage only) -->
    {path === "/" && (
      <div id="splash-screen"
           class="fixed inset-0 z-[9999] flex items-center justify-center 
                  bg-white pointer-events-none theme-light-aura">
        <div id="splash-inner" class="relative flex items-center justify-center z-10">
          <!-- Halo ring -->
          <div id="splash-ring" class="absolute rounded-full border border-white/40 shadow-[0_0_60px_rgba(255,255,255,0.35)] opacity-0 scale-50"
               style="width: var(--halo-size); height: var(--halo-size);"></div>

          <!-- Soft pulse -->
          <div id="splash-flash" class="absolute rounded-full bg-[var(--accent-strong)]/55 opacity-0 scale-50"
               style="width: var(--halo-size); height: var(--halo-size); filter: blur(var(--halo-blur));"></div>

          <!-- Circular loader -->
          <div
            id="splash-spinner"
            role="progressbar"
            aria-label="Loading"
            class="relative rounded-full border-white/20 border-t-[var(--accent-strong)] opacity-100"
            style="
              width: var(--spinner-size);
              height: var(--spinner-size);
              border-width: var(--spinner-border);
            "
          ></div>
        </div>
      </div>
    )}

    <!-- UNIFIED HEADER (handles all breakpoints) -->
    <Header />

    <!-- MAIN CONTENT -->
    <main class="flex-1 w-full min-w-0 overflow-x-clip">
      <slot />
    </main>

    <!-- CONTACT WIDGET (Responsive) -->
    <ContactWidget
      whatsapp={whatsappNumber}
      email="hello@thelifeplace.org"
      mapsUrl="https://maps.app.goo.gl/kWtzKtuyASu3qRxo7"
      mobileStyle="fab"
      tabletStyle="fab"
      desktopStyle="fab"
    />

    <CookieConsent />

    <!-- FOOTER -->
    <Footer />

    <!-- Site JS -->
    <script src="/js/dropdowns.js" defer></script>



    <!-- Animations -->
    <style is:inline>
      /* Light Aura tokens (shared with dev splash) */
      #splash-screen.theme-light-aura {
        --bg-base: #f7f6f4;
        --bg-top-left: #fdfaf6;
        --bg-bottom-right: #f1e8e4;
        --bg-glow1: rgba(255,183,190,0.28);
        --bg-glow2: rgba(224,74,79,0.20);
        --accent-strong: #b3282d;
        --halo-size: clamp(11rem, 34vw, 15rem);
        --halo-blur: 34px;
        --spinner-size: clamp(4.5rem, 18vw, 7.5rem);
        --spinner-border: clamp(3px, 0.9vw, 6px);
      }

      #splash-screen.fade-out {
        opacity: 0;
        transition: opacity 0.8s ease-out;
      }

      @keyframes splash-ring-pop {
        0% { opacity: 0; transform: scale(0.7); }
        60% { opacity: 1; transform: scale(1.08); }
        100% { opacity: 1; transform: scale(1); }
      }

      @keyframes splash-flash-pulse {
        0% { opacity: 0; transform: scale(0.7); }
        30% { opacity: 1; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.3); }
      }

      @keyframes splash-spinner-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
    </style>

    {path === "/" && (
      <script is:inline>
        const splashAlreadyShown = sessionStorage.getItem("tlp_splash_shown");

        const startSplash = () => {
          const screen = document.getElementById("splash-screen");
          const spinner = document.getElementById("splash-spinner");
          const flash = document.getElementById("splash-flash");
          const ring = document.getElementById("splash-ring");

          if (!screen || !spinner || !flash || !ring) return;

          // show elements
          spinner.style.opacity = "1";
          ring.style.opacity = "1";

          // animations
          ring.style.animation = "splash-ring-pop 0.9s cubic-bezier(0.33,1,0.68,1) forwards";
          setTimeout(() => {
            flash.style.animation = "splash-flash-pulse 0.8s ease-out forwards";
          }, 550);
          spinner.style.animation = "splash-spinner-spin 0.7s linear infinite";

          // auto-hide ~2s total (fade starts sooner to cut wait time)
          setTimeout(() => {
            screen.classList.add("fade-out");
          }, 1200);
          setTimeout(() => {
            screen.style.display = "none";
          }, 2000);
        };

        if (!splashAlreadyShown) {
          sessionStorage.setItem("tlp_splash_shown", "yes");
          document.addEventListener("DOMContentLoaded", startSplash);
        } else {
          const screen = document.getElementById("splash-screen");
          if (screen) screen.style.display = "none";
        }
      </script>
    )}

    <!-- Scroll progress logic -->
    <script is:inline>
      document.addEventListener("scroll", () => {
        const doc = document.documentElement;
        const scrollTop = doc.scrollTop;
        const scrollHeight = doc.scrollHeight - doc.clientHeight;
        const scrolled = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;

        const topBar = document.getElementById("scroll-progress-top");
        const sideWrapper = document.getElementById("scroll-progress-side-wrapper");
        const sideBar = document.getElementById("scroll-progress-side");

        if (topBar) topBar.style.width = scrolled + "%";
        if (sideBar) sideBar.style.height = scrolled + "vh";

        if (sideWrapper) {
          sideWrapper.style.opacity = scrollTop > 120 ? "1" : "0";
        }
      });
    </script>

    <!-- Fade-in + Parallax -->
    <script is:inline>
      const tlpPrefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!tlpPrefersReducedMotion) {
        document.querySelectorAll(".hero-img, .hero-bg")
          .forEach(el => {
            el.dataset.parallax = "0.03";
            el.classList.add("parallax", "motion-fade-up");
          });

        const pastor = document.getElementById("pastorsPhoto");
        if (pastor) {
          pastor.dataset.parallax = "0.015";
          pastor.classList.add("parallax", "motion-fade-up");
        }
      }

      if (!tlpPrefersReducedMotion && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );

        document.querySelectorAll(".motion-fade-up").forEach(el => observer.observe(el));
      } else {
        document.querySelectorAll(".motion-fade-up").forEach(el => el.classList.add("is-visible"));
      }

      const parallaxEls = Array.from(document.querySelectorAll("[data-parallax]"));
      if (!tlpPrefersReducedMotion && parallaxEls.length) {
        let ticking = false;

        const updateParallax = () => {
          parallaxEls.forEach(el => {
            const speed = parseFloat(el.dataset.parallax) || 0.03;
            el.style.transform = `translateY(${window.scrollY * speed}px)`;
          });
          ticking = false;
        };

        window.addEventListener("scroll", () => {
          if (!ticking) {
            requestAnimationFrame(updateParallax);
            ticking = true;
          }
        }, { passive: true });
      }
    </script>

    <!-- Motion targets -->
    <script is:inline>
      document.querySelectorAll("[data-motion-pressable]")
        .forEach(el => {
          el.classList.add("motion-pressable");
        });
    </script>

<script>
  async function checkGlobalLiveStatus() {
    const liveLabel = document.querySelector("[data-live-label]");
    const liveDot = document.querySelector("[data-live-indicator]");

    if (!liveLabel || !liveDot) return;

    try {
      const liveWindow = window as typeof window & { __TLP_LIVE__?: boolean };
      const isLive = liveWindow.__TLP_LIVE__ || false;

      if (isLive) {
        liveLabel.textContent = "Live now";
        liveLabel.classList.add("text-brand-red", "font-semibold");
        liveDot.classList.remove("hidden");
        liveDot.classList.add("inline-block");
      } else {
        liveLabel.textContent = "Live";
        liveLabel.classList.remove("text-brand-red", "font-semibold");
        liveDot.classList.add("hidden");
      }

    } catch (err) {
      console.error("Live status check failed:", err);
    }
  }

  // Auto-run every 20 seconds (NICE UX)
  checkGlobalLiveStatus();
  setInterval(checkGlobalLiveStatus, 20000);
</script>

<script is:inline>
  async function tlpGlobalLiveCheck() {
    try {
      const res = await fetch("/api/live-status.json");
      const data = await res.json();

      window.__TLP_LIVE__ = Boolean(data.live);

      document.dispatchEvent(new CustomEvent("tlp-live-updated", { detail: data.live }));
    } catch (e) {
      console.warn("Global live detection failed", e);
    }
  }

  tlpGlobalLiveCheck();
  setInterval(tlpGlobalLiveCheck, 60000);
</script>

<script is:inline>
  const syncLiveBanner = (isLive) => {
    const banner = document.getElementById("tlpLiveBanner");
    const dismissBtn = document.getElementById("tlpLiveBannerDismiss");
    const dismissKey = "tlp-live-banner-dismissed";

    if (!(banner instanceof HTMLDivElement) || !(dismissBtn instanceof HTMLButtonElement)) return;

    const hideBanner = () => {
      banner.classList.add("pointer-events-none", "max-h-0", "opacity-0");
      banner.classList.remove("max-h-48", "opacity-100");
      banner.setAttribute("aria-hidden", "true");
    };

    const showBanner = () => {
      banner.classList.remove("pointer-events-none", "max-h-0", "opacity-0");
      banner.classList.add("max-h-48", "opacity-100");
      banner.setAttribute("aria-hidden", "false");
    };

    if (!dismissBtn.dataset.bound) {
      dismissBtn.dataset.bound = "true";
      dismissBtn.addEventListener("click", () => {
        sessionStorage.setItem(dismissKey, "true");
        hideBanner();
      });
    }

    if (!isLive) {
      sessionStorage.removeItem(dismissKey);
      hideBanner();
      return;
    }

    if (window.location.pathname === "/live/") {
      hideBanner();
      return;
    }

    if (sessionStorage.getItem(dismissKey) === "true") {
      hideBanner();
      return;
    }

    showBanner();
  };

  document.addEventListener("tlp-live-updated", (e) => {
    syncLiveBanner(Boolean(e.detail));
  });

  syncLiveBanner(Boolean(window.__TLP_LIVE__));
</script>


  </body>
</html>
