---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import HeaderMobile from "../components/HeaderMobile.astro";
import HeaderDesktop from "../components/HeaderDesktop.astro";
import HeaderLaptop from "../components/HeaderLaptop.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import HeaderTablet from "../components/HeaderTablet.astro";
import Footer from "../components/Footer.astro";

const {
  title = "The Life Place",
  description = "Come. See. Jesus.",
} = Astro.props;

const whatsappNumber = "27XXXXXXXXX";
const whatsappMessage = "Hi The Life Place, I'd love to get in touch.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  whatsappMessage
)}`;
---
<!DOCTYPE html>
<html lang="en" class="min-h-screen">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
    />

    <!-- Inject PUBLIC env vars into window -->
    <script is:inline>
      window.__GOOGLE_PLACES_KEY__ = import.meta.env.PUBLIC_GOOGLE_PLACES_KEY;
      window.PUBLIC_YOUTUBE_API_KEY = import.meta.env.PUBLIC_YOUTUBE_API_KEY;
      window.PUBLIC_YOUTUBE_CHANNEL_ID = import.meta.env.PUBLIC_YOUTUBE_CHANNEL_ID;
    </script>

    <!-- Load Google Maps JS API dynamically -->
    <script is:inline>
      const key = import.meta.env.PUBLIC_GOOGLE_PLACES_KEY;
      if (key) {
        const script = document.createElement("script");
        script.src = `https://maps.googleapis.com/maps/api/js?key=${key}&libraries=places&v=weekly`;
        script.defer = true;
        document.head.appendChild(script);
      }
    </script>

    <!-- Load Google Web Components -->
    <script
      src="https://unpkg.com/@googlemaps/extended-component-library/dist/index.min.js"
      defer
    ></script>
  </head>

  <body class="min-h-screen flex flex-col bg-white antialiased">

    <!-- 🔥 SPLASH SCREEN -->
    <div
      id="splash-screen"
      class="fixed inset-0 z-[9999] flex items-center justify-center bg-white pointer-events-none"
    >
      <div id="splash-inner" class="relative flex items-center justify-center z-10">
        <!-- Flash background -->
        <div
          id="splash-flash"
          class="absolute inset-0 bg-brand-red opacity-0 rounded-full scale-75 z-0"
        ></div>

        <!-- Logo -->
        <img
          src="/logo.png"
          alt="The Life Place"
          class="relative h-28 w-auto opacity-0 z-20"
          id="splash-logo"
        />
      </div>
    </div>

    <!-- HEADERS -->
    <HeaderMobile class="md:hidden" />
    <HeaderTablet class="hidden md:block xl:hidden" />
    <HeaderDesktop class="hidden xl:block" />

    <!-- MAIN CONTENT -->
    <main
      class="flex-1 max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8 py-10"
    >
      <slot />
    </main>

    <!-- WIDGETS -->
    <WhatsAppWidget
      whatsapp={whatsappNumber}
      email="hello@thelifeplace.org"
      mapsUrl="https://maps.app.goo.gl/kWtzKtuyASu3qRxo7"
    />

    <CookieConsent />

    <!-- FOOTER (clean, correct, imported) -->
    <Footer />

    <!-- External JS -->
    <script src="/js/search.js" defer></script>
    <script src="/js/dropdowns.js" defer></script>
    <script src="/js/places-new.js" defer></script>

    <!-- 🔥 SPLASH ANIMATIONS -->
    <style is:inline>
      #splash-screen.fade-out {
        opacity: 0;
        transition: opacity 0.8s ease-out;
      }

      @keyframes splash-logo-in {
        0% { opacity: 0; transform: scale(0.85); }
        60% { opacity: 1; transform: scale(1); }
        100% { opacity: 1; }
      }

      @keyframes splash-flash-pulse {
        0% { opacity: 0; transform: scale(0.7); }
        30% { opacity: 1; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.3); }
      }
    </style>

    <script is:inline>
      window.addEventListener("load", () => {
        const screen = document.getElementById("splash-screen");
        const logo = document.getElementById("splash-logo");
        const flash = document.getElementById("splash-flash");

        setTimeout(() => {
          logo.style.animation = "splash-logo-in 0.9s ease-out forwards";
        }, 100);

        setTimeout(() => {
          flash.style.animation = "splash-flash-pulse 0.35s ease-out forwards";
        }, 700);

        setTimeout(() => {
          screen.style.transition = "opacity 0.8s ease-out";
          screen.style.opacity = "0";
        }, 1200);

        setTimeout(() => {
          screen.style.display = "none";
        }, 2000);
      });
    </script>

  </body>
</html>
