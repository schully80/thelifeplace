---
import BaseLayout from "../layouts/BaseLayout.astro";
// Assuming you have Montserrat loaded globally via your BaseLayout or Tailwind config
// If not, you'll need to link it in BaseLayout:
// <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100..900&display=swap" rel="stylesheet">
---

<BaseLayout title="The Life Place">

<!-- CINEMATIC SPLIT HERO — 75vh VERSION -->
<div class="w-screen max-w-none relative left-1/2 right-1/2 -mx-[50vw] bg-white py-20">

<section 
  class="relative w-full min-h-[75vh] px-6 md:px-12 lg:px-20 grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
>

  <!-- LEFT CINEMATIC IMAGE -->
  <div
    class="relative w-full h-[380px] md:h-[520px] lg:h-[620px] 
           overflow-hidden rounded-3xl shadow-2xl cine-zoom-apple-hover"
  >
    <img 
      src="/hero.jpg"
      alt="Cinematic Welcome at The Life Place"
      class="absolute inset-0 w-full h-full object-cover object-center 
             scale-[1.08] brightness-[0.55] contrast-[1.15] tlp-grayscale"
    />
  </div>

  <!-- RIGHT TEXT BLOCK -->
  <div class="relative flex flex-col justify-center md:pl-8 lg:pl-12 cine-zoom-apple-hover">

      <!-- Subtle white glow behind text (Apple) -->
      <div 
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.35),transparent_70%)] 
               blur-[80px] opacity-80 -z-10 pointer-events-none">
      </div>

      <!-- TITLE -->
      <h1 
        class="text-gray-900 text-4xl md:text-6xl font-extrabold leading-tight mb-8 opacity-0 translate-y-8 hero-title"
      >
        OUR WELCOME
      </h1>

      <!-- DNA POEM -->
      <div class="space-y-4">

        <p class="hero-line text-gray-900 text-xl md:text-3xl font-light leading-snug opacity-0 translate-y-8">
          We open wide our doors  
          with a welcome from <span class="font-semibold text-brand-red">Jesus</span> —
        </p>

        <p class="hero-line text-gray-900 text-xl md:text-3xl font-light leading-snug opacity-0 translate-y-8">
          the <span class="font-semibold text-brand-red">Embracer</span> of the outsider,
        </p>

        <p class="hero-line text-gray-900 text-xl md:text-3xl font-light leading-snug opacity-0 translate-y-8">
          the <span class="font-semibold text-brand-red">Defender</span> of the guilty,
        </p>

        <p class="hero-line text-gray-900 text-xl md:text-3xl font-light leading-snug opacity-0 translate-y-8">
          the <span class="font-semibold text-brand-red">Justifier</span> of the ungodly,
        </p>

        <p class="hero-line text-gray-900 text-xl md:text-3xl font-light leading-snug opacity-0 translate-y-8">
          the <span class="font-semibold text-brand-red">Friend</span> of sinners.
        </p>

      </div>

  </div>

</section>
</div>


<!-- ANIMATIONS -->
<style>
  @keyframes fadeUpSmooth {
    0%   { opacity: 0; transform: translateY(32px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .hero-title {
    animation: fadeUpSmooth 1.2s ease-out forwards;
    animation-delay: 0.3s;
  }

  .hero-line {
    animation: fadeUpSmooth 1.2s ease-out forwards;
  }

  .hero-line:nth-child(1) { animation-delay: 0.55s; }
  .hero-line:nth-child(2) { animation-delay: 0.75s; }
  .hero-line:nth-child(3) { animation-delay: 0.95s; }
  .hero-line:nth-child(4) { animation-delay: 1.15s; }
  .hero-line:nth-child(5) { animation-delay: 1.35s; }
</style>

<div id="slogan-block" class="w-full text-center py-20 md:py-32 bg-white relative font-['Montserrat',sans-serif]">
  <p class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight text-gray-900 leading-tight">
    Come. See.
    <span class="relative inline-block font-extrabold mx-2 group">
      <span
        class="inline-block px-4 py-2 rounded-full bg-brand-red text-white font-bold text-5xl md:text-7xl lg:text-8xl shadow-xl transition-all duration-300 ease-in-out group-hover:scale-[1.03]"
      >
        Jesus
      </span>
    </span>
  </p>

  </div>

---

<section id="what-we-believe" class="bg-gray-50 border-t border-gray-200 py-16 md:py-24 font-['Montserrat',sans-serif]">
  <div class="container-x max-w-5xl mx-auto px-4 ">

    <h2 class="text-center text-4xl md:text-6xl font-extrabold mb-12 tracking-tight">
      <span class="text-gray-900 block">OUR</span>
      <span class="text-brand-red inline-block -mt-3 md:-mt-6">BELIEFS</span>
    </h2>

    <p class="text-center text-xl md:text-2xl text-gray-700 leading-relaxed font-medium mb-16 max-w-3xl mx-auto">
      Sound doctrine isn’t about rules; it’s about **Jesus**—who He is, what He has done, and how His finished work shapes what we believe and how we live.
    </p>

    <div id="believe-anchor"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {[ /* ... (Your belief content array remains here) ... */ ].map(({ title, content }) => (
        <details class="border-t-4 border-b-2 border-brand-red bg-white shadow-xl rounded-lg overflow-hidden transition-all duration-300 hover:shadow-2xl">
          <summary class="flex items-center justify-between p-5 cursor-pointer text-xl md:text-2xl font-semibold text-gray-900 hover:text-brand-red transition-colors">
            <span>{title}</span>
            <svg
              class="h-8 w-8 transform transition-transform text-brand-red"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-5 pt-2 text-base leading-relaxed text-gray-700">
            {content}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

---

<div
  id="download-app"
  class="mx-auto mt-16 max-w-lg backdrop-blur-3xl bg-gray-50/70 border border-gray-200
         shadow-3xl rounded-[30px] p-10 text-center ring-1 ring-black/5 motion-safe:animate-[floatSlow_4s_ease-in-out_infinite]"
>
  <img
    src="/expo-qr.png"
    alt="Download App QR"
    class="w-40 h-40 mx-auto mb-6 rounded-2xl shadow-xl border-4 border-white"
  />

  <h3 class="text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">
    Get The Life Place App
  </h3>

   <p class="text-gray-600 text-lg leading-relaxed mb-8 font-light">
    Our mobile app is currently in development.  
    <span class="font-semibold text-brand-red">Launching soon.</span>
  </p>

  <a
    href="https://expo.dev/"
    target="_blank"
    class="inline-flex items-center gap-3 rounded-full px-8 py-4
           bg-brand-red text-white font-bold text-lg shadow-xl
           hover:bg-brand-red/90 hover:shadow-2xl active:scale-[0.98]
           transition-all duration-300"
  >
    Download Expo Go
    <svg
      class="w-6 h-6"
      fill="none" stroke="currentColor" stroke-width="2"
      viewBox="0 0 24 24">
      <path d="M22 2 11 13" />
      <path d="M22 2 15 22 11 13 2 9 22 2z" />
    </svg>
  </a>
</div>
</BaseLayout>

<div id="page-top"></div>