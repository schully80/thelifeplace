            <h3 class="text-xl font-extrabold mb-6 text-center">SnapScan</h3>
            <div class="flex justify-center mb-6">
              <i class="fa-solid fa-mobile-screen-button text-brand-red text-3xl" aria-hidden="true"></i>
            </div>
