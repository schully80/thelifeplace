              </div>
              <img
                src="/snapscan.png"
                alt="SnapScan QR"
                class="mx-auto w-40 h-40 md:w-48 md:h-48 object-contain mb-2"
              />
              <div class="flex flex-col items-center w-full">
                <p class="text-base md:text-lg text-gray-600 mb-2 text-center">
                  Scan QR or click button to give
                </p>
                <span class="inline-flex justify-center rounded-2xl px-5 md:px-6 lg:px-7 py-2.5 md:py-3
                             text-sm md:text-base lg:text-lg font-bold md:whitespace-nowrap
                             border border-brand-red
                             text-brand-red
