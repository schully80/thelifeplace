            <button class="methodTab shrink-0 rounded-2xl px-4 py-2 text-base font-semibold transition w-full" data-tab="paypal" id="method-tab-paypal" role="tab" aria-selected="false" aria-controls="method-panel-paypal" style="background-color: #f5f5f5; color:#333;">
              PayPal
            </button>
          </div>

          <!-- EFT Tab Content -->
