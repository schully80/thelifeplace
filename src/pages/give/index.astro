        </div>

        <!-- Mobile Tab Interface -->
        <div class="md:hidden space-y-5">
          <!-- Tabs -->
          <div class="flex flex-col gap-3 mb-6">
            <button class="methodTab active shrink-0 rounded-full px-4 md:px-6 py-2 md:py-3 text-base font-semibold transition w-full" data-tab="eft" 
            style="background-color: #DC2626; color:#ffffff;">
              EFT
            </button>
