    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-lg font-semibold text-gray-900">
