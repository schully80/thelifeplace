---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuickGive from "../../components/giving/QuickGive.astro";
import { site } from "../../../site.config.js";
const event = new URL(Astro.request.url).searchParams.get("event");
const { bank, snapscan, paypal, westernUnion } = site.giving;
const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || "";
const paypalCurrency = "USD";
const paypalCurrencySymbol = "$";
const paypalRecurringUrl = paypal.recurringUrl || paypal.donateUrl;
const supportEmail = site.contact.email;
const supportAddress = site.contact.address;
const supportPhoneDisplay = "+27 76 563 9460";
const supportPhoneHref = "tel:+27765639460";
---
<BaseLayout title="Generosity — The Life Place">

<!-- FULL-WIDTH HERO SECTION (Single Image) -->
<section class="relative w-screen h-[32svh] min-h-[240px] md:h-[40vh] lg:h-[65vh] overflow-hidden bg-black -ml-[calc((100vw-100%)/2)]">
  <img
    src="/Online giving photo smaller font.jpg"
    alt="Generosity expressed in community"
    class="absolute inset-0 w-full h-full object-cover object-center rounded-none hero-single-img"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/10 to-black/25"></div>
</section>

<!-- PAGE CONTENT CONTAINER -->
<div class="w-full max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8">

<!-- PAGE HEADER -->
<section class="w-full px-0 py-6 md:py-8 lg:py-8 bg-white relative">
  <div class="max-w-6xl mx-auto px-4 py-8 sm:px-6 md:py-24 lg:py-28 text-center">

    <h1 class="mx-auto block max-w-4xl text-[2.6rem] font-black leading-[0.98] text-gray-800 sm:text-5xl md:text-6xl lg:text-7xl">
      Extravagant Generosity
    </h1>

    <p
      class="mx-auto mt-5 max-w-2xl text-base md:mt-8 md:text-xl lg:text-2xl
             text-gray-600 leading-relaxed
             lg:max-w-4xl"
    >
      Generosity is our expression of who <span class="text-brand-red">Jesus</span> is and what He does.
    </p>

  </div>
</section>

<!-- IMPACT STATEMENT -->
<section class="w-full px-4 py-8 md:px-6 md:py-8 lg:px-8 lg:py-10">
  <div class="max-w-4xl mx-auto">
    <h2 class="block text-center text-3xl font-black leading-tight tracking-tight text-gray-800 sm:text-4xl md:text-5xl lg:text-6xl">
      Your generosity creates more opportunities and resources so others can
      <span class="block text-brand-red">
        Come. See. Jesus
      </span>
    </h2>
  </div>
</section>

<!-- QUICK GIVE + METHODS (Unified Container) -->
<section class="w-full px-3 py-8 sm:px-4 md:px-6 md:py-16 lg:px-8 lg:py-24 relative">
  <div class="max-w-6xl mx-auto">

    <!-- Guide Text (Above Container) -->
    <p class="mx-auto mb-6 max-w-2xl text-center text-base leading-relaxed text-gray-600 md:mb-12 md:text-xl lg:text-2xl">
      Below is a simple, guided way to give generously.
    </p>

    <!-- Unified Container: QuickGive + Methods -->
    <div class="rounded-3xl md:rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 shadow-sm hover:shadow-md transition overflow-hidden">
      
      <!-- QuickGive Section (Top) -->
      <div class="p-5 pb-4 sm:p-6 md:p-12 md:pb-8 lg:p-16 lg:pb-10">
        <QuickGive />
      </div>

      <!-- Methods Section (Bottom) -->
      <div id="giving-methods" class="p-4 pt-8 sm:p-6 md:p-10 md:pt-8 lg:p-14 lg:pt-10 xl:p-16">
        <div class="rounded-3xl md:rounded-[32px] border border-black/10 bg-gradient-to-br from-stone-50 via-white to-red-50 p-4 sm:p-5 md:p-8 lg:p-10">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-3xl">
              <p class="text-base font-bold text-gray-800 md:text-2xl">Step 3</p>
              <h2 class="mt-2 text-2xl font-black uppercase leading-tight text-gray-800 md:mt-4 md:text-3xl lg:text-4xl">
                Choose Your Giving Method
              </h2>
              <p class="mt-4 text-base md:text-lg text-gray-600 leading-relaxed">
                Choose the option that fits where you are and how you prefer to give.
              </p>
            </div>

            <div class="rounded-3xl border border-black/10 bg-white/85 p-4 shadow-sm md:p-5 lg:max-w-md">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-gray-500">Secure Giving</p>
                  <p class="mt-2 text-sm md:text-base text-gray-600 leading-relaxed">
                    We do not store your card or banking details. Every online option below completes on the payment provider’s side.
                  </p>
                </div>
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-red text-white">
                  <i class="fa-solid fa-shield-halved text-base" aria-hidden="true"></i>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
            <!-- EFT -->
            <article
              class="fadeIn relative overflow-hidden rounded-3xl border border-black/10 bg-white p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-lg sm:p-6 md:p-8"
              style="animation-delay: 0ms"
            >
              <div class="pointer-events-none absolute -right-10 -top-10 h-28 w-28 rounded-full bg-red-100 blur-2xl"></div>
              <div class="relative flex h-full flex-col">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-black/[0.03] px-3 py-1 text-xs font-semibold text-gray-700">
                      South Africa
                    </span>
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-black/[0.03] px-3 py-1 text-xs font-semibold text-gray-700">
                      Bank Transfer
                    </span>
                  </div>
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-red text-white shadow-sm">
                    <i class="fa-solid fa-laptop text-lg" aria-hidden="true"></i>
                  </div>
                </div>

                <div class="mt-4 text-center">
                  <h3 class="text-2xl font-black leading-tight text-gray-800">EFT</h3>
                </div>

                <dl class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <div class="rounded-2xl border border-black/10 bg-black/[0.02] p-4">
                    <dt class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Bank</dt>
                    <dd class="mt-2 text-sm md:text-base font-semibold text-gray-800">{bank.bankName}</dd>
                  </div>
                  <div class="rounded-2xl border border-black/10 bg-black/[0.02] p-4">
                    <dt class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Account name</dt>
                    <dd class="mt-2 text-sm md:text-base font-semibold text-gray-800">{bank.accountName}</dd>
                  </div>
                  <div class="rounded-2xl border border-black/10 bg-black/[0.02] p-4">
                    <dt class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Account number</dt>
                    <dd class="mt-2 text-sm md:text-base font-semibold text-gray-800">{bank.accountNumber}</dd>
                  </div>
                  <div class="rounded-2xl border border-black/10 bg-black/[0.02] p-4">
                    <dt class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Branch code</dt>
                    <dd class="mt-2 text-sm md:text-base font-semibold text-gray-800">{bank.branchCode}</dd>
                  </div>
                  <div class="rounded-2xl border border-black/10 bg-black/[0.02] p-4 sm:col-span-2">
                    <dt class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">SWIFT</dt>
                    <dd class="mt-2 text-sm md:text-base font-semibold text-gray-800">{bank.swift}</dd>
                  </div>
                </dl>

                <p class="mt-4 text-sm text-gray-500 leading-relaxed">
                  Use these details in your banking app or when making a direct transfer from your bank.
                </p>
              </div>
            </article>

            <!-- SNAPSCAN -->
            <article
              class="fadeIn relative overflow-hidden rounded-3xl border border-black/10 bg-white p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-lg sm:p-6 md:p-8"
              style="animation-delay: 100ms"
            >
              <div class="pointer-events-none absolute -right-10 -top-10 h-28 w-28 rounded-full bg-red-100 blur-2xl"></div>
              <div class="relative flex h-full flex-col">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-black/[0.03] px-3 py-1 text-xs font-semibold text-gray-700">
                      South Africa
                    </span>
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-black/[0.03] px-3 py-1 text-xs font-semibold text-gray-700">
                      Fast Mobile Checkout
                    </span>
                  </div>
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-red text-white shadow-sm">
                    <i class="fa-solid fa-mobile-screen-button text-lg" aria-hidden="true"></i>
                  </div>
                </div>

                <div class="mt-4 text-center">
                  <h3 class="text-2xl font-black leading-tight text-gray-800">SnapScan</h3>
                  <p class="mt-3 text-sm text-gray-500">Scan the QR or tap through to give.</p>
                </div>

                <div class="mt-6 flex justify-center">
                  <div class="inline-flex rounded-[24px] border border-black/10 bg-black/[0.02] p-5">
                    <img
                      src={snapscan.qrImagePath}
                      alt="SnapScan QR"
                      class="h-32 w-32 object-contain md:h-36 md:w-36"
                    />
                  </div>
                </div>

                <div class="mt-6 flex justify-center">
                  <a
                    href={snapscan.url}
                    class="inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-5 py-3 text-base font-bold text-white shadow-sm transition-colors duration-300 hover:bg-[#9f2429] sm:w-auto"
                  >
                    Open SnapScan
                  </a>
                </div>
              </div>
            </article>

            <!-- PAYPAL -->
            <article
              class="fadeIn relative self-start overflow-hidden rounded-3xl border border-black/10 bg-white p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-lg sm:p-6 md:p-8"
              style="animation-delay: 200ms"
            >
              <div class="pointer-events-none absolute -right-10 -top-10 h-28 w-28 rounded-full bg-red-100 blur-2xl"></div>
              <div class="relative flex h-full flex-col">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-black/[0.03] px-3 py-1 text-xs font-semibold text-gray-700">
                      International Giving
                    </span>
                  </div>
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-red text-white shadow-sm">
                    <i class="fa-brands fa-paypal text-lg" aria-hidden="true"></i>
                  </div>
                </div>

                <div class="mt-4 text-center">
                  <h3 class="text-2xl font-black leading-tight text-gray-800">PayPal</h3>
                  <p class="mt-3 text-sm text-gray-500">Give securely online via PayPal.</p>
                </div>

                <div class="mt-6 rounded-2xl border border-black/10 bg-black/[0.02] p-4">
                  <label for="paypal-amount" class="block text-xs font-bold uppercase tracking-[0.14em] text-gray-500">
                    Amount (USD)
                  </label>
                  <div class="mt-2 flex items-center gap-3">
                    <span class="inline-flex items-center justify-center rounded-2xl border border-black/10 bg-white px-3 py-3 text-sm font-black text-gray-700 shadow-sm">
                      {paypalCurrencySymbol}
                    </span>
                    <input
                      id="paypal-amount"
                      type="number"
                      inputmode="decimal"
                      min="1"
                      step="0.01"
                      class="w-full rounded-2xl border border-black/10 bg-white px-4 py-3 text-base font-semibold text-gray-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-red/40"
                      placeholder="Enter amount"
                      aria-describedby="paypal-amount-help"
                    />
                  </div>
                  <p id="paypal-amount-help" class="mt-2 text-xs text-gray-500 leading-relaxed">
                    Enter the amount in USD. Your payment completes on PayPal. PayPal Smart Buttons are currently available in USD only.
                  </p>
                </div>

                <div
                  class="mt-6"
                  data-paypal-buttons
                  data-client-id={paypalClientId}
                  data-currency={paypalCurrency}
                >
                  <div class="rounded-2xl border border-black/10 bg-white p-4 shadow-sm">
                    <div id="paypal-buttons" class="min-h-[44px]"></div>
                    <p id="paypal-status" class="mt-3 text-sm text-gray-600"></p>
                  </div>
                </div>

                {!paypalClientId ? (
                  <div class="mt-6 text-center">
                    <a
                      href={paypal.donateUrl}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-5 py-3 text-base font-bold text-white shadow-sm transition-colors duration-300 hover:bg-[#9f2429] sm:w-auto"
                    >
                      Give via PayPal
                    </a>
                    <p class="mt-2 text-xs text-gray-500 leading-relaxed">
                      PayPal Smart Buttons require `PUBLIC_PAYPAL_CLIENT_ID`.
                    </p>
                  </div>
                ) : null}

                <div class="mt-6 text-center">
                  <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Prefer to give monthly?</p>
                  <a
                    href={paypalRecurringUrl}
                    target="_blank"
                    rel="noopener"
                    class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-2xl border border-brand-red bg-white px-5 py-3 text-base font-bold text-brand-red shadow-sm transition-colors duration-300 hover:bg-brand-red hover:text-white sm:w-auto"
                  >
                    Set up monthly giving on PayPal
                  </a>
                  <p class="mt-2 text-xs text-gray-500 leading-relaxed">
                    Recurring giving is set up and managed on PayPal.
                  </p>
                </div>

              </div>
            </article>

            <!-- WESTERN UNION -->
            <article
              class="fadeIn relative overflow-hidden rounded-3xl border border-black/10 bg-white p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-lg sm:p-6 md:p-8"
              style="animation-delay: 300ms"
            >
              <div class="pointer-events-none absolute -right-10 -top-10 h-28 w-28 rounded-full bg-red-100 blur-2xl"></div>
              <div class="relative flex h-full flex-col">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-black/[0.03] px-3 py-1 text-xs font-semibold text-gray-700">
                      International Transfer
                    </span>
                  </div>
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-red text-white shadow-sm">
                    <span class="text-sm font-black tracking-tight" aria-hidden="true">WU</span>
                  </div>
                </div>

                <div class="mt-4 text-center">
                  <h3 class="text-2xl font-black leading-tight text-gray-800">Western Union</h3>
                </div>

	                <div class="mt-6 rounded-2xl border border-black/10 bg-black/[0.02] p-5 md:p-6">
		                  <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Send To Bank Account (Western Union)</p>
		                  <p class="mt-2 text-sm text-gray-500 leading-relaxed">
		                    When setting up your transfer, choose the <span class="font-semibold text-gray-800">Send to bank account</span> option.
		                  </p>

	                  <div class="mt-5 grid grid-cols-1 gap-4">
	                    <div>
	                      <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Recipient</p>
	                      <p class="mt-2 text-sm font-semibold text-gray-800">Schulter Etyang</p>
	                    </div>

	                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
	                      <div>
	                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Email</p>
	                        <p class="mt-2 text-sm font-semibold text-gray-800 break-words">
	                          <a href={`mailto:${supportEmail}`} class="hover:text-brand-red transition">
	                            {supportEmail}
	                          </a>
	                        </p>
	                      </div>
	                      <div>
	                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Mobile Number</p>
	                        <p class="mt-2 text-sm font-semibold text-gray-800">
	                          <a href={supportPhoneHref} class="hover:text-brand-red transition">
	                            {supportPhoneDisplay}
	                          </a>
	                        </p>
	                      </div>
	                    </div>

	                    <div>
	                      <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Physical Address</p>
	                      <p class="mt-2 text-sm font-semibold text-gray-800 leading-relaxed">
	                        {supportAddress.line1}<br />
	                        {supportAddress.line2}<br />
	                        {supportAddress.line3}<br />
	                        {supportAddress.line4}
	                      </p>
	                    </div>

		                    <div>
		                      <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Recipient Bank Details</p>
		                      <ul class="mt-3 list-disc pl-5 text-sm text-gray-500 space-y-2">
		                        <li>Account holder name: <span class="font-semibold text-gray-800">{bank.accountName}</span></li>
		                        <li>Bank name: <span class="font-semibold text-gray-800">{bank.bankName}</span></li>
		                        <li>Account number: <span class="font-semibold text-gray-800">{bank.accountNumber}</span></li>
		                        <li>Branch code: <span class="font-semibold text-gray-800">{bank.branchCode}</span></li>
	                        <li>SWIFT: <span class="font-semibold text-gray-800">{bank.swift}</span></li>
	                      </ul>
	                    </div>
	                  </div>
	                </div>

	                <div class="mt-6 flex justify-center">
	                  <a
	                    href={westernUnion.url}
	                    target="_blank"
                    rel="noopener"
                    class="inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-5 py-3 text-base font-bold text-white shadow-sm transition-colors duration-300 hover:bg-[#9f2429] sm:w-auto"
                  >
                    {westernUnion.ctaLabel}
                  </a>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- GIVE IN PERSON TEXT ONLY (outside container) -->
<section class="w-full px-4 py-12 md:px-6 md:py-24 lg:px-8 relative">
  <div class="max-w-3xl mx-auto text-center">
    <div class="flex justify-center mb-6">
      <i class="fa-solid fa-hand-holding-heart text-brand-red text-3xl md:text-4xl" aria-hidden="true"></i>
    </div>
    <p class="text-lg font-medium leading-relaxed text-gray-600 sm:text-xl md:text-3xl">
      While we encourage online giving for security and simplicity, we gladly receive in-person gifts during our weekend gatherings.
    </p>
  </div>
</section>

 <!-- Annual Report (featured card) -->
<section class="w-full px-4 py-12 md:px-6 md:py-24 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div
      class="relative overflow-hidden rounded-3xl md:rounded-[36px] border bg-white shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition
             p-5 sm:p-8 md:p-14"
      aria-labelledby="annual-report-title"
    >
    
    <div class="flex flex-col items-center gap-4">
      <!-- Icon -->
      <div class="flex h-12 w-12 items-center justify-center rounded-xl">
        <i class="fa-solid fa-file-lines text-brand-red text-3xl" aria-hidden="true"></i>
      </div>

      
      <div class="flex-1 w-full">
        <h2 id="annual-report-title" class="heading-2 text-center">
          Annual Financial Report
        </h2>
     
      <p
        class="mt-4 md:mt-5 text-base md:text-xl text-center
               leading-relaxed text-gray-600"
      >
        We value transparency and faithful stewardship.
        This report is shared with those who call
        <span class="font-semibold">The Life Place</span> home,
        reflecting how generosity is handled with care —
        to glorify <span class="text-brand-red">Jesus</span>, meet real needs, and serve the mission of
        The Life Place.
      </p>

<p class="mt-4 text-center text-base md:text-lg text-gray-600 leading-relaxed">
  To receive this report, contact us at
  <a href={`mailto:${supportEmail}`} class="font-semibold text-brand-red hover:underline">
    {supportEmail}
  </a>
  or during office hours at
  <a href={supportPhoneHref} class="font-semibold text-brand-red hover:underline">
    {supportPhoneDisplay}
  </a>
</p>

  </div>
</section>


<!-- Giving FAQ -->
<section class="w-full px-4 py-12 md:px-6 md:py-24 lg:px-8">
  <div class="max-w-6xl mx-auto data-faq-accordion">
  <!-- Header -->
  <div class="text-center mb-10 md:mb-14">
    <h2 class="heading-2">
      Giving FAQs
    </h2>
    <p class="mt-3 md:mt-4 text-base md:text-lg text-gray-600">
      Common questions about giving at The Life Place.
    </p>
  </div>

  <!-- FAQ Accordion -->
  <div class="space-y-4 md:space-y-5">

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-2xl md:rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-4 md:p-6">
      <button class="faq-summary flex min-h-12 w-full cursor-pointer items-center justify-between gap-4 text-left text-base font-semibold text-gray-800 md:text-lg">
        Is my donation secure?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-gray-600 leading-relaxed">
          Yes. All online giving platforms we use are secure and encrypted.
          We partner only with trusted payment providers and do not store your
          card or banking details on our systems.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-2xl border border-black/10 bg-white/80 backdrop-blur-xl p-4 md:rounded-3xl md:p-6">
      <button class="faq-summary flex min-h-12 w-full cursor-pointer items-center justify-between gap-4 text-left text-base font-semibold text-gray-800 md:text-lg">
        Will I receive a confirmation or receipt?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
