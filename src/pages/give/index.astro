            >
              Give via SnapScan
            </span>
          </a>

          <!-- PayPal Tab Content -->
          <form
            action="https://www.paypal.com/donate"
            method="post"
            target="_top"
            class="methodTabContent rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 p-6 fadeIn shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition-all cursor-pointer hidden"
            data-tab-content="paypal" id="method-panel-paypal" role="tabpanel" aria-labelledby="method-tab-paypal" hidden
