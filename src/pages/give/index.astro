---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuickGive from "../../components/giving/QuickGive.astro";
import { site } from "../../../site.config.js";

const { bank, snapscan, paypal, westernUnion } = site.giving;
const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || "";
const paypalCurrency = "USD";
const paypalCurrencySymbol = "$";
const paypalRecurringUrl = paypal.recurringUrl || paypal.donateUrl;
const supportEmail = site.contact.email;
const supportAddress = site.contact.address;
const supportPhoneDisplay = "+27 76 563 9460";
const supportPhoneHref = "tel:+27765639460";

const bankDetails = [
  ["Bank", bank.bankName],
  ["Account name", bank.accountName],
  ["Account number", bank.accountNumber],
  ["Branch code", bank.branchCode],
  ["SWIFT", bank.swift],
];

const faqs = [
  {
    question: "Is my donation secure?",
    answer: "Yes. Online giving completes through trusted payment providers. We do not store your card or banking details on this website.",
  },
  {
    question: "Will I receive a confirmation or receipt?",
    answer: "Online platforms send their own confirmations. For a formal receipt or giving record, contact us and we will help you.",
  },
  {
    question: "Can I give anonymously?",
    answer: "Yes. You are welcome to give anonymously. Our heart is to steward every gift faithfully and responsibly.",
  },
  {
    question: "Can I give from outside South Africa?",
    answer: "Yes. PayPal is available for international giving, and Western Union can be used for bank transfers from abroad.",
  },
  {
    question: "Is my giving tax-deductible?",
    answer: "Tax donation receipts are available where applicable. Contact us if you need documentation for your records.",
  },
  {
    question: "How are donations used?",
    answer: "Gifts support the ministry, mission, gatherings, pastoral care, community initiatives, and ongoing work of The Life Place.",
  },
];
---

<BaseLayout
  title="Give — The Life Place"
  description="Give to The Life Place through EFT, SnapScan, PayPal, or Western Union. Support the mission of helping people Come. See. Jesus."
>
  <main class="bg-[oklch(98.5%_0.006_20)] text-gray-900">
    <section class="relative overflow-hidden bg-[oklch(98.5%_0.006_20)]">
      <div class="pointer-events-none absolute inset-y-0 right-0 w-full sm:-right-[14vw] sm:w-[92vw] md:right-0 md:w-[72vw] lg:w-[50vw]">
        <img
          src="/online giving2.jpg"
          alt="Generosity at The Life Place"
          class="h-full w-full object-cover object-[68%_center] sm:object-[72%_center] md:object-[76%_center] lg:object-[92%_center]"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[oklch(98.5%_0.006_20)] via-[oklch(98.5%_0.006_20_/_0.78)] to-[oklch(98.5%_0.006_20_/_0.02)] sm:via-[oklch(98.5%_0.006_20_/_0.66)] md:via-[oklch(98.5%_0.006_20_/_0.58)] lg:via-[oklch(98.5%_0.006_20_/_0.58)] lg:to-[oklch(20%_0.01_20_/_0.08)]"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-[oklch(98.5%_0.006_20_/_0.42)] via-transparent to-[oklch(98.5%_0.006_20_/_0.22)] sm:from-[oklch(98.5%_0.006_20_/_0.22)] md:hidden"></div>
      </div>

      <div class="relative mx-auto grid min-h-[calc(100svh-5rem)] max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 md:py-16 lg:grid-cols-[minmax(0,0.92fr)_minmax(22rem,0.48fr)] lg:px-8 lg:py-20">
        <div class="max-w-4xl">
          <p class="mb-5 text-sm font-bold uppercase tracking-[0.16em] text-brand-red md:text-base">
            Generosity at The Life Place
          </p>
          <h1 class="text-5xl font-black leading-[0.96] text-gray-900 sm:text-6xl md:text-7xl lg:text-8xl">
           We are generous because <span class="text-brand-red">Jesus</span> is generous to us.
          </h1>
          <p class="mt-7 max-w-2xl text-lg font-medium leading-relaxed text-gray-700 md:text-2xl">
            Your giving helps create more room for people in our city, nation, and the world to Come. See. Jesus.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#quick-give" class="inline-flex min-h-12 items-center justify-center rounded-2xl bg-brand-red px-7 py-4 text-base font-black text-[oklch(99%_0.004_20)] shadow-md transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-[#9F2429] hover:shadow-lg active:scale-[0.98]">
              Give Now
            </a>
            <a href="#giving-methods" class="inline-flex min-h-12 items-center justify-center rounded-2xl border-2 border-brand-red/40 bg-[oklch(99%_0.004_20)] px-7 py-4 text-base font-black text-gray-900 shadow-sm transition-[border-color,background-color,transform] duration-200 ease-out hover:border-brand-red/70 hover:bg-[oklch(97%_0.006_20)] active:scale-[0.98]">
              See Giving Methods
            </a>
          </div>

          <aside class="mt-7 max-w-xl rounded-2xl border border-black/10 bg-[oklch(99%_0.004_20)] p-4 shadow-sm" aria-label="Giving reassurance">
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-red text-[oklch(99%_0.004_20)]">
                <i class="fa-solid fa-shield-halved text-sm" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-gray-500">Secure giving</p>
                <p class="mt-2 text-sm leading-relaxed text-gray-600">
                  Card and banking details are handled by each payment provider. The Life Place does not store them here.
                </p>
              </div>
            </div>
          </aside>

        </div>
      </div>
    </section>

    <section id="quick-give" class="scroll-mt-24 px-4 py-14 sm:px-6 md:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl rounded-3xl border border-black/10 bg-[oklch(99%_0.004_20)] p-5 shadow-sm sm:p-8 md:p-12">
        <QuickGive />
      </div>
    </section>

    <section id="giving-methods" class="scroll-mt-24 px-4 py-10 sm:px-6 md:py-16 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 max-w-3xl md:mb-12">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Choose a method</p>
          <h2 class="mt-3 text-3xl font-black leading-tight text-gray-900 sm:text-4xl md:text-5xl">
            Give in the way that fits where you are.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-gray-600 md:text-lg">
            EFT and SnapScan are simplest in South Africa. PayPal and Western Union are available for international giving.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
          <article class="rounded-3xl border border-black/10 bg-[oklch(99%_0.004_20)] p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:shadow-md active:scale-[0.99] sm:p-6 md:p-8">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">South Africa</p>
                <h3 class="mt-3 text-3xl font-black leading-tight text-gray-900">EFT</h3>
              </div>
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red">
                <i class="fa-solid fa-laptop text-lg" aria-hidden="true"></i>
              </div>
            </div>

            <dl class="mt-6 divide-y divide-black/10 rounded-2xl border border-black/10 bg-[oklch(97.5%_0.006_20)]">
              {bankDetails.map(([label, value]) => (
                <div class="grid gap-1 px-4 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                  <dt class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">{label}</dt>
                  <dd class="text-sm font-bold text-gray-900 break-words">{value}</dd>
                </div>
              ))}
            </dl>

            <p class="mt-4 text-sm leading-relaxed text-gray-600">
              Suggested reference: {bank.referenceHint}.
            </p>
          </article>

          <article class="rounded-3xl border border-black/10 bg-[oklch(99%_0.004_20)] p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:shadow-md active:scale-[0.99] sm:p-6 md:p-8">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">Fast mobile checkout</p>
                <h3 class="mt-3 text-3xl font-black leading-tight text-gray-900">SnapScan</h3>
              </div>
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red">
                <i class="fa-solid fa-mobile-screen-button text-lg" aria-hidden="true"></i>
              </div>
            </div>

            <div class="mt-6 flex flex-col items-center rounded-2xl border border-black/10 bg-[oklch(97.5%_0.006_20)] p-5">
              <img src={snapscan.qrImagePath} alt="SnapScan QR code for The Life Place giving" class="h-40 w-40 object-contain" loading="eager" decoding="async" />
              <p class="mt-4 text-center text-sm leading-relaxed text-gray-600">
                Scan the QR code or open SnapScan on your phone.
              </p>
            </div>

            <a href={snapscan.url} class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-5 py-3 text-base font-bold text-[oklch(99%_0.004_20)] shadow-sm transition-colors duration-200 ease-out hover:bg-[#9f2429]">
              Open SnapScan
            </a>
          </article>

          <article class="rounded-3xl border border-black/10 bg-[oklch(99%_0.004_20)] p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:shadow-md active:scale-[0.99] sm:p-6 md:p-8">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">International giving</p>
                <h3 class="mt-3 text-3xl font-black leading-tight text-gray-900">PayPal</h3>
              </div>
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red">
                <i class="fa-brands fa-paypal text-lg" aria-hidden="true"></i>
              </div>
            </div>

            <label for="paypal-amount" class="mt-6 block text-sm font-bold uppercase tracking-[0.16em] text-gray-500">
              Amount ({paypalCurrency})
            </label>
            <div class="mt-3 flex items-center gap-3">
              <span class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-black/10 bg-[oklch(97.5%_0.006_20)] px-4 text-base font-black text-gray-700">
                {paypalCurrencySymbol}
              </span>
              <input
                id="paypal-amount"
                type="number"
                inputmode="decimal"
                min="1"
                step="0.01"
                class="min-h-12 w-full rounded-2xl border border-black/10 bg-[oklch(99%_0.004_20)] px-4 text-base font-bold text-gray-900 shadow-sm focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red/30"
                placeholder="Enter amount"
                aria-describedby="paypal-amount-help"
              />
            </div>
            <p id="paypal-amount-help" class="mt-2 text-xs leading-relaxed text-gray-500">
              PayPal Smart Buttons currently use USD.
            </p>

            <div class="mt-6" data-paypal-buttons data-client-id={paypalClientId} data-currency={paypalCurrency}>
              <div id="paypal-buttons" class="min-h-[44px]"></div>
              <p id="paypal-status" class="mt-3 text-sm text-gray-600" aria-live="polite"></p>
            </div>

            {!paypalClientId ? (
              <div class="mt-6">
                <a href={paypal.donateUrl} target="_blank" rel="noopener" class="inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-5 py-3 text-base font-bold text-[oklch(99%_0.004_20)] shadow-sm transition-colors duration-200 ease-out hover:bg-[#9f2429]">
                  Give via PayPal
                </a>
                <p class="mt-2 text-xs leading-relaxed text-gray-500">
                  PayPal Smart Buttons require PUBLIC_PAYPAL_CLIENT_ID.
                </p>
              </div>
            ) : null}

            <a href={paypalRecurringUrl} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-12 w-full items-center justify-center rounded-2xl border border-brand-red bg-[oklch(99%_0.004_20)] px-5 py-3 text-base font-bold text-brand-red shadow-sm transition-colors duration-200 ease-out hover:bg-brand-red hover:text-[oklch(99%_0.004_20)]">
              Set Up Monthly Giving
            </a>
          </article>

          <article class="rounded-3xl border border-black/10 bg-[oklch(99%_0.004_20)] p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:shadow-md active:scale-[0.99] sm:p-6 md:p-8">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">International transfer</p>
                <h3 class="mt-3 text-3xl font-black leading-tight text-gray-900">Western Union</h3>
              </div>
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red">
                <span class="text-sm font-black tracking-tight" aria-hidden="true">WU</span>
              </div>
            </div>

            <div class="mt-6 space-y-5 rounded-2xl border border-black/10 bg-[oklch(97.5%_0.006_20)] p-5">
              <p class="text-sm leading-relaxed text-gray-600">
                Choose the Send to bank account option, then use the recipient and bank details below.
              </p>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Recipient</p>
                <p class="mt-2 text-sm font-bold text-gray-900">Schulter Etyang</p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Email</p>
                <a href={`mailto:${supportEmail}`} class="mt-2 inline-block text-sm font-bold text-gray-900 hover:text-brand-red">{supportEmail}</a>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Mobile number</p>
                <a href={supportPhoneHref} class="mt-2 inline-block text-sm font-bold text-gray-900 hover:text-brand-red">{supportPhoneDisplay}</a>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Physical address</p>
                <p class="mt-2 text-sm font-bold leading-relaxed text-gray-900">
                  {supportAddress.line1}<br />
                  {supportAddress.line2}<br />
                  {supportAddress.line3}<br />
                  {supportAddress.line4}
                </p>
              </div>
            </div>

            <a href={westernUnion.url} target="_blank" rel="noopener" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-5 py-3 text-base font-bold text-[oklch(99%_0.004_20)] shadow-sm transition-colors duration-200 ease-out hover:bg-[#9f2429]">
              {westernUnion.ctaLabel}
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="px-4 py-14 sm:px-6 md:py-20 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="rounded-3xl border border-black/10 bg-[oklch(99%_0.004_20)] p-6 shadow-sm md:p-8">
          <i class="fa-solid fa-file-lines text-3xl text-brand-red" aria-hidden="true"></i>
          <h2 class="mt-5 text-3xl font-black leading-tight text-gray-900">Annual Financial Report</h2>
          <p class="mt-4 text-base leading-relaxed text-gray-600 md:text-lg">
            We value transparency and faithful stewardship. Members can request the report at
            <a href={`mailto:${supportEmail}`} class="font-bold text-brand-red hover:underline">{supportEmail}</a>
            or call
            <a href={supportPhoneHref} class="font-bold text-brand-red hover:underline">{supportPhoneDisplay}</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="px-4 py-14 sm:px-6 md:py-20 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="mb-8 text-center md:mb-12">
          <h2 class="text-3xl font-black leading-tight text-gray-900 sm:text-4xl md:text-5xl">Giving FAQs</h2>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-gray-600 md:text-lg">
            Clear answers for common questions about giving at The Life Place.
          </p>
        </div>

        <div class="space-y-3">
          {faqs.map((item) => (
            <details class="group rounded-2xl border border-black/10 bg-[oklch(99%_0.004_20)] p-4 shadow-sm md:p-5">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-bold text-gray-900 md:text-lg">
                {item.question}
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[oklch(97.5%_0.006_20)] text-gray-500 transition-transform duration-200 ease-out group-open:rotate-180">
                  <i class="fa-solid fa-chevron-down text-sm" aria-hidden="true"></i>
                </span>
              </summary>
              <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">{item.answer}</p>
            </details>
          ))}
        </div>

        <p class="mt-10 text-center text-sm text-gray-500">
          Still have questions?
          <a href={`mailto:${supportEmail}`} class="font-bold text-brand-red hover:underline">We are happy to help.</a>
        </p>
      </div>
    </section>

    <section class="bg-[oklch(99%_0.004_20)] px-4 py-16 text-center sm:px-6 md:py-24 lg:px-8">
      <h2 class="mx-auto max-w-3xl text-4xl font-black leading-tight text-gray-900 sm:text-5xl md:text-6xl">
        Come. See. <span class="text-brand-red">Jesus.</span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-gray-600 md:text-xl">
        Join us this Sunday.
      </p>
    </section>
  </main>
</BaseLayout>

{paypalClientId ? (
  <script
    id="paypal-sdk"
    src={`https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(paypalClientId)}&currency=${encodeURIComponent(paypalCurrency)}&intent=capture&components=buttons`}
    async
  ></script>
) : null}

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.querySelector("[data-paypal-buttons]");
    if (!root) return;

    const clientId = root.getAttribute("data-client-id") || "";
    const currency = (root.getAttribute("data-currency") || "USD").toUpperCase();

    const amountInput = document.querySelector("#paypal-amount");
    const statusEl = document.querySelector("#paypal-status");
    const buttonsContainer = document.querySelector("#paypal-buttons");
    const quickGiveRoot = document.querySelector("[data-quick-give]");

    function setStatus(message) {
      if (!statusEl) return;
      statusEl.textContent = message || "";
    }

    function getSelectedQuickGiveCategory() {
      const selected = quickGiveRoot?.querySelector(".categoryBtn.bg-brand-red");
      return selected?.getAttribute("data-category") || "";
    }

    function getAmountValue() {
      const raw = amountInput?.value || "";
      const amount = Number(raw);
      if (!Number.isFinite(amount) || amount <= 0) return null;
      return amount;
    }

    if (!clientId) {
      setStatus("PayPal is not configured.");
      return;
    }

    function waitForPayPal() {
      if (window.paypal?.Buttons) return Promise.resolve();
      return new Promise((resolve, reject) => {
        const started = Date.now();
        const timer = setInterval(() => {
          if (window.paypal?.Buttons) {
            clearInterval(timer);
            resolve();
            return;
          }
          if (Date.now() - started > 15000) {
            clearInterval(timer);
            reject(new Error("PayPal SDK did not load"));
          }
        }, 100);
      });
    }

    function renderButtons() {
      if (!buttonsContainer || !window.paypal?.Buttons) return;

      buttonsContainer.innerHTML = "";
      window.paypal.Buttons({
        style: {
          layout: "vertical",
          shape: "pill",
          label: "donate",
        },
        onInit: (_data, actions) => {
          actions.disable();

          const maybeEnable = () => {
            const amount = getAmountValue();
            if (amount) actions.enable();
            else actions.disable();
          };

          amountInput?.addEventListener("input", maybeEnable);
          maybeEnable();
        },
        createOrder: (_data, actions) => {
          const amount = getAmountValue();
          if (!amount) {
            setStatus("Please enter an amount first.");
            throw new Error("Missing amount");
          }

          const category = getSelectedQuickGiveCategory();
          const description = category
            ? `The Life Place - ${category}`
            : "The Life Place - Giving";

          return actions.order.create({
            purchase_units: [
              {
                description,
                amount: {
                  currency_code: currency,
                  value: amount.toFixed(2),
                },
              },
            ],
          });
        },
        onApprove: async (_data, actions) => {
          try {
            const details = await actions.order.capture();
            const id = details?.id ? ` (${details.id})` : "";
            setStatus(`Thank you! Your donation was successful${id}. Redirecting...`);
            window.location.href = "/thank-you?event=Donation";
          } catch (error) {
            setStatus("Payment was approved, but capture failed. Please try again.");
            throw error;
          }
        },
        onCancel: () => setStatus("Payment canceled."),
        onError: () => setStatus("Something went wrong with PayPal. Please try again."),
      }).render(buttonsContainer);
    }

    waitForPayPal()
      .then(() => {
        renderButtons();
      })
      .catch(() => {
        setStatus("PayPal could not be loaded. Please try again later.");
      });
  });
</script>
