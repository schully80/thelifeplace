---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SnapScanConfirmForm from "../../components/SnapScanConfirmForm.astro";
import QuickGive from "../../components/giving/QuickGive.astro";
const event = new URL(Astro.request.url).searchParams.get("event");
---
<BaseLayout title="Generosity — The Life Place">

<!-- FULL-WIDTH HERO SECTION (Single Image) -->
<section class="relative w-screen h-[35vh] md:h-[40vh] lg:h-[70vh] overflow-hidden bg-black -ml-[calc((100vw-100%)/2)]">
  <img
    src="/Online giving photo 2 grayscale.jpg"
    alt="Generosity expressed in community"
    class="absolute inset-0 w-full h-full object-cover object-center rounded-none hero-single-img"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/10 to-black/25"></div>
</section>

<!-- PAGE CONTENT CONTAINER -->
<div class="w-full max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8">

<!-- PAGE HEADER -->
<section class="w-full px-0 py-8 md:py-8 lg:py-8 bg-white relative">
  <div class="max-w-6xl mx-auto px-6 py-12 md:py-28 lg:py-32 text-center">

    <h1 class="block text-4xl md:text-5xl lg:text-7xl font-black text-gray-800 leading-tight md:leading-tight lg:leading-tight">
      Extravagant Generosity
    </h1>

    <p
      class="mt-8 text-xl md:text-xl lg:text-2xl
             text-gray-600 leading-relaxed
             max-w-4xl mx-auto"
    >
      Generosity is our expression of who <span class="text-brand-red">Jesus</span> is and what He does.
    </p>

  </div>
</section>

<!-- IMPACT STATEMENT -->
<section class="w-full px-4 md:px-6 lg:px-8 py-6 md:py-6 lg:py-8">
  <div class="max-w-4xl mx-auto">
    <h2 class="block heading-2 text-center">
      Your generosity creates more opportunities and resources so others can
      <span class="block text-brand-red">
        Come. See. Jesus
      </span>
    </h2>
  </div>
</section>

<!-- QUICK GIVE + METHODS (Unified Container) -->
<section class="w-full px-4 md:px-6 lg:px-8 py-8 md:py-20 lg:py-24 relative">
  <div class="max-w-6xl mx-auto">

    <!-- Guide Text (Above Container) -->
    <p class="text-xl md:text-xl lg:text-2xl text-gray-600 text-center mb-10 md:mb-16 md:max-w-full mx-auto leading-relaxed">
      Below is a simple, guided way to give generously—step by step.
    </p>

    <!-- Unified Container: QuickGive + Methods -->
    <div class="rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 shadow-sm hover:shadow-md transition overflow-hidden">
      
      <!-- QuickGive Section (Top) -->
      <div class="p-4 sm:p-6 md:p-14 lg:p-20 pb-4 md:pb-8 lg:pb-10">
        <QuickGive />
      </div>

      <!-- Methods Section (Bottom) -->
      <div id="giving-methods" class="pt-8 md:pt-8 lg:pt-10 p-10 md:p-14 lg:p-20">


        <!-- Step 3 Heading -->
        <h2 class="text-xl md:text-2xl font-extrabold text-gray-800 mb-14 md:mb-16 lg:mb-20">Step 3 · CHOOSE PAYMENT METHOD</h2>

        <!-- Desktop / Tablet Methods Grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-1 lg:grid-cols-3 gap-10 md:gap-14">

          <!-- EFT -->
          <div
            class="rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 p-8 md:p-12 lg:p-14 fadeIn shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition-all flex flex-col items-center"
            style="animation-delay: 0ms"
          >
            <h3 class="text-center text-xl md:text-2xl font-extrabold mb-3 md:mb-4 whitespace-nowrap">EFT (Bank Transfer)</h3>
            <div class="flex justify-center mb-4">
              <i class="fa-solid fa-laptop text-brand-red text-3xl md:text-4xl" aria-hidden="true"></i>
            </div>
            <ul class="space-y-2 text-base md:text-lg text-gray-600 text-center list-none">
              <li class="whitespace-nowrap"><strong>Bank:</strong> Standard Bank</li>
              <li class="whitespace-nowrap"><strong>Account:</strong> The Life Place</li>
              <li class="whitespace-nowrap"><strong>Number:</strong> 301524351</li>
              <li class="whitespace-nowrap"><strong>Branch:</strong> 051001</li>
              <li class="whitespace-nowrap"><strong>SWIFT:</strong> SBZAZAJJ</li>
            </ul>
            <p class="mt-4 text-center text-sm md:text-lg text-gray-500">
              Reference: Tithe / Offering / Your name
            </p>
          </div>

          <!-- SNAPSCAN -->
          <a href="https://pos.snapscan.io/qr/VISFNLkM" class="rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 p-8 md:p-12 lg:p-14 text-center fadeIn shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition-all block cursor-pointer" style="animation-delay: 100ms">
            <h3 class="text-center text-xl md:text-2xl font-extrabold mb-6 md:mb-8">SnapScan</h3>
