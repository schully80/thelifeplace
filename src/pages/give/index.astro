              Reference: Tithe / Offering / Your name
            </p>
          </div>

          <!-- SnapScan Tab Content -->
          <a href="https://pos.snapscan.io/qr/VISFNLkM" class="methodTabContent rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 p-6 fadeIn shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition-all hidden" data-tab-content="snapscan">
            <h3 class="text-xl font-extrabold mb-6 text-center">SnapScan</h3>
            <div class="flex justify-center mb-6">
              <img
                src="/reshot-icon-hand-holding-smartphone-4L7F8HCGWT.svg"
                alt="Hand holding smartphone icon"
                class="h-10 w-10"
              />
            </div>
            <p class="text-base text-gray-700 mb-6 text-center">
              Scan or click to give instantly.
            </p>
            <img
              src="/SnapCode_1 grayscale.png"
              alt="SnapScan QR"
              class="mx-auto w-40 h-40 object-contain mb-6"
            />
            <span
              class="block text-center rounded-full px-6 py-3
                     text-base font-bold
                     border border-brand-red
                     text-brand-red"
            >
              Give via SnapScan
            </span>
          </a>

          <!-- PayPal Tab Content -->
          <form
            action="https://www.paypal.com/donate"
            method="post"
            target="_top"
            class="methodTabContent rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 p-6 fadeIn shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition-all cursor-pointer hidden"
            data-tab-content="paypal"
          >
            <input type="hidden" name="hosted_button_id" value="4L3NWWAZ9PPV6" />
            <h3 class="text-lg font-extrabold mb-3 text-center">PayPal</h3>
            <div class="flex justify-center mb-3">
              <img
                src="/paypal-blue.svg"
                alt="PayPal"
                class="h-10 w-10"
              />
            </div>
            <p class="text-sm text-gray-700 mb-3 text-center">
              <span class="block font-semibold uppercase text-xs">International Giving</span>
              <span class="block text-xs text-gray-500">(Outside South Africa)</span>
            </p>
            <p class="text-xs text-gray-500 mb-3 text-center">Click button or anywhere on this card to give</p>
            <button type="submit" class="mb-3">
              <img
                src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif"
                class="h-auto max-w-xs rounded-lg border p-1 bg-white shadow-sm pointer-events-none"
