---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SnapScanConfirmForm from "../../components/SnapScanConfirmForm.astro";
import FullBleed from "../../components/tlp/FullBleed.astro";
import HeroTitle from "../../components/tlp/HeroTitle.astro";
import SectionWrapper from "../../components/tlp/SectionWrapper.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
import WarmBackground from "../../components/tlp/WarmBackground.astro";
import QuickGive from "../../components/giving/QuickGive.astro";
const url = new URL(Astro.request.url);
const event = url.searchParams.get("event");
---
<BaseLayout title="Generosity — The Life Place">

<!-- FULL-WIDTH HERO SECTION -->
<section class="relative w-screen h-[30vh] md:h-[70vh] overflow-hidden -ml-[calc((100vw-100%)/2)]">
  <div class="absolute inset-0 w-full h-full">

    <div class="absolute inset-0 grid grid-cols-2 w-full h-full">
      <img
        src="/giving-hero2.jpg"
        alt="Community members giving together"
        class="w-full h-full object-cover col-start-1 row-start-1"
      />
      <img
        src="/giving-hero7.jpg"
        alt="Generosity in action"
        class="w-full h-full object-cover col-start-2 row-start-1"
      />
    </div>

    <div
      class="pointer-events-none absolute inset-y-0 left-1/2 w-32 -translate-x-1/2
             bg-gradient-to-r from-transparent via-black/60 to-transparent z-10">
    </div>

    <div class="absolute inset-0 bg-black/10"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/20 to-transparent"></div>

  </div>
</section>

<!-- PAGE CONTENT CONTAINER -->
<div class="w-full max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 lg:px-8">

<!-- PAGE HEADER -->
<section class="w-full px-0 py-8 md:py-20 bg-white relative">
  <div class="max-w-6xl mx-auto px-6 py-12 md:py-36 text-center">

    <h1 class="heading-1">
      Extravagant Generosity
    </h1>

    <p
      class="mt-8 text-xl md:text-2xl
             text-gray-700 leading-relaxed
             max-w-4xl mx-auto"
    >
      Generosity is our expression of who <span class="text-brand-red">Jesus</span> is and what He does.
    </p>

  </div>
</section>

<!-- SUBTLE DIVIDER -->
<FadeDivider mt="mt-0" mb="mb-0" color="bg-gray-300" width="w-[98%]" />

<!-- IMPACT STATEMENT -->
<section class="w-full px-4 md:px-6 lg:px-8 py-16 md:py-24">
  <div class="max-w-3xl mx-auto">
    <h2 class="heading-2 leading-[1.05] mb-[5rem]">
      Your generosity creates more opportunities and resources so others can
      <span class="block text-brand-red">
        Come. See. Jesus
      </span>
    </h2>
  </div>
</section>

<!-- QUICK GIVE + METHODS (Unified Container) -->
<section class="w-full px-4 md:px-6 lg:px-8 py-8 md:py-28 relative">
  <div class="max-w-6xl mx-auto">

    <!-- Guide Text (Above Container) -->
    <p class="text-lg sm:text-xl md:text-2xl text-gray-700 text-center mb-10 md:mb-16 md:max-w-full mx-auto leading-relaxed">
      Below is a simple, guided way to give generously — step by step.
    </p>

    <!-- Unified Container: QuickGive + Methods -->
    <div class="rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 shadow-sm hover:shadow-md transition overflow-hidden">
      
      <!-- QuickGive Section (Top) -->
      <div class="p-4 sm:p-6 md:p-20 pb-4 md:pb-10">
        <QuickGive />
      </div>

      <!-- Methods Section (Bottom) -->
      <div id="giving-methods" class="pt-8 md:pt-10 p-10 md:p-20">


        <!-- Step 3 Heading -->
        <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-16 md:mb-20">Step 3 · CHOOSE PAYMENT METHOD</h2>

        <!-- Desktop Methods Grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10 md:gap-14">

          <!-- EFT -->
          <div
            class="rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 p-10 md:p-16 fadeIn shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition-all flex flex-col items-center"
            style="animation-delay: 0ms"
          >
            <h3 class="text-center text-xl md:text-2xl font-extrabold mb-3 md:mb-4 whitespace-nowrap">EFT (Bank Transfer)</h3>
            <div class="flex justify-center mb-4">
              <img
                src="/reshot-icon-laptop-Y6XNMWGB8C.svg"
                alt="Laptop icon"
                class="h-10 w-10 md:h-12 md:w-12"
              />
            </div>
            <ul class="space-y-2 text-base md:text-lg text-gray-700 text-center list-none">
              <li class="whitespace-nowrap"><strong>Bank:</strong> Standard Bank</li>
              <li class="whitespace-nowrap"><strong>Account:</strong> The Life Place</li>
              <li class="whitespace-nowrap"><strong>Number:</strong> 301524351</li>
              <li class="whitespace-nowrap"><strong>Branch:</strong> 051001</li>
              <li class="whitespace-nowrap"><strong>SWIFT:</strong> SBZAZAJJ</li>
            </ul>
            <p class="mt-4 text-center text-sm md:text-lg text-gray-500">
              Reference: Tithe / Offering / Your name
            </p>
          </div>

          <!-- SNAPSCAN -->
          <a href="https://pos.snapscan.io/qr/VISFNLkM" class="rounded-[32px] bg-white/80 backdrop-blur-xl border border-black/10 p-10 md:p-16 text-center fadeIn shadow-sm hover:shadow-md hover:-translate-y-0.5 transform transition-all block" style="animation-delay: 100ms">
            <h3 class="text-center text-xl md:text-2xl font-extrabold mb-6 md:mb-8">SnapScan</h3>
            <div class="flex justify-center mb-6">
              <img
                src="/reshot-icon-hand-holding-smartphone-4L7F8HCGWT.svg"
                alt="Hand holding smartphone icon"
