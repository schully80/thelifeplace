            style="animation-delay: 200ms"
          >
            <input type="hidden" name="hosted_button_id" value="4L3NWWAZ9PPV6" />
            <h3 class="text-center text-xl md:text-2xl font-extrabold">PayPal</h3>
            <div class="flex justify-center">
              <i class="fa-brands fa-paypal text-brand-red text-3xl md:text-4xl" aria-hidden="true"></i>
            </div>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed">
              <span class="block font-semibold uppercase tracking-wide">International Giving</span>
              <span class="block mt-1 text-sm text-gray-500">(Outside South Africa)</span>
            </p>
            <p class="text-xs md:text-lg text-gray-500 mb-4">Click on button or anywhere on this card to give</p>
            <button type="submit">
              <img
                src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif"
                alt=""
                class="rounded-2xl border p-2 md:p-4 bg-white shadow-md pointer-events-none"
              />
            </button>
            <button
              type="submit"
              class="rounded-2xl px-5 md:px-6 lg:px-7 py-2.5 md:py-3
                text-sm md:text-base lg:text-lg font-bold md:whitespace-nowrap
