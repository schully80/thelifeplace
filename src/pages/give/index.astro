<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Method tabs functionality
    const methodTabs = document.querySelectorAll(".methodTab");
    const tabPanels = document.querySelectorAll(".methodTabContent");
    
    methodTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const tabName = tab.dataset.tab;
        
        // Deactivate all tabs and hide all content
        methodTabs.forEach((t) => {
          t.classList.remove("active");
          t.style.backgroundColor = "#f5f5f5";
          t.style.color = "#333";
          t.setAttribute("aria-selected", "false");
          t.setAttribute("tabindex", "-1");
        });
        
        tabPanels.forEach((content) => {
          content.classList.add("hidden");
          content.setAttribute("hidden", "true");
        });
        
        // Activate clicked tab
        tab.classList.add("active");
        tab.style.backgroundColor = "#DC2626";
        tab.style.color = "white";
        tab.setAttribute("aria-selected", "true");
        tab.setAttribute("tabindex", "0");
        
        // Show corresponding content
        const content = document.querySelector(`[data-tab-content="${tabName}"]`);
        if (content) {
          content.classList.remove("hidden");
          content.removeAttribute("hidden");
        }
        
        // Smooth scroll after animation starts (delays scroll to let fade-in play)
        setTimeout(() => {
          const methodsSection = document.getElementById("giving-methods");
          if (methodsSection) {
            methodsSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
        }, 150);
      });
    });

    // Make PayPal form containers fully clickable (desktop, tablet, mobile)
    const paypalForms = document.querySelectorAll('form[action*="paypal.com"]');
    paypalForms.forEach((form) => {
      form.addEventListener("click", (e) => {
        // If a real submit button is ever made interactive, let it handle the submit
        const directSubmit = e.target.closest('button[type="submit"]');
        if (directSubmit) return;

        // Otherwise, treat any click inside the card as a submit
        e.preventDefault();
        const submitButton = form.querySelector('button[type="submit"]');
        if (submitButton) {
          submitButton.click();
        }
      });
    });
  });
</script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll(".faq-item");

    items.forEach((item, index) => {
      const summary = item.querySelector(".faq-summary");
      const content = item.querySelector(".faq-content");
      const icon = summary.querySelector("svg");

      // ARIA wiring
      const buttonId = `faq-button-${index}`;
      const panelId = `faq-panel-${index}`;
      summary.setAttribute("id", buttonId);
      summary.setAttribute("aria-controls", panelId);
      summary.setAttribute("aria-expanded", "false");
      content.setAttribute("id", panelId);
      content.setAttribute("role", "region");
      content.setAttribute("aria-labelledby", buttonId);

      summary.addEventListener("click", () => {
        const isOpen = content.style.maxHeight && content.style.maxHeight !== "0px";

        // Close all
        items.forEach((other, i) => {
          const otherSummary = other.querySelector(".faq-summary");
          const otherContent = other.querySelector(".faq-content");
          const otherIcon = other.querySelector("svg");
          if (otherContent) otherContent.style.maxHeight = null;
          if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
          if (otherSummary) otherSummary.setAttribute("aria-expanded", "false");
          other.classList.remove("open");
        });

        // Open clicked one
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + "px";
          if (icon) icon.style.transform = "rotate(180deg)";
          summary.setAttribute("aria-expanded", "true");
          item.classList.add("open");
        }
      });
    });
  });
</script>

