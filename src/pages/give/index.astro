            >
              Give via PayPal
            </button>
          </form>

        </div>

        <!-- Mobile Tab Interface -->
        <div class="md:hidden space-y-5">
          <!-- Tabs -->
          <div class="flex flex-col gap-3 mb-6" role="tablist">
            <button class="methodTab active shrink-0 rounded-2xl px-4 md:px-6 py-2 md:py-3 text-base font-semibold transition w-full" data-tab="eft" 
            id="method-tab-eft" role="tab" aria-selected="true" aria-controls="method-panel-eft"
