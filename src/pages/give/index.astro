                class="h-10 w-10 md:h-12 md:w-12"
              />
            </div>
            <p class="text-base md:text-lg text-gray-700 leading-relaxed">
              <span class="block font-semibold uppercase tracking-wide">International Giving</span>
              <span class="block mt-1 text-sm text-gray-500">(Outside South Africa)</span>
            </p>
            <p class="text-xs md:text-lg text-gray-500 mb-4">Click on button or anywhere on this card to give</p>
            <button type="submit">
