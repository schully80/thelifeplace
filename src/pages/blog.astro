---
import BaseLayout from "../layouts/BaseLayout.astro";
import customTags from "../data/blog-tags.json";
import blogTagLinks from "../data/blog-tag-links.json";
import {
  decodeHtmlEntities,
  formatDate,
  getPaginationItems,
  imageObjectPosition,
  isValidDate,
  monthKey,
  monthLabel,
  parseBlogFeed,
  type BlogFeedItem,
  type MonthGroup,
  type PaginationItem,
} from "../utils/blog-feed";

export const prerender = false;

const FEED_URL = "https://schulteretyang.substack.com/feed";
const PAGE_SIZE = 11;
const FEED_TIMEOUT_MS = 8000; // abort slow requests after 8s
const FEED_TTL_MS = 5 * 60 * 1000; // cache feed for 5 minutes

const tagLinks = blogTagLinks as Record<string, string>;
const customTagList: string[] = Array.isArray(customTags?.tags)
  ? customTags.tags.filter((tag): tag is string => typeof tag === "string")
  : [];

// Simple in-memory cache for parsed feed items
let feedCache: { items: BlogFeedItem[] | null; fetchedAt: number } = { items: null, fetchedAt: 0 };

let items: BlogFeedItem[] = [];
let error: string | null = null;
let page = 1;
let totalPages = 1;
let pagedItems: BlogFeedItem[] = [];
let monthGroups: MonthGroup[] = [];
let allMonthArchives: string[] = [];
let allYearArchives: string[] = [];
let allTags: string[] = [];
let displayTags: string[] = [];
let usingFallbackTags = false;
let paginationItems: PaginationItem[] = [];

// Resolve a tag's link with case-insensitive override support
function tagHref(tag: string): string {
  const key = tag || "";
  const lower = key.toLowerCase();
  return tagLinks[key] ?? tagLinks[lower] ?? `https://schulteretyang.substack.com/t/${encodeURIComponent(key)}`;
}

try {
  // Use cached items if still fresh
  const now = Date.now();
  const cacheValid = feedCache.items && (now - feedCache.fetchedAt) < FEED_TTL_MS;
  if (cacheValid && feedCache.items) {
    items = feedCache.items.slice();
  } else {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), FEED_TIMEOUT_MS);
    const res = await fetch(FEED_URL, {
      headers: {
        Accept: "application/rss+xml, application/xml, text/xml",
        "User-Agent": "thelifeplace-blog-list"
      },
      signal: controller.signal
    });
    clearTimeout(timeoutId);
    if (!res.ok) throw new Error(`Feed fetch failed: HTTP ${res.status}`);
    const xml = await res.text();
    items = parseBlogFeed(xml);

    // Save to cache
    feedCache.items = items.slice();
    feedCache.fetchedAt = Date.now();
  }

  // RSS-only mode: do not supplement with index items

  // Sort recent first
  items.sort((a, b) => {
    const at = isValidDate(a.dateObj) ? a.dateObj.getTime() : 0;
    const bt = isValidDate(b.dateObj) ? b.dateObj.getTime() : 0;
    return bt - at;
  });

  // Pagination
  const param = Astro.url.searchParams.get("page");
  page = Math.max(1, Math.min(Number(param) || 1, Math.max(1, Math.ceil(items.length / PAGE_SIZE))));
  totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
  const start = (page - 1) * PAGE_SIZE;
  pagedItems = items.slice(start, start + PAGE_SIZE);
  paginationItems = getPaginationItems(totalPages, page, 1);

  // Group by month for the current page
  const groupsMap = new Map<string, MonthGroup>();
  for (const item of pagedItems) {
    const key = monthKey(item.dateObj);
    const label = monthLabel(item.dateObj);
    if (!groupsMap.has(key)) groupsMap.set(key, { label, items: [] });
    groupsMap.get(key)!.items.push(item);
  }
  monthGroups = Array.from(groupsMap.values());

  // RSS-only mode: remove archive derivation logic

  // Build tag cloud from all items
  const tagSet = new Set<string>();
  for (const it of items) {
    it.categories.forEach((c) => tagSet.add(c));
  }
  // Case-insensitive sort for consistency
  allTags = Array.from(tagSet)
    .filter((tag): tag is string => Boolean(tag))
    .sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
  usingFallbackTags = allTags.length === 0;
  displayTags = (usingFallbackTags ? customTagList : allTags)
    .slice()
    .sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
} catch (e) {
  // Normalize abort timeout error
  const isAbort = e instanceof Error && e.name === "AbortError";
  const msg = isAbort ? "Feed request timed out. Please try again." : (e instanceof Error ? e.message : String(e));
  error = msg;
}

// SEO / canonical
const canonicalHref = (() => {
  const base = `${Astro.url.origin}/blog`;
  if (page > 1) return `${base}?page=${page}`;
  return base;
})();
---

<BaseLayout title="Blog">
  <Fragment slot="head">
    <meta name="description" content="Latest posts from The Life Place Substack—listings, excerpts, and links to full articles." />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:title" content="Blog — The Life Place" />
    <meta property="og:description" content="Latest posts from The Life Place Substack—listings, excerpts, and links to full articles." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&display=swap" rel="stylesheet" />
  </Fragment>

  <style is:global>
    /* Visible horizontal scrollbar styling (WebKit + Firefox) */
    .scrollbar-visible { scrollbar-width: thin; scrollbar-color: rgba(239, 68, 68, 0.35) rgba(239, 68, 68, 0.12); }
    .scrollbar-visible::-webkit-scrollbar { height: 8px; }
    .scrollbar-visible::-webkit-scrollbar-track { background-color: rgba(239, 68, 68, 0.12); border-radius: 9999px; }
    .scrollbar-visible::-webkit-scrollbar-thumb { background-color: rgba(239, 68, 68, 0.35); border-radius: 9999px; }

    /* Hide native scrollbars while preserving scroll functionality */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <!-- Page Hero -->
    <!-- Latest Blog Post Hero Header -->
    {items && items.length > 0 && (
      <section class="relative flex h-[50svh] min-h-[380px] w-full items-center justify-center overflow-hidden bg-gray-100 sm:h-[42vh] md:h-[50vh] lg:h-[70vh]">
        {items[0].imageUrl ? (
          <Fragment>
            <img
              src={items[0].imageUrl}
              alt={items[0].title}
              class="absolute inset-0 w-full h-full object-cover object-center opacity-80"
              style={`object-position: ${imageObjectPosition(items[0])};`}
              loading="eager"
              decoding="async"
            />
            {/* Enhanced modern underlay: multi-stop gradient and blur for depth */}
            <div class="absolute inset-0 pointer-events-none" style="
              background: linear-gradient(120deg, rgba(24,24,27,0.55) 0%, rgba(24,24,27,0.25) 60%, rgba(0,0,0,0.10) 100%);
              z-index: 1;
            "></div>
          </Fragment>
        ) : (
          <div class="absolute inset-0 bg-gradient-to-r from-brand-red/20 via-red-500/10 to-brand-red/20"></div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
        <div class="absolute inset-0 ring-1 ring-brand-red"></div>
        <div class="absolute inset-0 shadow-[inset_0_1px_0_rgba(255,255,255,0.35)]"></div>
        <div class="relative z-10 mx-auto flex h-full max-w-5xl flex-col items-center justify-center px-4 text-center sm:px-6">
          <a href={items[0].link} target="_blank" rel="noopener" class="block group max-w-full">
            <h1
              class="mb-5 max-w-full text-3xl font-extrabold leading-[1.05] tracking-normal transition-colors duration-200 group-hover:text-brand-red sm:text-4xl md:mb-6 md:text-5xl lg:text-6xl"
              style="
                color: #fff;
                text-shadow: 0 4px 32px rgba(0,0,0,0.45);
                font-family: 'Montserrat', 'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
              "
            >
              {items[0].title}
            </h1>
          </a>
          {/* Subtitle removed for cleaner look */}
          <div class="mt-2 flex w-full justify-center sm:mt-4">
            <a
              href={items[0].link}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-6 py-3 font-bold text-white shadow transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-red-700 active:scale-[0.98] sm:w-auto"
              style="font-family: 'Montserrat', sans-serif;"
            >
              Read now
            </a>
          </div>
          <div class="mt-4 flex max-w-full flex-wrap justify-center gap-2">
            {items[0].categories && items[0].categories.length > 0 && items[0].categories.map((cat) => (
              <a href={tagHref(cat)} class="inline-flex min-h-11 items-center rounded-2xl bg-brand-red/80 px-3 py-2 text-xs font-semibold text-white shadow-md transition-colors duration-150 hover:bg-brand-red" target="_blank" rel="noopener">{cat}</a>
            ))}
          </div>
          {/* Date removed for cleaner look */}
        </div>
      </section>
    )}

  

  {/* Place 'All Blog Posts' label to the right of the first visible month/year heading */}
  <!-- Feed Cards -->
  <section class="w-full mt-10 bg-white py-10 md:mt-20 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      {error ? (
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
          <p class="text-red-700 font-semibold">We’re having trouble loading the feed right now.</p>
          {import.meta.env.DEV && (
            <p class="text-red-700 text-sm mt-1">{error}</p>
          )}
          <div class="mt-3">
            <a href="https://schulteretyang.substack.com" target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2 rounded-2xl bg-red-600 px-4 py-3 text-white transition-colors duration-150 hover:bg-red-700">
              View latest on Substack
            </a>
          </div>
        </div>
      ) : (
        <div>
        
          
          <div id="blogNoResults" class="hidden rounded-2xl border border-gray-200 bg-gray-50 p-4 text-gray-600">No matching posts.</div>
          {monthGroups.map((group) => {
            // Filter out the latest post (items[0]) from the first group only
            const filteredItems = group === monthGroups[0]
              ? group.items.filter((item) => item.link !== items[0]?.link)
              : group.items;
            if (filteredItems.length === 0) return null;
            return (
              <section class="mb-10 md:mb-12" data-month-group>
                {/* For the first group, show month/year left and 'All Blog Posts' right on the same row */}
                <h2 class="mb-4 text-lg font-bold uppercase text-brand-warmgray-800 md:text-2xl">{group.label}</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6 sm:gap-8 md:gap-10 xl:gap-12">
                  {filteredItems.map((item) => (
                    <a href={item.link} class="group block overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-md transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-red-200 hover:shadow-xl active:scale-[0.99] md:rounded-3xl" data-card data-title={item.title || item.link} data-desc={item.description || ""}>
                      {item.imageUrl ? (
                        <div class="relative">
                          <img src={item.imageUrl} alt={item.title} class="h-52 w-full object-cover object-center transition-transform duration-300 ease-out group-hover:scale-[1.03] sm:h-64 md:h-72 lg:h-80" style={`object-position: ${imageObjectPosition(item)};`} loading="lazy" decoding="async" />
                          <div class="absolute inset-0 bg-gradient-to-t from-black/15 via-transparent to-transparent opacity-60 transition-opacity duration-200 group-hover:opacity-40"></div>
                        </div>
                      ) : (
                        <div class="relative h-52 w-full bg-gradient-to-r from-brand-red/20 via-red-500/10 to-brand-red/20 sm:h-64 md:h-72 lg:h-80">
                          <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent"></div>
                        </div>
                      )}
                      <div class="p-5 sm:p-6 md:p-8">
                        <div class="flex items-center gap-2">
                          <span class="inline-flex items-center px-2 py-1 rounded-full bg-gray-100 text-gray-600 text-xs">{formatDate(item.dateObj, item.date)}</span>
                        </div>
                        <h3 class="mt-4 text-lg font-semibold leading-snug tracking-normal text-gray-800 transition-colors duration-200 group-hover:text-brand-red md:text-xl">{item.title || item.link}</h3>
                        <span class="mt-1 block text-xs text-gray-500">Opens on Substack</span>
                        {item.categories && item.categories.length > 0 && (
                          <div class="mt-4 flex flex-wrap gap-3">
                            {[...item.categories].sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase())).map((cat) => (
                              <a href={tagHref(cat)} class="inline-flex min-h-11 items-center rounded-2xl px-3 py-2 text-xs text-gray-600 transition-colors duration-150 hover:bg-brand-red/10 hover:text-brand-red">
                                {cat}
                              </a>
                            ))}
                          </div>
                        )}
                        {item.description && (
                          <p class="text-sm md:text-base text-gray-600 mt-4 line-clamp-4">{item.description}</p>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            );
          })}

          <!-- Search script -->
          <script>
            document.addEventListener('DOMContentLoaded', () => {
              const input = document.getElementById('blogSearch');
              const clearBtn = document.getElementById('blogSearchClear');
              const noResults = document.getElementById('blogNoResults');
              const groups = Array.from(document.querySelectorAll('section[data-month-group]'));
              const cards = Array.from(document.querySelectorAll('a[data-card]'));

              const noResultsEl = noResults instanceof HTMLElement ? noResults : null;
              if (!noResultsEl) return;
              const resultsEl = noResultsEl;

              function applyFilter(q: string) {
                const query = (q || '').trim().toLowerCase();
                let visibleCardCount = 0;
                cards.forEach(card => {
                  const title = (card.getAttribute('data-title') || '').toLowerCase();
                  const desc = (card.getAttribute('data-desc') || '').toLowerCase();
                  const match = !query || title.includes(query) || desc.includes(query);
                  card.classList.toggle('hidden', !match);
                  if (match) visibleCardCount++;
                });
                // Hide empty groups
                groups.forEach(group => {
                  const groupCards = Array.from(group.querySelectorAll('a[data-card]'));
                  const anyVisible = groupCards.some(c => !c.classList.contains('hidden'));
                  group.classList.toggle('hidden', !anyVisible);
                });
                resultsEl.classList.toggle('hidden', visibleCardCount > 0);
              }

              if (input instanceof HTMLInputElement) {
                input.addEventListener('input', () => applyFilter(input.value));
              }
              clearBtn?.addEventListener('click', () => {
                if (!(input instanceof HTMLInputElement)) return;
                input.value = '';
                applyFilter('');
                input.focus();
              });
            });
          </script>

          

          <!-- Pagination -->
          <nav aria-label="Pagination" class="mt-12">
              <div class="w-full overflow-x-scroll scroll-px-4 sm:scroll-px-0 pb-4 sm:pb-2 scrollbar-visible sm:no-scrollbar" style="scrollbar-gutter: stable both-edges;">
              <div class="flex items-center gap-2 px-2 pr-6 sm:pr-0 whitespace-nowrap justify-start sm:justify-center snap-x snap-mandatory">
              {page > 1 ? (
                <a href={`/blog?page=1`} class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-white px-4 text-gray-800 transition-[background-color,border-color,transform] duration-150 ease-out hover:bg-gray-50 active:scale-[0.97]">First</a>
              ) : (
                <span class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-gray-100 px-4 text-gray-400 cursor-not-allowed">First</span>
              )}
              {page > 1 ? (
                <a href={`/blog?page=${page - 1}`} class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-white px-4 text-gray-800 transition-[background-color,border-color,transform] duration-150 ease-out hover:bg-gray-50 active:scale-[0.97]">Prev</a>
              ) : (
                <span class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-gray-100 px-4 text-gray-400 cursor-not-allowed">Prev</span>
              )}

              {getPaginationItems(totalPages, page, 1).map((it) => (
                it.type === "ellipsis" ? (
                  <span class="px-2 text-gray-500 select-none flex-shrink-0 snap-start">&hellip;</span>
                ) : it.current ? (
                  <span aria-current="page" class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full bg-brand-red px-4 font-medium text-white shadow-sm">{it.page}</span>
                ) : (
                  <a href={`/blog?page=${it.page}`} class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-white px-4 text-gray-800 transition-[background-color,border-color,transform] duration-150 ease-out hover:bg-gray-50 active:scale-[0.97]">{it.page}</a>
                )
              ))}

              {page < totalPages ? (
                <a href={`/blog?page=${page + 1}`} class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-white px-4 text-gray-800 transition-[background-color,border-color,transform] duration-150 ease-out hover:bg-gray-50 active:scale-[0.97]">Next</a>
              ) : (
                <span class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-gray-100 px-4 text-gray-400 cursor-not-allowed">Next</span>
              )}
              {page < totalPages ? (
                <a href={`/blog?page=${totalPages}`} class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-white px-4 text-gray-800 transition-[background-color,border-color,transform] duration-150 ease-out hover:bg-gray-50 active:scale-[0.97]">Last</a>
              ) : (
                <span class="inline-flex h-11 min-w-11 flex-shrink-0 snap-start items-center justify-center rounded-full border bg-gray-100 px-4 text-gray-400 cursor-not-allowed">Last</span>
              )}
              <span aria-hidden="true" class="w-2 flex-shrink-0"></span>
              </div>
            </div>
          </nav>

          <!-- Tags -->
          {displayTags.length > 0 && (
            <section class="mt-14">
              <div class="mb-3 flex items-center gap-2">
                <h2 class="text-2xl font-bold text-brand-warmgray-800">Tags</h2>
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-2xl border border-gray-300 text-gray-600 text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <path d="M18 13v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <path d="M15 3h6v6"/>
                    <path d="M10 14 21 3"/>
                  </svg>
                  <span>Tags open on Substack</span>
                </span>
              </div>
              <div class="flex flex-wrap gap-2">
                {displayTags.map((tag) => (
                  <a href={tagHref(tag)} class="inline-flex min-h-11 items-center rounded-2xl px-3 py-2 text-base text-gray-800 transition-colors duration-150 hover:bg-brand-red/10 hover:text-brand-red">
                    {tag}
                  </a>
                ))}
              </div>
            </section>
          )}

          <div class="mt-8 text-center">
            <a href="https://schulteretyang.substack.com" target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2 rounded-2xl bg-brand-red px-6 py-3 font-bold text-white shadow-md transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-red-700 hover:shadow-lg active:scale-[0.98]">
              Read more on Substack
            </a>
          </div>
        </div>
      )}
    </div>
  </section>
  
  
</BaseLayout>
