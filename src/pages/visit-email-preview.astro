---
import BaseLayout from "../layouts/BaseLayout.astro";
import { html as visitConfirmHtml } from "../utils/visit-confirmation-email-template";

const sample = {
  firstName: "Jordan",
  attendees: 3,
  email: "person@example.com",
  serviceTime: "Sundays 9:00–11:00am",
  address: "51 Villa Monte Catini\n1 Elm Avenue\nCraigavon AH, 2191\nSandton\nSouth Africa",
  mapUrl: "https://maps.app.goo.gl/Mk3pCED8Ubp4e8gF9",
  logoUrl: "https://thelifeplace.org/logo4.svg",
};
---

<BaseLayout title="Visit Confirmation Email Preview">
  <section class="max-w-3xl mx-auto my-12 p-6 bg-white rounded-2xl shadow">
    <h1 class="text-2xl font-bold mb-4 text-brand-red">Visit Confirmation Email Preview</h1>
    <div class="border rounded-xl overflow-hidden shadow">
      <iframe srcdoc={visitConfirmHtml(sample)} style="width:100%;min-height:700px;border:0;background:white;"></iframe>
    </div>
    <div class="mt-8">
      <h2 class="text-lg font-semibold mb-2">Sample Data</h2>
      <pre class="bg-gray-100 p-4 rounded text-sm">{JSON.stringify(sample, null, 2)}</pre>
    </div>
  </section>
</BaseLayout>
