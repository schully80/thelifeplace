---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Plan a Visit - Test">

<!-- ===== DRAMATIC HERO SECTION ===== -->
<section class="w-full min-h-screen md:min-h-[90vh] relative overflow-hidden bg-gradient-to-br from-slate-950 via-black to-slate-900 flex items-center justify-center">
  
  <!-- Animated background elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-full h-full bg-gradient-to-bl from-brand-red/15 via-transparent to-transparent"></div>
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-red/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 text-center z-10">
    
    <!-- Label -->
    <div class="mb-8 opacity-0 animate-fadeUp">
      <span class="inline-block px-4 py-2 rounded-full bg-gradient-to-r from-brand-red/20 to-red-600/10 border border-brand-red/40 text-sm md:text-base text-brand-red font-bold uppercase tracking-widest backdrop-blur-sm">
        Join Us This Sunday
      </span>
    </div>

    <!-- Main heading -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black leading-tight text-white mb-8 opacity-0 animate-fadeUp delay-100 max-w-5xl mx-auto">
      Come
      <span class="block bg-gradient-to-r from-brand-red via-red-500 to-brand-red bg-clip-text text-transparent mt-4 md:mt-6">
        See
      </span>
      Jesus
    </h1>

    <!-- Service Info -->
    <div class="mt-12 opacity-0 animate-fadeUp delay-200">
      <p class="text-2xl md:text-3xl text-yellow-200 font-black mb-6">Sundays</p>
      <p class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-8">
        9:00 AM – 11:00 AM
      </p>
      <p class="text-lg md:text-xl text-gray-300/90 max-w-2xl mx-auto leading-relaxed">
        Whether you work downtown, live in a Sandton tower, or travel through the city—a warm welcome awaits you. No matter where you're from, we'd love to see you.
      </p>
    </div>

  </div>

</section>

<!-- ===== LOCATION SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-white relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Location Info -->
    <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
      
      <!-- Left: Address Info -->
      <div class="opacity-0 animate-fadeUp delay-100">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 mb-8">
          In the Heart of
          <span class="text-brand-red">Sandton</span>
        </h2>
        
        <div class="space-y-6">
          <div>
            <p class="text-sm font-bold text-brand-red uppercase tracking-widest mb-2">Address</p>
            <p class="text-lg md:text-xl text-gray-700 leading-relaxed font-medium">
              51 Villa Monte Catini<br/>1 Elm Avenue<br/>Craigavon AH, 2191<br/>Sandton<br/>South Africa
            </p>
          </div>

          <div class="pt-8 border-t border-gray-200">
            <p class="text-sm font-bold text-brand-red uppercase tracking-widest mb-4">Get There</p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="https://www.google.com/maps?q=51+Villa+Monte+Catini,+1+Elm+Avenue,+Craigavon+AH,+2191,+Sandton,+South+Africa" target="_blank" class="inline-block px-6 py-3 bg-gradient-to-r from-brand-red to-red-600 hover:from-red-600 hover:to-red-700 text-white font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
                Get Directions
              </a>
              <a href="https://maps.app.goo.gl/kWtzKtuyASu3qRxo7" target="_blank" class="inline-block px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-900 font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
                Open in Maps
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Map -->
      <div class="opacity-0 animate-fadeUp delay-200 rounded-3xl overflow-hidden shadow-2xl border border-gray-200 h-[400px] md:h-[500px]">
        <iframe
          class="w-full h-full"
          src="https://www.google.com/maps?q=51+Villa+Monte+Catini,+1+Elm+Avenue,+Craigavon+AH,+2191,+Sandton,+South+Africa&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="The Life Place Location"
        ></iframe>
      </div>

    </div>

  </div>

</section>

<!-- ===== WHAT TO EXPECT SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-white relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="mb-20 text-center opacity-0 animate-fadeUp delay-100">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 mb-4">
        What to <span class="text-brand-red">Expect</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">At the heart of everything we believe and do is Jesus and His finished work. Here's what your first Sunday will look like.</p>
    </div>

    <!-- Experience Grid - 8 cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mb-20">
      
      <!-- We Open Our Bibles -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-blue-50 to-white border border-blue-200/50 opacity-0 animate-fadeUp delay-200 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">📖</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          We Open Our Bibles
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          We open our bibles to see Jesus and hear the good news. Gospel-rich, Jesus-centered teaching from Scripture.
        </p>
      </div>

      <!-- Joyful Community -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-green-50 to-white border border-green-200/50 opacity-0 animate-fadeUp delay-300 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">🌍</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          Our Community
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          Multiracial. Multiethnic. Multigenerational. A family united in Christ across every difference.
        </p>
      </div>

      <!-- Worship & Music -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-purple-50 to-white border border-purple-200/50 opacity-0 animate-fadeUp delay-400 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">🎵</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          Worship & Dancing
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          With music and dancing, we celebrate Jesus with joy, beauty, and wonder in authentic worship.
        </p>
      </div>

      <!-- The Lord's Table -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-red-50 to-white border border-red-200/50 opacity-0 animate-fadeUp delay-500 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">🍷</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          The Lord's Table
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          At the Lord's Table we remember Jesus and His finished work. Celebrating His grace together.
        </p>
      </div>

      <!-- Extravagant Giving -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-amber-50 to-white border border-amber-200/50 opacity-0 animate-fadeUp delay-600 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">❤️</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          Extravagant Generosity
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          We give extravagantly. We help others passionately. Sharing is at the heart of who we are.
        </p>
      </div>

      <!-- Sent Out -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-pink-50 to-white border border-pink-200/50 opacity-0 animate-fadeUp delay-700 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">🚀</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          We Are Sent Out
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          We are sent out to live Jesus' story in our city, our nation, and the world.
        </p>
      </div>

      <!-- Kids Welcome -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-teal-50 to-white border border-teal-200/50 opacity-0 animate-fadeUp delay-800 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">👨‍👩‍👧‍👦</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          Kids @ The Life Place
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          Children are welcome to remain with their parents during service. Come. See. Jesus together.
        </p>
      </div>

      <!-- Warm Welcome -->
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-indigo-50 to-white border border-indigo-200/50 opacity-0 animate-fadeUp delay-900 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl mb-4">🙏</div>
        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          Warm Welcome
        </h3>
        <p class="text-base text-gray-700 leading-relaxed">
          You'll be greeted with genuine kindness. No pressure, no judgment—just a sincere, warm welcome.
        </p>
      </div>

    </div>

    <!-- First-Time Guest FAQs Section -->
    <div class="mt-24 pt-16 border-t border-gray-200">
      <h3 class="text-2xl md:text-3xl font-black text-gray-900 mb-10 text-center opacity-0 animate-fadeUp delay-100">
        First-Time Guest <span class="text-brand-red">FAQs</span>
      </h3>

      <!-- FAQ Accordion Grid -->
      <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- FAQ 1 -->
        <div class="faq-item p-6 rounded-2xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all opacity-0 animate-fadeUp delay-200">
          <h4 class="text-lg font-bold text-gray-900 mb-3">What time should I arrive?</h4>
          <p class="text-gray-700 leading-relaxed">
            Arrive 10–15 minutes early to settle in, find seating, and enjoy the atmosphere before service begins.
          </p>
        </div>

        <!-- FAQ 2 -->
        <div class="faq-item p-6 rounded-2xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all opacity-0 animate-fadeUp delay-300">
          <h4 class="text-lg font-bold text-gray-900 mb-3">What should I wear?</h4>
          <p class="text-gray-700 leading-relaxed">
            Wear what you're comfortable in—casual, smart, or in-between. Come as you are. We don't judge by appearance.
          </p>
        </div>

        <!-- FAQ 3 -->
        <div class="faq-item p-6 rounded-2xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all opacity-0 animate-fadeUp delay-400">
          <h4 class="text-lg font-bold text-gray-900 mb-3">How long is the service?</h4>
          <p class="text-gray-700 leading-relaxed">
            Our gatherings run for about 90 minutes, including worship, teaching, communion, and ministry moments.
          </p>
        </div>

        <!-- FAQ 4 -->
        <div class="faq-item p-6 rounded-2xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all opacity-0 animate-fadeUp delay-500">
          <h4 class="text-lg font-bold text-gray-900 mb-3">Will I be singled out as a guest?</h4>
          <p class="text-gray-700 leading-relaxed">
            No—you won't be asked to stand or introduce yourself. We're honored to have you, quietly and sincerely.
          </p>
        </div>

        <!-- FAQ 5 -->
        <div class="faq-item p-6 rounded-2xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all opacity-0 animate-fadeUp delay-600">
          <h4 class="text-lg font-bold text-gray-900 mb-3">Do I need to register?</h4>
          <p class="text-gray-700 leading-relaxed">
            No registration needed. Simply come. If an event requires registration, we'll make it clear.
          </p>
        </div>

        <!-- FAQ 6 -->
        <div class="faq-item p-6 rounded-2xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-lg transition-all opacity-0 animate-fadeUp delay-700">
          <h4 class="text-lg font-bold text-gray-900 mb-3">Can my children attend?</h4>
          <p class="text-gray-700 leading-relaxed">
            Children are welcome to remain with their parents during the service. A dedicated kids space will launch soon.
          </p>
        </div>

      </div>
    </div>

  </div>

</section>

<!-- ===== WHAT MAKES US DIFFERENT ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-br from-slate-900 via-black to-slate-900 relative overflow-hidden">
  
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-red/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6">
    
    <div class="mb-16 text-center opacity-0 animate-fadeUp delay-100">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-4">
        Why Visit The
        <span class="block text-brand-red">Life Place?</span>
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">We're not perfect, but we're passionate about Jesus</p>
    </div>

    <!-- Three Pillars -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      
      <div class="group p-10 rounded-3xl bg-gradient-to-br from-brand-red/20 to-red-600/10 border border-brand-red/40 opacity-0 animate-fadeUp delay-200 hover:from-brand-red/30 hover:to-red-600/20 hover:shadow-2xl hover:shadow-brand-red/20 transition-all duration-300">
        <div class="text-6xl mb-6">✝️</div>
        <h3 class="text-2xl md:text-3xl font-black text-white mb-4">Jesus-Centered</h3>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          Everything we do points to Jesus. He's not just mentioned—He's the heartbeat of every service.
        </p>
      </div>

      <div class="group p-10 rounded-3xl bg-gradient-to-br from-blue-500/20 to-blue-600/10 border border-blue-500/40 opacity-0 animate-fadeUp delay-300 hover:from-blue-500/30 hover:to-blue-600/20 hover:shadow-2xl hover:shadow-blue-500/20 transition-all duration-300">
        <div class="text-6xl mb-6">🤝</div>
        <h3 class="text-2xl md:text-3xl font-black text-white mb-4">Radically Welcome</h3>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          No matter your background, story, or struggles—you belong here. Period. We mean it.
        </p>
      </div>

      <div class="group p-10 rounded-3xl bg-gradient-to-br from-purple-500/20 to-purple-600/10 border border-purple-500/40 opacity-0 animate-fadeUp delay-400 hover:from-purple-500/30 hover:to-purple-600/20 hover:shadow-2xl hover:shadow-purple-500/20 transition-all duration-300">
        <div class="text-6xl mb-6">🔥</div>
        <h3 class="text-2xl md:text-3xl font-black text-white mb-4">Spirit-Empowered</h3>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          We depend on the Holy Spirit to transform hearts, heal wounds, and empower real change.
        </p>
      </div>

    </div>

  </div>

</section>

<!-- ===== FAQ SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-white">
  
  <div class="max-w-4xl mx-auto px-6">
    
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 mb-16 text-center opacity-0 animate-fadeUp delay-100">
      Common <span class="text-brand-red">Questions</span>
    </h2>

    <!-- FAQ Grid -->
    <div class="space-y-6">
      
      <div class="group p-8 rounded-3xl bg-gradient-to-br from-blue-50 to-white border border-blue-200/50 opacity-0 animate-fadeUp delay-200 hover:shadow-xl hover:border-brand-red transition-all">
        <h3 class="text-lg md:text-xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          What should I wear?
        </h3>
        <p class="text-base text-gray-700">
          Wear whatever makes you comfortable! We're casual and welcoming—jeans, suits, anything. It's not about appearance; it's about your heart.
        </p>
      </div>

      <div class="group p-8 rounded-3xl bg-gradient-to-br from-green-50 to-white border border-green-200/50 opacity-0 animate-fadeUp delay-300 hover:shadow-xl hover:border-brand-red transition-all">
        <h3 class="text-lg md:text-xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          Is there parking?
        </h3>
        <p class="text-base text-gray-700">
          Yes! We have accessible parking at our location. Just drive up and we'll help you find a spot. It's easy and stress-free.
        </p>
      </div>

      <div class="group p-8 rounded-3xl bg-gradient-to-br from-purple-50 to-white border border-purple-200/50 opacity-0 animate-fadeUp delay-400 hover:shadow-xl hover:border-brand-red transition-all">
        <h3 class="text-lg md:text-xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          What if I'm a skeptic or new to church?
        </h3>
        <p class="text-base text-gray-700">
          You're exactly who we want to see. We're not here to judge or pressure anyone—just to help you encounter Jesus in an honest way. Your questions are welcome.
        </p>
      </div>

      <div class="group p-8 rounded-3xl bg-gradient-to-br from-amber-50 to-white border border-amber-200/50 opacity-0 animate-fadeUp delay-500 hover:shadow-xl hover:border-brand-red transition-all">
        <h3 class="text-lg md:text-xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          Can I bring my kids?
        </h3>
        <p class="text-base text-gray-700">
          Absolutely! Children are welcomed and encouraged to stay with you during service. We're a family, and kids are valued members of our community.
        </p>
      </div>

      <div class="group p-8 rounded-3xl bg-gradient-to-br from-pink-50 to-white border border-pink-200/50 opacity-0 animate-fadeUp delay-600 hover:shadow-xl hover:border-brand-red transition-all">
        <h3 class="text-lg md:text-xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          How long is the service?
        </h3>
        <p class="text-base text-gray-700">
          Our service runs from 9:00 AM to 11:00 AM. That gives us time for worship, teaching, communion, and genuine connection as a community.
        </p>
      </div>

      <div class="group p-8 rounded-3xl bg-gradient-to-br from-teal-50 to-white border border-teal-200/50 opacity-0 animate-fadeUp delay-700 hover:shadow-xl hover:border-brand-red transition-all">
        <h3 class="text-lg md:text-xl font-black text-gray-900 mb-3 group-hover:text-brand-red transition-colors">
          What if I want to connect further?
        </h3>
        <p class="text-base text-gray-700">
          We'd love that! Stick around after the service to chat, grab coffee, or ask any questions. We have greeters and leaders ready to help you connect.
        </p>
      </div>

    </div>

  </div>

</section>

<!-- ===== CLOSING CTA ===== -->
<section class="w-full py-24 md:py-32 bg-gradient-to-r from-brand-red/95 via-red-600/90 to-brand-red/95 relative overflow-hidden">
  
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/15 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-black/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 text-center">
    
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-8 opacity-0 animate-fadeUp delay-100">
      We're Excited to Meet You
      <span class="block text-yellow-200 mt-3">This Sunday</span>
    </h2>

    <p class="text-lg md:text-xl text-white/95 max-w-2xl mx-auto mb-12 opacity-0 animate-fadeUp delay-200">
      No expectations. No judgment. Just a warm welcome and the good news of Jesus. Come as you are.
    </p>

    <div class="flex flex-col md:flex-row gap-6 justify-center opacity-0 animate-fadeUp delay-300">
      
      <a href="https://www.google.com/maps?q=51+Villa+Monte+Catini,+1+Elm+Avenue,+Craigavon+AH,+2191,+Sandton,+South+Africa" target="_blank" class="inline-block px-8 py-4 bg-white hover:bg-gray-100 text-brand-red font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
        Get Directions
      </a>

      <a href="/" class="inline-block px-8 py-4 bg-gradient-to-r from-white/20 to-white/10 hover:from-white/30 hover:to-white/20 text-white font-bold rounded-full border border-white/30 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 backdrop-blur-sm">
        Learn More
      </a>

    </div>

    <p class="text-white/80 text-sm mt-12 opacity-0 animate-fadeUp delay-400">
      Sundays: 9:00 AM – 11:00 AM<br/>
      51 Villa Monte Catini, 1 Elm Avenue, Craigavon AH, 2191, Sandton
    </p>

  </div>

</section>

<!-- Custom animations -->
<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }
  .delay-600 { animation-delay: 600ms; }
  .delay-700 { animation-delay: 700ms; }
  .delay-800 { animation-delay: 800ms; }
  .delay-900 { animation-delay: 900ms; }
  .delay-1000 { animation-delay: 1000ms; }
</style>

</BaseLayout>
