---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeDivider from "../components/tlp/FadeDivider.astro";
---

<BaseLayout 
  title="Ministries — Come. See. Jesus. | The Life Place"
  description="The Life Place — Come. See. Jesus. Explore our ministries: youth, families, relief, outreach, and more. Discover how to grow in Jesus and serve your community."
>

<!-- ===== MINISTRIES HERO SECTION ===== -->
<section class="relative w-full py-32 md:py-48 overflow-hidden flex items-center">
  <!-- Background overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-white via-gray-50 to-white"></div>
  
  <!-- Hero Content -->
  <div class="relative max-w-6xl mx-auto px-6 py-12 text-center z-10">
    <!-- Preheader -->
    <p class="text-base md:text-lg text-brand-red font-semibold uppercase tracking-[0.15em] mb-6 opacity-0 animate-fadeUp">Who we are</p>
    
    <!-- Main Heading -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black leading-tight text-gray-800 mb-8 opacity-0 animate-fadeUp delay-100">
      Our Community
    </h1>
    
    <!-- Subheading -->
    <p class="text-xl md:text-3xl text-gray-600 max-w-4xl mx-auto leading-relaxed font-medium mb-8 opacity-0 animate-fadeUp delay-200">
      Each ministry exists to help people see <span class="text-brand-red">Jesus</span> and live out His story in every sphere of life.
  </div>
</section>


<!-- Fade divider -->
<FadeDivider width="w-[50%]" height="h-[2px]" color="bg-gray-400" mt="mt-6 md:mt-8" mb="mb-16 md:mb-20" />

<!-- ===== MINISTRIES GRID ===== -->
<section class="w-full py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Grid of Ministry Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      
      <!-- Card 1: New @The Life Place -->
      <a href="/ministries/new-members/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">New @The Life Place</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          Start your journey with us. Get connected to our community and discover what it means to follow Jesus at The Life Place.
        </p>
      </a>

      <!-- Card 2: Bring Them to Jesus -->
      <a href="/ministries/bring-them-to-jesus/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Bring Them to Jesus</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          Share your faith and invite others to experience Jesus. Join us in reaching Sandton with the gospel.
        </p>
      </a>

      <!-- Card 3: Kids Ministry -->
      <a href="/ministries/kids/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Kids Ministry</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          We're passionate about helping children encounter Jesus in age-appropriate and engaging ways.
        </p>
      </a>

      <!-- Card 4: ThisGen -->
      <a href="/ministries/gen/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">ThisGen</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          A community for young adults to grow in faith, build authentic friendships, and discover God's calling.
        </p>
      </a>

      <!-- Card 5: Premarital Counseling -->
      <a href="/ministries/premarital-counseling/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Premarital Counseling</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          Prepare for marriage from a biblical perspective. Strengthen your relationship and build a Christ-centered foundation.
        </p>
      </a>

      <!-- Card 6: Life Place Institute -->
      <a href="/ministries/institute/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Life Place Institute</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          Deepen your understanding of Scripture and theology. Grow in your knowledge and love of Jesus.
        </p>
      </a>

      <!-- Card 7: Faith & Work -->
      <a href="/ministries/faith-and-work/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Faith & Work</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          Discover how to live out your faith in your workplace. Integrate Jesus into your professional life.
        </p>
      </a>

      <!-- Card 8: Relief Center -->
      <a href="/ministries/relief-center/" class="group rounded-3xl border border-gray-200 hover:border-brand-red/40 bg-white p-8 md:p-10 shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Relief Center</h3>
          </div>
          <span class="text-3xl text-gray-300 group-hover:text-brand-red transition-colors">→</span>
        </div>
        <p class="text-gray-600 text-base md:text-lg leading-relaxed">
          Serve those in need. Our relief center provides practical help and compassion to our community.
        </p>
      </a>

    </div>

  </div>
</section>

<!-- Fade divider -->
<FadeDivider width="w-[50%]" height="h-[2px]" color="bg-gray-400" mt="mt-16 md:mt-20" mb="mb-16 md:mb-24" />

<!-- ===== CTA SECTION ===== -->
<section class="w-full py-24 md:py-32 bg-gradient-to-r from-gray-50 to-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-4xl md:text-5xl font-black text-gray-800 mb-8">
      Ready to Get <span class="text-brand-red">Involved?</span>
    </h2>
    <p class="text-xl md:text-2xl text-gray-600 mb-10 leading-relaxed">
      Whether you're looking to grow in your faith, connect with community, or serve others, there's a place for you at The Life Place.
    </p>
    <a href="/visit" class="inline-flex items-center justify-center gap-2 px-10 py-5 min-w-[280px] bg-gradient-to-r from-brand-red to-red-600 hover:from-red-600 hover:to-red-700 text-white font-bold rounded-full shadow-lg hover:shadow-xl transition-all text-lg">
      Get Started Today
    </a>
  </div>
</section>

</BaseLayout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 {
    animation-delay: 0.1s;
  }

  .delay-200 {
    animation-delay: 0.2s;
  }

  .delay-300 {
    animation-delay: 0.3s;
  }
</style>
