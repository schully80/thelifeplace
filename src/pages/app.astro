---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="The Life Place App">

<!-- HERO SECTION -->
<section class="relative py-28 md:py-36 overflow-hidden">

  <!-- (Option 2) Transparent background: uses your site’s real background -->
  <div class="absolute inset-0 bg-transparent"></div>

  <!-- Floating Particles (extremely subtle) -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.04] animate-slowFloat"
       style="
         background-image:
           radial-gradient(circle at 20% 30%, rgba(0,0,0,0.25) 2px, transparent 2px),
           radial-gradient(circle at 80% 70%, rgba(0,0,0,0.25) 2px, transparent 2px),
           radial-gradient(circle at 50% 50%, rgba(0,0,0,0.25) 2px, transparent 2px);
         background-size: 300px 300px;
       ">
  </div>

  <!-- GLASS CARD -->
  <div class="relative max-w-3xl mx-auto px-6">
    <div
      class="backdrop-blur-xl bg-white/10 border border-white/20 
             shadow-2xl rounded-3xl px-10 py-16 text-center ring-1 ring-black/5"
    >
      <!-- Heading -->
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-gray-900 mb-4">
        The Life Place App
      </h1>

      <p class="text-lg md:text-xl text-gray-700 leading-relaxed max-w-2xl mx-auto">
        Stay connected with messages, live services, devotionals, giving, prayer, and more —
        all in one beautiful space.
      </p>

      <!-- QR Glass Card -->
      <div
        class="mt-12 mx-auto backdrop-blur-xl bg-white/20 rounded-3xl p-10 
               shadow-xl ring-1 ring-black/10 max-w-sm"
      >
        <img 
          src="/expo-qr.png"
          alt="Expo QR"
          class="w-40 h-40 mx-auto rounded-lg shadow"
        />

        <p class="mt-5 text-gray-800 text-lg font-medium">
          Scan to open in Expo Go
        </p>
        <p class="text-gray-600 text-sm mt-1">
          (Development Preview)
        </p>

        <!-- CTA -->
        <a
          href="https://expo.dev/"
          target="_blank"
          class="inline-flex items-center gap-2 mt-6 rounded-full px-6 py-3 
                 bg-brand-red text-white font-semibold shadow 
                 hover:bg-brand-red/90 hover:shadow-md active:scale-[0.97] 
                 transition-all"
        >
          Get Expo Go
          <svg 
            class="w-5 h-5"
            fill="none" stroke="currentColor" stroke-width="2"
            viewBox="0 0 24 24">
            <path d="M22 2 11 13" />
            <path d="M22 2 15 22 11 13 2 9 22 2z" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>


<!-- FEATURES -->
<section class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">

    <h2 class="text-3xl md:text-4xl font-semibold text-gray-900 text-center mb-14">
      What’s Inside the App
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">

      <div class="p-8 rounded-3xl border bg-white shadow-sm hover:shadow-lg transition-all">
        <div class="text-brand-red text-4xl mb-4">🎧</div>
        <h3 class="font-semibold text-xl text-gray-900 mb-2">Messages</h3>
        <p class="text-gray-600 text-sm">Watch & listen anytime.</p>
      </div>

      <div class="p-8 rounded-3xl border bg-white shadow-sm hover:shadow-lg transition-all">
        <div class="text-brand-red text-4xl mb-4">🙏</div>
        <h3 class="font-semibold text-xl text-gray-900 mb-2">Prayer</h3>
        <p class="text-gray-600 text-sm">Send a request anytime.</p>
      </div>

      <div class="p-8 rounded-3xl border bg-white shadow-sm hover:shadow-lg transition-all">
        <div class="text-brand-red text-4xl mb-4">📖</div>
        <h3 class="font-semibold text-xl text-gray-900 mb-2">Devotionals</h3>
        <p class="text-gray-600 text-sm">Grow daily in God’s Word.</p>
      </div>

      <div class="p-8 rounded-3xl border bg-white shadow-sm hover:shadow-lg transition-all">
        <div class="text-brand-red text-4xl mb-4">🎥</div>
        <h3 class="font-semibold text-xl text-gray-900 mb-2">Live</h3>
        <p class="text-gray-600 text-sm">Join from anywhere.</p>
      </div>

      <div class="p-8 rounded-3xl border bg-white shadow-sm hover:shadow-lg transition-all">
        <div class="text-brand-red text-4xl mb-4">💝</div>
        <h3 class="font-semibold text-xl text-gray-900 mb-2">Giving</h3>
        <p class="text-gray-600 text-sm">Simple & secure.</p>
      </div>

      <div class="p-8 rounded-3xl border bg-white shadow-sm hover:shadow-lg transition-all">
        <div class="text-brand-red text-4xl mb-4">📅</div>
        <h3 class="font-semibold text-xl text-gray-900 mb-2">Events</h3>
        <p class="text-gray-600 text-sm">Never miss what's happening.</p>
      </div>

    </div>
  </div>
</section>


<!-- SLOGAN -->
<section class="py-20 bg-white text-center">
  <p class="text-xl text-gray-700 font-medium">
    Come. See.  
    <span class="relative inline-block premium-underline text-brand-red font-semibold">
      Jesus
      <span class="gradient-underline"></span>
    </span>
  </p>
</section>


<style>
  @keyframes slowFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(10px); }
  }
  .animate-slowFloat {
    animation: slowFloat 7s ease-in-out infinite alternate;
  }

  .premium-underline {
    position: relative;
    display: inline-block;
  }
  .gradient-underline {
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg,
      rgba(179, 40, 45, 0) 0%,
      rgba(179, 40, 45, 1) 50%,
      rgba(179, 40, 45, 0) 100%
    );
    background-size: 200% 100%;
    animation: gradientSlide 2.8s ease-in-out infinite;
    border-radius: 999px;
  }
  @keyframes gradientSlide {
    0% { background-position: 200% 0; opacity: 0.5; }
    50% { background-position: 0% 0; opacity: 1; }
    100% { background-position: -200% 0; opacity: 0.5; }
  }
</style>

</BaseLayout>
