---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisitLocation } from "../../content/shared-content.js";

const visitLocation = getVisitLocation();
const SUBSTACK_URL = "https://schulteretyang.substack.com";
---

<BaseLayout
  title="Leadership | Schulter and Genevieve Etyang"
  description="Meet Schulter and Genevieve Etyang, founding pastors of The Life Place. Learn their story, their heart for Jesus, and how to visit The Life Place this Sunday."
>
  <main class="bg-white text-gray-900">
    <section class="grid bg-gray-50 lg:min-h-[640px] lg:grid-cols-[0.95fr_1.05fr] xl:min-h-[680px]">
      <div class="aspect-[3/2] overflow-hidden rounded-br-[2rem] bg-gray-100 sm:aspect-[16/9] md:aspect-[3/2] lg:aspect-auto lg:min-h-[640px] lg:rounded-br-[3rem] xl:min-h-[680px]">
        <img
          src="/founders-grayscale.jpg"
          alt="Schulter and Genevieve Etyang"
          class="h-full w-full object-cover object-[48%_40%] grayscale sm:object-[center_40%] lg:object-[center_45%]"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="flex min-w-0 flex-col justify-center px-5 py-8 sm:px-8 sm:py-10 md:px-12 lg:px-12 lg:py-12 xl:px-24">
        <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.16em] text-brand-red sm:mb-5">Leadership</p>
        <h1 class="max-w-3xl text-balance text-4xl font-black leading-[0.98] tracking-[-0.035em] text-gray-900 sm:text-6xl sm:leading-[0.96] sm:tracking-[-0.04em] md:text-6xl xl:text-8xl">
          Schulter and Genevieve Etyang
        </h1>
        <p class="mt-5 max-w-2xl text-balance text-base font-semibold leading-7 text-gray-600 sm:mt-6 sm:text-xl sm:leading-9 lg:text-lg lg:leading-8 xl:text-2xl xl:leading-10">
          As founding pastors of The Life Place, a community shaped by the beauty of Jesus and His grace, they are
          passionate about helping people Come. See. Jesus.
        </p>
        <div class="mt-5 max-w-2xl rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:mt-6 sm:p-5 lg:mt-5">
          <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-gray-500">Join us this Sunday</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:gap-3 xl:gap-4">
            <div class="flex items-start gap-3">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red xl:h-10 xl:w-10">
                <i class="fa-regular fa-clock" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-gray-500">Time</p>
                <p class="mt-1 text-sm font-black leading-6 text-gray-900 xl:text-base">9:00 to 11:00 AM</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red xl:h-10 xl:w-10">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-gray-500">Place</p>
                <p class="mt-1 text-sm font-black leading-6 text-gray-900 xl:text-base">
                  {visitLocation.addressLines?.[0] ?? "The Life Place"}
                </p>
                <p class="mt-1 text-sm font-semibold leading-6 text-gray-600">Craigavon AH, Sandton</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4 flex max-w-2xl flex-col justify-center gap-3 sm:flex-row">
          <a
            href="/visit/"
            class="inline-flex min-h-12 items-center justify-center rounded-2xl bg-brand-red px-6 py-3 text-base font-bold text-white shadow-sm transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-[#9F2429] hover:shadow-lg active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
          >
            Plan A Visit
          </a>
          <a
            href="/live/"
            class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-gray-300 bg-white px-6 py-3 text-base font-bold text-gray-900 transition-[border-color,background-color,transform] duration-200 ease-out hover:border-gray-500 hover:bg-gray-50 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
          >
            Watch Live
          </a>
        </div>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 sm:py-20 md:py-28">
      <div class="mx-auto max-w-5xl">
        <p class="mb-6 text-sm font-extrabold uppercase tracking-[0.16em] text-brand-red">From our leaders</p>
        <blockquote class="text-balance text-3xl font-black leading-[1.1] tracking-[-0.03em] text-gray-900 sm:text-4xl md:text-5xl lg:text-6xl">
          We are intentional about The Life Place being a community where all that we are and do communicates the beauty, gentleness, and kindness of who <span class="text-brand-red">Jesus</span> is.
        </blockquote>
      </div>
    </section>

    <section class="bg-gray-50 px-5 py-16 sm:px-6 sm:py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div class="max-w-xl">
          <p class="mb-5 text-sm font-extrabold uppercase tracking-[0.16em] text-brand-red">Their story</p>
          <h2 class="text-balance text-3xl font-black leading-[1.08] tracking-[-0.03em] text-gray-900 sm:text-4xl md:text-5xl">
            A story of grace, friendship, and helping people see Jesus.
          </h2>
        </div>

        <div class="max-w-3xl text-base font-medium leading-8 text-gray-600 sm:text-lg sm:leading-9">
          <div class="space-y-5">
            <p>
              Schulter and Genevieve serve The Life Place through teaching, pastoral care, leadership, and the slow work
              of building a Jesus-centered community in Sandton, South Africa.
            </p>
            <p>
              Beyond ministry, they love family life, meaningful conversations, good friends, good food, music, hiking,
              exercise, and the simple joys that make life beautiful.
            </p>
            <p>
              Schulter also writes regularly about Jesus, the gospel of grace, the new covenant, and what they mean for
              everyday life.
            </p>
          </div>

          <div class="mt-8 flex justify-center">
            <a
              href={SUBSTACK_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Read Schulter's Substack, opens in a new tab"
              class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-gray-200 bg-white px-6 py-3 text-base font-bold text-brand-red transition-[border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:bg-white hover:shadow-md active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
            >
              Read Schulter's Substack
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-6 sm:py-20 md:py-28">
      <div class="mx-auto max-w-6xl rounded-[2rem] bg-brand-red px-6 py-8 text-white shadow-[0_18px_40px_rgba(179,40,45,0.24)] sm:px-8 sm:py-10 md:px-10 md:py-12">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-white/75">Our invitation</p>
          <h2 class="mt-4 text-balance text-4xl font-black leading-none tracking-[-0.035em] text-white sm:text-5xl md:text-6xl">
            Come. See. Jesus.
          </h2>
          <p class="mt-5 text-base font-semibold leading-7 text-white/90 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
            If you are visiting for the first time, you will find a warm welcome, clear teaching, and a church
            community making room for Jesus.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
