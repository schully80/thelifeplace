---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisitLocation } from "../../content/shared-content.js";

const visitLocation = getVisitLocation();
const SUBSTACK_URL = "https://schulteretyang.substack.com";
const serviceAddress = visitLocation.addressLines?.[0] ?? "The Life Place";
---

<BaseLayout
  title="Leadership | Schulter & Jenny"
  description="Meet Schulter and Jenny Etyang, founding pastors of The Life Place. Learn their story, their heart for Jesus, and how to visit The Life Place this Sunday."
>
  <main class="bg-white text-gray-900">
    <section class="bg-gray-50 px-5 py-12 sm:px-6 sm:py-16 md:py-24 lg:py-28">
      <div class="mx-auto grid max-w-7xl gap-10 md:gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div class="min-w-0 max-w-2xl lg:order-2">
          <p class="mb-5 text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Leadership</p>
          <h1 class="text-balance text-3xl font-black leading-tight text-gray-900 sm:text-4xl md:text-6xl lg:text-7xl">
            Schulter and Genevieve Etyang
          </h1>
          <div class="mt-7 space-y-5 text-base font-medium leading-7 text-gray-600 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
            <p>
              Schulter and Genevieve are the founding pastors of
              <span class="font-semibold text-brand-red">The Life Place</span>.
            </p>
            
            <p>
They are passionate about helping people see Jesus and encounter the beauty of His grace.
          Their lives and leadership have been shaped by one simple invitation:
              <span class="font-semibold text-brand-red">Come. See. Jesus.</span>
            </p>
             <p>
            Together, they serve the church through teaching, pastoral care, leadership, and building a community
            where <span class="text-brand-red">Jesus</span> is seen as true, good, beautiful, and kind.
          </p>
            <p>
              They care deeply about people encountering the beauty of
              <span class="text-brand-red">Jesus</span> and the kindness of His grace in everyday life.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-3xl bg-gray-100 shadow-xl lg:order-1">
          <img
            src="/founders-grayscale.jpg"
            alt="Schulter and Genevieve Etyang"
            class="h-[300px] w-full object-cover object-center grayscale transition-transform duration-500 motion-safe:hover:scale-105 sm:h-[340px] md:h-[560px] lg:h-[640px]"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="cookie-safe-section px-5 py-14 sm:px-6 sm:py-16 md:py-24">
      <div class="mx-auto max-w-4xl">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.24em] text-brand-red">From our leaders</p>
        <h2 class="max-w-4xl text-balance text-2xl font-black leading-snug tracking-[0.02em] text-gray-900 sm:text-3xl sm:leading-tight md:text-5xl">
          "We are intentional about The Life Place being a community. Where all that we are and do communicates the beauty, gentleness and kindness of who
            <span class="text-brand-red">Jesus</span> is."
        </h2>
      </div>
    </section>

    <section class="bg-gray-50 px-5 py-14 sm:px-6 sm:py-16 md:py-20">
      <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-[0.7fr_1.3fr] md:items-start">
        <div>
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Bio</p>
          
        </div>

        <div class="flex flex-col items-center space-y-6 text-base font-medium leading-7 text-gray-600 sm:text-lg sm:leading-8 md:items-start">
        
         
          <p>
            Outside of ministry, they enjoy family life, meaningful conversations, friends, good food, music, hikes, exercise and the simple joys of life. 
 
          </p>
          <p>
            Schulter writes regularly about Jesus, the gospel of grace, the new covenant, and what they mean for
            everyday life.
          </p>
          <a
            href={SUBSTACK_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Read Schulter's Substack, opens in a new tab"
            class="inline-flex min-h-12 items-center justify-center self-center rounded-2xl border border-brand-red px-6 py-3 text-base font-bold text-brand-red transition hover:bg-brand-red hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
          >
            Read Schulter's Substack
          </a>
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-6 sm:py-16 md:py-24">
      <div class="mx-auto max-w-6xl rounded-[2rem] bg-brand-red px-6 py-8 text-white shadow-[0_18px_40px_rgba(179,40,45,0.24)] sm:px-8 sm:py-10 md:px-10 md:py-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="max-w-3xl">
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-white/75">Join us this Sunday</p>
            <h2 class="mt-4 text-balance text-3xl font-black leading-tight text-white sm:text-4xl md:text-5xl">
              Come. See. Jesus.
            </h2>
            <p class="mt-5 text-base font-medium leading-7 text-white/90 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
              If you are visiting for the first time, you will find a warm welcome, clear teaching, and a church
              community making room for Jesus.
            </p>
            <p class="mt-5 text-sm font-semibold uppercase tracking-[0.16em] text-white/75 sm:text-base sm:tracking-[0.18em]">
              Sundays, 9:00 to 11:00. {serviceAddress}
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a
              href="/visit/"
              class="inline-flex min-h-12 items-center justify-center rounded-2xl bg-white px-7 py-3 text-base font-bold text-brand-red shadow-sm transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-[#FDECEC] hover:shadow-lg active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-brand-red"
            >
              Plan A Visit
            </a>
            <a
              href="/live/"
              class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-white/40 bg-transparent px-7 py-3 text-base font-bold text-white transition-[border-color,background-color,transform] duration-200 ease-out hover:border-white/70 hover:bg-white/10 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-brand-red"
            >
              Watch Live
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    :global(html.cookie-consent-visible) .cookie-safe-section {
      padding-top: calc(8rem + var(--tlp-cookie-consent-height, 0px));
    }

    @media (min-width: 768px) {
      :global(html.cookie-consent-visible) .cookie-safe-section {
        padding-top: calc(10rem + var(--tlp-cookie-consent-height, 0px));
      }
    }
  </style>
</BaseLayout>
