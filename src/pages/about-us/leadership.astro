---
import BaseLayout from "../../layouts/BaseLayout.astro";

const SCHULTER_WEBSITE_URL = "https://schulteretyang.substack.com";
---

<BaseLayout
  title="Leadership | Schulter and Genevieve Etyang"
  description="Meet Schulter and Genevieve Etyang, founding pastors of The Life Place. Learn their story, their heart for Jesus, and how to visit The Life Place this Sunday."
>
  <main class="bg-white text-gray-900">
    <section class="bg-gray-50 px-5 py-[clamp(3.5rem,7vw,6rem)] sm:px-6">
      <div class="mx-auto max-w-5xl text-left">
        <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-brand-red">Leadership</p>
        <h1 class="mt-3 text-balance text-3xl font-black leading-[0.96] tracking-[-0.04em] text-gray-900 sm:text-lg md:text-4xl lg:text-5xl">
          Schulter and Genevieve Etyang
        </h1>
      </div>
    </section>

    <section class="px-5 pb-[clamp(3.5rem,7vw,6rem)] sm:px-6">
      <div class="mx-auto max-w-5xl overflow-hidden rounded-[2rem] bg-gray-100 shadow-sm md:rounded-[3rem]">
        <picture>
          <source type="image/webp" srcset="/images/founders-grayscale-960.webp 960w, /images/founders-grayscale-1600.webp 1600w" sizes="(max-width: 1023px) 100vw, 64rem" />
          <img
          src="/founders-grayscale.jpg"
          alt="Schulter and Genevieve Etyang"
          class="aspect-[4/3] w-full object-cover object-[52%_38%] grayscale sm:aspect-[16/10] lg:aspect-[16/9] lg:object-[center_42%]"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          />
        </picture>
      </div>
    </section>

    <section class="bg-gray-50 px-5 py-[clamp(4.5rem,10vw,9rem)] sm:px-6">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-[clamp(3rem,7vw,7rem)]">
        <div class="max-w-xl">
          <p class="mb-5 text-sm font-extrabold uppercase tracking-[0.16em] text-brand-red">Their story</p>
          <h2 class="text-balance text-3xl font-black leading-[1.08] tracking-[-0.03em] text-gray-900 sm:text-4xl md:text-5xl">
            A story of grace, friendship, and helping people see Jesus.
          </h2>
        </div>

        <div class="max-w-3xl text-base font-medium leading-8 text-gray-600 sm:text-lg sm:leading-9">
          <div class="space-y-5">
            <p>
              Schulter and Genevieve serve The Life Place through teaching, pastoral care, leadership, and the slow work
              of building a Jesus-centered community in Sandton, South Africa.
            </p>
            <p>
              Beyond ministry, they love family life, meaningful conversations, good friends, good food, music, hiking,
              exercise, and the simple joys that make life beautiful.
            </p>
            <p>
              Schulter speaks and writes regularly about Jesus, the gospel of grace, the new covenant, and what they mean for
              everyday life.
            </p>
          </div>

          <div class="mt-8 flex justify-center">
            <a
              href={SCHULTER_WEBSITE_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit schulteretyang.com, opens in a new tab"
              class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-gray-200 bg-white px-6 py-3 text-base font-bold text-brand-red transition-[border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:bg-white hover:shadow-md active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
            >
              schulteretyang.com
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-[clamp(4.5rem,10vw,9rem)] sm:px-6">
      <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-[minmax(10rem,0.35fr)_minmax(0,1fr)] lg:gap-12">
        <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-brand-red lg:pt-3">Schulter and Genevieve Etyang</p>
        <blockquote class="max-w-5xl text-balance text-3xl font-black leading-[1.1] tracking-[-0.03em] text-gray-900 sm:text-4xl md:text-5xl lg:text-6xl">
          "We are intentional about The Life Place being a community where everything we are and do communicates the beauty, gentleness, and kindness of <span class="text-brand-red">Jesus</span>."
        </blockquote>
      </div>
    </section>

    <section class="px-5 py-[clamp(4.5rem,10vw,9rem)] sm:px-6">
      <div class="mx-auto max-w-6xl rounded-[2rem] bg-brand-red px-6 py-8 text-white shadow-[0_18px_40px_rgba(179,40,45,0.24)] sm:px-8 sm:py-10 md:px-10 md:py-12">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-white/75">Our invitation</p>
          <h2 class="mt-4 text-balance text-2xl font-black leading-none tracking-[-0.035em] text-white sm:text-4xl md:text-4xl">
            Come. See. Jesus.
          </h2>
          <p class="mt-5 text-base font-semibold leading-7 text-white/90 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
            If you are visiting for the first time, you will find a warm welcome, clear teaching, and a church
            community making room for Jesus.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
