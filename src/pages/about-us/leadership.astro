---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
const SNAPSCAN_URL = "https://pos.snapscan.io/qr/VISFNLkM";
const PAYPAL_URL = "https://www.paypal.com/paypalme/thelifeplace";
---

<BaseLayout title="Leadership – Schulter & Genevieve" 
  description="Learn about the leadership of The Life Place, led by Schulter and Genevieve Etyang. Discover their story, vision, and passion for helping people encounter Jesus and live out His story in every sphere of life."
>

<!-- ===========================
      HERO — Cinematic & Pastoral (Swapped Order)
=========================== -->
<section class="w-full bg-gray-50 min-h-auto justify-center flex items-center py-4 md:py-32 mt-0">
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid lg:grid-cols-2 gap-16 items-center">



    <!-- RIGHT — TEXT BLOCK (moved to be FIRST in DOM for UX flow) -->
    <div class="relative flex items-center justify-center text-center md:text-left -mt-2 md:-mt-0 mb-6 md:mb-8 font-body z-[5] order-3 lg:order-2">

      <!-- Soft ambient glow -->
      <div 
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.35),transparent_70%)]
               blur-[80px] opacity-80 -z-10 pointer-events-none">
      </div>

      <div class="max-w-7xl space-y-4 md:space-y-6 lg:space-y-8">

        <!-- PASTORS NAME — Premium Apple-Style Heading (desktop only) -->
        <div class="w-full mb-10 md:mb-12 lg:mb-8 hidden lg:block">
          <h1 
            class="block text-gray-800 text-2xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-relaxed antialiased"
          >Schulter & Genevieve Etyang</h1>
        </div>

        <p class="text-lg md:text-2xl md:text-center lg:text-justify leading-relaxed text-gray-600">
          Schulter and Genevieve lead 
          <span class="text-brand-red">The Life Place</span>.
        </p>

        <p class="text-lg md:text-2xl md:text-center lg:text-justify leading-relaxed text-gray-600">
        Fifteen years ago, the good news of who Jesus is became real to us.  
          Since then, our lives have been shaped by one simple invitation —  
          <span class="font-semibold text-brand-red">Come. See. Jesus</span>.
        </p>

        <p class="text-lg md:text-2xl md:text-center lg:text-justify leading-relaxed text-gray-600">
          It remains the heartbeat of our lives, our conversations,  
          and the community we serve.
        </p>

        <p class="text-lg md:text-2xl md:text-center lg:text-justify leading-relaxed text-gray-600">
          We care deeply about people discovering how true, good, beautiful,  
          and kind <span class="text-brand-red">Jesus</span> is.
        </p>

        <p class="text-center text-lg md:text-2xl md:text-center lg:text-center leading-relaxed text-gray-600">
          Seeing <span class="text-brand-red">Jesus</span> changes everything.
        </p>

      </div>
    </div>

    <!-- LEFT — IMAGE BLOCK (moved to second position) -->

    <!-- PASTORS NAME — Mobile & Tablet (visible only on md and below, placed above image) -->
    <div class="w-full mt-12 md:mt-6 md:mb-8 block lg:hidden">
      <h1 class="block text-center md:text-center text-gray-800 text-3xl md:text-6xl font-extrabold tracking-tight leading-relaxed antialiased">
        Schulter & Genevieve <br>Etyang
      </h1>
    </div>

    <div class="relative w-[calc(100%+2rem)] md:w-full h-[300px] md:h-[560px] lg:h-[620px] -mt-6 mb-6 md:mb-0 -mx-4 md:mx-0 lg:mx-0
          overflow-hidden rounded-3xl shadow-xl order-2 lg:order-1">

    

      <img 
        id="pastorsPhoto"
        src="/founders-grayscale.jpg"
        alt="Schulter & Genevieve Etyang"
        class="w-full h-full object-cover object-center grayscale transition-transform duration-500 hover:scale-105 cine-zoom-apple-hover"
      />
    </div>

  </div>
</section>

<!-- Add extra margin between sections -->
<div class="my-32"></div>


<!-- ===========================
       CONNECT • PARTNER • SUBSCRIBE
=========================== -->
<div class="my-24"></div>

<section class="max-w-5xl mx-auto px-6 pt-8 md:pt-12 pb-20 md:pb-24 mt-0 bg-gray-50">

  <h2 class="font-body block text-center text-3xl md:text-4xl lg:text-5xl font-semibold text-gray-800 mb-10">
    CONNECT • PARTNER • SUBSCRIBE
  </h2>
  

  <!-- INTRO PARAGRAPH -->
  <p class="text-left text-lg md:text-2xl leading-relaxed text-gray-800 max-w-3xl mx-auto mb-10 md:mb-14">
    Schulter writes regularly at 
    <a 
      href="https://schulteretyang.substack.com" 
      target="_blank"
      class="text-brand-red underline hover:no-underline"
    >
      schulteretyang.substack.com,
    </a>
    exploring Jesus, the gospel of grace, the new covenant and their meaning for everyday life.
  </p>

  <!-- GRID CARDS -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-12 lg:gap-16">

    <!-- SUBSTACK CARD -->
    <a href="https://schulteretyang.substack.com" target="_blank" class="group p-6 rounded-3xl border border-gray-200 bg-gray-50 hover:bg-white hover:shadow-xl transition-all flex items-center gap-6">
      <img src="/substack-qr2.png" width="140" height="140" class="rounded-2xl border flex-shrink-0" />
      <div class="space-y-2">
        <h3 class="font-heading text-xl font-semibold group-hover:text-brand-red transition">Subscribe to Schulter's Substack</h3>
        <p class="text-gray-700 text-sm leading-relaxed">
          Scan or tap below to receive new articles and reflections.
        </p>
        <span class="inline-flex items-center justify-center rounded-2xl px-5 py-2 text-brand-red border border-brand-red group-hover:bg-brand-red group-hover:text-white transition font-medium">
          Substack
        </span>
      </div>
    </a>

    <!-- SNAPSCAN CARD -->
    <a href={SNAPSCAN_URL} target="_blank" class="group p-6 rounded-3xl border border-gray-200 bg-gray-50 hover:bg-white hover:shadow-xl transition-all flex items-center gap-6">
      <img src="/snapscan-qr2.png" width="140" height="140" class="rounded-2xl border flex-shrink-0" />
      <div class="space-y-2">
        <h3 class="font-heading text-xl font-semibold group-hover:text-brand-red transition">Partner with The Life Place</h3>
        <p class="text-gray-700 text-sm leading-relaxed">
          Scan or tap to open our giving portal.
        </p>
        <span class="inline-flex items-center justify-center rounded-2xl px-5 py-2 text-brand-red border border-brand-red group-hover:bg-brand-red group-hover:text-white transition font-medium">
          SnapScan
        </span>
      </div>
    </a>

  </div>


  <!-- PAYPAL CARD -->
  <div class="max-w-xl mx-auto mt-12 md:mt-16">
    <a href={PAYPAL_URL} target="_blank" class="group p-6 rounded-3xl border border-gray-200 bg-gray-50 hover:bg-white hover:shadow-xl transition-all flex items-center gap-6">
      <!-- PayPal QR/Icon -->
      <div class="flex-shrink-0 w-[140px] h-[140px] rounded-2xl border border-brand-red bg-white flex items-center justify-center">
        <i class="fa-brands fa-paypal text-brand-red text-5xl" aria-hidden="true"></i>
      </div>

      <!-- Text -->
      <div class="space-y-2">
        <h3 class="font-heading text-xl font-semibold group-hover:text-brand-red transition">Support via PayPal</h3>
        <p class="text-gray-700 text-sm leading-relaxed">
          Donate securely through PayPal. Tap below to open our giving portal.
        </p>
        <span class="inline-flex items-center justify-center rounded-2xl px-5 py-2 text-brand-red border border-brand-red group-hover:bg-brand-red group-hover:text-white transition font-medium">
          PayPal 
        </span>
      </div>
    </a>
  </div>

  <p class="text-center text-sm text-gray-600 mt-6">
    If QR codes don’t scan, tap the buttons to open the links instantly.
  </p>

</section>

  <!-- Final Invitation -->
<section class="py-24 md:py-32 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    
    <h2 class="text-4xl md:text-5xl font-black mb-6 text-gray-800">
      Come. See. <span class="text-brand-red">Jesus</span>
    </h2>

    <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
      Join us this Sunday.

  </div>
</section>
<style>
/* Fade + Lift + Scale Entrance */
.motion-card {
  opacity: 0;
  transform: translateY(50px) scale(0.97);
  transition: opacity 1s ease, transform 1.2s cubic-bezier(.16,1,.3,1);
}
.motion-card.visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* Floaty animation (Values-style) */
.value-card {
  animation: floaty 16s ease-in-out infinite;
}
@keyframes floaty {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
  100% { transform: translateY(0px); }
}

/* Hover tilt effect */
.value-card:hover {
  transform: perspective(900px) rotateX(3deg) rotateY(-2deg) scale(1.02);
}
</style>

<script>
const cards = document.querySelectorAll(".motion-card");

function revealCards() {
  const trigger = window.innerHeight * 0.88;

  cards.forEach(card => {
    if (card.getBoundingClientRect().top < trigger) {
      card.classList.add("visible");
    }
  });
}

window.addEventListener("scroll", revealCards);
window.addEventListener("load", revealCards);
</script>



</BaseLayout>
