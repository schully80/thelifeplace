    </div>

    <!-- RIGHT CARD -->
    <div class="flex items-center">
      <div class="value-card w-full max-w-[560px] p-12 rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20">

        <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6">
          See <span class="text-brand-red">Jesus.</span><br/>Hear the Good News.
