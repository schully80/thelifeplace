---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Slogan from "../../components/Slogan.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
import AppDownloadCard from "../../components/AppDownloadCard.astro";
---

<BaseLayout title="Our Values">


<!-- HERO IMAGE SECTION — Full-Bleed using CSS Grid Escape -->
<section class="w-[100vw] h-[50vh] md:h-[70vh] overflow-hidden tlp-grayscale rounded-none" style="margin-left: calc(50% - 50vw); position: relative;">
  <img
    src="/our-values6.jpg"
    alt="Our Values Hero"
    class="absolute inset-0 w-full h-full object-cover object-center rounded-none"
    style="z-index:0;"
  />
  <!-- ensure any overlay/text sits above the image -->
  <div class="absolute inset-0 pointer-events-none" style="z-index:1"></div>
</section>

<!-- ====================================================== -->
<!-- INTRO NARRATIVE — FULL LEFT-ALIGNED BLOCK -->
<!-- ====================================================== -->
<section class="w-full py-32 bg-white">
  <div class="w-full px-6 lg:px-12 xl:px-20">

    <div class="max-w-5xl text-left">
      <p class="text-2xl md:text-3xl font-medium text-gray-800 leading-relaxed">
        We are intentional about The Life Place being a community where all that
        we are and do communicates the beauty, gentleness and kindness of who <span class="text-brand-red">Jesus</span> is and what He did for us—a community defined and sweetened by the gospel.
      </p>

      <p class="mt-6 text-gray-500 text-xl text-right">
        Schulter & Genevieve Etyang
      </p>
    </div>

  </div>
</section>

<FadeDivider mt="mt-2" mb="mb-20" />


<!-- ====================================================== -->
<!-- VALUE 1 — SECTION INTRO (Option A Badge) -->
<!-- ====================================================== -->
<section class="w-full py-32">
  <div class="max-w-4xl mx-auto px-6">

    <!-- BADGE + TITLE -->
    <div class="flex items-center gap-6 mb-10">
      <div class="h-14 w-14 rounded-full bg-gray-200 flex items-center justify-center">
        <span class="text-brand-red font-black text-2xl">1</span>
      </div>

      <h2 class="text-3xl md:text-6xl font-black tracking-tight text-gray-900">
        Seeing <span class="text-brand-red">Jesus</span> in the Bible
      </h2>
    </div>

    <!-- NARRATIVE -->
    <p class="text-2xl md:text-3xl font-regular text-gray-800 leading-relaxed">
     Just as <span class="text-brand-red">Jesus</span> taught that everything in the Bible points to Him,
     so we believe that every time we open the Bible, we are invited to see and meet with Him.

    </p>

    <p class="mt-6 text-gray-500 text-lg text-center">
      (Luke 24:47; John 1:19-35, 5:39, 46, 12:26-27, 13:3)
    </p>

  </div>
</section>


<!-- VALUE 1 — CARD SECTION -->
<section id="value-1" class="w-full px-6 pt-24 pb-32 bg-gray-50">
