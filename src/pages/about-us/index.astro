---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisitLocation } from "../../content/shared-content.js";

const visitLocation = getVisitLocation();

const values = [
  {
    title: "Seeing Jesus in the Bible",
    icon: "fa-solid fa-book-open",
    body:
      "When we open the Bible, we look for Jesus: who He is, what He has done, and how His grace meets real life.",
    references: "Luke 24:47; John 5:39, 46; John 12:26-27",
  },
  {
    title: "Diverse Community",
    icon: "fa-solid fa-users",
    body:
      "We want our community to reflect the city God is building: many cultures, stories, and families gathered by grace.",
    references: "Acts 2:46-47; Ephesians 3; Revelation 7:9",
  },
  {
    title: "Extravagant Generosity",
    icon: "fa-solid fa-hand-holding-heart",
    body:
      "Because Jesus has been generous to us, we give, share, serve, and open our lives with joy.",
    references: "Acts 2:45; 2 Corinthians 8:2-4; 9:1-15",
  },
  {
    title: "Graceful Compassion",
    icon: "fa-solid fa-hands-helping",
    body:
      "The grace of Jesus moves us toward people who are overlooked, burdened, isolated, or in need.",
    references: "Deuteronomy 10:18; Matthew 25:35-40; James 1:27",
  },
  {
    title: "Go and tell the story",
    icon: "fa-solid fa-bullhorn",
    body:
      "The story of Jesus moves through us into our city, our nation, and the world through words, presence, and action.",
    references: "Luke 8:39; John 17:18; 1 Corinthians 9:23",
  },
];
---

<BaseLayout
  title="About Us | The Life Place"
  description="The Life Place is a Jesus-centered church in Craigavon AH, Sandton. Learn our story, values, leadership, beliefs, and how to join us on Sunday from 9:00 to 11:00."
>
  <main class="about-page bg-white text-gray-800">
    <section class="relative isolate min-h-[560px] overflow-hidden md:min-h-[640px]">
      <img
        src="/sandton-skyline-grayscale.jpg"
        alt="Sandton skyline near The Life Place"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(17,24,39,0.82),rgba(17,24,39,0.48),rgba(17,24,39,0.24))]"></div>

      <div class="relative z-10 mx-auto flex min-h-[560px] max-w-7xl items-center px-6 py-20 md:min-h-[640px]">
        <div class="max-w-4xl">
          <p class="mb-5 text-sm font-bold uppercase tracking-[0.16em] text-white/75">About The Life Place</p>
          <h1 class="max-w-4xl text-5xl font-black leading-[1.02] text-white sm:text-6xl md:text-7xl lg:text-8xl">
            Every time we meet, we see how true, good, beautiful, and kind Jesus is.
          </h1>
        </div>
      </div>
    </section>

    <section class="border-b border-gray-200 bg-gray-50">
      <div class="mx-auto grid max-w-7xl gap-0 px-6 py-8 md:grid-cols-3 md:py-10">
        <div class="border-b border-gray-200 py-5 md:border-b-0 md:border-r md:pr-8">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">Every Sunday</p>
          <p class="mt-2 text-2xl font-black text-gray-900">9:00-11:00</p>
        </div>
        <div class="border-b border-gray-200 py-5 md:border-b-0 md:border-r md:px-8">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">Location</p>
          <p class="mt-2 text-lg font-bold text-gray-900">{visitLocation.addressLines[0]}</p>
          <p class="text-gray-600">{visitLocation.addressLines.slice(1).join(", ")}</p>
        </div>
        <div class="py-5 md:pl-8">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-gray-500">First time?</p>
          <a href="/visit/" class="mt-2 inline-flex font-bold text-brand-red transition hover:text-brand-red-hover">
            Get directions and know what to expect
          </a>
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Who we are</p>
          <h2 class="text-4xl font-black leading-tight text-gray-900 md:text-6xl">
            We meet to see Jesus and let His finished work shape our everyday lives.
          </h2>
        </div>
        <div class="space-y-6 text-lg font-medium leading-8 text-gray-600 md:text-xl md:leading-9">
          <p>
            The Life Place exists to help people see Jesus clearly and follow Him in real life.
          </p>
          <p>
            Our invitation is simple: Come. See. Jesus.
          </p>
          <p>
            If you are exploring faith, returning to church, or looking for a place for your family,
            you are welcome this Sunday.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-gray-50 px-6 py-20 md:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 max-w-3xl">
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Our values</p>
          <h2 class="text-4xl font-black leading-tight text-gray-900 md:text-6xl">
            How we live out our vision as a community.
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {values.map((value) => (
            <article class="rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-sm transition-[border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:bg-gray-50 hover:shadow-md active:scale-[0.99] md:p-7">
              <div class="mx-auto mb-5 flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red">
                <i class={value.icon} aria-hidden="true"></i>
              </div>
              <h3 class="mb-4 text-2xl font-black leading-tight text-gray-900">{value.title}</h3>
              <p class="text-base font-medium leading-7 text-gray-600">{value.body}</p>
              <p class="mt-5 text-sm font-semibold leading-6 text-gray-500">{value.references}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-3xl bg-gray-100 shadow-sm">
          <img
            src="/founders-grayscale.jpg"
            alt="Schulter and Genevieve Etyang"
            class="h-full min-h-[360px] w-full object-cover grayscale md:min-h-[540px]"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="max-w-xl">
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Leadership</p>
          <h2 class="text-4xl font-black leading-tight text-gray-900 md:text-6xl">
            Schulter and Genevieve Etyang.
          </h2>
          <p class="mt-6 text-lg font-medium leading-8 text-gray-600 md:text-xl md:leading-9">
            Fifteen years ago, the good news of Jesus became real to them. Since then,
            their lives and leadership have been shaped by the same invitation that
            shapes The Life Place: Come. See. Jesus.
          </p>
          <a
            href="/about-us/leadership/"
            class="mt-8 inline-flex min-h-12 items-center justify-center rounded-2xl border border-brand-red px-6 py-3 font-bold text-brand-red transition hover:bg-brand-red hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
          >
            Meet Our Leaders
          </a>
        </div>
      </div>
    </section>

    <section class="bg-gray-50 px-6 py-20 text-gray-900 md:py-28">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-brand-red">What We Believe</p>
        <h2 class="text-4xl font-black leading-tight md:text-6xl">
          Everything we believe starts with Jesus.
        </h2>
        <p class="mx-auto mt-6 max-w-3xl text-lg font-medium leading-8 text-gray-600 md:text-xl md:leading-9">
          We are a Christ-centered and Pentecostal-Charismatic community shaped by covenant
          theology.
        </p>
        <a
          href="/what-we-believe/"
          class="mt-10 inline-flex min-h-12 items-center justify-center rounded-2xl bg-white px-6 py-3 font-bold text-gray-900 shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
        >
          Read What We Believe
        </a>
      </div>
    </section>

    <section class="px-6 py-20 md:py-28">
      <div class="mx-auto max-w-5xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Join us</p>
        <h2 class="text-4xl font-black leading-tight text-gray-900 md:text-6xl">
          Come. See. <span class="text-brand-red">Jesus</span>.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg font-medium leading-8 text-gray-600 md:text-xl">
          We meet every Sunday from 9:00 to 11:00.
          <br />
          Come and discover how the finished work changes everything.
        </p>
        <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
          <a
            href="/visit/"
            class="inline-flex min-h-12 items-center justify-center rounded-2xl bg-brand-red px-7 py-3 text-base font-bold text-white shadow-[0_10px_30px_rgba(179,40,45,0.18)] transition hover:bg-brand-red-hover focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
          >
            Plan A Visit
          </a>
          <a
            href="/live/"
            class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-gray-300 px-7 py-3 text-base font-bold text-gray-900 transition hover:border-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2"
          >
            Watch Live
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
