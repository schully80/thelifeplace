---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FullBleed from "../../components/tlp/FullBleed.astro";
import HeroTitle from "../../components/tlp/HeroTitle.astro";
import SectionWrapper from "../../components/tlp/SectionWrapper.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
import GlassCard from "../../components/tlp/GlassCard.astro";
import WarmBackground from "../../components/tlp/WarmBackground.astro";

---

<BaseLayout title="About Us">
  <!-- Full-bleed hero with image + subtle overlay -->
  <section class="relative full-bleed cine-zoom-apple-hover">
    <div class="relative min-h-[70vh] md:min-h-[80vh] overflow-hidden">
      <img
        src="/sandton-skyline.jpg"
        alt="About The Life Place"
        class="absolute inset-0 h-full w-full object-cover tlp-grayscale"
        loading="eager"
        decoding="async"
      />
      <!-- Soft dark overlay for legibility -->
      <div class="absolute inset-0 bg-black/30"></div>

      <!-- Centered content -->
      <!-- Mobile: shorter & tighter; Desktop: original min-h-screen spacing preserved -->
      <div class="relative z-20 flex h-full flex-col items-center justify-center px-4 text-center min-h-[70vh] md:min-h-screen gap-4 md:gap-8">
         <!-- Subtle white glow behind text -->
      <div 
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.35),transparent_70%)] 
               blur-[80px] opacity-80 -z-10 pointer-events-none">
      </div>

        <!-- Heading -->
        <!-- Mobile smaller (2xl); Desktop unchanged (md:5xl) -->
        <h1 class="mb-6 md:mb-10 text-4xl md:text-7xl font-bold text-center text-white drop-shadow-lg">
          What We Do
        </h1>

        <!-- Vision statement -->
        <!-- Mobile smaller (text-lg + tighter leading); Desktop unchanged (sm:6xl + md:leading-snug) -->
        <p class="max-w-5xl mx-auto text-3xl sm:text-6xl font-semibold leading-7 md:leading-snug text-white">
          Every time we meet, we see how true, good, beautiful and kind
          <!-- Retro sign with nails -->
          <span class="relative inline-block px-3 py-0 rounded-[9px] bg-[#B3282D] text-white font-bold border-4 border-white shadow-lg drop-shadow-xl tracking-wide rotate-[-2deg]">
            Jesus
            <!-- Left nail -->
            <span
              class="absolute top-1 left-1 w-2 h-2 rounded-full border border-gray-700 shadow"
              style="background: radial-gradient(circle at 30% 30%, #f0f0f0, #a0a0a0 60%, #5a5a5a);"
            />
            <!-- Right nail -->
            <span
              class="absolute top-1 right-1 w-2 h-2 rounded-full border border-gray-700 shadow"
              style="background: radial-gradient(circle at 30% 30%, #f0f0f0, #a0a0a0 60%, #5a5a5a);"
            />
          </span>
          is.
        </p>
      </div>
    </div>
    
  </section>
  
</BaseLayout>
