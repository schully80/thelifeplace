---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Slogan from "../components/Slogan.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
import AppDownloadCard from "../../components/AppDownloadCard.astro";
---


<BaseLayout title="Our Values">

<!-- ======================================= -->
<!-- FULL-WIDTH HERO — Warm Premium Gradient -->
<!-- ======================================= -->
<section
  class="relative h-[60vh] md:h-[70vh] w-full flex items-center justify-center overflow-hidden
         bg-white"
>
  <!-- Optional: super-subtle vignette for depth -->
<div class="absolute inset-0 bg-gradient-to-b 
