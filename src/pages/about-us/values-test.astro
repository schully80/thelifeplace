<!-- ======================================= -->
<!-- MOTION PACK CSS + JS -->
<!-- ======================================= -->
<style>

/* Fade-up animation */
.motion-card {
  opacity: 0;
  transform: translateY(50px) scale(0.97);
  transition: opacity 1s ease, transform 1.2s cubic-bezier(.16,1,.3,1);
}
.motion-card.visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* Ambient floating */
.value-card {
  animation: floaty 16s ease-in-out infinite;
}
@keyframes floaty {
  0%   { transform: translateY(0px); }
  50%  { transform: translateY(-6px); }
  100% { transform: translateY(0px); }
}

/* Tilt hover */
.value-card:hover {
  transform: perspective(900px) rotateX(3deg) rotateY(-2deg) scale(1.02);
}

/* Shine sweep */
.value-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    120deg,
    transparent 30%,
    rgba(255,255,255,0.12) 50%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.8s ease;
}
.value-card:hover::before {
  opacity: 1;
}

/* Parallax background */
.parallax-section {
  background-attachment: fixed;
}
@media (max-width: 768px) {
  .parallax-section {
    background-attachment: scroll;
  }
}

</style>

<script>
const cards = document.querySelectorAll(".motion-card");

function revealCards() {
  const trigger = window.innerHeight * 0.88;
  cards.forEach(card => {
    const rect = card.getBoundingClientRect();
    if (rect.top < trigger) card.classList.add("visible");
  });
}

window.addEventListener("scroll", revealCards);
window.addEventListener("load", revealCards);
</script>

<script>
  const bar = document.getElementById("progress-bar");

  function updateProgressBar() {
    const scrollY = window.scrollY;
    const pageHeight = document.body.scrollHeight - window.innerHeight;
    const progress = (scrollY / pageHeight) * 100;
    bar.style.width = progress + "%";
  }

  window.addEventListener("scroll", updateProgressBar);
  window.addEventListener("load", updateProgressBar);
</script>


</BaseLayout>
