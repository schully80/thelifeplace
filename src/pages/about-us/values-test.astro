    <!-- Warm vignette -->
    <div class="absolute inset-0 bg-gradient-to-b 
                from-[#F3ECE6]/15 via-transparent to-[#F3ECE6]/15"></div>

    <div class="relative z-10 text-center px-6">
      <h1 class="text-4xl md:text-6xl font-black tracking-tight text-gray-900">
        Our Values
      </h1>

      <Slogan size="md" arrow={true} class="mt-10 md:mt-14" />

  </section>
</div>


<!-- ====================================================== -->
<!-- FADE DIVIDER BELOW HERO                                -->
<!-- ====================================================== -->
<div
  class="w-screen max-w-none relative left-1/2 -mx-[50vw]
