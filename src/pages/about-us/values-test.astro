---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Slogan from "../../components/Slogan.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
import AppDownloadCard from "../../components/AppDownloadCard.astro";
---


<BaseLayout title="Our Values">

<!-- ====================================================== -->
<!-- HERO — WARM MINIMAL HEADER                             -->
<!-- ====================================================== -->
<div class="w-screen max-w-none relative left-1/2 -mx-[50vw]">
  <section
    class="relative h-auto md:h-auto lg:h-auto py-32
           w-full flex flex-col items-center justify-center bg-white"
