</section>

<!-- FADE DIVIDER -->
<FadeDivider mt="mt-2" mb="mb-20" />


<!-- ====================================================== -->
<!-- VALUE 1 — INTRO NARRATIVE (Premium Editorial Style)   -->
<!-- ====================================================== -->
