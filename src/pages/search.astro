---
// src/pages/search.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const url = new URL(Astro.request.url);
const q = (url.searchParams.get("q") || "").trim();
const title = q ? `Search: ${q}` : "Search";
---
<BaseLayout title={title}>
  <section class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-2xl md:text-3xl font-bold mb-6">Search Results</h1>

    {q ? (
      <p class="text-gray-600 mb-6">You searched for: <span class="font-semibold">{q}</span></p>
    ) : (
      <p class="text-gray-500">Type something in the search box above to get started.</p>
    )}

    <!-- Results will come from client-side script -->
    <div id="results" class="space-y-4" data-query={q}></div>
  </section>
</BaseLayout>
