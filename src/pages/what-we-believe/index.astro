---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatWeBelieveSection from "../../components/WhatWeBelieveSection.astro";

const creeds = [
  {
    title: "Apostles' Creed",
    meta: "Earliest summary of apostolic faith",
    href: "https://www.ccel.org/creeds/apostles.creed.html",
  },
  {
    title: "Nicene Creed",
    meta: "A.D. 325/381",
    href: "https://www.ccel.org/creeds/nicene.creed.html",
  },
  {
    title: "Chalcedonian Creed",
    meta: "A.D. 451",
    href: "https://thewestminsterstandard.org/the-chalcedonian-creed/",
  },
  {
    title: "Westminster Confession",
    meta: "A.D. 1646",
    href: "https://westminsterstandards.org/westminster-confession-of-faith/",
  },
];
---

<BaseLayout
  title="What We Believe - Come. See. Jesus. | The Life Place"
  description="The Life Place - Come. See. Jesus. Explore our beliefs, theological posture, historical creeds, and the Jesus-centered faith that shapes our church."
>
  <main>
    <section class="bg-gray-50 pt-20 md:pt-28 pb-14 md:pb-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-4xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Come. See. Jesus.</p>
          <h1 class="mt-5 text-4xl md:text-6xl lg:text-7xl font-black leading-tight text-gray-800">
            What We Believe
          </h1>
          <p class="mt-6 max-w-3xl text-xl md:text-2xl leading-relaxed text-gray-600">
            Everything we believe is centered on <span class="font-bold text-brand-red">Jesus</span> and His finished work.
          </p>
        </div>
      </div>
    </section>

    <WhatWeBelieveSection />

    <section class="bg-white py-14 md:py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,0.38fr)_minmax(0,1fr)] lg:items-start">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Historical Creeds</p>
            <h2 class="mt-4 text-3xl md:text-4xl font-black leading-tight text-gray-800">Rooted in the global Church.</h2>
            <p class="mt-4 text-base md:text-lg leading-relaxed text-gray-600">
              We stand with centuries of Christian witnesses who have confessed the unchanging gospel.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {creeds.map((creed) => (
              <a
                href={creed.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group rounded-xl border border-gray-200 bg-white p-5 transition-[border-color,background-color] duration-200 hover:border-brand-red/40 hover:bg-gray-50"
                aria-label={`Open ${creed.title} (external)`}
              >
                <h3 class="text-lg font-black text-gray-800 group-hover:text-brand-red">{creed.title}</h3>
                <p class="mt-1 text-sm text-gray-500">{creed.meta}</p>
                <span class="mt-4 inline-flex text-sm font-bold text-brand-red">Read More</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-gray-50 py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl">
          <h2 class="text-3xl md:text-5xl font-black leading-tight text-gray-800">
            Come. See. <span class="text-brand-red">Jesus</span>
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-gray-600">
            The clearest way to understand our beliefs is to gather with us and see how they shape worship, teaching, prayer, and community.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a
              href="/visit/"
              class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-brand-red px-6 py-4 text-base font-bold text-white transition-colors duration-200 hover:bg-brand-red-hover"
            >
              Join Us This Sunday
            </a>
            <a
              href="/about-us/leadership/"
              class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl border border-gray-300 bg-white px-6 py-4 text-base font-bold text-gray-800 transition-colors duration-200 hover:border-brand-red hover:text-brand-red"
            >
              Meet Our Leadership
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
