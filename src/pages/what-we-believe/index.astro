---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
import WhatWeBelieveSection from "../../components/WhatWeBelieveSection.astro";

---

<BaseLayout title="What We Believe - Come. See. Jesus. | The Life Place"
description="The Life Place — Come. See. Jesus. Explore our beliefs: Pentecostal Charismatic, Covenant Theology, Incarnational Posture, and more. Discover how we live out our faith in Jesus.">



<!-- ===== MODERN HERO HEADER (2025+) ===== -->
<header class="relative w-full min-h-[40vh] sm:min-h-[34vh] md:min-h-[50vh] lg:min-h-[70vh] xl:min-h-[80vh] flex items-center justify-center bg-gray-50 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none select-none opacity-60">
    <svg class="w-full h-full" viewBox="0 0 1440 320" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path fill="#f87171" fill-opacity="0.08" d="M0,160L60,170.7C120,181,240,203,360,197.3C480,192,600,160,720,133.3C840,107,960,85,1080,101.3C1200,117,1320,171,1380,197.3L1440,224L1440,0L1380,0C1320,0,1200,0,1080,0C960,0,840,0,720,0C600,0,480,0,360,0C240,0,120,0,60,0L0,0Z"></path>
    </svg>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-6 py-16 text-center flex flex-col items-center gap-6">
    <!-- Intro Paragraph (moved here) -->
      <p class="text-2xl md:text-5xl lg:text-6xl font-semibold text-gray-700 leading-relaxed max-w-5xl mx-auto px-6 py-4 text-center">
      <span class="font-black block big-clip-text text-gray-800 mb-4 leading-tighter">
        Theology isn't about rules; it's about <span class="text-brand-red">JESUS</span>—who He is, what He has done, and how His finished work shapes what we believe and how we live.
      </span>
    </p>
  </div>
</header>

<!-- ===== THEOLOGICAL FRAMEWORK SECTION ===== -->
<section class="w-full py-16 md:py-28 bg-white relative overflow-hidden">
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="mb-16 text-center opacity-0 animate-fadeUp delay-100">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-800 mb-4">
        <span class="text-gray-800">Our Theological </span>
        <span class="text-brand-red">Posture</span>
      </h2>
      <!-- Subtle divider -->
      <div class="mx-auto mt-6 mb-12 h-[3px] w-16 rounded-full bg-brand-red/90"></div>
      <p class="text-xl md:text-xl lg:text-2xl text-gray-600 max-w-4xl mx-auto">We are a Christ-centred and Pentecostal-Charismatic community shaped by covenant theology and sent to live the gospel in the world.</p>
    </div>
    <!-- Framework Grid -->
    <div class="flex flex-col md:flex-col lg:flex-row items-stretch justify-center gap-0">
      
      
      <!-- Pentecostal Charismatic -->
      <div class="flex-1 flex flex-col items-center justify-center p-8 md:p-10">
        <div class="flex flex-col items-center w-full h-full transition-all duration-300 hover:shadow-lg hover:scale-[1.03] bg-gray-50 p-4 rounded-2xl border border-gray-200 hover:border-brand-red/40">
          <div class="flex justify-center w-full mb-6">
            <span class="fa-stack fa-2x">
              <i class="fa-solid fa-fire fa-stack-1x text-brand-red"></i>
            </span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-center text-gray-800 mb-3 transition-colors duration-300 group-hover:text-brand-red hover:text-brand-red">Pentecostal/<br/>Charismatic</h3>
          <p class="text-base md:text-lg text-gray-600 leading-relaxed text-center">
            Joyfully dependent on the present and active work of the Holy Spirit, who gives gifts as He wills, forms Christ in us, and empowers us for faithful witness.
          </p>
        </div>
      </div>
      <!-- Vertical Separator -->
      <div class="hidden lg:flex items-stretch">
        <div class="w-px h-auto my-8 bg-brand-red mx-0"></div>
      </div>
      <!-- Covenant Theology -->
      <div class="flex-1 flex flex-col items-center justify-center p-8 md:p-10">
        <div class="flex flex-col items-center w-full h-full transition-all duration-300 hover:shadow-lg hover:scale-[1.03] bg-gray-50 p-4 rounded-2xl border border-gray-200 hover:border-brand-red/40">
          <div class="flex justify-center w-full mb-6">
            <span class="fa-stack fa-2x">
              <i class="fa-solid fa-book-open fa-stack-1x text-brand-red"></i>
            </span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-center text-gray-800 mb-3 transition-colors duration-300 group-hover:text-brand-red hover:text-brand-red">Covenant<br/>Theology</h3>
          <p class="text-base md:text-lg text-gray-600 leading-relaxed text-center">
            We read the Bible as one unified redemptive story of God's grace, fulfilled in Jesus Christ rather than fragmented into isolated texts.
          </p>
        </div>
      </div>
      <!-- Vertical Separator -->
      <div class="hidden lg:flex items-stretch">
        <div class="w-px h-auto my-8 bg-brand-red mx-0"></div>
      </div>
      <!-- Incarnational -->
      <div class="flex-1 flex flex-col items-center justify-center p-8 md:p-10">
        <div class="flex flex-col items-center w-full h-full transition-all duration-300 hover:shadow-lg hover:scale-[1.03] bg-gray-50 p-4 rounded-2xl border border-gray-200 hover:border-brand-red/40">
          <div class="flex justify-center w-full mb-6">
            <span class="fa-stack fa-2x">
              <i class="fa-solid fa-person-walking-arrow-right fa-stack-1x text-brand-red"></i>
            </span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-center text-gray-800 mb-3 transition-colors duration-300 group-hover:text-brand-red hover:text-brand-red">Sent<br/>Into the World</h3>
          <p class="text-base md:text-lg text-gray-600 leading-relaxed text-center">
            Shaped by the way Jesus entered real places, real cultures, and real lives. The gospel is embodied among people, not merely proclaimed from a distance.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Spacer between Theological Framework Section and second FadeDivider (slightly reduced) -->
<div class="h-12 md:h-20"></div>


<WhatWeBelieveSection />
<!-- Add extra spacer between WhatWeBelieveSection and Historical Creeds -->

<div class="h-20 md:h-32"></div>


<!-- Historical Creeds Section -->
<section class="w-full py-20 md:py-32 bg-white relative z-10">

  <div class="max-w-7xl mx-auto px-6">

    <!-- Section Title -->
    <h2 class="heading-2 text-center mb-6">
      <span class="text-gray-800">HISTORICAL </span>
      <span class="text-brand-red">CREEDS</span>
    </h2>

    <!-- Subtle divider -->
    <div class="mx-auto mt-6 mb-12 h-[3px] w-16 rounded-full bg-brand-red/90"></div>

    <!-- Intro -->
    <p class="text-center text-lg md:text-xl text-gray-600 leading-relaxed mb-12 max-w-3xl mx-auto">
      <span class="text-gray-600">We are connected to centuries of Christian witnesses who have articulated the unchanging gospel.</span>
    </p>

    <!-- Creed Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- Apostles Creed -->
      <a href="https://www.ccel.org/creeds/apostles.creed.html" target="_blank" rel="noopener noreferrer" aria-label="Open Apostles' Creed (external)" class="group p-8 md:p-10 rounded-3xl bg-white  hover:shadow-lg hover:scale-[1.03] cursor-pointer border border-gray-200 hover:border-brand-red/40 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">A</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Apostles' Creed</h3>
            <p class="text-sm text-gray-500 mt-1">Earliest summary of apostolic faith</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          The foundational declaration of Christian belief, covering God the Father, Jesus Christ, the Holy Spirit, the church, and eternal life.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

      <!-- Nicene Creed -->
      <a href="https://www.ccel.org/creeds/nicene.creed.html" target="_blank" rel="noopener noreferrer" aria-label="Open Nicene Creed (external)" class="group p-8 md:p-10 rounded-3xl bg-white  hover:shadow-lg hover:scale-[1.03] cursor-pointer border border-gray-200 hover:border-brand-red/40 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">N</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Nicene Creed</h3>
            <p class="text-sm text-gray-500 mt-1">A.D. 325/381</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          Defining the deity of Christ and the doctrine of the Trinity. A crucial affirmation that Jesus Christ is of one substance with the Father.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

      <!-- Chalcedonian Creed -->
      <a href="https://thewestminsterstandard.org/the-chalcedonian-creed/" target="_blank" rel="noopener noreferrer" aria-label="Open Chalcedonian Creed (external)" class="group p-8 md:p-10 rounded-3xl bg-white  hover:shadow-lg hover:scale-[1.03] cursor-pointer border border-gray-200 hover:border-brand-red/40 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">C</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Chalcedonian Creed</h3>
            <p class="text-sm text-gray-500 mt-1">A.D. 451</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          Affirming that Jesus Christ is fully God and fully man in one person. The definitive statement on the nature of Christ's incarnation.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

      <!-- Westminster Confession -->
      <a href="https://westminsterstandards.org/westminster-confession-of-faith/" target="_blank" rel="noopener noreferrer" aria-label="Open Westminster Confession (external)" class="group p-8 md:p-10 rounded-3xl bg-white  hover:shadow-lg hover:scale-[1.03] cursor-pointer border border-gray-200 hover:border-brand-red/40 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">W</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Westminster Confession</h3>
            <p class="text-sm text-gray-500 mt-1">A.D. 1646</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          A rich summary of Reformed theology and Christian doctrine. A comprehensive guide to biblical faith and practice for believers and churches.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

    </div>

  </div>

</section>

<!-- ===== CLOSING CTA ===== -->
<section class="w-full py-24 md:py-32 bg-white">
  
  <div class="relative max-w-6xl mx-auto px-6 text-center">
    
   <h2 class="text-4xl md:text-5xl font-black mb-6 text-gray-800">
      Come. See. <span class="text-brand-red">Jesus</span>
    </h2>

    <div class="flex flex-col md:flex-row gap-6 justify-center opacity-0 animate-fadeUp delay-300">

        <a href="/visit/" class="inline-flex w-full sm:w-auto items-center justify-center px-6 sm:px-8 md:px-10 py-3 sm:py-4 md:py-5 bg-brand-red text-white text-base sm:text-lg md:text-xl font-semibold rounded-2xl hover:bg-red-600 transition-colors duration-300">
          Plan Your Visit
        </a>

        <a href="/about-us/leadership/" class="inline-flex w-full sm:w-auto items-center justify-center px-6 sm:px-8 md:px-10 py-3 sm:py-4 md:py-5 border border-gray-300 text-gray-800 text-base sm:text-lg md:text-xl font-semibold rounded-2xl hover:border-brand-red hover:text-brand-red transition-colors duration-300">
          Meet Our Leadership
        </a>  


         

    </div>

  </div>

</section>


<!-- Custom animations -->
<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }
  .delay-600 { animation-delay: 600ms; }
  .delay-700 { animation-delay: 700ms; }
  .delay-800 { animation-delay: 800ms; }
  .delay-900 { animation-delay: 900ms; }
  .delay-1000 { animation-delay: 1000ms; }
</style>

</BaseLayout>
