---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormCard from "../../components/FormCard.astro";
import AddressFields from "../../components/AddressFields.astro";

const NEW_MEMBERS_REG_OPEN = true;
---

<BaseLayout 
  title="New @ The Life Place — Come. See. Jesus. | The Life Place"
  description="The Life Place — Come. See. Jesus. Welcome to The Life Place! Learn more about our community, get connected, and take your next step in faith."
>


  <!-- Hero -->
  <section class="relative left-1/2 right-1/2 -mx-[50vw] w-screen h-[45vh] md:h-[60vh] overflow-hidden tlp-grayscale">
    <img
      src="/join-us.jpg"
      alt="Join Us"
      class="absolute inset-0 w-full h-full object-cover tlp-grayscale"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/0 to-black/5 md:from-black/5 md:to-black/15"></div>
  </section>

  <!-- Main content -->
  <section class="relative py-16 md:py-24">
    <div class="container-x px-4 md:px-8">
      <!-- Header -->
      <header class="text-center mb-12 md:mb-16 pb-8 md:pb-12 border-b border-gray-200/50">
        <h1 class="text-5xl md:text-6xl font-black text-gray-800 mb-4 tracking-tight">Vision Night</h1>
        <p class="text-lg md:text-2xl text-gray-600 font-light tracking-wide">
         Come. See. <span class="text-brand-red font-semibold">Jesus</span>
        </p>
      </header>

     <!-- Content Grid -->
  <div class="grid gap-5 md:gap-10 md:grid-cols-3 px-4 md:px-0 mb-14 md:mb-20">
    
    <!-- What / Intro -->
    <article class="group rounded-2xl md:rounded-[36px] backdrop-blur-xl bg-white/10 p-6 md:p-8 shadow-[0_8px_40px_rgba(0,0,0,0.25)] transition-all duration-300 hover:shadow-[0_12px_50px_rgba(0,0,0,0.35)] text-center overflow-hidden">
      <svg class="w-8 h-8 md:w-10 md:h-10 text-gray-800 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h2 class="text-base md:text-2xl text-center font-semibold text-gray-800 mb-3 md:mb-4 tracking-tight">What is Vision Night?</h2>
      <div class="w-12 h-0.5 bg-gradient-to-r from-brand-red/50 to-transparent mx-auto mb-4"></div>
      <p class="text-sm md:text-lg text-gray-600 leading-7 md:leading-relaxed text-center">
        Vision Night is a special gathering where we share
        <strong class="text-gray-800">who we are, why we exist, and where Jesus is leading us</strong>.
      </p>
    </article>

    <!-- Why Attend -->
    <article class="group rounded-2xl md:rounded-[36px] backdrop-blur-xl bg-white/10 p-6 md:p-8 shadow-[0_8px_40px_rgba(0,0,0,0.25)] transition-all duration-300 hover:shadow-[0_12px_50px_rgba(0,0,0,0.35)] text-center overflow-hidden">
      <svg class="w-8 h-8 md:w-10 md:h-10 text-gray-800 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
      <h2 class="text-base md:text-2xl text-center text-gray-800 font-semibold mb-3 md:mb-4 tracking-tight">Why Attend?</h2>
      <div class="w-12 h-0.5 bg-gradient-to-r from-brand-red/50 to-transparent mx-auto mb-4"></div>
      <ul class="text-sm md:text-lg space-y-2.5 text-gray-600 leading-7 md:leading-relaxed list-none pl-0">
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>Hear our story and vision for The Life Place.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>Meet our leadership team and community.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>Discover our mission, values, and future plans.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>Find ways to connect, belong, and serve.</span>
        </li>
      </ul>
    </article>

    <!-- Vision Night Is For -->
    <article class="group rounded-2xl md:rounded-[36px] backdrop-blur-xl bg-white/10 p-6 md:p-8 shadow-[0_8px_40px_rgba(0,0,0,0.25)] transition-all duration-300 hover:shadow-[0_12px_50px_rgba(0,0,0,0.35)] text-center overflow-hidden">
      <svg class="w-8 h-8 md:w-10 md:h-10 text-gray-800 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <h2 class="text-base md:text-2xl font-semibold text-center text-gray-800 mb-3 md:mb-4 tracking-tight">Vision Night Is For</h2>
      <div class="w-12 h-0.5 bg-gradient-to-r from-brand-red/50 to-transparent mx-auto mb-4"></div>
      <ul class="text-sm md:text-lg space-y-2.5 text-gray-600 leading-7 md:leading-relaxed list-none pl-0">
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>Anyone exploring the heartbeat of The Life Place.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>Those ready to take a next step in belonging.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>Those searching for a Jesus-centred community.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-brand-red font-bold mt-1">•</span>
          <span>All who want to be part of Jesus' unfolding future</span>
        </li>
      </ul>
    </article>
  </div>

  <!-- Registration Section -->
  <section class="relative py-20 md:py-32 -mx-4 md:mx-0">
    <div class="container-x px-4 md:px-8">
      <!-- Section Header -->
      <div class="text-center mb-12 md:mb-16">
        <div class="flex justify-center mb-4">
          <svg class="w-6 h-6 md:w-8 md:h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h2 class="heading-2 mb-3">Ready to Attend?</h2>
        <p class="text-lg md:text-xl text-gray-600 font-light tracking-wide max-w-2xl mx-auto">
          Register below to save your spot and be part of this incredible night.
        </p>
      </div>

      <!-- Form Container -->
      <div class="max-w-2xl mx-auto rounded-2xl md:rounded-[36px] backdrop-blur-xl bg-white/10 p-8 md:p-12 shadow-[0_8px_40px_rgba(0,0,0,0.25)] overflow-hidden">
        <FormCard
          title=""
          instructionText=""
          eventName="Vision Night"
          ctaText="Can't Wait"
          showComingSoon={true}
          comingSoonMessage="Registration opens soon."
        />
      </div>
    </div>
  </section>

</section>
</BaseLayout>