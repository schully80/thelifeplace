---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormCard from "../../components/FormCard.astro";
import TurnstileWidget from "../../components/TurnstileWidget.astro";
import AddressFields from "../../components/AddressFields.astro";

const NEW_MEMBERS_REG_OPEN = true;
---

<BaseLayout title="New @The Life Place">


  <!-- Hero -->
  <section class="relative full-bleed">
    <div class="relative min-h-[38vh] md:min-h-[50vh] flex items-center justify-center">
      <img
        src="/join-us.jpg"
        alt="Join Us"
        class="absolute inset-0 h-full w-full object-cover tlp-grayscale"
        style="max-height:60vh"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/10"></div>
    </div>
  </section>

  <!-- Main content -->
  <section class="relative py-10 md:py-16">
    <div class="container-x px-4 md:px-8">
      <!-- Header -->
      <header class="text-center mb-8 md:mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">Vision Night</h1>
        <p class="mt-4 md:mt-5 text-xl md:text-2xl text-brand-warmgray-700">
         Come. See. <span class="text-brand-red">Jesus</span>
        </p>
      </header>

     <!-- Content Grid -->
  <div class="grid gap-6 md:gap-8 md:grid-cols-3">
    
    <!-- What / Intro -->
    <article class="rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red">
      <h2 class="text-1xl md:text-xl text-center font-semibold text-brand-red mb-3">What is Vision Night?</h2>
      <p class="text-lg md:text-lg text-brand-warmgray-800 leading-7 md:leading-relaxed">
        Vision Night is a special gathering where we share
        <strong>who we are, why we exist, and where Jesus is leading us</strong>.
      </p>
    </article>

    <!-- Why Attend -->
    <article class="rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red">
      <h2 class="text-1xl md:text-xl text-center text-brand-red font-semibold mb-3">Why Attend?</h2>
      <ul class="text-lg md:text-lg space-y-2 text-brand-warmgray-800 leading-7 md:leading-relaxed list-disc pl-5">
        <li>Hear our story and vision for The Life Place.</li>
        <li>Meet our leadership team and community.</li>
        <li>Discover our mission, values, and future plans.</li>
        <li>Find ways to connect, belong, and serve.</li>
      </ul>
    </article>

    <!-- Vision Night Is For -->
    <article class="rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red">
      <h2 class="text-1xl md:text-xl font-semibold text-center text-brand-red mb-3">Vision Night Is For</h2>
      <ul class="text-lg md:text-lg space-y-2 text-brand-warmgray-800 leading-7 md:leading-relaxed list-disc pl-5">
        <li>Anyone exploring the heartbeat of The Life Place.</li>
        <li>Those ready to take a next step in belonging.</li>
        <li>Those searching for a Jesus-centred community.</li>
        <li>All who want to be part of Jesus' unfolding future</li>
      </ul>
    </article>
  </div>

<!-- Registration Form -->
<div class="mt-10 md:mt-12 max-w-2xl mx-auto px-4 md:px-0 cine-zoom-apple-hover">
   <FormCard
  title="Vision Night"
  eventName="Vision Night"
  ctaText="I'm Coming"
  showComingSoon={true}
  comingSoonMessage="A night to see what Jesus is unfolding—registration opens soon."
/>
</div>

</section>
</BaseLayout>