---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Ministries — Come. See. Jesus. | The Life Place"
  description="The Life Place — Come. See. Jesus. Explore our ministries: youth, families, relief, outreach, and more. Discover how to grow in Jesus and serve your community."
>
  <section class="container-x py-12 md:py-20">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="mt-2 text-3xl md:text-5xl xl:text-6xl font-medium">
        Ministries
      </h1>

      <p class="mt-6 text-lg sm:text-2xl xl:text-[1.75rem] text-gray-600">
        Come. See. <span class="text-brand-red">Jesus</span>
      </p>

      <p class="mt-4 text-lg md:text-xl xl:text-[1.375rem] text-gray-600">
        Explore how we grow in Jesus, build strong families, and serve our city.
      </p>
    </div>

    <!-- Body Copy (Short Overview) -->
    <div class="mt-10 max-w-4xl mx-auto text-lg md:text-xl text-gray-600 leading-relaxed">
      <p>
        The Life Place is made up of communities, ministries, and teams that help people
        encounter Jesus and live out His story in every sphere of life.
      </p>

      <p class="mt-4">
        Use the ministries menu above to explore each ministry:
      </p>

      <ul class="mt-4 list-disc list-inside space-y-2">
        <li><a href="/ministries/new-members/" class="text-brand-red hover:underline">New @The Life Place</a></li>
        <li><a href="/ministries/bring-them-to-jesus/" class="text-brand-red hover:underline">Bring Them to Jesus</a></li>
        <li><a href="/ministries/kids/" class="text-brand-red hover:underline">Kids Ministry</a></li>
        <li><a href="/ministries/gen/" class="text-brand-red hover:underline">ThisGen</a></li>
        <li><a href="/ministries/premarital-counseling/" class="text-brand-red hover:underline">Premarital Counseling</a></li>
        <li><a href="/ministries/institute/" class="text-brand-red hover:underline">Life Place Institute</a></li>
        <li><a href="/ministries/faith-and-work/" class="text-brand-red hover:underline">Faith & Work</a></li>
        <li><a href="/ministries/relief-center/" class="text-brand-red hover:underline">Relief Center</a></li>
      </ul>

      <p class="mt-6">
        Each ministry exists to help people experience the fullness of life Jesus promised.
      </p>
    </div>

  </section>
</BaseLayout>
