---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Relief Center">
  <section class="container-x py-10 md:py-16">
    <!-- Hero -->
  <section class="relative full-bleed">
    <div class="relative min-h-[38vh] md:min-h-[50vh] flex items-center justify-center">
      <img
        src="/relief-center.jpg"
        alt="Join Us"
        class="absolute inset-0 h-full w-full object-cover"
        style="max-height:60vh"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/10"></div>
    </div>
  </section>

  
  <section class="container-x py-10 md:py-16 text-center">

    <!-- Main content -->
  <section class="relative py-10 md:py-16">
    <div class="container-x px-4 md:px-8">
      <!-- Header -->
      <header class="text-center mb-8 md:mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-warmgray-800">Relief Center</h1>
        <p class="mt-4 md:mt-5 text-xl md:text-2xl text-brand-warmgray-700">
         Come. See. <span class="text-brand-red">Jesus</span>
        </p>
      </header>
    <div class="rounded-xl border bg-white p-5 md:p-6 shadow-sm ring-1 ring-brand-red">
      <!-- Main text -->
      <p class="mt-3 md:mt-4 text-lg md:text-xl text-warmgray-600 leading-7 md:leading-relaxed">
        We believe in being the hands and feet of Jesus by caring for the vulnerable and serving our
        community with compassion and dignity.
      </p>

      <!-- Donate Button -->
      <div class="mt-5 md:mt-6 flex justify-center md:justify-end">
        <a 
          href="/give/" 
          class="inline-block rounded-full bg-brand-red px-5 md:px-6 py-2.5 md:py-3 
                 text-base md:text-xl font-bold text-white shadow-md 
                 transform transition-transform duration-300 hover:scale-105 
                 hover:bg-brand-red hover:shadow-lg"
        >
          Donate
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
