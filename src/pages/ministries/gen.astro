---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegisterForm from "../../components/RegisterForm.astro";
---
<BaseLayout 
  title="Gen — Youth Ministry | Come. See. Jesus. | The Life Place"
  description="The Life Place — Come. See. Jesus. Join Gen, our youth ministry for students. Grow in faith, build authentic community, and discover your calling."
>
  <!-- Full-bleed hero with dark overlay -->
  <section class="relative full-bleed">
    <img
      src="/youth.jpg"
      alt="Youth at The Life Place"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/20"></div>

    <!-- Centered hero text -->
    <div class="relative z-10 flex items-center justify-center min-h-[50vh] md:min-h-[60vh] px-4">
      <!-- Mobile: slightly smaller; Desktop unchanged -->
      <h1 class="text-5xl md:text-7xl font-extrabold italic text-white drop-shadow-lg">
        This<span class="text-brand-red">Gen</span>
      </h1>
    </div>
  </section>

  <!-- Content section -->
  <section class="max-w-5xl mx-auto px-4 py-12 md:py-20">
    <div class="rounded-xl border bg-white shadow-sm p-5 md:p-8">
      
      <!-- Mobile: text-base; Desktop: text-xl -->
      <p class="text-gray-800 text-lg md:text-xl font-medium leading-7 md:leading-relaxed">
        <strong class="text-brand-red">ThisGen</strong> is our youth expression at The Life Place — 
        a space for our generation to Come. See. <span class="text-brand-red font-medium">Jesus</span>, 
        grow in faith, build lifelong friendships, and discover their purpose — 
        all for the glory of <span class="text-brand-red">Jesus</span> and the good of the world.
      </p>
    </div>
  </section>
</BaseLayout>
