---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormCard from "../../components/FormCard.astro";
import AddressFields from "../../components/AddressFields.astro";
import TurnstileWidget from "../../components/TurnstileWidget.astro";
import RegisterForm from "../../components/RegisterForm.astro";

const url = new URL(Astro.request.url);
const event = url.searchParams.get("event");
---

<BaseLayout title="Bring Them To Jesus">
  <!-- Hero -->
  <section class="relative full-bleed">
    <div class="relative min-h-[38vh] md:min-h-[60vh] flex items-center justify-center">
      <img
        src="/father-child3.jpg"
        alt="Only Jesus"
        class="absolute inset-0 h-full w-full object-cover tlp-grayscale"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/20"></div>

      <div class="relative z-10 px-4 text-center">
        <h1 class="text-3xl md:text-5xl font-bold text-white drop-shadow">
          Bring Them to Jesus
        </h1>
        <p class="mt-3 text-lg md:text-2xl leading-7 md:leading-8 text-white/95">
          Let the children come to me... Matthew 19:14, Mark 10:14
        </p>
      </div>
    </div>
  </section>

  <section class="relative py-10 md:py-16">
    <div class="container-x px-4 md:px-8">
      <!-- Header -->
      <header class="text-center mb-8 md:mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">Bring Them To Jesus</h1>
        <p class="mt-4 md:mt-5 text-xl md:text-2xl text-brand-warmgray-700">
          Come. See. <span class="text-brand-red">Jesus</span>
        </p>
      </header>

      <!-- Content Grid -->
      <section class="container-x pt-12 md:pt-16 pb-12 md:pb-14">
        <div class="grid gap-6 md:gap-8 md:grid-cols-3">
          <!-- Objective -->
          <article class="rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red">
            <h2 class="text-center text-2xl md:text-2xl font-sembold text-brand-red mb-3">Objective</h2>
            <p class="text-lg md:text-lg leading-7 md:leading-8 mt-3 text-brand-warmgray-800">
              We invite parents into a Jesus-centred dedication journey—filled with encouragement, practical resources for parenting, and the joy of building friendships with other parents along the way.
            </p>
          </article>

          <!-- Duration -->
          <article class="rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red">
            <h2 class="text-center text-2xl md:text-2xl font-semibold text-brand-red mb-3">Duration</h2>
            <p class="text-lg md:text-lg leading-7 md:leading-8 text-brand-warmgray-800">
              <strong>Two-weeks</strong>, two sessions, ninety minutes each — preparing you for a lifetime commitment.
            </p>
          </article>

          <!-- Program Features -->
          <article class="rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red">
            <h2 class="text-center text-2xl md:text-2xl font-semibold text-brand-red mb-3">Program Features</h2>
            <ul class="text-lg md:text-lg leading-7 md:leading-8 space-y-3 text-brand-warmgray-800 list-disc pl-5">
              <li><span class="font-bold">Style:</span> Warm, engaging, short gospel presentation, Q&amp;A session, and prayer.</li>
              <li><span class="font-bold">Duration:</span> 2 sessions, 90 minutes each.</li>
              <li><span class="font-bold">Materials:</span> <em>Bring Them to Jesus Handbook</em> and your Bible.</li>
            </ul>
          </article>
        </div>

        <!-- Costs -->
        <article class="mt-10 max-w-xl mx-auto rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red text-center">
          <h2 class="text-2xl md:text-2xl font-semibold text-brand-red mb-3">Costs</h2>
          <p class="text-lg md:text-lg leading-7 md:leading-8 text-brand-warmgray-800">
            <span class="font-medium text-warm-gray"> A one-time registration cost per household for the 2-week class (covers catering &amp; admin, non-refundable).
          </p>
        </article>

<!-- Registration Form -->
<div class="mt-10 md:mt-12 max-w-2xl mx-auto px-4 md:px-0 cine-zoom-apple-hover">
 <FormCard
  title="Bring Them To Jesus "
  eventName="Bring Them To Jesus"
  ctaText="Register for Child Dedication"
  showComingSoon={true}
  comingSoonMessage="Preparing hearts to bring little ones to Jesus—registration opens soon."
/>

</div>
</section>
</BaseLayout>