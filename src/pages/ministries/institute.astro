---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegisterForm from "../../components/RegisterForm.astro";
---
<BaseLayout title="The Life Place Institute">
  <section class="container-x py-10 md:py-16 text-center">
    <div class="rounded-xl border bg-white p-5 md:p-6 shadow-sm ring-1 ring-brand-warmgray-200">
      <!-- Stack on mobile so the badge doesn’t crowd the title -->
      <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-3 sm:gap-4 mb-4">
        <!-- Desktop unchanged (you used 3xl already) -->
        <h1 class="text-3xl md:text-4xl font-bold">The Life Place Institute</h1>
        <span class="inline-block rounded-full bg-brand-red px-3 py-1 text-lg font-bold text-white">
          Launching Soon
        </span>
      </div>

      <!-- Mobile smaller body; desktop unchanged intent -->
      <p class="text-lg md:text-xl text-warmgray-700 leading-7 md:leading-8">
        A hub for discipleship, teaching, and leadership training is on the way.<br />
        <em class="text-brand-red">Come. See. Jesus</em>
      </p>
    </div>
  </section>
</BaseLayout>
