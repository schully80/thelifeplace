---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegisterForm from "../../components/RegisterForm.astro";
---
<BaseLayout
  title="Kids @The Life Place - Coming Soon">


<!-- Hero -->
  <section class="relative full-bleed">
    <div class="relative min-h-[38vh] md:min-h-[50vh] flex items-center justify-center">
      <img
        src="/kids-church.jpg"
        alt="Join Us"
        class="absolute inset-0 h-full w-full object-cover"
        style="max-height:60vh"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/10"></div>
    </div>
  </section>

  
    <!-- Main content -->
  <section class="relative py-10 md:py-16">
    <div class="container-x px-4 md:px-8">
      <!-- Header -->
      <header class="text-center mb-8 md:mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">Kids @The Life Place</h1>
        <p class="mt-4 md:mt-5 text-xl md:text-2xl text-brand-warmgray-700">
         Come. See. <span class="text-brand-red">Jesus</span>
        </p>
      </header>

    <!-- Coming Soon Banner -->
    <div class="rounded-xl border bg-white p-6 shadow-sm ring-1 ring-brand-red text-center">
      <span class="inline-block rounded-full bg-[#B3282D] px-3 md:px-4 py-1.5 md:py-2 text-sm md:text-lg font-bold text-white mb-3 md:mb-4">
        Launching Soon
      </span>

      <p class="text-lg md:text-lg text-gray-700 leading-7 md:leading-relaxed max-w-2xl mx-auto">
        At present, we have no kids’ church. As Jesus supplies the resources needed,
        we will launch one where our children too will Come. See. <span class="text-brand-red">Jesus</span>
      </p>

      <p class="mt-3 md:mt-4 text-lg md:text-lg text-gray-700 leading-7 md:leading-relaxed max-w-2xl mx-auto">
        Children are welcome to remain with their parents during service.
      </p>
    </div>

    <!-- Decal-style words -->
    <div class="mt-10 md:mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 text-center overflow-visible">
        <div class="p-5 rounded-lg bg-brand-red font-bold text-m sm:text-lg text-white shadow transform rotate-3 -translate-y-2 z-30">
        COME.SEE.JESUS
      </div>
      <div class="p-4 rounded-full bg-yellow-300 font-bold text-base sm:text-lg text-yellow-900 shadow transform -rotate-6 -translate-y-1 z-20">
        JOY
      </div>
      <div class="p-5 rounded-lg bg-pink-400 font-bold text-lg sm:text-xl text-white shadow transform rotate-2 translate-y-1 z-10">
        LOVE
      </div>
      <div class="p-5 rounded-full bg-blue-500 font-bold text-xl sm:text-2xl text-white shadow transform rotate-3 -translate-y-2 z-30">
        JESUS
      </div>
      <div class="p-4 rounded bg-green-300 font-bold text-base sm:text-lg text-green-900 shadow transform -rotate-2 translate-y-1 z-10">
        PEACE
      </div>
      <div class="p-5 rounded-full bg-purple-500 font-bold text-lg sm:text-xl text-white shadow transform rotate-1 -translate-y-1 z-20">
        HOPE
      </div>
      <div class="p-4 rounded bg-orange-400 font-bold text-base sm:text-lg text-white shadow transform -rotate-3 translate-y-2 z-10">
        FAITH
      </div>
      <div class="p-5 rounded-full bg-red-500 font-bold text-lg sm:text-xl text-white shadow transform rotate-2 -translate-y-1 z-20">
        BLESSED
      </div>
      <div class="p-4 rounded bg-teal-400 font-bold text-base sm:text-lg text-white shadow transform -rotate-2 translate-y-1 z-10">
        LIGHT
      </div>
    </div>
  </section>
</BaseLayout>
