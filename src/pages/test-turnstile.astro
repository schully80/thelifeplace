---
import Turnstile from '../components/ui/Turnstile.astro';
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Turnstile test</title>
  </head>
  <body>
    <main style="max-width:720px;margin:2rem auto;padding:1rem;">
      <h1>Cloudflare Turnstile — Test Page</h1>

      <p>Use this page to exercise the Turnstile widget and verify tokens.</p>

      <form id="turnstile-form">
        <!-- hidden token field the Turnstile component should populate -->
        <input type="hidden" name="token" id="turnstile-token" />

        <Turnstile sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY} />

        <div style="margin-top:1rem;">
          <button type="submit">Verify token</button>
        </div>
      </form>

      <pre id="result" style="margin-top:1rem;background:#f6f8fa;padding:1rem;border-radius:6px;white-space:pre-wrap;">Waiting for action...</pre>

      <script type="module">
        const form = document.getElementById('turnstile-form');
        const resultEl = document.getElementById('result');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          // Prefer Turnstile-generated input(s) first, fall back to any token field
          const tokenInput = form.querySelector('input[name^="cf-turnstile-response"], input[name="cf-turnstile-response"], input[name="token"], input[name="turnstile-token"]');
          const token = tokenInput ? tokenInput.value : '';
          if (!token) {
            resultEl.textContent = 'No token found — complete the challenge first.';
            return;
          }

          resultEl.textContent = 'Verifying...';

          try {
            const res = await fetch('/api/turnstile-verify.json', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token }),
            });
            const json = await res.json();
            resultEl.textContent = JSON.stringify(json, null, 2);
          } catch (err) {
            resultEl.textContent = 'Error: ' + String(err);
          }
        });
      </script>
    </main>
  </body>
</html>
