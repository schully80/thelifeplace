---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FadeDivider from "../../../components/tlp/FadeDivider.astro";
import {
  formatDate,
  isValidDate,
  monthLabelFromParts,
  parseBlogFeed,
  type BlogFeedItem,
} from "../../../utils/blog-feed";
export const prerender = true;

const FEED_URL = "https://schulteretyang.substack.com/feed";

let items: BlogFeedItem[] = [];
let error: string | null = null;

const yearParam = Astro.params.year;
const monthParam = Astro.params.month; // expected 01-12

const yearNum = Number(yearParam);
const monthNum = Number(monthParam);
const paddedMonth = String(monthNum).padStart(2, "0");
const monthLabel = monthLabelFromParts(yearNum, monthNum);

export async function getStaticPaths() {
  try {
    const res = await fetch(FEED_URL, {
      headers: {
        Accept: "application/rss+xml, application/xml, text/xml",
        "User-Agent": "thelifeplace-blog-archive-staticpaths",
      },
    });
    if (!res.ok) throw new Error(`Feed fetch failed: HTTP ${res.status}`);
    const xml = await res.text();
    const parsed = parseBlogFeed(xml);
    const months = new Set<string>();
    for (const item of parsed) {
      const d = item.dateObj;
      if (d instanceof Date && !isNaN(d.getTime())) {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        months.add(`${y}-${m}`);
      }
    }
    const paths = Array.from(months).map((ym) => {
      const [y, m] = ym.split("-");
      return { params: { year: y, month: m } };
    });
    return paths;
  } catch (e) {
    // On failure, no paths (prevents build crash in dev)
    return [];
  }
}

try {
  if (!yearParam || isNaN(yearNum) || !monthParam || isNaN(monthNum) || monthNum < 1 || monthNum > 12) {
    throw new Error("Invalid archive route. Use /blog/YYYY/MM");
  }

  const res = await fetch(FEED_URL, {
    headers: {
      Accept: "application/rss+xml, application/xml, text/xml",
      "User-Agent": "thelifeplace-blog-archive"
    }
  });
  if (!res.ok) throw new Error(`Feed fetch failed: HTTP ${res.status}`);
  const xml = await res.text();
  const parsed = parseBlogFeed(xml);

  // Filter by year/month
  items = parsed.filter((it) => isValidDate(it.dateObj) && it.dateObj.getFullYear() === yearNum && (it.dateObj.getMonth() + 1) === monthNum);

  // Sort recent first within the month
  items.sort((a, b) => {
    const at = isValidDate(a.dateObj) ? a.dateObj.getTime() : 0;
    const bt = isValidDate(b.dateObj) ? b.dateObj.getTime() : 0;
    return bt - at;
  });
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}

// SEO / canonical
const canonicalHref = `${Astro.url.origin}/blog/${yearNum}/${paddedMonth}`;
---

<BaseLayout title={`Archive: ${monthLabel}`}>
  <Fragment slot="head">
    <meta name="description" content={`Posts from ${monthLabel} — The Life Place Substack archive.`} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:title" content={`Archive: ${monthLabel} — The Life Place`} />
    <meta property="og:description" content={`Posts from ${monthLabel} — The Life Place Substack archive.`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
  </Fragment>

  <!-- Page Hero -->
  <section class="relative w-full py-16 md:py-22 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-black to-gray-900"></div>
    <div class="relative max-w-6xl mx-auto px-6 text-center z-10">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-2">{monthLabel}</h1>
      <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto">Monthly archive from our Substack, shown newest first.</p>
      <div class="mt-6">
        <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/30 text-white hover:bg-white/10">← Back to Blog</a>
        <a href="https://schulteretyang.substack.com/archive" target="_blank" rel="noopener" class="ml-3 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/30 text-white hover:bg-white/10">Open on Substack</a>
      </div>
    </div>
  </section>

  <FadeDivider mt="mt-10" mb="mb-12" width="w-[90%] max-w-6xl" />

  <section class="w-full py-14 md:py-18 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      {error ? (
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
          <p class="text-red-700 font-semibold">Error:</p>
          <p class="text-red-700 text-sm mt-1">{error}</p>
        </div>
      ) : items.length === 0 ? (
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 text-center text-gray-600">
          No posts found for {monthLabel}.
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 md:gap-10 xl:gap-12">
          {items.map((item) => (
            <a href={item.link} target="_blank" rel="noopener" class="group block rounded-2xl overflow-hidden shadow-sm border bg-white">
              {item.imageUrl ? (
                <img src={item.imageUrl} alt={item.title} class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" decoding="async" />
              ) : (
                <div class="w-full h-48 bg-gradient-to-r from-brand-red/20 via-red-500/10 to-brand-red/20"></div>
              )}
              <div class="p-6 md:p-8">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center px-2 py-1 rounded-full bg-gray-100 text-gray-600 text-xs">{formatDate(item.dateObj, item.date)}</span>
                </div>
                <h3 class="mt-4 font-semibold text-gray-800 group-hover:text-brand-red transition-colors">{item.title || item.link}</h3>
                {item.description && (
                  <p class="text-sm text-gray-600 mt-4 line-clamp-3">{item.description}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
