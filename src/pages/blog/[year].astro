---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";

export const prerender = false;

const FEED_URL = "https://schulteretyang.substack.com/feed";
const ARCHIVE_URL = (year) => `https://schulteretyang.substack.com/archive?year=${year}`;
const FEED_TIMEOUT_MS = 8000; // abort slow requests after 8s
const FEED_TTL_MS = 5 * 60 * 1000; // cache for 5 minutes

let items = [];
let error = null;
let monthGroups = [];

// Simple in-memory cache per year for parsed archive items
const yearCache = new Map(); // key: year, value: { items, fetchedAt }

function cleanCdata(str) {
  return (str || "").replace(/<!\[CDATA\[/g, "").replace(/\]\]>/g, "").trim();
}

function pick(chunk, re) {
  const m = chunk.match(re);
  if (!m) return "";
  return cleanCdata(m[1] || m[2] || "");
}

function decodeHtmlEntities(str) {
  if (!str) return "";
  return str
    .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
    .replace(/&#x([0-9a-fA-F]+);/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">");
}

function isValidDate(d) {
  return d instanceof Date && !isNaN(d.getTime());
}

function formatDate(d, fallback) {
  return isValidDate(d)
    ? d.toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric" })
    : (fallback || "");
}

function monthKey(d) {
  if (!isValidDate(d)) return "unknown";
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
}

function monthLabel(d) {
  return isValidDate(d)
    ? `${d.toLocaleString("en-US", { month: "long" })} ${d.getFullYear()}`
    : "Unknown";
}

const yearParam = Number(Astro.params.year || 0);

try {
  if (!yearParam || Number.isNaN(yearParam)) throw new Error("Invalid year route");

  // Preferred: load from our aggregated index and filter by year
  const idxController = new AbortController();
  const idxTimeout = setTimeout(() => idxController.abort(), FEED_TIMEOUT_MS);
  const idxRes = await fetch(new URL('/api/blog-index.json?refresh=1', Astro.url).toString(), {
    headers: { Accept: 'application/json', 'User-Agent': 'thelifeplace-blog-year-index' },
    signal: idxController.signal,
  });
  clearTimeout(idxTimeout);
  if (idxRes.ok) {
    const data = await idxRes.json();
    const indexItems = Array.isArray(data?.items) ? data.items : [];
    const allowedMin = 2020;
    const allowedMax = new Date().getFullYear();
    const filtered = indexItems.filter((it) => typeof it.year === 'number' && it.year === yearParam && it.year >= allowedMin && it.year <= allowedMax);
    if (filtered.length > 0) {
      items = filtered.map((it) => {
        const y = typeof it.year === 'number' ? it.year : undefined;
        const m = typeof it.month === 'number' ? it.month : undefined;
        const dateObj = it.date ? new Date(it.date) : (y && m ? new Date(y, m - 1, 1) : new Date(0));
        return {
          title: it.title || it.link,
          link: it.link,
          date: it.date || '',
          dateObj,
          description: it.excerpt || '',
          imageUrl: '',
          categories: Array.isArray(it.categories) ? it.categories : []
        };
      });
    }
  }

  // Fallback: RSS + HTML archive parsing if index didn't provide items
  if (items.length === 0) {
    // RSS feed
    const rssController = new AbortController();
    const rssTimeout = setTimeout(() => rssController.abort(), FEED_TIMEOUT_MS);
    const res = await fetch(FEED_URL, {
      headers: {
        Accept: "application/rss+xml, application/xml, text/xml",
        "User-Agent": "thelifeplace-blog-year"
      },
      signal: rssController.signal
    });
    clearTimeout(rssTimeout);
    if (!res.ok) throw new Error(`Feed fetch failed: HTTP ${res.status}`);
    const xml = await res.text();
    const chunks = xml.split("<item>").slice(1);
    const parsed = chunks.map((chunk) => {
      const title = decodeHtmlEntities(pick(chunk, /<title>(?:<!\[CDATA\[(.*?)\]\]>|(.*?))<\/title>/s));
      const link = pick(chunk, /<link>(.*?)<\/link>/s);
      const date = pick(chunk, /<pubDate>(.*?)<\/pubDate>/s);
      const dateObj = new Date(date);
      const description = decodeHtmlEntities(pick(chunk, /<description>(?:<!\[CDATA\[(.*?)\]\]>|(.*?))<\/description>/s));
      const enclosureMatch = chunk.match(/<enclosure[^>]*url="(.*?)"[^>]*>/s);
      const imageUrl = enclosureMatch ? enclosureMatch[1] : "";
      const catMatches = Array.from(chunk.matchAll(/<category>(?:<!\[CDATA\[(.*?)\]\]>|(.*?))<\/category>/g));
      const categories = catMatches.map((m) => decodeHtmlEntities(cleanCdata(m[1] || m[2] || ""))).filter(Boolean);
      return { title, link, date, dateObj, description, imageUrl, categories };
    });

    items = parsed.filter((it) => isValidDate(it.dateObj) && it.dateObj.getFullYear() === yearParam);

    // If RSS has no items for this year, try Substack archive HTML fallback with cache
    const cached = yearCache.get(yearParam);
    const now = Date.now();
    if (cached && (now - cached.fetchedAt) < FEED_TTL_MS) {
      items = cached.items.slice();
    } else {
      const htmlController = new AbortController();
      const htmlTimeout = setTimeout(() => htmlController.abort(), FEED_TIMEOUT_MS);
      const ares = await fetch(ARCHIVE_URL(yearParam), {
        headers: {
          Accept: "text/html",
          "User-Agent": "thelifeplace-blog-year-archive"
        },
        signal: htmlController.signal
      });
      clearTimeout(htmlTimeout);
      if (!ares.ok) throw new Error(`Archive fetch failed: HTTP ${ares.status}`);
      const html = await ares.text();

      // Parse archive HTML (best-effort, resilient regex)
      function parseArchiveHTML(h) {
        const results = [];
        // Try to match list items with anchor + time
        const liRe = /<li[\s\S]*?<a[^>]*href="https:\/\/schulteretyang\.substack\.com\/p\/[^\"]+"[^>]*>(.*?)<\/a>[\s\S]*?<time[^>]*datetime="([^"]+)"[\s\S]*?<\/li>/gi;
        let m;
        while ((m = liRe.exec(h)) !== null) {
          const title = decodeHtmlEntities(cleanCdata(m[1] || ""));
          const time = m[2];
          const linkMatch = m[0].match(/href="(https:\/\/schulteretyang\.substack\.com\/p\/[^\"]+)"/);
          const link = linkMatch ? linkMatch[1] : "";
          const dateObj = time ? new Date(time) : null;
          if (link && title) {
            results.push({ title, link, date: time || "", dateObj, description: "", imageUrl: "", categories: [] });
          }
        }

        // Fallback: match anchors to posts with nearby date text
        if (results.length === 0) {
          const aRe = /<a[^>]*href="(https:\/\/schulteretyang\.substack\.com\/p\/[^\"]+)"[^>]*>(.*?)<\/a>/gi;
          let am;
          while ((am = aRe.exec(h)) !== null) {
            const link = am[1];
            const title = decodeHtmlEntities(cleanCdata(am[2] || ""));
            // Try to find a date within the next ~200 chars
            const tail = h.slice(aRe.lastIndex, aRe.lastIndex + 200);
            const dateTextMatch = tail.match(/([A-Za-z]{3,} \d{1,2}, \d{4})/);
            const dateText = dateTextMatch ? dateTextMatch[1] : "";
            const dateObj = dateText ? new Date(dateText) : null;
            if (link && title) {
              results.push({ title, link, date: dateText, dateObj, description: "", imageUrl: "", categories: [] });
            }
          }
        }
        return results;
      }

      items = parseArchiveHTML(html);
      yearCache.set(yearParam, { items: items.slice(), fetchedAt: Date.now() });
    }
  }

  // Sort recent first
  items.sort((a, b) => {
    const at = isValidDate(a.dateObj) ? a.dateObj.getTime() : 0;
    const bt = isValidDate(b.dateObj) ? b.dateObj.getTime() : 0;
    return bt - at;
  });

  // Group by month within the year
  const groupsMap = new Map();
  for (const item of items) {
    const key = monthKey(item.dateObj);
    const label = monthLabel(item.dateObj);
    if (!groupsMap.has(key)) groupsMap.set(key, { label, items: [] });
    groupsMap.get(key).items.push(item);
  }
  monthGroups = Array.from(groupsMap.values());
} catch (e) {
  const isAbort = e && typeof e === "object" && (e.name === "AbortError");
  const msg = isAbort ? "Request timed out. Please try again." : (e instanceof Error ? e.message : String(e));
  error = msg;
}

const canonicalHref = `${Astro.url.origin}/blog/${yearParam}`;
---

<BaseLayout title={`Archive: ${yearParam}`}>
  <Fragment slot="head">
    <meta name="description" content={`Posts from ${yearParam} — The Life Place Substack.`} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:title" content={`Archive ${yearParam} — The Life Place`} />
    <meta property="og:description" content={`Posts from ${yearParam} — The Life Place Substack.`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
  </Fragment>

  <!-- Page Hero -->
  <section class="relative w-full py-16 md:py-22 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-black to-gray-900"></div>
    <div class="relative max-w-6xl mx-auto px-6 text-center z-10">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-2">Archive: {yearParam}</h1>
      <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto">All posts published in {yearParam}, newest first.</p>
      <div class="mt-6">
        <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/30 text-white hover:bg-white/10">← Back to Blog</a>
        <!-- Substack's archive may not consistently respect the year query; open the generic archive to avoid confusion. -->
        <a href="https://schulteretyang.substack.com/archive" target="_blank" rel="noopener" class="ml-3 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/30 text-white hover:bg-white/10">Open Substack Archives</a>
      </div>
    </div>
  </section>

  <FadeDivider mt="mt-10" mb="mb-12" width="w-[90%] max-w-6xl" />

  <section class="w-full py-14 md:py-18 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      {error ? (
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
          <p class="text-red-700 font-semibold">Error:</p>
          <p class="text-red-700 text-sm mt-1">{error}</p>
        </div>
      ) : items.length === 0 ? (
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 text-center text-gray-600">
          No posts found for {yearParam}.
        </div>
      ) : (
        <div>
          {monthGroups.map((group) => (
            <section class="mb-10" data-month-group>
              <h2 class="text-xl md:text-2xl font-bold text-brand-warmgray-800 mb-4">{group.label}</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6 sm:gap-8 md:gap-10 xl:gap-12">
                {group.items.map((item) => (
                  <a href={item.link} class="group block rounded-3xl overflow-hidden border border-gray-200 bg-white shadow-md hover:shadow-xl transition-shadow">
                    {item.imageUrl ? (
                      <div class="relative">
                        <img src={item.imageUrl} alt={item.title} class="w-full h-64 md:h-72 lg:h-80 object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" decoding="async" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/15 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
                      </div>
                    ) : (
                      <div class="relative w-full h-64 md:h-72 lg:h-80 bg-gradient-to-r from-brand-red/20 via-red-500/10 to-brand-red/20">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent"></div>
                      </div>
                    )}
                    <div class="p-7 md:p-8">
                      <div class="flex items-center gap-2">
                        <span class="inline-flex items-center px-2 py-1 rounded-full bg-gray-100 text-gray-600 text-xs">{formatDate(item.dateObj, item.date)}</span>
                      </div>
                      <h3 class="mt-4 text-lg md:text-xl font-semibold tracking-tight text-gray-800 group-hover:text-brand-red transition-colors">{item.title || item.link}</h3>
                      <span class="mt-1 block text-xs text-gray-500">Opens on Substack</span>
                      {item.categories && item.categories.length > 0 && (
                        <div class="mt-4 flex flex-wrap gap-3">
                          {[...item.categories].sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase())).map((cat) => (
                            <a href={`https://schulteretyang.substack.com/t/${encodeURIComponent(cat)}`} class="inline-flex items-center px-2 py-1 rounded-2xl text-xs text-gray-600 hover:bg-brand-red/10 hover:text-brand-red transition-colors">
                              {cat}
                            </a>
                          ))}
                        </div>
                      )}
                      {item.description && (
                        <p class="text-sm md:text-base text-gray-600 mt-4 line-clamp-4">{item.description}</p>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
