---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FadeDivider from "../../../components/tlp/FadeDivider.astro";
export const prerender = true;

const FEED_URL = "https://schulteretyang.substack.com/feed";

let items = [];
let error = null;

const rawTag = Astro.params.tag || "";
const tagParam = decodeURIComponent(rawTag).trim();

export async function getStaticPaths() {
  try {
    const res = await fetch(FEED_URL, {
      headers: {
        Accept: "application/rss+xml, application/xml, text/xml",
        "User-Agent": "thelifeplace-blog-tag-staticpaths",
      },
    });
    if (!res.ok) throw new Error(`Feed fetch failed: HTTP ${res.status}`);
    const xml = await res.text();
    const chunks = xml.split("<item>").slice(1);
    const tagSet = new Set();
    for (const chunk of chunks) {
      const catMatches = Array.from(chunk.matchAll(/<category>(?:<!\[CDATA\[(.*?)\]\]>|(.*?))<\/category>/g));
      for (const m of catMatches) {
        const tag = (m[1] || m[2] || "").replace(/<!\[CDATA\[/g, "").replace(/\]\]>/g, "").trim();
        if (tag) tagSet.add(tag);
      }
    }
    const paths = Array.from(tagSet).map((tag) => ({ params: { tag: encodeURIComponent(tag) } }));
    return paths;
  } catch (e) {
    return [];
  }
}

function cleanCdata(str) {
  return (str || "").replace(/<!\[CDATA\[/g, "").replace(/\]\]>/g, "").trim();
}

function pick(chunk, re) {
  const m = chunk.match(re);
  if (!m) return "";
  return cleanCdata(m[1] || m[2] || "");
}

function decodeHtmlEntities(str) {
  if (!str) return "";
  return str
    .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
    .replace(/&#x([0-9a-fA-F]+);/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">");
}

function isValidDate(d) {
  return d instanceof Date && !isNaN(d.getTime());
}

function formatDate(d, fallback) {
  return isValidDate(d)
    ? d.toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric" })
    : (fallback || "");
}

try {
  if (!tagParam) throw new Error("Invalid tag route");

  const res = await fetch(FEED_URL, {
    headers: {
      Accept: "application/rss+xml, application/xml, text/xml",
      "User-Agent": "thelifeplace-blog-tag"
    }
  });
  if (!res.ok) throw new Error(`Feed fetch failed: HTTP ${res.status}`);
  const xml = await res.text();
  const chunks = xml.split("<item>").slice(1);
  const parsed = chunks.map((chunk) => {
    const title = decodeHtmlEntities(pick(chunk, /<title>(?:<!\[CDATA\[(.*?)\]\]>|(.*?))<\/title>/s));
    const link = pick(chunk, /<link>(.*?)<\/link>/s);
    const date = pick(chunk, /<pubDate>(.*?)<\/pubDate>/s);
    const dateObj = new Date(date);
    const description = decodeHtmlEntities(pick(chunk, /<description>(?:<!\[CDATA\[(.*?)\]\]>|(.*?))<\/description>/s));
    const enclosureMatch = chunk.match(/<enclosure[^>]*url="(.*?)"[^>]*>/s);
    const imageUrl = enclosureMatch ? enclosureMatch[1] : "";
    const catMatches = Array.from(chunk.matchAll(/<category>(?:<!\[CDATA\[(.*?)\]\]>|(.*?))<\/category>/g));
    const categories = catMatches.map((m) => decodeHtmlEntities(cleanCdata(m[1] || m[2] || ""))).filter(Boolean);
    return { title, link, date, dateObj, description, imageUrl, categories };
  });

  const wanted = tagParam.toLowerCase();
  items = parsed.filter((it) => (it.categories || []).some((c) => c.toLowerCase() === wanted));

  items.sort((a, b) => {
    const at = isValidDate(a.dateObj) ? a.dateObj.getTime() : 0;
    const bt = isValidDate(b.dateObj) ? b.dateObj.getTime() : 0;
    return bt - at;
  });
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}

const canonicalHref = `${Astro.url.origin}/blog/tag/${encodeURIComponent(tagParam)}`;
---

<BaseLayout title={`Tag: ${tagParam}`}>
  <Fragment slot="head">
    <meta name="description" content={`Posts tagged '${tagParam}' — The Life Place Substack.`} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:title" content={`Tag: ${tagParam} — The Life Place`} />
    <meta property="og:description" content={`Posts tagged '${tagParam}' — The Life Place Substack.`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
  </Fragment>

  <!-- Page Hero -->
  <section class="relative w-full py-16 md:py-22 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-black to-gray-900"></div>
    <div class="relative max-w-6xl mx-auto px-6 text-center z-10">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-2">Tag: {tagParam}</h1>
      <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto">Posts labeled with this tag, newest first.</p>
      <div class="mt-6">
        <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/30 text-white hover:bg-white/10">← Back to Blog</a>
          <a href={`https://schulteretyang.substack.com/t/${encodeURIComponent(tagParam)}`} target="_blank" rel="noopener" class="ml-3 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/30 text-white hover:bg-white/10">Open on Substack</a>
      </div>
    </div>
  </section>

  <FadeDivider mt="mt-10" mb="mb-12" width="w-[90%] max-w-6xl" />

  <section class="w-full py-12 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      {error ? (
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
          <p class="text-red-700 font-semibold">Error:</p>
          <p class="text-red-700 text-sm mt-1">{error}</p>
        </div>
      ) : items.length === 0 ? (
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 text-center text-gray-600">
          No posts found for tag '{tagParam}'.
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((item) => (
            <a href={item.link} target="_blank" rel="noopener" class="group block rounded-2xl overflow-hidden shadow-sm border bg-white">
              {item.imageUrl ? (
                <img src={item.imageUrl} alt={item.title} class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" decoding="async" />
              ) : (
                <div class="w-full h-48 bg-gradient-to-r from-brand-red/20 via-red-500/10 to-brand-red/20"></div>
              )}
              <div class="p-4">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center px-2 py-1 rounded-full bg-gray-100 text-gray-600 text-xs">{formatDate(item.dateObj, item.date)}</span>
                </div>
                <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red transition-colors">{item.title || item.link}</h3>
                {item.description && (
                  <p class="text-sm text-gray-600 mt-2 line-clamp-3">{item.description}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
