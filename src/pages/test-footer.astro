---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Footer - Test">

<!-- ===== DRAMATIC HERO SECTION ===== -->
<section class="w-full min-h-screen md:min-h-[80vh] relative overflow-hidden bg-gradient-to-r from-brand-red/95 via-red-600/90 to-brand-red/95 flex items-center justify-center">
  
  <!-- Animated background elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 right-1/4 w-80 h-80 bg-brand-red/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 left-1/3 w-64 h-64 bg-brand-red/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 text-center z-10">
    
    <!-- Label -->
    <div class="mb-8 opacity-0 animate-fadeUp">
      <span class="inline-block px-4 py-2 rounded-full bg-gradient-to-r from-brand-red/20 to-red-600/10 border border-brand-red/40 text-sm md:text-base text-brand-red font-bold uppercase tracking-widest backdrop-blur-sm">
        Site Foundation
      </span>
    </div>

    <!-- Main heading -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black leading-tight text-white mb-8 opacity-0 animate-fadeUp delay-100 max-w-5xl mx-auto">
      Build Community
      <span class="block text-yellow-200 mt-4 md:mt-6">
        From The Ground Up
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base md:text-xl text-white max-w-2xl mx-auto leading-relaxed font-medium opacity-0 animate-fadeUp delay-200 mb-12">
      A strong footer creates connection points, shares your story, and builds lasting relationships with your community.
    </p>

    <!-- CTA -->
    <div class="opacity-0 animate-fadeUp delay-300">
      <a href="#footer-section" class="inline-block px-8 py-4 bg-white text-brand-red font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
        Explore Below
      </a>
    </div>

  </div>

</section>

<!-- ===== FOOTER SHOWCASE SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-white">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="mb-20 text-center opacity-0 animate-fadeUp delay-100">
      <h2 class="text-4xl md:text-5xl font-black text-gray-800 mb-6">
        Modern Footer Design
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
        Every section serves a purpose—connecting, informing, and inspiring your community to take the next step.
      </p>
    </div>

  </div>

</section>

<!-- ===== ACTUAL FOOTER SECTION (REIMAGINED) ===== -->
<section id="footer-section" class="w-full bg-gradient-to-br from-slate-900 via-black to-slate-800 relative overflow-hidden">
  
  <!-- Background elements -->
  <div class="absolute inset-0 opacity-40">
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-red/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative py-24 md:py-40">
    
    <div class="max-w-7xl mx-auto px-6">

      <!-- Brand Statement -->
      <div class="text-center mb-20 opacity-0 animate-fadeUp delay-100">
        <h3 class="text-2xl md:text-4xl font-black text-white mb-4">
          Come. See. <span class="text-brand-red">Jesus</span>
        </h3>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
          Building a vibrant urban church community in the heart of Sandton
        </p>
      </div>

      <!-- 4-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-6 mb-20 opacity-0 animate-fadeUp delay-200">
        
        <!-- EXPLORE -->
        <div>
          <h4 class="text-sm font-black text-brand-red uppercase tracking-widest mb-6">
            Explore
          </h4>
          <ul class="space-y-3">
            <li><a href="/about-us/" class="text-gray-400 hover:text-white transition-colors duration-300">About</a></li>
            <li><a href="/about-us/leadership/" class="text-gray-400 hover:text-white transition-colors duration-300">Leadership</a></li>
            <li><a href="/visit/" class="text-gray-400 hover:text-white transition-colors duration-300">Plan a Visit</a></li>
            <li><a href="/ministries/" class="text-gray-400 hover:text-white transition-colors duration-300">Ministries</a></li>
          </ul>
        </div>

        <!-- NEXT STEPS -->
        <div>
          <h4 class="text-sm font-black text-brand-red uppercase tracking-widest mb-6">
            Next Steps
          </h4>
          <ul class="space-y-3">
            <li><a href="/give/" class="text-gray-400 hover:text-white transition-colors duration-300">Giving</a></li>
            <li><a href="/prayer/" class="text-gray-400 hover:text-white transition-colors duration-300">Prayer</a></li>
            <li><a href="/" class="text-gray-400 hover:text-white transition-colors duration-300">Contact</a></li>
            <li><a href="/app/" class="text-gray-400 hover:text-white transition-colors duration-300">Get App</a></li>
          </ul>
        </div>

        <!-- RESOURCES -->
        <div>
          <h4 class="text-sm font-black text-brand-red uppercase tracking-widest mb-6">
            Resources
          </h4>
          <ul class="space-y-3">
            <li><a href="/messages" class="text-gray-400 hover:text-white transition-colors duration-300">Sermons</a></li>
            <li><a href="/" class="text-gray-400 hover:text-white transition-colors duration-300">Events</a></li>
            <li><a href="/" class="text-gray-400 hover:text-white transition-colors duration-300">Blog</a></li>
            <li><a href="/" class="text-gray-400 hover:text-white transition-colors duration-300">Podcasts</a></li>
          </ul>
        </div>

        <!-- LEGAL -->
        <div>
          <h4 class="text-sm font-black text-brand-red uppercase tracking-widest mb-6">
            Legal
          </h4>
          <ul class="space-y-3">
            <li><a href="/privacy-policy" class="text-gray-400 hover:text-white transition-colors duration-300">Privacy</a></li>
            <li><a href="/terms/" class="text-gray-400 hover:text-white transition-colors duration-300">Terms</a></li>
            <li><a href="/cookies/" class="text-gray-400 hover:text-white transition-colors duration-300">Cookies</a></li>
            <li><a href="/" class="text-gray-400 hover:text-white transition-colors duration-300">Sitemap</a></li>
          </ul>
        </div>

      </div>

      <!-- Contact & Location Card -->
      <div class="mb-20 p-8 md:p-12 bg-gradient-to-r from-brand-red/15 to-red-600/10 border border-brand-red/30 rounded-2xl opacity-0 animate-fadeUp delay-300">
        <div class="grid md:grid-cols-2 gap-12">
          
          <!-- Address & Contact -->
          <div>
            <h4 class="text-sm font-black text-brand-red uppercase tracking-widest mb-6">
              Get in Touch
            </h4>
            <div class="space-y-4">
              <div>
                <p class="font-semibold text-white text-lg mb-1">The Life Place</p>
                <p class="text-gray-400 text-sm">51 Villa Monte Catini, 1 Elm Avenue</p>
                <p class="text-gray-400 text-sm">Craigavon AH, 2191</p>
                <p class="text-gray-400 text-sm">Sandton, South Africa</p>
              </div>
              <div>
                <p class="text-white font-bold mb-2">Sundays 9:00–11:00am</p>
                <a href="mailto:hello@thelifeplace.org" class="text-brand-red hover:text-red-400 transition-colors duration-300 font-medium">
                  hello@thelifeplace.org
                </a>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div>
            <h4 class="text-sm font-black text-brand-red uppercase tracking-widest mb-6">
              Quick Links
            </h4>
            <div class="space-y-3">
              <a href="/visit/" class="flex items-center gap-2 text-gray-300 hover:text-white transition-colors duration-300">
                <span class="text-brand-red">→</span> Plan a Visit
              </a>
              <a href="https://maps.app.goo.gl/kWtzKtuyASu3qRxo7" target="_blank" rel="noopener" class="flex items-center gap-2 text-gray-300 hover:text-white transition-colors duration-300">
                <span class="text-brand-red">→</span> Open in Maps
              </a>
              <a href="/give/" class="flex items-center gap-2 text-gray-300 hover:text-white transition-colors duration-300">
                <span class="text-brand-red">→</span> Make a Donation
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Social Icons -->
      <div class="mb-16 flex justify-center gap-4 opacity-0 animate-fadeUp delay-400">
        <a href="https://facebook.com/thelifeplacesa" target="_blank" rel="noopener" class="w-12 h-12 bg-black/50 hover:bg-brand-red rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110">
          <i class="fa-brands fa-facebook-f"></i>
        </a>
        <a href="https://instagram.com/thelifeplacesa" target="_blank" rel="noopener" class="w-12 h-12 bg-black/50 hover:bg-brand-red rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110">
          <i class="fa-brands fa-instagram"></i>
        </a>
        <a href="https://youtube.com/@thelifeplacesa" target="_blank" rel="noopener" class="w-12 h-12 bg-black/50 hover:bg-brand-red rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110">
          <i class="fa-brands fa-youtube"></i>
        </a>
        <a href="https://open.spotify.com/show/31hbtgq5cvmqr4tyzs2faygvrzaa" target="_blank" rel="noopener" class="w-12 h-12 bg-black/50 hover:bg-brand-red rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110">
          <i class="fa-brands fa-spotify"></i>
        </a>
        <a href="https://podcasts.apple.com/us/podcast/the-life-place/id1816955719" target="_blank" rel="noopener" class="w-12 h-12 bg-black/50 hover:bg-brand-red rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110">
          <i class="fa-solid fa-podcast"></i>
        </a>
      </div>

      <!-- Divider -->
      <div class="border-t border-white/10 mb-8"></div>

      <!-- Copyright -->
      <div class="text-center text-gray-500 text-sm opacity-0 animate-fadeUp delay-500">
        <p>&copy; {new Date().getFullYear()} The Life Place. All rights reserved.</p>
      </div>

    </div>

  </div>

</section>

<!-- ===== FOOTER FEATURE SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-white">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="text-center mb-16 opacity-0 animate-fadeUp delay-100">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-800 mb-6">
        Why a Strong Footer <span class="text-brand-red">Matters</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
        The footer is where visitors complete their journey—make it count.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      
      <!-- Feature 1 -->
      <div class="p-8 bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-2xl opacity-0 animate-fadeUp delay-200 border border-blue-200/50">
        <div class="text-4xl mb-4">🔗</div>
        <h3 class="text-2xl font-black text-gray-800 mb-3">Navigation</h3>
        <p class="text-gray-600">
          Help visitors find what they're looking for with organized, intuitive navigation links throughout your site.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="p-8 bg-gradient-to-br from-green-50 to-green-100/50 rounded-2xl opacity-0 animate-fadeUp delay-300 border border-green-200/50">
        <div class="text-4xl mb-4">📱</div>
        <h3 class="text-2xl font-black text-gray-800 mb-3">Connection</h3>
        <p class="text-gray-600">
          Build deeper relationships through newsletter signups, social media links, and contact information.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="p-8 bg-gradient-to-br from-purple-50 to-purple-100/50 rounded-2xl opacity-0 animate-fadeUp delay-400 border border-purple-200/50">
        <div class="text-4xl mb-4">🏢</div>
        <h3 class="text-2xl font-black text-gray-800 mb-3">Trust & Credibility</h3>
        <p class="text-gray-600">
          Display legal info, social proof, and brand story to build confidence in your organization.
        </p>
      </div>

    </div>

  </div>

</section>

<!-- ===== BACK TO TEST PAGES ===== -->
<section class="w-full py-20 md:py-28 bg-gradient-to-r from-brand-red/95 via-red-600/90 to-brand-red/95">
  
  <div class="max-w-4xl mx-auto px-6 text-center">
    
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-8 opacity-0 animate-fadeUp delay-100">
      Explore Other Test Pages
    </h2>

    <div class="grid md:grid-cols-3 gap-6 opacity-0 animate-fadeUp delay-300">
      
      <a href="/test-home" class="px-6 py-4 bg-white/20 hover:bg-white/30 text-white font-bold rounded-full border border-white/30 transition-all duration-300 hover:scale-105 backdrop-blur-sm">
        Test Home
      </a>

      <a href="/test-values" class="px-6 py-4 bg-white/20 hover:bg-white/30 text-white font-bold rounded-full border border-white/30 transition-all duration-300 hover:scale-105 backdrop-blur-sm">
        Test Values
      </a>

      <a href="/test-beliefs" class="px-6 py-4 bg-white/20 hover:bg-white/30 text-white font-bold rounded-full border border-white/30 transition-all duration-300 hover:scale-105 backdrop-blur-sm">
        Test Beliefs
      </a>

      <a href="/test-leadership" class="px-6 py-4 bg-white/20 hover:bg-white/30 text-white font-bold rounded-full border border-white/30 transition-all duration-300 hover:scale-105 backdrop-blur-sm">
        Test Leadership
      </a>

      <a href="/test-visit" class="px-6 py-4 bg-white/20 hover:bg-white/30 text-white font-bold rounded-full border border-white/30 transition-all duration-300 hover:scale-105 backdrop-blur-sm">
        Test Visit
      </a>

      <a href="/" class="px-6 py-4 bg-white text-brand-red font-bold rounded-full transition-all duration-300 hover:scale-105">
        Back Home
      </a>

    </div>

  </div>

</section>

<!-- Custom animations -->
<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }
  .delay-1000 { animation-delay: 1000ms; }
</style>

</BaseLayout>
