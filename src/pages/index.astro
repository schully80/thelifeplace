---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="The Life Place">

<!-- HERO / Welcome -->

<!-- Break parent container so hero is truly full width -->
<div class="w-screen max-w-none relative left-1/2 right-1/2 -mx-[50vw]">

<section
  class="relative w-screen h-screen overflow-hidden flex items-center justify-center 
         mt-[96px] -translate-y-[96px] md:mt-[96px] md:-translate-y-[96px]"
>
  <!-- BACKGROUND -->
  <div class="absolute inset-0 z-0">
    <img
      src="/hero.jpg"
      alt="Welcome to The Life Place"
      class="w-full h-full object-cover object-center scale-[1.05] blur-[6px] opacity-95 brightness-75 contrast-110"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
  </div>

  <!-- TEXT CONTENT -->
  <div class="relative z-10 text-center fade-in-slow max-w-4xl mx-auto px-8">
    <h1 class="text-white text-5xl md:text-6xl leading-tight font-extrabold flex items-center justify-center gap-3 drop-shadow-[0_4px_10px_rgba(0,0,0,0.45)] mb-8 md:mb-12">
      <span>OUR WELCOME</span>
    </h1>

    <!-- Motion-stagger paragraphs -->
    <p class="text-white text-2xl md:text-4xl fade-in-up delay-300 drop-shadow-[0_4px_10px_rgba(0,0,0,0.45)]">
      We open wide our doors with a welcome from
      <span class="text-white">Jesus</span>,
    </p>

    <p class="text-white text-2xl md:text-4xl fade-in-up delay-500 drop-shadow-[0_4px_10px_rgba(0,0,0,0.45)]">
      the <span class="text-white">Embracer</span> of the outsider,
    </p>

    <p class="text-white text-2xl md:text-4xl fade-in-up delay-700 drop-shadow-[0_4px_10px_rgba(0,0,0,0.45)]">
      the <span class="text-white">Defender</span> of the guilty,
    </p>

    <p class="text-white text-2xl md:text-4xl fade-in-up delay-900 drop-shadow-[0_4px_10px_rgba(0,0,0,0.45)]">
      the <span class="text-white">Justifier</span> of the ungodly,
    </p>

    <p class="text-white text-2xl md:text-4xl fade-in-up delay-[1100ms] drop-shadow-[0_4px_10px_rgba(0,0,0,0.45)]">
      the <span class="text-white">Friend</span> of sinners.
    </p>

  </div>
</section>
</div>

<!-- SLOGAN BLOCK -->
<div id="slogan-block" class="w-full text-center py-12 md:py-20 bg-white relative">
  <p class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 inline-block relative">

    Come. See.

    <span class="relative inline-block font-extrabold mx-2">

      <!-- JESUS PILL -->
      <span
        class="inline-block px-3 py-0 rounded-[9px] bg-brand-red text-white font-bold border-4 border-white shadow-lg tracking-wide rotate-[-2deg] relative"
      >
        Jesus
        <span class="absolute top-1 left-1 w-2 h-2 rounded-full border border-gray-700 shadow bg-gray-300"></span>
        <span class="absolute top-1 right-1 w-2 h-2 rounded-full border border-gray-700 shadow bg-gray-300"></span>
      </span>

      <!-- ARROW POINTER TO JESUS -->
      <span class="finger-pointer absolute top-1/2 -translate-y-1/2 right-[-40px] md:right-[-90px]">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="w-14 h-14 md:w-20 md:h-20 text-brand-red"
             viewBox="0 0 24 24" fill="currentColor">
          <path d="M22 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H22v-2z"/>
        </svg>
      </span>

    </span>
  </p>

 <!-- FIXED SCROLL ARROW (starts here) -->
<div
  id="scroll-arrow"
  class="fixed right-6 top-1/3 z-[30] cursor-pointer opacity-0 scale-90 transition-all duration-600 ease-in-out"
>
  <div class="text-brand-red opacity-90 hover:opacity-100 transition">
    <svg xmlns="http://www.w3.org/2000/svg"
         class="w-16 h-16 md:w-20 md:h-20 transition-transform duration-600"
         viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 7l7 7 7-7" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7 7 7-7" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7 7 7-7" />
    </svg>
  </div>
</div>  

<!-- SOFT DIVIDER -->
<div class="w-full my-20">
  <div class="h-[4px] w-full bg-gradient-to-r from-transparent via-brand-red to-transparent"></div>
</div>


  <!-- WHAT WE BELIEVE -->
  
<section id="what-we-believe" class="bg-white border-t border-gray-200 py-12 md:py-20">
  <div class="container-x max-w-4xl mx-auto px-4 ">

    
    <!-- Section Title -->
    <h2 class="text-center text-3xl md:text-4xl font-bold mb-6">
  <span class="text-gray-700">WHAT WE</span>
  <span class="text-brand-red">BELIEVE</span>
</h2>

    <!-- Intro Paragraph -->
    <p class="text-center text-lg md:text-xl text-gray-700 leading-relaxed mb-10">
      Sound doctrine isn’t about rules; it’s about Jesus—who He is, what He has done, and how His finished work shapes what we believe and how we live.
    </p>

    <div id="believe-anchor"></div>

   <!-- Belief Categories -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {[   
   { title: "GOD", 
   content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
    We believe in one God, eternally existing in three persons: Father, Son, and Holy Spirit.<br />
    The Father is the source of all life, the Son is our Saviour and Lord, and the Holy Spirit gives new life and power.<br />
    To Him alone belongs all honour, praise, and worship forever.<br /><br />
    Genesis 1:1; Deuteronomy 6:4; Matthew 28:19; John 1:1–3, 14; 2 Corinthians 13:14
     </div>
  )
},

    { title: "JESUS", 
    content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe the eternal Son became fully man without ceasing to be fully God.<br />
We affirm His virgin birth and His sinless life.<br />
We believe it is understood only by the Spirit’s illumination and is relevant to every culture, age, and human condition.<br /><br />
John 1:14; Romans 1:3–4; Galatians 4:4; Isaiah 7:14; Luke 1:35
</div>
  )
},
   
        { title: "HOLY SPIRIT",   
       content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe the Holy Spirit is God, co-equal with the Father and the Son.<br />
He convicts of sin, regenerates hearts, indwells believers, produces spiritual fruit, and empowers the Church for witness and service.<br />
We believe it is understood only by the Spirit’s illumination and is relevant to every culture, age, and human condition.<br /><br />
Romans 8:26–27; John 14:16–17, 26; 2 Corinthians 3:17–18; Galatians 5:22–23; Acts 1:8
</div>
  )
},
   
   
   { title: "CREATION", 
   content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
    We believe God created the universe and affirm the historic truth of Genesis, including Adam and Eve, the fall, the flood, and the tower of Babel.<br /><br />
    Genesis 1-11
     </div>
  )
},
   
     { title: "HUMANITY",     
    content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe every human being is made in the image of God.<br />
We believe God created humanity as male and female.<br />
We believe all humanity is fallen through sin but redeemed through Christ’s death and resurrection.<br />
We believe believers are made new in spirit and renewed in mind.<br /><br />
Genesis 1:26–28; 5:1–3; Ephesians 4:22–23; Hebrews 4:12; 1 Thessalonians 5:23; Genesis 3:6; Psalm 51:5; Romans 5:12; 7:17–20; John 1:29; Ephesians 1:7; Galatians 3:13; Hebrews 9:12; 1 Peter 1:18–19; Romans 8:29; 12:2; Ephesians 4:13; Philippians 3:21; Colossians 3:10     
</div>
  )
},

   { title: "SIN",     
    content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe sin is the fallen state of creation. 
We believe that through the disobedience of Adam and Eve, sin entered the world, and all humanity has been affected. Every person is born with a sinful nature and inclined toward disobedience.<br />
We believe sin brings death, but through repentance and faith we are reconciled to God.<br /><br />
Ezekiel 36:26–27; John 8:24; Romans 3:23, 6:6; Ephesians 2:13–14; 1 James 4:17; John 1:6–7
</div>
  )
},

   { title: "THE BIBLE ", 
   content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe the Bible is God’s written word, fully inspired, enduring forever, true and without error.<br /><br />
John 1:14, 18; Deuteronomy 29:29; 1 Peter 1:23, 25; Psalm 119:89; John 17:17; 1 Corinthians 2:12–13; Ephesians 1:17; Revelation 14:6
</div>
  )
},


    
       { title:"SALVATION", 
   content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
    We believe that salvation is by grace alone, through faith alone, in Christ alone.<br />
It is the free gift of God, not earned by works or human effort, so that no one may boast.<br />
By His death on the cross and His resurrection from the dead, Jesus Christ accomplished our redemption.<br />
All who repent and believe in Him are forgiven, justified, and given eternal life. <br /><br />
Ephesians 2:8–9; Romans 3:28; Titus 3:4–7; Acts 4:12
</div>
  )
},
      
     { title: "THE RESURRECTION OF JESUS", 
content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">

We believe Jesus was crucified, buried, and rose bodily from the dead on the third day.<br />
We believe the resurrection of Jesus Christ is a historical fact, witnessed by His disciples, over five hundred followers at one time, and many others.<br />
His resurrection is the cornerstone of our faith and the assurance of our eternal hope.<br /><br />
Luke 24:6–7; Romans 4:25; 1 Corinthians 15:3–4, 14, 20 
</div>
  )
},


  { title: "THE CHURCH", 
  content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe all believers form one body — the Church.<br />
We believe the local church gathers for worship, teaching, and mission.<br /><br />
Romans 12:4–5; Galatians 3:26, 28; 1 Corinthians 12:12, 27; Acts 2:46–47; 1 Timothy 3:14–15
</div>
  )
},
  
    {title: "MARRIAGE AND FAMILY",
  content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
      We uphold the biblical and orthodox view of marriage between a man (male) and a woman (female).<br />
      We believe marriage is the foundation of any society and is solely between a man and a woman, as set out in Genesis 2:21–25.<br />
      We believe that a man and a woman come together in marriage union for the purpose of re-creation, companionship and enjoyment.<br />
      We believe that sexual activity is between a man (male) and a woman (female) within the confines of lawful matrimony.<br />
      We believe that a Christian must be joined in marriage to another Christian.<br />
      We do not conduct or condone marriage between a Christian and a non-Christian.<br />
      We reserve the right not to counsel or wed any persons entering into same-sex marriages.<br /><br />
      Genesis 2:21–25, Matthew 10:6–9, Mark 10:6–12, 1 Corinthians 6:16; 7:2–4, Ephesians 5:28–33, 1 Timothy 5:14, Genesis 1:28, Proverbs 5:18–19, Romans 1:16–27
    </div>
  )
},


     { title: "BAPTISM AND COMMUNION", 
     content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe baptism and communion are ordinances given by Christ.<br />
Baptism testifies to new life in Him.<br />
Communion remembers His body broken and His blood shed for our salvation. <br /><br />
Matthew 28:19; Luke 22:19–20; Romans 6:3–4; 1 Corinthians 11:23–26
</div>
  )
},  
      
      { title: "TITHES AND OFFERINGS", 
      content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe giving is an act of worship.<br />
We believe tithes and offerings honour Jesus, support His work, and express gratitude for His provision.<br /><br />
Proverbs 3:9–10; Malachi 3:10; 2 Corinthians 9:6–7; Hebrews 7:8
</div>
  )
},

    { title: "HEAVEN", 
      content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe Heaven is God’s dwelling place and the eternal home of believers.<br /><br />
Hebrews 11:6, 15–16; Ephesians 1:20; Hebrews 3:11</div>
  )
},

    { title: "HELL", 
      content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe Hell is the eternal place of punishment for satan, demons, and those who reject God's love.<br /><br />
Matthew 13:42; Mark 9:43–47; Revelation 20:10, 14; 2 Thessalonians 1:9
</div>
  )
},

    { title: "THE RETURN OF JESUS", 
      content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
    We believe Jesus will return personally, visibly, and gloriously to judge, rule, and reign.<br /><br />
Acts 1:11; 1 Thessalonians 4:16–17; Revelation 22:12
</div>
  )
},

 { title: "LAST THINGS", 
      content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
 We believe God will bring history to its rightful conclusion with Christ’s triumph over all evil, the final judgment, and the renewal of all things.<br /><br />
 Matthew 24:30–31; Revelation 20:11–15
 </div>
  )
},


 { title: "ALL THINGS MADE NEW", 
      content: (
    <div class="text-base sm:text-lg md:text-lg leading-relaxed text-gray-700">
We believe God will make all things new — a new heavens and new earth where righteousness dwells.<br />
Believers will receive glorified, imperishable bodies, transformed into the likeness of Christ’s glorious body.<br /><br />
Isaiah 65:17; 2 Peter 3:13; Revelation 21:1–4; 1 Corinthians 15:51–53; Philippians 3:20–21 
</div>
  )
},



        ].map(({ title, content }) => (
        <details class="border border-l-4 border-brand-red rounded-lg bg-white shadow-sm transition">
          <summary class="flex items-center justify-between px-4 py-3 cursor-pointer text-lg md:text-xl font-semibold text-brand-darkgray hover:text-brand-red">
            <span>{title}</span>
            <svg
              class="h-8 w-8 transform transition-transform text-brand-red"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 9l-7 7-7-7M19 13l-7 7-7-7" />
            </svg>
          </summary>
         <div class="overflow-hidden transition-all duration-700 ease-in-out group-open:max-h-[2000px] px-4 pb-4 pt-2 text-base sm:text-lg leading-relaxed text-gray-700">
    {content}
  </div>
</details>
      ))}
    </div>
  </div>
</section>

<style>
  :global(details[open] summary svg) {
    transform: rotate(180deg);
  }

  .gradient-underline {
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 100%;
  height: 5px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent 0%, #B3282D 50%, transparent 100%);
  background-size: 200% 100%;
  animation: gradientSlide 2.8s ease-in-out infinite;
}

@keyframes gradientSlide {
  0%   { background-position: 200% 0; }
  50%  { background-position: 0% 0; }
  100% { background-position: -200% 0; }
}

@keyframes fingerBounce {
  0%, 100% { transform: translateY(-50%) translateX(0); }
  50%      { transform: translateY(-50%) translateX(-8px); }
}

.finger-pointer {
  animation: fingerBounce 1.8s ease-in-out infinite;
}

</style>


<!-- SOFT DIVIDER BETWEEN BLOCKS -->
<div class="w-full my-20">
  <div class="h-[4px] w-full bg-gradient-to-r from-transparent via-brand-red to-transparent"></div>
</div>


<!-- INLINE GLASS APP DOWNLOAD CARD -->
<div
  id="download-app"
  class="mx-auto mt-16 max-w-md backdrop-blur-xl bg-white/20 border border-white/30
         shadow-2xl rounded-3xl p-8 text-center ring-1 ring-black/5 animate-floatSlow"
>
  <img 
    src="/expo-qr.png"
    alt="Download App QR"
    class="w-36 h-36 mx-auto mb-4 rounded-lg shadow-md"
  />

  <h3 class="text-2xl font-semibold text-gray-900 mb-2">
    Download Our App
  </h3>

  <p class="text-gray-600 text-sm leading-relaxed mb-5">
    Scan the QR code to open the app instantly in Expo Go.
  </p>

  <a
    href="https://expo.dev/"
    target="_blank"
    class="inline-flex items-center gap-2 rounded-full px-6 py-3
           bg-brand-red text-white font-semibold shadow-sm
           hover:bg-brand-red/90 hover:shadow-md active:scale-[0.97]
           transition-all"
  >
    Get Expo Go
    <svg 
      class="w-5 h-5"
      fill="none" stroke="currentColor" stroke-width="2"
      viewBox="0 0 24 24">
      <path d="M22 2 11 13" />
      <path d="M22 2 15 22 11 13 2 9 22 2z" />
    </svg>
  </a>
</div>
</BaseLayout>

<div id="page-top"></div>

<style>
  @keyframes fadeBounce {
    0% { opacity: 0; transform: scale(0.9) translateY(20px); }
    60% { opacity: 1; transform: scale(1.05) translateY(-5px); }
    80% { transform: scale(0.98) translateY(2px); }
    100% { transform: scale(1) translateY(0); }
  }

  .fade-bounce {
    animation: fadeBounce 0.6s ease-out forwards;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const arrow = document.getElementById("scroll-arrow");
    const svg = arrow.querySelector("svg");

    const scrollTargets = ["what-we-believe", "download-app", "top"];
    let currentIndex = 0;
    let lastScrollY = window.scrollY; // track last scroll position

    function smoothScrollTo(targetElement) {
      const targetY = targetElement.getBoundingClientRect().top + window.scrollY;
      const startY = window.scrollY;
      const distance = targetY - startY;
      const duration = 900;
      let startTime = null;

      function animation(currentTime) {
        if (!startTime) startTime = currentTime;
        const timeElapsed = currentTime - startTime;

        // Ease-in-out for smooth motion
        const ease = timeElapsed / duration < 1
          ? (1 - Math.cos(Math.PI * (timeElapsed / duration))) / 2
          : 1;

        window.scrollTo(0, startY + distance * ease);

        if (timeElapsed < duration) {
          requestAnimationFrame(animation);
        }
      }

      requestAnimationFrame(animation);
    }

    /* -------------------------------------------------------
        CLICK HANDLER
    --------------------------------------------------------*/
    arrow.addEventListener("click", () => {
      const targetId = scrollTargets[currentIndex];
      const target = document.getElementById(targetId);

      if (target) smoothScrollTo(target);

      // Arrow rotation only on final step
      if (currentIndex === scrollTargets.length - 1) {
        svg.classList.add("rotate-180");
      } else {
        svg.classList.remove("rotate-180");
      }

     if (targetId === "top") {
  // Scroll smoothly to the very top by targeting the <html> element
  document.documentElement.scrollIntoView({ behavior: "smooth", block: "start" });
} else {
  const target = document.getElementById(targetId);
  if (target) {
    target.scrollIntoView({ behavior: "smooth", block: "start" });
  }
}
      currentIndex = (currentIndex + 1) % scrollTargets.length;
    });

    

    // Scroll tracking
    window.addEventListener("scroll", () => {
      const sloganBlock = document.getElementById("slogan-block");
      const sloganTop = sloganBlock.getBoundingClientRect().top;

      // Fade + bounce in when slogan enters view
      if (sloganTop <= window.innerHeight * 0.75) {
        if (!arrow.classList.contains("opacity-100")) {
          arrow.classList.remove("opacity-0", "scale-90");
          arrow.classList.add("opacity-100", "scale-100");
          arrow.classList.add("fade-bounce"); // trigger bounce
          setTimeout(() => arrow.classList.remove("fade-bounce"), 700); // reset class so bounce can replay
        }
      } else {
        arrow.classList.remove("opacity-100", "scale-100", "fade-bounce");
        arrow.classList.add("opacity-0", "scale-90");
        svg.classList.remove("rotate-180");
        currentIndex = 0;
        return;
      }

      // Detect scroll direction
      if (window.scrollY > lastScrollY) {
        // Scrolling down → arrow points down
        svg.classList.remove("rotate-180");
      } else if (window.scrollY < lastScrollY) {
        // Scrolling up → arrow points up
        svg.classList.add("rotate-180");
      }
      lastScrollY = window.scrollY;

      // Flip arrow at bottom + bounce
      const scrollBottom = window.innerHeight + window.scrollY;
      const pageHeight = document.body.offsetHeight;

      if (scrollBottom >= pageHeight - 50) {
        svg.classList.add("rotate-180", "fade-bounce");
        setTimeout(() => svg.classList.remove("fade-bounce"), 700);
      }
    });
  });
</script>