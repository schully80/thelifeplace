<script>
  console.log('Script loaded');
  
  function setupAccordions() {
    console.log('setupAccordions called');
    const beliefSection = document.querySelector('#what-we-believe');
    console.log('Belief section:', !!beliefSection);
    if (!beliefSection) return;
    
    const allDetails = beliefSection.querySelectorAll('details');
    console.log('Found details elements:', allDetails.length);
    
    allDetails.forEach((details, idx) => {
      details.addEventListener('toggle', (e) => {
        const titleEl = details.querySelector('summary span');
        const title = titleEl ? titleEl.textContent : 'Unknown';
        console.log(`\n>>> Toggle event on "${title}" - now open:`, details.open);
        
        // Log state of all accordions
        console.log('Current state of all accordions:');
        allDetails.forEach((d, i) => {
          const t = d.querySelector('summary span')?.textContent || 'Unknown';
          console.log(`  [${i}] ${t}: ${d.open}`);
        });
        
        if (details.open) {
          console.log(`>>> Closing all others...`);
          let closedCount = 0;
          allDetails.forEach((otherDetails, otherIdx) => {
            if (otherDetails !== details && otherDetails.open) {
              const otherTitle = otherDetails.querySelector('summary span')?.textContent || 'Unknown';
              console.log(`  Closing [${otherIdx}] "${otherTitle}"`);
              otherDetails.open = false;
              closedCount++;
            }
          });
          if (closedCount === 0) {
            console.log(`  (No others were open)`);
          }
        }
      });
    });
  }
  
  // Try immediately first
  if (document.readyState === 'loading') {
    console.log('Document still loading, waiting for DOMContentLoaded');
    document.addEventListener('DOMContentLoaded', setupAccordions);
  } else {
    console.log('Document already loaded, running setup now');
    setupAccordions();
  }
</script>

