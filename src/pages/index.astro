---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisitLocation } from "../content/shared-content.js";
import { site } from "../../site.config.js";

const visitLocation = getVisitLocation();
const storyEmail = "mystory@thelifeplace.org";
const storyWhatsAppNumber = "27765639460";
const storyWhatsAppMessage = "Hi The Life Place, I'd like to share my story.";
const storyWhatsAppUrl = `https://wa.me/${storyWhatsAppNumber}?text=${encodeURIComponent(
  storyWhatsAppMessage
)}`;

const storyChannels = [
  {
    href: `mailto:${storyEmail}`,
    label: "Email your story",
    icon: "fa-solid fa-envelope",
  },
  {
    href: storyWhatsAppUrl,
    label: "WhatsApp your story",
    icon: "fa-brands fa-whatsapp",
    external: true,
  },
  {
    href: site.socials.facebook,
    label: "Facebook",
    icon: "fa-brands fa-facebook-f",
    external: true,
  },
  {
    href: site.socials.instagram,
    label: "Instagram",
    icon: "fa-brands fa-instagram",
    external: true,
  },
  {
    href: site.socials.youtube,
    label: "YouTube",
    icon: "fa-brands fa-youtube",
    external: true,
  },
];

const kidsSlides = [
  { src: "/what-kids15.jpg", alt: "Children at The Life Place" },
  { src: "/what-kids.jpg", alt: "Children learning and worshipping at The Life Place" },
  { src: "/what-kids11.jpg", alt: "Kids participating in activities at The Life Place" },
  { src: "/what-kids4.jpg", alt: "Children welcomed at The Life Place" },
  { src: "/what-kids5.jpg", alt: "Kids participating in activities at The Life Place" },
  { src: "/what-kids6.jpg", alt: "Children learning and worshipping at The Life Place" },
  { src: "/what-kids12.jpg", alt: "Kids participating in activities at The Life Place" },
  { src: "/what-kids8.jpg", alt: "Kids participating in activities at The Life Place" },
  { src: "/what-kids14.jpg", alt: "Kids participating in activities at The Life Place" },
  { src: "/what-kids10.jpg", alt: "Kids participating in activities at The Life Place" },
  { src: "/what-kids13.jpg", alt: "Kids participating in activities at The Life Place" },
];

const sundayFlow = [
  {
    icon: "fa-solid fa-music",
    title: "Worship",
    body: "We sing, pray, and make room to see the presence and kindness of Jesus.",
  },
  {
    icon: "fa-solid fa-book-open",
    title: "Teaching",
    body: "The Bible is taught as one story of grace, always pointing us to Jesus.",
  },
  {
    icon: "fa-solid fa-cross",
    title: "Communion",
    body: "At the Lord's Supper we remember what Jesus has done for us.",
  },
  {
    icon: "fa-solid fa-people-group",
    title: "Community",
    body: "A diverse community that gathers to see Jesus.",
  },
  {
    icon: "fa-solid fa-hand-holding-heart",
    title: "Generosity",
    body: "We give generously as a response to what Jesus has done for us.",
  },
  {
    icon: "fa-solid fa-person-walking-arrow-right",
    title: "Sent out",
    body: "We are sent to live Jesus' story in our city, our nation, and the world.",
  },
];

const connectedItems = [
  {
    href: "/about-us/leadership",
    icon: "fa-solid fa-user-group",
    title: "Meet our leaders",
    body: "Get to know Schulter and Genevieve.",
    action: "Meet Our Leaders",
  },
  {
    href: "/what-we-believe/",
    icon: "fa-solid fa-book-bible",
    title: "What we believe",
    body: "See how everything at The Life Place revolves around the person and finished work of Jesus.",
    action: "Read Our Beliefs",
  },
  {
    href: "/prayer",
    icon: "fa-solid fa-hands-praying",
    title: "Need prayer?",
    body: "Jesus prays for you. We would be honoured to pray with you.",
    action: "Request Prayer",
  },
  {
    href: "/give",
    icon: "fa-solid fa-hand-holding-heart",
    title: "Give",
    body: "Support our mission to reach our city, nation, and the world with the gospel of grace.",
    action: "Give Now",
  },
  {
    href: "/live",
    icon: "fa-solid fa-laptop",
    title: "Watch online",
    body: "Join the livestream.",
    action: "Watch Live",
  },
];

const faqItems = [
  {
    question: "What time should I arrive?",
    answer: "Arriving 10-15 minutes early gives you time to settle in and find seating before service begins.",
  },
  {
    question: "What should I wear?",
    answer: "Wear what you are comfortable in: casual, smart, or in-between. Come as you are.",
  },
  {
    question: "What about my children?",
    answer: "Children are welcome to remain with their parents during the service. A dedicated kids space will launch soon.",
  },
  {
    question: "How long is the service?",
    answer: "Our gatherings run for about 90 minutes, including worship, teaching, and ministry moments.",
  },
  {
    question: "Will I be singled out as a first-time guest?",
    answer: "No. You will not be asked to stand, wave, or introduce yourself. We are honoured to welcome you without pressure.",
  },
  {
    question: "Do I need to register?",
    answer: "No registration is needed for Sunday service. If a special event requires registration, we will make that clear.",
  },
];
---
<BaseLayout title="The Life Place">

<section class="relative overflow-hidden bg-white">
  <div class="absolute inset-y-0 right-0 hidden w-[46vw] lg:block">
    <img
      src="/sandton-skyline-grayscale.jpg"
      alt="Sandton skyline near The Life Place"
      class="h-full w-full rounded-none object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/55 to-black/10"></div>
  </div>

  <div class="relative mx-auto grid min-h-[calc(100svh-5rem)] max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 md:py-16 lg:grid-cols-[minmax(0,0.92fr)_minmax(22rem,0.48fr)] lg:px-8 lg:py-20">
    <div class="max-w-4xl">
      <p class="mb-5 text-sm font-bold uppercase tracking-[0.16em] text-brand-red md:text-base">
        Sundays in Craigavon AH, Sandton
      </p>
      <h1 class="text-5xl font-black leading-[0.96] text-gray-900 sm:text-6xl md:text-7xl lg:text-8xl">
        Come. See. <span class="text-brand-red">Jesus.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg font-medium leading-relaxed text-gray-700 md:text-2xl">
        Join us this Sunday.
      </p>

      <div class="mt-8 grid gap-3 rounded-2xl border border-gray-200 bg-gray-50 p-4 shadow-sm sm:max-w-2xl sm:grid-cols-2 md:p-5">
        <div class="flex items-start gap-3">
          <i class="fa-regular fa-clock mt-1 text-xl text-brand-red" aria-hidden="true"></i>
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-gray-500">This Sunday</p>
            <p class="mt-1 text-xl font-black text-gray-900">9:00-11:00 AM</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <i class="fa-solid fa-location-dot mt-1 text-xl text-brand-red" aria-hidden="true"></i>
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-gray-500">Location</p>
            <p class="mt-1 text-xl font-black text-gray-900">The Life Place</p>
            <p class="mt-1 text-sm leading-relaxed text-gray-600">{visitLocation.addressLines[0]}, {visitLocation.addressLines[1]}</p>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="/visit" class="inline-flex min-h-12 items-center justify-center rounded-2xl bg-brand-red px-7 py-4 text-base font-black text-white shadow-md transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-[#9F2429] hover:shadow-lg active:scale-[0.98]">
          Plan A Visit
        </a>
        <a href={visitLocation.mapsQueryUrl} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center justify-center rounded-2xl border-2 border-brand-red/40 bg-white px-7 py-4 text-base font-black text-gray-900 shadow-sm transition-[border-color,background-color,transform] duration-200 ease-out hover:border-brand-red/70 hover:bg-gray-50 active:scale-[0.98]">
          Get Directions
        </a>
        <a href="/live/" class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-gray-300 bg-white px-7 py-4 text-base font-black text-gray-800 transition-[border-color,background-color,transform] duration-200 ease-out hover:border-gray-500 hover:bg-gray-50 active:scale-[0.98]">
          Watch Live
        </a>
      </div>
    </div>

    <div class="rounded-3xl border border-gray-200 bg-white p-5 shadow-xl lg:bg-white/90 lg:backdrop-blur">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">First time?</p>
      <h2 class="mt-3 text-3xl font-black leading-tight text-gray-900">Welcome.</h2>
      <p class="mt-4 text-base leading-relaxed text-gray-600">
        We want your first experience with us to be a warm welcome into the presence of Jesus.
      </p>
      <div class="mt-6 space-y-3 text-sm font-semibold text-gray-700">
        <p class="flex gap-3"><i class="fa-solid fa-check mt-1 text-brand-red" aria-hidden="true"></i><span>Arrive 10-15 minutes early if you can.</span></p>
        <p class="flex gap-3"><i class="fa-solid fa-check mt-1 text-brand-red" aria-hidden="true"></i><span>Wear what you are comfortable in.</span></p>
        <p class="flex gap-3"><i class="fa-solid fa-check mt-1 text-brand-red" aria-hidden="true"></i><span>Children are welcome in the service.</span></p>
      </div>
    </div>
  </div>
</section>

<section class="relative isolate overflow-hidden bg-white py-20 md:py-28 lg:py-36">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-red/30 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-brand-red/20 to-transparent"></div>

  <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand-red md:text-base">Our welcome</p>
    <h2 class="mx-auto mt-6 max-w-5xl text-4xl font-black leading-[1.12] text-gray-900 md:text-6xl md:leading-[1.1] lg:text-7xl">
      We open wide our doors with a welcome from <span class="text-brand-red">Jesus:</span>
    </h2>
    <p class="mx-auto mt-10 max-w-5xl text-3xl font-black leading-[1.22] text-gray-900 md:mt-12 md:text-5xl md:leading-[1.18] lg:text-6xl">
      the <span class="text-brand-red">Embracer</span> of the outsider,
      the <span class="text-brand-red">Defender</span> of the guilty,
      the <span class="text-brand-red">Justifier</span> of the ungodly,
      the <span class="text-brand-red">Friend</span> of sinners.
    </p>
  </div>
</section>

<section class="bg-gray-50 py-14 md:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">What to expect</p>
        <h2 class="mt-4 text-4xl font-black leading-tight text-gray-900 md:text-6xl">
          What happens on Sunday.
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-gray-600">
          Every time we meet, we see how true, good, beautiful and kind Jesus is.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {sundayFlow.map((item) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-[border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:bg-gray-50 hover:shadow-md active:scale-[0.99] md:p-7">
            <div class="flex items-start gap-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[#FDECEC] text-brand-red">
                <i class={item.icon} aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="text-2xl font-black text-gray-900">{item.title}</h3>
                <p class="mt-3 text-base leading-relaxed text-gray-600">{item.body}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="bg-white py-14 md:py-20 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-[0.7fr_1.3fr] md:items-start">
      <div class="border-t border-gray-200 pt-6 lg:sticky lg:top-28">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Next steps</p>
        <h2 class="mt-4 text-4xl font-black leading-tight text-gray-900 md:text-5xl">
          Start here.
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-gray-600">
          Whether you are visiting, watching online, needing prayer, or ready to give, start here.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {connectedItems.map((item) => (
          <a href={item.href} class="group flex min-h-[15rem] flex-col justify-between rounded-3xl border border-gray-200 bg-gray-50 p-6 transition-[border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/30 hover:bg-white hover:shadow-md active:scale-[0.99] md:p-7">
            <div>
              <div class="mb-5 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-brand-red shadow-sm ring-1 ring-gray-200">
                <i class={item.icon} aria-hidden="true"></i>
              </div>
              <h3 class="text-2xl font-black text-gray-900">{item.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-gray-600">{item.body}</p>
            </div>
            <span class="mt-6 inline-flex items-center text-sm font-black uppercase tracking-[0.14em] text-brand-red">
              {item.action}<span class="ml-2 transition-transform duration-150 ease-out group-hover:translate-x-1">-&gt;</span>
            </span>
          </a>
        ))}
        <article class="flex min-h-[15rem] flex-col justify-between rounded-3xl border border-gray-200 bg-gray-50 p-6 transition-[border-color,background-color,box-shadow] duration-200 ease-out hover:border-brand-red/30 hover:bg-white hover:shadow-md md:p-7">
          <div>
            <div class="mb-5 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-brand-red shadow-sm ring-1 ring-gray-200">
              <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
            </div>
            <h3 class="text-2xl font-black text-gray-900">Share your story</h3>
            <p class="mt-3 text-base leading-relaxed text-gray-600">
              We'd love to hear how seeing Jesus has transformed your life and changed your story.
            </p>
          </div>
          <div class="mt-6">
            <p class="mb-3 text-center text-sm font-semibold leading-relaxed text-gray-600">
              Email, WhatsApp, or share through our social media channels.
            </p>
            <div class="flex items-center justify-center gap-2">
              {storyChannels.map((channel) => (
                <a href={channel.href} target={channel.external ? "_blank" : undefined} rel={channel.external ? "noopener" : undefined} aria-label={channel.label} class="flex h-11 w-11 items-center justify-center rounded-full bg-gray-900 text-white transition hover:bg-brand-red focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2">
                  <i class={channel.icon} aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="bg-white py-14 md:py-20 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Kids</p>
        <h2 class="mt-4 text-4xl font-black leading-tight text-gray-900 md:text-5xl">
          Kids are welcome with us.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-gray-600">
          We do not have a kids' church yet. As Jesus provides, we are preparing a space where our kids will experience His truth, goodness, beauty, and kindness.
        </p>
        <div class="mt-6 rounded-2xl border border-brand-red/20 bg-[#FDECEC] p-5">
          <p class="text-xl font-black text-gray-900">For now, children remain with their parents during service.</p>
          <p class="mt-2 text-base leading-relaxed text-gray-700">You are still welcome. Bring them with you.</p>
        </div>
      </div>

      <div class="relative overflow-hidden rounded-3xl border border-gray-200 bg-gray-100 shadow-xl">
        <div id="kidsSlidesHome" class="flex aspect-[4/3] w-full transition-transform duration-700 ease-out">
          {kidsSlides.map((slide) => (
            <img src={slide.src} alt={slide.alt} class="kids-slide-img rounded-none" />
          ))}
        </div>
        <div class="absolute inset-x-4 bottom-4 flex items-center justify-center gap-1.5 rounded-full bg-white/85 px-3 py-2 shadow-lg ring-1 ring-black/5 backdrop-blur">
          {kidsSlides.map((_, index) => (
            <button class:list={["kids-slide-indicator", { "is-active": index === 0 }]} type="button" data-slide={index} aria-label={`Show kids image ${index + 1}`} aria-current={index === 0 ? "true" : "false"}></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-gray-50 py-14 md:py-20 lg:py-24" data-faq-accordion>
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <div class="mb-8 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">First-time guest FAQs</p>
      <h2 class="mt-4 text-4xl font-black leading-tight text-gray-900 md:text-5xl">A few things people ask.</h2>
    </div>

    <div class="space-y-4">
      {faqItems.map((item, index) => (
        <article class="faq-item rounded-2xl border border-gray-200 bg-white p-4 shadow-sm md:p-6">
          <button
            id={`faq-trigger-${index}`}
            class="faq-summary flex min-h-12 w-full cursor-pointer items-center justify-between gap-4 text-left text-base font-bold text-gray-900 transition-transform duration-150 ease-out active:scale-[0.995] md:text-xl"
            type="button"
            aria-expanded="false"
            aria-controls={`faq-panel-${index}`}
          >
            <span>{item.question}</span>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-transform duration-200 ease-out">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </span>
          </button>
          <div id={`faq-panel-${index}`} class="faq-content max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out" role="region" aria-labelledby={`faq-trigger-${index}`}>
            <p class="mt-4 text-base leading-relaxed text-gray-600 md:text-lg">{item.answer}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-white py-14 md:py-20 lg:py-24">
  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">This Sunday</p>
    <h2 class="mt-4 text-4xl font-black leading-tight text-gray-900 md:text-6xl">
      Come. See. <span class="text-brand-red">Jesus</span>.
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-gray-600 md:text-xl">
      Join us from 9:00-11:00 AM.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
      <a href="/visit" class="inline-flex min-h-12 items-center justify-center rounded-2xl bg-brand-red px-7 py-4 text-base font-black text-white shadow-md transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-[#9F2429] hover:shadow-lg active:scale-[0.98]">
        Plan A Visit
      </a>
      <a href={visitLocation.mapsQueryUrl} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center justify-center rounded-2xl border-2 border-brand-red/40 bg-white px-7 py-4 text-base font-black text-gray-900 shadow-sm transition-[border-color,background-color,transform] duration-200 ease-out hover:border-brand-red/70 hover:bg-gray-50 active:scale-[0.98]">
        Get Directions
      </a>
    </div>
  </div>
</section>

<style>
  .kids-slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    flex-shrink: 0;
    background: #f3f4f6;
  }

  .kids-slide-indicator {
    width: clamp(1.25rem, 6vw, 2.75rem);
    height: 0.375rem;
    border-radius: 9999px;
    background: #d1d5db;
    transition: background-color 180ms ease-out, transform 180ms ease-out, width 180ms ease-out;
  }

  .kids-slide-indicator.is-active {
    width: clamp(2rem, 10vw, 4rem);
    background: #B3282D;
  }

  .kids-slide-indicator:hover {
    background: #9ca3af;
  }

  .kids-slide-indicator.is-active:hover {
    background: #B3282D;
  }
</style>

<script is:inline>
const initHomePageInteractions = () => {
  const slidesEl = document.getElementById('kidsSlidesHome');
  const slideIndicators = Array.from(document.querySelectorAll('.kids-slide-indicator'));

  if (slidesEl && slidesEl.dataset.carouselReady !== 'true') {
    slidesEl.dataset.carouselReady = 'true';
    const totalSlides = slidesEl.querySelectorAll('img').length;
    let index = 0;

    const updateIndicators = () => {
      slideIndicators.forEach((indicator, i) => {
        const isActive = i === index;
        indicator.classList.toggle('is-active', isActive);
        indicator.setAttribute('aria-current', String(isActive));
      });
    };

    const updateSlide = () => {
      slidesEl.style.transform = `translateX(-${index * 100}%)`;
      updateIndicators();
    };

    slideIndicators.forEach((indicator, i) => {
      indicator.addEventListener('click', () => {
        index = i;
        updateSlide();
      });
    });

    updateSlide();
    if (totalSlides > 1) {
      slidesEl.dataset.autoplay = 'true';
      window.setInterval(() => {
        index = (index + 1) % totalSlides;
        updateSlide();
      }, 3200);
    }
  }

  const faqItems = Array.from(document.querySelectorAll('.faq-item'));
  faqItems.forEach((item) => {
    if (item.dataset.faqReady === 'true') return;
    item.dataset.faqReady = 'true';

    const summary = item.querySelector('.faq-summary');
    const content = item.querySelector('.faq-content');
    const iconWrap = summary?.querySelector('span:last-child');
    if (!summary || !content) return;

    summary.addEventListener('click', () => {
      const isOpen = summary.getAttribute('aria-expanded') === 'true';

      faqItems.forEach((other) => {
        const otherSummary = other.querySelector('.faq-summary');
        const otherContent = other.querySelector('.faq-content');
        const otherIcon = otherSummary?.querySelector('span:last-child');
        if (otherSummary) otherSummary.setAttribute('aria-expanded', 'false');
        if (otherContent) otherContent.style.maxHeight = '0px';
        if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
        other.classList.remove('open');
      });

      if (!isOpen) {
        summary.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = `${content.scrollHeight}px`;
        if (iconWrap) iconWrap.style.transform = 'rotate(180deg)';
        item.classList.add('open');
      }
    });
  });
};

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initHomePageInteractions, { once: true });
} else {
  initHomePageInteractions();
}
</script>

</BaseLayout>
