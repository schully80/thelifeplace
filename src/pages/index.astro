<!-- Auto-trigger modal on home page (scroll-based) -->
<script is:inline>
  let blogModalShown = false;
  
  window.addEventListener("scroll", () => {
    if (blogModalShown) return;
    
    // Calculate scroll percentage
    const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = (window.scrollY / scrollHeight) * 100;
    
    // Trigger modal at 55% scroll (slightly later for better UX)
    if (scrollPercent >= 55) {
      if (typeof openBlogSignupModal === "function") {
        openBlogSignupModal();
        blogModalShown = true;
      }
    }
  });
</script>


