<BlogSignupModal />

<!-- Auto-trigger modal on home page (scroll-based) -->
<script is:inline>
  let blogModalShown = false;
  
  window.addEventListener("scroll", () => {
    if (blogModalShown) return;
    
    // Calculate scroll percentage
    const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = (window.scrollY / scrollHeight) * 100;
    
    // Trigger modal at 55% scroll (slightly later for better UX)
    if (scrollPercent >= 55) {
      if (typeof openBlogSignupModal === "function") {
        openBlogSignupModal();
        blogModalShown = true;
      }
    }
  });

  // Smooth, gentle scroll animation
  function gentleScrollToTop() {
    const duration = 1200; // milliseconds
    const startY = window.scrollY;
    const startTime = Date.now();
    
    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }
    
    function scroll() {
      const elapsed = Date.now() - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const ease = easeInOutCubic(progress);
      
      window.scrollY = startY - startY * ease;
      window.scrollTo(0, startY - startY * ease);
      
      if (progress < 1) {
        requestAnimationFrame(scroll);
      }
    }
    
    requestAnimationFrame(scroll);
  }
  
  // Open ministries menu from Stay Connected section (and shared behaviours)
  function openMinistries() {
    const width = window.innerWidth;

    // MOBILE: open drawer and expand Ministries accordion
    if (width < 768) {
      const mobileBtn = document.getElementById('mobileMenuButton');
      if (mobileBtn) {
        mobileBtn.click();

        setTimeout(() => {
          const mobileDrawer = document.getElementById('mobileNavDrawer');
          if (!mobileDrawer) return;

          const accPanel = mobileDrawer.querySelector('#acc-ministries');
          if (!accPanel) return;

          const acc = accPanel.closest('[data-accordion]');
          if (!acc) return;

          const trigger = acc.querySelector('[data-accordion-trigger]');
          const panel = acc.querySelector('[data-accordion-panel]');
          if (!trigger || !panel) return;

          trigger.setAttribute('aria-expanded', 'true');
          const icon = trigger.querySelector('svg');
          if (icon) icon.style.transform = 'rotate(180deg)';
          panel.style.gridTemplateRows = '1fr';
        }, 300);
      }
      return;
    }

    // TABLET PORTRAIT: open tablet drawer and expand Ministries accordion
    if (width < 1280) {
      const tabletBtn = document.getElementById('tabletMenuButton');
      if (tabletBtn) {
        tabletBtn.click();

        setTimeout(() => {
          const tabletDrawer = document.getElementById('tabletNavDrawer');
          if (!tabletDrawer) return;

          const accPanel = tabletDrawer.querySelector('#acc-ministries-tablet');
          if (!accPanel) return;

          const trigger = tabletDrawer.querySelector('[data-accordion-trigger][aria-controls="acc-ministries-tablet"]');
          const panel = accPanel;
          if (!trigger || !panel) return;

          trigger.setAttribute('aria-expanded', 'true');
          const icon = trigger.querySelector('svg');
          if (icon) icon.style.transform = 'rotate(180deg)';
          panel.style.gridTemplateRows = '1fr';
        }, 300);
      }
      return;
    }

    // DESKTOP (xl+): open and keep the Ministries dropdown open in the header nav
    // We look for the dropdown whose trigger text includes "Ministries".
    const dropdowns = document.querySelectorAll('header [data-dropdown]');
    let ministriesDropdown = null;

    dropdowns.forEach((wrap) => {
      const trigger = wrap.querySelector('[data-trigger]');
      if (trigger && trigger.textContent && trigger.textContent.trim().includes('Ministries')) {
        ministriesDropdown = wrap;
      }
    });

    if (ministriesDropdown) {
      const menu = ministriesDropdown.querySelector('[data-menu]');
      const trigger = ministriesDropdown.querySelector('[data-trigger]');

      if (menu && trigger) {
        // Scroll to top with gentle, smooth animation
        gentleScrollToTop();

        // Trigger mouseenter to activate the Header's open handler
        trigger.dispatchEvent(new MouseEvent('mouseenter', { bubbles: true }));
        menu.dispatchEvent(new MouseEvent('mouseenter', { bubbles: true }));

        // Keep the menu open by continuously removing the hidden class
        const keepOpen = setInterval(() => {
          if (menu.classList.contains('hidden')) {
            menu.classList.remove('hidden');
            trigger.setAttribute('aria-expanded', 'true');
          }
        }, 50);

        // Stop keeping it open when user moves mouse to the menu
        menu.addEventListener(
          'mouseenter',
          () => {
            clearInterval(keepOpen);
          },
          { once: true }
        );
      }
    }
  }
  
  window.openMinistries = openMinistries;
</script>


