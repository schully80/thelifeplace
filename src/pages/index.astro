<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  /* Kids carousel (homepage) */
  const slidesEl = document.getElementById('kidsSlidesHome');
  const dotIndicators = document.querySelectorAll('.kids-dot-indicator');
  if (slidesEl && dotIndicators.length) {
    const totalSlides = slidesEl.querySelectorAll('img').length;
    let index = 0;
    function updateDots() { dotIndicators.forEach((dot, i) => { dot.classList.toggle('bg-brand-red', i === index % totalSlides); dot.classList.toggle('bg-gray-300', i !== index % totalSlides); }); }
    function updateSlide() { slidesEl.style.transform = `translateX(-${index * 100}%)`; updateDots(); }
    function nextSlide() { index = (index + 1) % totalSlides; updateSlide(); }
    dotIndicators.forEach((dot, i) => dot.addEventListener('click', () => { index = i; updateSlide(); }));
    updateSlide(); setInterval(nextSlide, 3200);
  }

  /* FAQ accordion */
  const items = document.querySelectorAll('.faq-item');
  items.forEach((item) => {
    const summary = item.querySelector('.faq-summary');
    const content = item.querySelector('.faq-content');
    const icon = summary && summary.querySelector('svg');
    summary?.addEventListener('click', () => {
      const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
      items.forEach((other) => { const otherContent = other.querySelector('.faq-content'); const otherIcon = other.querySelector('svg'); if (otherContent) otherContent.style.maxHeight = null; if (otherIcon) otherIcon.style.transform = 'rotate(0deg)'; other.classList.remove('open'); });
      if (!isOpen) { content.style.maxHeight = content.scrollHeight + 'px'; if (icon) icon.style.transform = 'rotate(180deg)'; item.classList.add('open'); }
    });
  });
});
</script>

<script is:inline>
  // Newsletter form: open Substack in new tab after native validation
  (() => {
    const form = document.getElementById('newsletterForm');
    const emailInput = document.getElementById('newsletterEmail');
    if (!form || !emailInput) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const email = emailInput.value.trim();
      const url = `https://schulteretyang.substack.com/subscribe?email=${encodeURIComponent(email)}`;
      window.open(url, '_blank', 'noopener');
    });
  })();
</script>

