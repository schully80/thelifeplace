---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuickGive from "../../components/giving/QuickGive.astro";

---

<BaseLayout title="Generosity — The Life Place">

<!-- HERO / Giving -->
<section
  class="relative w-screen h-[70vh]
         overflow-hidden
         left-1/2 right-1/2 -mx-[50vw]"
>
  <div class="absolute inset-0 grid grid-cols-1 md:grid-cols-2">
    <img src="/giving-hero2.jpg" class="w-full h-full object-cover" />
    <img src="/giving-hero7.jpg" class="w-full h-full object-cover" />
  </div>

  <!-- Seam softener -->
  <div
    class="pointer-events-none absolute inset-y-0 left-1/2 w-24 -translate-x-1/2
           bg-gradient-to-r from-transparent via-black/70 to-transparent">
  </div>

  <div class="absolute inset-0 bg-black/40"></div>
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black/60 to-transparent"></div>
</section>


<!-- PAGE HEADER -->
<section class="bg-white">
  <div class="max-w-6xl mx-auto px-6 py-24 md:py-32 text-center">

    <h1
      class="text-5xl md:text-7xl font-extrabold tracking-tight text-gray-900"
    >
      Generosity
    </h1>

    <p
      class="mt-8 text-xl md:text-3xl
             text-gray-700 leading-relaxed
             max-w-4xl mx-auto"
    >
      Generosity is our expression of who Jesus is and what He does.
    </p>

  </div>
</section>

<!-- QUICK GIVE -->
<section class="bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-20 md:py-28
  ">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

    <!-- Guided Giving -->
    <div class="lg:col-span-8">
      <QuickGive
        subtitle="Below is a simple, guided way to give generously — step by step."
      />
    </div>

    <!-- TRUST -->
    <aside
      class="lg:col-span-4 rounded-[36px]
             bg-white p-10
             border border-brand-red
         shadow-sm hover:shadow-md
         transition transform hover:-translate-y-0.5"
             >


      <h3 class="text-2xl md:text-3xl text-center font-extrabold tracking-tight mb-8">
        Giving you can trust
      </h3>

      <ul class="space-y-6 text-gray-800 text-lg leading-relaxed">
        <li><strong>EFT</strong> — Direct bank transfer</li>
        <li><strong>SnapScan</strong> — Secure mobile giving</li>
        <li><strong>PayPal</strong> — International giving</li>
        <li><strong>In-person</strong> — Weekend gatherings</li>
      </ul>

      <p class="mt-10 text-base text-gray-500 leading-relaxed">
        All platforms listed are official giving channels of The Life Place.
      </p>
    </aside>

  </div>
</section>

<!-- METHODS -->
<section id="giving-methods" 

class="max-w-7xl mx-auto px-6 pb-36">

<div class="flex flex-col items-center justify-center text-center py-24">


<!-- WAYS TO GIVE — SECTION BREAK -->
<section class="max-w-6xl mx-auto px-6 py-20 md:py-20 text-center">
  <h2
    class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900"
  >
    Ways to Give
  </h2>

  <p class="mt-6 text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
    Choose the method that works best for you.
  </p>
</section>


 <!-- 👇 GRAY WRAPPER (cards only) -->
    <div class="bg-gray-50 mt-10 md:mt-14 px-8 py-14 md:px-12 md:py-20">


  <div class="mt-20 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10">

    <!-- EFT -->
    <div
      class="rounded-3xl bg-white
             border border-brand-red
         shadow-sm hover:shadow-md
         transition transform hover:-translate-y-0.5 p-10"
    >
      <h3 class="text-center text-4xl font-extrabold mb-6">EFT (Bank Transfer)</h3>

 <!-- ICON -->
  <div class="mt-6 flex justify-center">
    <img
      src="/reshot-icon-laptop-Y6XNMWGB8C.svg"
      alt="Laptop icon"
      class="h-10 w-10 md:h-12 md:w-12"
    />
  </div>

      <ul class="space-y-3 text-xl text-gray-700 py-8">
        <li><strong>Bank:</strong> Standard Bank</li>
        <li><strong>Account:</strong> The Life Place</li>
        <li><strong>Number:</strong> 301524351</li>
        <li><strong>Branch:</strong> 051001</li>
        <li><strong>SWIFT:</strong> SBZAZAJJ</li>
      </ul>

      <p class="mt-8 text-center text-lg text-gray-500">
        Reference: Tithe / Offering / Your name
      </p>
    </div>

    <!-- SNAPSCAN -->
    <div
      class="rounded-3xl bg-white
             border border-brand-red
         shadow-sm hover:shadow-md
         transition transform hover:-translate-y-0.5 p-10 text-center"
    >
      <h3 class="text-center text-4xl font-extrabold mb-4">SnapScan</h3>

<!-- ICON -->
  <div class="mt-6 flex justify-center">
    <img
      src="/reshot-icon-hand-holding-smartphone-4L7F8HCGWT.svg"
      alt="Hand holding smartphone icon"
      class="h-10 w-10 md:h-12 md:w-12"
    />
  </div>

      <p class="text-center text-xl text-gray-700 mb-8 py-8">
        Scan or click to give instantly.
      </p>

      <img
        src="/SnapCode_1 grayscale.png"
        alt="SnapScan QR"
        class="mx-auto w-48 h-48 md:w-48 md:h-48 object-contain"
      />

      <a
        href="https://pos.snapscan.io/qr/VISFNLkM"
        class="mt-8 inline-flex justify-center rounded-full px-8 py-4
               text-lg font-bold
               border border-brand-red
               text-brand-red
               hover:bg-brand-red hover:text-white transition"
      >
        Give via SnapScan
      </a>
    </div>

    <!-- PAYPAL -->
      <div
      class="rounded-3xl bg-white
             border border-brand-red
         shadow-sm hover:shadow-md
         transition transform hover:-translate-y-0.5 p-10 text-center"
    >
      <form
        action="https://www.paypal.com/donate"
        method="post"
        target="_top"
        class="flex flex-col items-center gap-6"
      >
        <input type="hidden" name="hosted_button_id" value="4L3NWWAZ9PPV6" />

      <h3 class="text-center text-4xl font-extrabold mb-4">PayPal</h3>

  <!-- PAYPAL ICON (restored, under header) -->
  <div class="mt-3 flex justify-center -translate-y-4">
    <img
      src="/paypal-blue.svg"
      alt="PayPal"
      class="h-10 w-10 md:h-12 md:w-12"
    />
  </div>


    <p class="mt-2 text-xl text-center text-gray-700 leading-relaxed">
  <span class="block font-semibold uppercase tracking-wide">
    International Giving
  </span>
  <span class="block mt-1 text-md text-gray-500">
    (Outside South Africa)
  </span>
</p>


        <button type="submit">
          <img
            src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif"
            class="rounded-2xl border p-4 bg-white shadow-md"
          />
        </button>

        <button
          type="submit"
          class="mt-2 rounded-full px-8 py-4
                 text-lg font-bold
                 border border-brand-red
                 text-brand-red
                 hover:bg-brand-red hover:text-white transition"
        >
          Give via PayPal
        </button>
      </form>
    </div>

  </div>

 <!-- GIVE IN PERSON — PASTORAL CARD -->
<div class="mt-20 max-w-5xl mx-auto rounded-[36px]
    bg-white border border-brand-red
  shadow-sm hover:shadow-md transition transform hover:-translate-y-0.5
  p-10 md:p-14
    text-center
    motion-safe:animate-[floatSlow_6s_ease-in-out_infinite]
  "
>

  <!-- Icon -->
  <div class="flex justify-center mb-6">
    <img
      src="/hand-holding-heart.png"
      alt="Give in person"
      class="h-12 w-12 md:h-14 md:w-14 opacity-90"
    />
  </div>

  <!-- Heading -->
  <h3 class="text-2xl md:text-3xl font-extrabold text-gray-900">
    Give in Person
  </h3>

  <!-- Copy -->
  <p class="mt-4 text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
    While we encourage online giving for security and simplicity,  
    we gladly receive in-person gifts during our weekend gatherings.
  </p>

  <!-- Soft reassurance -->
  <p class="mt-6 text-sm md:text-base text-gray-500">
    No pressure. No obligation. Simply an expression of worship.
  </p>
</div>


  <p
    class="mt-28 text-center text-2xl md:text-3xl
           leading-relaxed text-gray-700
           max-w-3xl mx-auto"
  >
    Whether once-off or recurring, your generosity helps us create more space
    and resources so others can
    <span class="font-semibold">
    Come. See. <span class="text-brand-red">Jesus</span>
  </span>
</p>

</section>

 <!-- Annual Report (featured card) -->
<section class="max-w-6xl mx-auto px-6 pb-32">
  <div
    class="relative overflow-hidden rounded-xl border bg-white ring-1 ring-brand-red shadow-sm
           p-6 sm:p-8 md:p-10"
    aria-labelledby="annual-report-title"
  >
    
    <div class="flex items-start gap-3 sm:gap-4">
      <!-- Icon -->
      <div class="hidden sm:flex h-12 w-12 items-center justify-center rounded-xl">
       
      </div>

      
      <div class="flex-1">
        <h2 id="annual-report-title"
            class="text-2xl md:text-4xl text-center font-bold tracking-tight text-gray-900">
          Annual Financial Report
        </h2>
     
      <p
        class="mt-5 text-lg md:text-xl text-center
               leading-relaxed text-gray-700"
      >
        We value transparency and faithful stewardship.
        This report is shared with those who call
        <span class="font-semibold">The Life Place</span> home,
        reflecting how generosity is handled with care —
        to glorify Jesus, meet real needs, and serve the mission of
        The Life Place.
      </p>

<p class="mt-4 text-center text-base md:text-lg text-gray-600 leading-relaxed">
  To receive this report, contact us at
  <a href="mailto:giving@thelifeplace.org" class="font-semibold text-brand-red hover:underline">
    giving@thelifeplace.org
  </a>
  or during office hours at
  <a href="tel:+27765639460" class="font-semibold text-brand-red hover:underline">
    +27&nbsp;76&nbsp;563&nbsp;9460
  </a>
</p>

  </div>
</section>


<!-- Giving FAQ -->
<section class="max-w-4xl mx-auto px-6 mt-32 mb-40 data-faq-accordion">
  <!-- Header -->
  <div class="text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-900">
      Giving FAQs
    </h2>
    <p class="mt-4 text-lg text-gray-600">
      Common questions about giving at The Life Place.
    </p>
  </div>

  <!-- FAQ Accordion -->
  <div class="space-y-4">

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-lg font-semibold text-gray-900">
        Is my donation secure?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-gray-600 leading-relaxed">
          Yes. All online giving platforms we use are secure and encrypted.
          We partner only with trusted payment providers and do not store your
          card or banking details on our systems.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-lg font-semibold text-gray-900">
        Will I receive a confirmation or receipt?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-gray-600 leading-relaxed">
          Yes. For online giving, you’ll receive a confirmation from the payment provider.
          If you require a formal receipt or confirmation, you’re welcome to contact us at
          <a href="mailto:giving@thelifeplace.org"
             class="font-semibold text-brand-red hover:underline">
            giving@thelifeplace.org
          </a>.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-lg font-semibold text-gray-900">
        Can I give anonymously?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-gray-600 leading-relaxed">
          Yes. You’re welcome to give anonymously.
          Our heart is not to track giving, but to steward it faithfully and responsibly.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-lg font-semibold text-gray-900">
        Can I give if I live outside South Africa?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-gray-600 leading-relaxed">
          Yes. If you live outside South Africa, you can give securely through PayPal.
          This option is best suited for international giving.
        </p>
        <p class="mt-3">
          <a
            href="https://www.paypal.com/donate?hosted_button_id=4L3NWWAZ9PPV6"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 font-semibold text-brand-red hover:underline"
          >
            Click here to give via PayPal →
          </a>
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-lg font-semibold text-gray-900">
        Is my giving tax-deductible?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-gray-600 leading-relaxed">
          Tax donation receipts are available where applicable.
          If you have questions about receipts or documentation, please contact us at
          <a href="mailto:giving@thelifeplace.org"
             class="font-semibold text-brand-red hover:underline">
            giving@thelifeplace.org
          </a>.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-lg font-semibold text-gray-900">
        How are donations used?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-gray-600 leading-relaxed">
          Gifts support the ministry, mission, and practical needs of The Life Place —
          including gatherings, pastoral care, community initiatives, and the ongoing
          work of the church.
        </p>
      </div>
    </div>

  </div>

  <!-- Soft footer reassurance -->
  <p class="mt-12 text-center text-base text-gray-500">
    Still have questions?
    <a href="mailto:giving@thelifeplace.org" class="font-semibold text-brand-red hover:underline">
      We’re happy to help.
    </a>
  </p>
</section>


<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll(".faq-item");

    items.forEach((item) => {
      const summary = item.querySelector(".faq-summary");
      const content = item.querySelector(".faq-content");
      const icon = summary.querySelector("svg");

      summary.addEventListener("click", () => {
        const isOpen = content.style.maxHeight && content.style.maxHeight !== "0px";

        // Close all
        items.forEach((other) => {
          const otherContent = other.querySelector(".faq-content");
          const otherIcon = other.querySelector("svg");
          if (otherContent) otherContent.style.maxHeight = null;
          if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
          other.classList.remove("open");
        });

        // Open clicked one
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + "px";
          if (icon) icon.style.transform = "rotate(180deg)";
          item.classList.add("open");
        }
      });
    });
  });
</script>



</BaseLayout>