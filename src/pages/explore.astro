---
import BaseLayout from "../layouts/BaseLayout.astro";

const sections = [
  {
    title: "Visit",
    description: "Everything you need for a relaxed first Sunday.",
    links: [
      { label: "Plan a visit", href: "/visit/" },
      { label: "Events", href: "/events" },
    ],
  },
  {
    title: "About",
    description: "Get to know our church, our pastors, and what we believe.",
    links: [
      { label: "Our story", href: "/about-us" },
      { label: "Meet our pastors", href: "/about-us/leadership" },
      { label: "What we believe", href: "/what-we-believe" },
    ],
  },
  {
    title: "Watch and read",
    description: "Join us live or spend time with teaching and encouragement during the week.",
    links: [
      { label: "Watch live", href: "/live/" },
      { label: "Devotionals", href: "/devotionals" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    title: "Next steps",
    description: "Practical ways to take part in the life of our church.",
    links: [
      { label: "Request prayer", href: "/prayer" },
      { label: "Give", href: "/give/" },
      { label: "Current ministries", href: "/ministries" },
    ],
  },
  {
    title: "Current ministries",
    description: "Opportunities that are active and ready to explore.",
    links: [
      { label: "New @ The Life Place", href: "/ministries/new-members" },
      { label: "Bring Them to Jesus", href: "/ministries/bring-them-to-jesus" },
      { label: "ThisGen", href: "/ministries/gen" },
      { label: "Relief Center", href: "/ministries/relief-center" },
    ],
  },
  {
    title: "Information",
    description: "The details behind how this website works.",
    links: [
      { label: "Privacy policy", href: "/privacy-policy" },
      { label: "Cookie policy", href: "/cookies" },
      { label: "Terms and conditions", href: "/terms" },
    ],
  },
];
---

<BaseLayout
  title="Explore The Life Place | Church in Sandton, Johannesburg"
  description="Explore The Life Place: plan a visit, watch live, request prayer, give, and find current ministries, beliefs, leadership, events, and helpful resources."
>
  <main class="bg-white text-gray-800">
    <section class="border-b border-gray-200 bg-gray-50 px-6 pb-16 pt-24 md:pb-24 md:pt-32">
      <div class="mx-auto max-w-7xl">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-red">Explore</p>
        <div class="mt-5 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.55fr)] lg:items-end">
          <h1 class="max-w-4xl text-5xl font-black leading-[1.02] tracking-tight text-gray-900 sm:text-6xl md:text-7xl">
            Find your way around The Life Place.
          </h1>
          <p class="max-w-xl text-lg font-medium leading-8 text-gray-600 md:text-xl">
            Whether you are planning your first visit or looking for a next step, begin here.
          </p>
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid border-t border-gray-200 md:grid-cols-2">
          {sections.map((section) => (
            <section class="border-b border-gray-200 py-9 md:py-12 odd:md:pr-12 even:md:border-l even:md:pl-12">
              <h2 class="text-2xl font-black tracking-tight text-gray-900 md:text-3xl">{section.title}</h2>
              <p class="mt-3 max-w-md leading-7 text-gray-600">{section.description}</p>
              <ul class="mt-6 space-y-3" aria-label={`${section.title} links`}>
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group inline-flex items-center gap-3 font-bold text-gray-800 transition-colors hover:text-brand-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-4"
                    >
                      <span>{link.label}</span>
                      <span class="text-brand-red transition-transform duration-200 ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-brand-red px-6 py-14 text-white md:py-20">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 md:flex-row md:items-end">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-white/75">This Sunday</p>
          <h2 class="mt-4 text-4xl font-black leading-tight md:text-5xl">Come. See. Jesus.</h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-white/90">Join us in Craigavon, Sandton, every Sunday from 9:00 to 11:00.</p>
        </div>
        <a href="/visit/" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-6 py-3 font-bold text-gray-900 transition-[background-color,color,transform] duration-200 ease-out hover:bg-gray-100 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand-red">
          Plan a visit
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
