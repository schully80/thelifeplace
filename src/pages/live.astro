---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/toast.css"; // 🍎 Imports premium red toast

// SERVICE TIME FOR COUNTDOWN
const serviceDay = 0; // Sunday (0 = Sunday)
const serviceHour = 10; // 10:00 AM SAST
const serviceMinute = 0;
---

<BaseLayout title="Live">
  
  <!-- Hero -->
  <section class="bg-gradient-to-b from-gray-50 to-white py-10 md:py-16 text-center">
    <h1 class="text-3xl md:text-5xl font-bold text-gray-900">Join Us Live</h1>
    <p class="mt-3 text-gray-600 text-lg">Sundays • 10:00 AM (SAST)</p>
    <div id="countdown" class="mt-6 text-2xl font-semibold text-brand-red"></div>
  </section>

  <!-- Cinematic Live Player -->
  <section class="max-w-7xl mx-auto px-4 pb-16 relative">

    <div class="absolute inset-0 -z-10 blur-3xl opacity-30 bg-brand-red/30 animate-pulse rounded-full"></div>

    <div class="rounded-3xl overflow-hidden shadow-2xl bg-black relative">
      
      <!-- Live Status Badge -->
      <div class="absolute top-6 left-6 z-20">
        <span id="liveStatusBadge"
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-gray-500 text-white">
          ● Checking…
        </span>
      </div>

      <!-- Player -->
      <div class="aspect-video w-full">
        <iframe
          id="liveFrame"
          src="https://www.youtube.com/embed/live_stream?channel=YOUR_CHANNEL_ID"
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <!-- SHARE BUTTON (Apple Standard) -->
    <div class="mt-8 flex justify-center">
      <button
        id="tlpShareBtn"
        class="group relative px-6 py-3 rounded-full bg-brand-red text-white font-semibold
               shadow-sm hover:bg-brand-red/90 hover:shadow-lg active:scale-[0.97]
               transition-all duration-300 flex items-center gap-2"
      >
        <svg 
          class="w-5 h-5 transition-transform duration-300 group-hover:-translate-y-0.5"
          fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="M8.59 13.51l6.83 3.98" />
          <path d="M15.41 6.51L8.59 10.49" />
        </svg>
        <span>Share</span>
      </button>
    </div>

  </section>

  <!-- OUR MISSION -->
<section class="max-w-5xl mx-auto px-6 py-24 pt-24 pb-32 text-center">

  <p class="max-w-4xl mx-auto text-3xl sm:text-6xl font-semibold leading-snug text-gray-900">
    Every time we meet, we see how true, good, beautiful and kind
    <span
      class="relative inline-block px-3 py-0 rounded-[9px] bg-brand-red text-white font-bold border-4 border-white shadow-lg tracking-wide rotate-[-2deg]"
    >
      Jesus
      <span class="absolute top-1 left-1 w-2 h-2 rounded-full border border-gray-700 shadow bg-gray-300"></span>
      <span class="absolute top-1 right-1 w-2 h-2 rounded-full border border-gray-700 shadow bg-gray-300"></span>
    </span>
    is
  </p>
</section>


  <!-- GRID -->
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 place-items-center">

   <!-- INLINE GLASS APP DOWNLOAD CARD -->
<div
  id="download-app"
  class="mx-auto mt-16 max-w-md backdrop-blur-xl bg-white/20 border border-white/30
         cine-zoom-apple-hover shadow-2xl rounded-3xl p-8 text-center ring-1 ring-black/5 animate-floatSlow"
>

  <img 
    src="/expo-qr.png"
    alt="Download App QR"
    class="w-36 h-36 mx-auto mb-4 rounded-lg shadow-md"
  />

  <h3 class="text-2xl font-semibold text-gray-900 mb-2">
    Download Our App
  </h3>

  <!-- ⚠️ DISABLED APP STORE AND GOOGLE PLAY BADGES -->
  <div class="flex justify-center items-center gap-4 mb-4 opacity-90 cursor-not-allowed select-none">
    <img 
      src="/app-store-badge.svg"
      alt="Download on the App Store"
      class="h-12 w-auto"
    />

<img 
    src="/google-play-badge.jpg"
    alt="Get it on Google Play"
    class="h-16 w-auto"
  />

  </div>

  <p class="text-md text-gray-600 italic">
    Download coming soon
  </p>

</div>

      <!-- GIVE -->
      <div
        class="cine-zoom-apple-hover relative rounded-3xl p-10
               backdrop-blur-xl bg-white/10 border border-white/20
               shadow-[0_8px_40px_rgba(0,0,0,0.25)] text-center overflow-hidden"
      >
        <img 
  src="/hand-holding-heart.png" 
  alt="Give Icon"
  class="w-16 h-16 mx-auto mb-5 opacity-90"
/>


        <h3 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-3">
          Partner With Us
        </h3>
        <p class="text-gray-700 mb-6 text-lg">
          Your generosity moves the mission of <span class="word-jesus">Jesus</span> forward.
        </p>

        <a href="/give" class="inline-block mt-2 text-brand-red font-semibold hover:underline">
          Give Online →
        </a>
      </div>

      <!-- PLAN A VISIT -->
      <div
        class="cine-zoom-apple-hover relative rounded-3xl p-10
               backdrop-blur-xl bg-white/10 border border-white/20
               shadow-[0_8px_40px_rgba(0,0,0,0.25)] text-center overflow-hidden sm:col-span-2 lg:col-span-1"
      >
           <img 
  src="/home.svg" 
  alt="Give Icon"
  class="w-16 h-16 mx-auto mb-5 opacity-90"
/>


        <h3 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-3">
          Plan a Visit
        </h3>
        <p class="text-gray-700 mb-6 text-lg">
          We would love to welcome you this Sunday.
        </p>

        <a href="/visit" class="inline-block mt-2 text-brand-red font-semibold hover:underline">
          Plan Your Visit →
        </a>
      </div>

    </div>
    <!-- END GRID -->

  </section>
</div>
<!-- END NEXT STEPS -->

  <!-- Scripts -->
  <script>
    /* ---------------------------
       SHARE BUTTON
    ----------------------------*/
    const shareBtn = document.getElementById("tlpShareBtn");

    shareBtn.addEventListener("click", async () => {
      const shareData = {
        title: document.title,
        text: "Join us live at The Life Place!",
        url: window.location.href
      };

      // Native share
      if (navigator.share) {
        try {
          await navigator.share(shareData);
          return;
        } catch (e) {
          console.warn("Share cancelled:", e);
        }
      }

      // Fallback
      try {
        await navigator.clipboard.writeText(window.location.href);
        tlpCopiedToast();
      } catch {
        alert("Link copied!");
      }
    });

    function tlpCopiedToast() {
      const t = document.createElement("div");
      t.textContent = "Link copied!";
      t.className =
        "tlp-toast-red fixed bottom-6 right-6 px-4 py-2 text-white text-sm font-medium " +
        "rounded-full shadow-xl backdrop-blur-xl animate-toastSlide z-[99999]";
      document.body.appendChild(t);
      setTimeout(() => t.classList.add("toast-hide"), 1600);
      setTimeout(() => t.remove(), 2200);
    }

    /* ---------------------------
       COUNTDOWN TIMER
    ----------------------------*/
    function updateCountdown() {
      const now = new Date();
      const nextService = new Date();
      nextService.setDate(now.getDate() + ((serviceDay + 7 - now.getDay()) % 7));
      nextService.setHours(serviceHour, serviceMinute, 0, 0);

      const diff = nextService - now;

      if (diff <= 0) {
        document.getElementById("countdown").textContent = "We are live now!";
        return;
      }

      const hours = Math.floor(diff / 1000 / 60 / 60);
      const minutes = Math.floor((diff / 1000 / 60) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      document.getElementById("countdown").textContent =
        `${hours}h ${minutes}m ${seconds}s until next service`;
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();


    /* ---------------------------
       LIVE STATUS (placeholder)
    ----------------------------*/
    async function checkLiveStatus() {
      const badge = document.getElementById("liveStatusBadge");

      // TODO: Replace with actual YouTube API
      const isLive = true; // temp
      if (isLive) {
        badge.textContent = "🔴 Live Now";
        badge.className =
          "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-red-600 text-white";
      } else {
        badge.textContent = "● Offline";
        badge.className =
          "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-gray-500 text-white";
      }
    }
    checkLiveStatus();
  </script>

  <!-- ANIMATIONS -->
<style>
  @keyframes fog {
    0% { transform: translateY(0); }
    100% { transform: translateY(20px); }
  }
  .animate-fog { animation: fog 10s ease-in-out infinite alternate; }

  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(25px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeUp { animation: fadeUp .8s ease-out both; }

  @keyframes iconRise {
    0% { transform: translateY(30px) scale(0.8); opacity: 0; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }
  .animate-iconRise { animation: iconRise .9s cubic-bezier(.25,.46,.45,.94) forwards; }

  .sheen::after {
    content:""; position:absolute; top:0; left:-150%; width:200%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,.55),transparent);
    animation:sheenMove 2.6s ease-in-out infinite;
  }
  @keyframes sheenMove {
    0% { left:-150%; }
    50% { left:100%; }
    100% { left:100%; }
  }

  .particle-layer {
    background-image: radial-gradient(circle, rgba(255,255,255,0.25) 1px, transparent 1px);
    background-size: 3px 3px;
  }

  .sparkle-layer {
    background-image:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,0.25), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255,255,255,0.18), transparent 50%);
    animation: sparkleMove 8s ease-in-out infinite alternate;
  }
  @keyframes sparkleMove {
    0% { transform: translateY(0); }
    100% { transform: translateY(10px); }
  }

  .gradient-underline {
    position:absolute; left:0; bottom:-4px;
    width:100%; height:3px; border-radius:999px;
    background:linear-gradient(90deg, transparent 0%, #B3282D 50%, transparent 100%);
    background-size:200% 100%;
    animation: gradientSlide 2.8s ease-in-out infinite;
  }
  @keyframes gradientSlide {
    0% { background-position:200% 0; }
    50% { background-position:0% 0; }
    100% { background-position:-200% 0; }
  }
</style>

</BaseLayout>
