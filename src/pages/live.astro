---
import BaseLayout from "../layouts/BaseLayout.astro";

const apiKey = import.meta.env.PUBLIC_YOUTUBE_API_KEY;
const channelId = import.meta.env.PUBLIC_YOUTUBE_CHANNEL_ID;

let live = null;

if (apiKey && channelId) {
  const qs = new URLSearchParams({
    part: "snippet",
    eventType: "live",
    type: "video",
    key: apiKey,
    channelId,
  });

  try {
    const res = await fetch(`https://www.googleapis.com/youtube/v3/search?${qs.toString()}`);
    const data = await res.json();
    live = data.items?.[0] || null;
  } catch {}
}
---

<BaseLayout title="Live">
  <section class="max-w-5xl mx-auto px-4 py-16 text-center">
    <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">Live</h1>

    {live ? (
      <>
        <!-- LIVE PLAYER -->
        <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-lg border">
          <iframe
            src={`https://www.youtube.com/embed/${live.id.videoId}`}
            class="w-full h-full"
            allowfullscreen
          ></iframe>
        </div>

        <h2 class="mt-6 text-2xl font-semibold text-gray-900">
          {live.snippet.title}
        </h2>
      </>
    ) : (
      <div class="max-w-md mx-auto p-6 border rounded-xl shadow-sm bg-white">
        <h2 class="text-xl font-semibold">We’re not live right now</h2>
        <p class="mt-3 text-gray-600">
          When we go live, the stream will appear here.
        </p>

        <a
          href={`https://youtube.com/channel/${channelId}`}
          target="_blank"
          class="inline-flex items-center justify-center mt-6 w-12 h-12 rounded-full bg-brand-red text-white shadow-md hover:bg-red-700 transition"
        >
          <svg viewBox="0 0 24 24" class="h-6 w-6">
            <path fill="currentColor" d="M10 15l5.19-3L10 9v6z" />
          </svg>
        </a>
      </div>
    )}
  </section>
</BaseLayout>
