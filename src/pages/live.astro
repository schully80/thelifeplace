---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/toast.css"; // 🍎 Imports premium red toast
import FullBleed from "../components/tlp/FullBleed.astro";

// SERVICE TIME FOR COUNTDOWN
const serviceDay = 0; // Sunday (0 = Sunday)
const serviceHour = 10; // 10:00 AM SAST
const serviceMinute = 0;
---

<BaseLayout 
  title="Live Stream — Come. See. Jesus. | The Life Place"
  description="The Life Place — Come. See. Jesus. Watch our Sunday worship service live at 9:00–11:00 AM. Connect with our community in real time."
>
  
  <!-- Hero -->
  <FullBleed class="overflow-hidden bg-gradient-to-b from-gray-950 via-gray-900/95 to-gray-900 py-16 md:py-24 px-6 md:px-10 h-[35vh] md:h-[50vh] lg:h-[70vh]">
    <!-- Modern gradient mesh background -->
    <div class="absolute inset-0 opacity-40">
      <div class="absolute top-0 -left-1/2 w-full h-full bg-gradient-to-r from-brand-red/30 to-transparent rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-gradient-to-tl from-red-600/20 to-transparent rounded-full blur-3xl"></div>
    </div>

    <!-- Animated particles - enhanced -->
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-20 left-10 w-72 h-72 bg-brand-red rounded-full mix-blend-screen filter blur-3xl animate-blob"></div>
      <div class="absolute top-40 right-10 w-72 h-72 bg-red-600 rounded-full mix-blend-screen filter blur-3xl animate-blob animation-delay-2000"></div>
      <div class="absolute -bottom-8 left-20 w-72 h-72 bg-red-500 rounded-full mix-blend-screen filter blur-3xl animate-blob animation-delay-4000"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 text-center h-full md:flex md:items-center md:justify-center">
      <div class="w-full max-w-5xl mx-auto">
        <!-- Eyebrow text with service time -->
        <p class="text-sm md:text-base font-semibold text-red-400 uppercase tracking-widest mb-6 opacity-90">
          Sunday 9:00 AM SAST
        </p>
        
        <h1 class=" block text-white heading-1 mb-8 leading-relaxed tracking-tighter">
          Join Us <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-brand-red to-red-600 drop-shadow-lg">Live</span>
        </h1>
        
        <!-- Countdown with enhanced styling -->
        <div id="countdown" class="text-xl md:text-2xl font-semibold text-transparent bg-clip-text bg-gradient-to-r from-red-300 to-red-500 mb-8 leading-relaxed"></div>
        
        <!-- CTA Button -->
        <button onclick="document.querySelector('[id=liveFrame]').scrollIntoView({behavior:'smooth'})" class="inline-flex items-center gap-2 px-5 py-3 md:gap-3 md:px-8 md:py-4 
        bg-gradient-to-r from-brand-red to-red-600 hover:from-brand-red hover:to-red-700
         text-white font-semibold rounded-2xl shadow-lg hover:shadow-xl 
         transition-all duration-300 group text-base md:text-lg">
          <span>Watch Now</span>
        </button>
      </div>
    </div>
  </FullBleed>

  <!-- Cinematic Live Player — Industry Standard Design -->
  <section class="w-full px-4 md:px-6 lg:px-8 py-24 md:py-32 bg-gradient-to-b from-gray-50 to-white relative">
    <!-- Glow effect behind player -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-96 bg-brand-red/10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto">
      <!-- Player Container — 16:9 Aspect Ratio with Glow -->
      <div class="relative">
        <!-- Gradient border glow -->
        <div class="absolute -inset-1 bg-gradient-to-r from-brand-red to-red-600 rounded-3xl opacity-0 group-hover:opacity-100 blur transition duration-500 -z-10"></div>
        
        <div class="relative w-full bg-black rounded-3xl overflow-hidden shadow-2xl" style="aspect-ratio: 16/9;">
          
  <!-- Live Status Badge -->
<div class="absolute top-4 left-4 z-20">
  <span
    id="liveStatusBadge"
    class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs md:text-sm font-semibold bg-green-500 text-white backdrop-blur-md shadow-lg"
  >
    <span class="w-2.5 h-2.5 bg-white rounded-full animate-pulse"></span>
    LIVE
  </span>
</div>

          <!-- Player — 16:9 Fill -->
          <iframe
            id="liveFrame"
            src="https://www.youtube.com/embed/live_stream?channel=UC2f4d_FFU4HiTT_DiPhZwvw"
            class="absolute inset-0 w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>

    <!-- SHARE BUTTON WITH MENU -->
    <div class="mt-12 flex flex-col items-center gap-3">
      <button
        id="tlpShareBtn"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="tlpShareMenu"
        class="group relative px-5 py-3 md:px-4 md:py-2 lg:px-6 lg:py-4 rounded-2xl bg-gradient-to-r from-brand-red to-red-600 text-white font-semibold text-base md:text-lg shadow-lg hover:shadow-2xl hover:from-brand-red hover:to-red-700 active:scale-95 transition-all duration-300 flex items-center gap-2 md:gap-2.5 border border-red-500/50 backdrop-blur-sm"
      >
        <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
        <span class="group-hover:tracking-wide transition-all duration-300">Share</span>
      </button>

      <!-- SHARE MENU (Hidden by default) -->
      <div
        id="tlpShareMenu"
        class="w-full max-w-[14rem] bg-white rounded-2xl shadow-2xl p-4 z-40
               backdrop-blur-xl border border-white/20 overflow-hidden transition-[max-height,opacity] duration-200 ease-out max-h-0 opacity-0 pointer-events-none"
      >
        <!-- Copy Link -->
        <a
          id="shareLink"
          href="#"
          class="flex items-center gap-3 w-full px-4 py-3 text-left text-gray-600 hover:bg-gray-50 rounded-lg transition"
        >
          <i class="fa-solid fa-link text-brand-red text-lg" aria-hidden="true"></i>
          <span class="font-medium">Copy Link</span>
        </a>

        <!-- Facebook -->
        <a
          id="shareFacebook"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 w-full px-4 py-3 text-left text-gray-600 hover:bg-gray-50 rounded-lg transition"
        >
          <i class="fa-brands fa-facebook-f text-brand-red text-lg" aria-hidden="true"></i>
          <span class="font-medium">Facebook</span>
        </a>

        <!-- Twitter/X -->
        <a
          id="shareTwitter"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 w-full px-4 py-3 text-left text-gray-600 hover:bg-gray-50 rounded-lg transition"
        >
          <i class="fa-brands fa-x-twitter text-brand-red text-lg" aria-hidden="true"></i>
          <span class="font-medium">Twitter</span>
        </a>

        <!-- WhatsApp -->
        <a
          id="shareWhatsapp"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 w-full px-4 py-3 text-left text-gray-600 hover:bg-gray-50 rounded-lg transition"
        >
          <i class="fa-brands fa-whatsapp text-brand-red text-lg" aria-hidden="true"></i>
          <span class="font-medium">WhatsApp</span>
        </a>

        <!-- Email -->
        <a
          id="shareEmail"
          class="flex items-center gap-3 w-full px-4 py-3 text-left text-gray-600 hover:bg-gray-50 rounded-lg transition"
        >
          <i class="fa-solid fa-envelope text-brand-red text-lg" aria-hidden="true"></i>
          <span class="font-medium">Email</span>
        </a>
      </div>
    </div>

  </section>

  <!-- NEXT STEPS & CTA SECTION -->
  <section class="w-full bg-white py-16 md:py-24">
  <!-- GRID -->
    <div class="px-4 md:px-6 grid gap-6 md:gap-10 sm:grid-cols-2 lg:grid-cols-3 place-items-center">

   <!-- INLINE GLASS APP DOWNLOAD CARD -->
<div
  id="download-app"
  class="w-full max-w-sm mx-auto backdrop-blur-xl bg-white/20 border border-white/30
         cine-zoom-apple-hover shadow-2xl rounded-2xl md:rounded-[36px] p-6 md:p-8 text-center animate-floatSlow cursor-pointer transition-all duration-300 hover:shadow-2xl"
>

  <i class="fa-solid fa-download text-brand-red mx-auto mb-3 md:mb-5 text-3xl md:text-4xl opacity-90" aria-hidden="true"></i>

  <h3 class="text-xl md:text-2xl font-semibold text-gray-800 mb-2">
    Download Our App
  </h3>

  <!-- ⚠️ DISABLED APP STORE AND GOOGLE PLAY BADGES -->
  <div class="flex flex-col sm:flex-row justify-center items-center gap-2 md:gap-4 mb-4 opacity-90 cursor-not-allowed select-none">
    <img 
      src="/app-store-badge.svg"
      alt="Download on the App Store"
      class="h-10 md:h-12 w-auto"
    />

<img 
    src="/google-play-badge.jpg"
    alt="Get it on Google Play"
    class="h-10 md:h-16 w-auto"
  />

  </div>

  <p class="text-sm md:text-base text-gray-600 italic">
    Download coming soon
  </p>

</div>

      <!-- GIVE -->
      <a
        href="/give"
        class="block w-full max-w-sm cine-zoom-apple-hover relative rounded-2xl md:rounded-[36px] p-6 md:p-10
               backdrop-blur-xl bg-white/10 
               shadow-[0_8px_40px_rgba(0,0,0,0.25)] text-center overflow-hidden cursor-pointer transition-all duration-300 hover:shadow-[0_12px_50px_rgba(0,0,0,0.35)]"
      >
        <i class="fa-solid fa-hand-holding-heart text-brand-red mx-auto mb-3 md:mb-5 text-3xl md:text-4xl opacity-90" aria-hidden="true"></i>


        <h3 class="text-xl md:text-3xl font-semibold text-gray-800 mb-2 md:mb-3">
          Partner With Us
        </h3>
        <p class="text-sm md:text-base text-gray-600 mb-4 md:mb-6">
          Your generosity moves the mission of <span class="word-jesus">Jesus</span> forward.
        </p>
      </a>

      <!-- PLAN A VISIT -->
      <a
        href="/visit"
        class="block w-full max-w-sm cine-zoom-apple-hover relative rounded-2xl md:rounded-[36px] p-6 md:p-10
               backdrop-blur-xl bg-white/10 
               shadow-[0_8px_40px_rgba(0,0,0,0.25)] text-center overflow-hidden sm:col-span-2 lg:col-span-1 cursor-pointer transition-all duration-300 hover:shadow-[0_12px_50px_rgba(0,0,0,0.35)]"
      >
           <i class="fa-solid fa-house text-brand-red mx-auto mb-3 md:mb-5 text-3xl md:text-4xl opacity-90" aria-hidden="true"></i>


        <h3 class="text-xl md:text-3xl font-semibold text-gray-800 mb-2 md:mb-3">
          Plan a Visit
        </h3>
        <p class="text-sm md:text-base text-gray-600 mb-4 md:mb-6">
          We would love to welcome you this Sunday.
        </p>
      </a>

    </div>
    <!-- END GRID -->

  </section>
</div>
<!-- END NEXT STEPS -->

  <!-- Scripts -->
  <script>
    /* ---------------------------
       SHARE BUTTON WITH MENU
    ----------------------------*/
    const shareBtn = document.getElementById("tlpShareBtn");
    const shareMenu = document.getElementById("tlpShareMenu");
    const shareLink = document.getElementById("shareLink");
    const shareFacebook = document.getElementById("shareFacebook");
    const shareTwitter = document.getElementById("shareTwitter");
    const shareWhatsapp = document.getElementById("shareWhatsapp");
    const shareEmail = document.getElementById("shareEmail");
    const countdown = document.getElementById("countdown");
    const pageUrl = window.location.href;
    const pageTitle = "Join us live at The Life Place!";
    const serviceDay = 0;
    const serviceHour = 10;
    const serviceMinute = 0;
    let setOpen: ((isOpen: boolean) => void) | null = null;

    if (
      shareBtn instanceof HTMLButtonElement &&
      shareMenu instanceof HTMLDivElement &&
      shareLink instanceof HTMLAnchorElement &&
      shareFacebook instanceof HTMLAnchorElement &&
      shareTwitter instanceof HTMLAnchorElement &&
      shareWhatsapp instanceof HTMLAnchorElement &&
      shareEmail instanceof HTMLAnchorElement &&
      !shareBtn.dataset.bound
    ) {
      shareBtn.dataset.bound = "true";

      setOpen = (isOpen: boolean) => {
        shareMenu.classList.toggle("is-open", isOpen);
        shareBtn.setAttribute("aria-expanded", String(isOpen));
      };

      // Toggle menu
      shareBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !shareMenu.classList.contains("is-open");
        setOpen?.(isOpen);
      });

      // Close menu when clicking outside
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Node)) return;
        if (!shareBtn.contains(target) && !shareMenu.contains(target)) {
          setOpen?.(false);
        }
      });

      // Copy Link
      shareLink.addEventListener("click", async (e) => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(pageUrl);
          tlpCopiedToast("Link copied!");
          setOpen ? setOpen(false) : shareMenu.classList.remove("is-open");
        } catch {
          alert("Link copied!");
        }
      });

      shareFacebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
      shareTwitter.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`;
      shareWhatsapp.href = `https://wa.me/?text=${encodeURIComponent(pageTitle + " " + pageUrl)}`;
      shareEmail.href = `mailto:?subject=${encodeURIComponent("Join us live at The Life Place!")}&body=${encodeURIComponent(pageTitle + "\n" + pageUrl)}`;
    }

    function tlpCopiedToast(message = "Copied!") {
      const t = document.createElement("div");
      t.textContent = message;
      t.className =
        "tlp-toast-red fixed bottom-6 right-6 px-4 py-2 text-white text-sm font-medium " +
        "rounded-full shadow-xl backdrop-blur-xl animate-toastSlide z-[99999]";
      document.body.appendChild(t);
      setTimeout(() => t.classList.add("toast-hide"), 1600);
      setTimeout(() => t.remove(), 2200);
    }

    /* ---------------------------
       COUNTDOWN TIMER
    ----------------------------*/
    function updateCountdown() {
      if (!(countdown instanceof HTMLElement)) return;
      const now = new Date();
      const nextService = new Date();
      nextService.setDate(now.getDate() + ((serviceDay + 7 - now.getDay()) % 7));
      nextService.setHours(serviceHour, serviceMinute, 0, 0);

      const diff = nextService.getTime() - now.getTime();

      if (diff <= 0) {
        countdown.textContent = "We are live now!";
        return;
      }

      const hours = Math.floor(diff / 1000 / 60 / 60);
      const minutes = Math.floor((diff / 1000 / 60) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      countdown.textContent = `${hours}h ${minutes}m ${seconds}s until next service`;
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();


    /* ---------------------------
       LIVE STATUS (placeholder)
    ----------------------------*/
    async function checkLiveStatus() {
      const badge = document.getElementById("liveStatusBadge");
      if (!(badge instanceof HTMLElement)) return;
      const liveWindow = window as typeof window & { __TLP_IS_LIVE?: boolean };

      // TODO: Replace with actual YouTube API
      liveWindow.__TLP_IS_LIVE = true; // if truly LIVE
      const isLive = liveWindow.__TLP_IS_LIVE === true;
      if (isLive) {
        badge.textContent = "🔴 Live Now";
        badge.className =
          "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-red-600 text-white";
      } else {
        badge.textContent = "● Offline";
        badge.className =
          "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-gray-500 text-white";
      }
    }
    checkLiveStatus();
  </script>


<script is:inline>
  async function updateLiveBadge() {
    const badge = document.getElementById("liveStatusBadge");
    if (!(badge instanceof HTMLElement)) return;

    try {
      const res = await fetch("/api/live-status.json");
      const data = await res.json();

      if (data.live) {
        badge.textContent = "🔴 Live Now";
        badge.classList.remove("bg-gray-500");
        badge.classList.add("bg-red-600");
      } else {
        badge.textContent = "● Offline";
        badge.classList.remove("bg-red-600");
        badge.classList.add("bg-gray-500");
      }
    } catch {
      badge.textContent = "● Offline";
    }
  }

  updateLiveBadge();
  setInterval(updateLiveBadge, 60000);
</script>

  <!-- ANIMATIONS & STYLES -->
<style>
  /* Blob animation */
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
  }
  .animate-blob { animation: blob 7s infinite; }
  .animation-delay-2000 { animation-delay: 2s; }
  .animation-delay-4000 { animation-delay: 4s; }

  /* Pulse soft */
  @keyframes pulse-soft {
    0%, 100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
    50% { box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); }
  }
  .hover\:animate-pulse-soft:hover { animation: pulse-soft 2s infinite; }

  /* Share menu */
  #tlpShareMenu { max-height: 0; opacity: 0; pointer-events: none; }
  #tlpShareMenu.is-open { max-height: 500px; opacity: 1; pointer-events: auto; }

  /* Fade up animations */
  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(25px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeUp { animation: fadeUp 0.8s ease-out both; }

  /* Stagger animation */
  @keyframes staggerIn {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  /* Mobile optimizations */
  @media (max-width: 768px) {
    h1 {
      font-size: 2.25rem;
    }
    #tlpShareBtn {
      padding: 0.875rem 1.5rem;
      font-size: 1rem;
    }
  }
</style>

</BaseLayout>
