---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/toast.css"; // For red-glass toast (already used in messages)

// SERVICE TIME FOR COUNTDOWN
const serviceDay = 0; // Sunday
const serviceHour = 10; // 10 AM SAST
const serviceMinute = 0;
---

<BaseLayout title="Live">

  <!-- HERO HEADER -->
  <section class="bg-gradient-to-b from-gray-50 to-white py-10 md:py-16 text-center">
    <h1 class="text-3xl md:text-5xl font-bold text-gray-900">Join Us Live</h1>
    <p class="mt-3 text-gray-600 text-lg">Sundays • 10:00 AM (SAST)</p>
    <div id="countdown" class="mt-6 text-2xl font-semibold text-brand-red"></div>
  </section>

  <!-- CINEMATIC PLAYER -->
  <section class="max-w-7xl mx-auto px-4 pb-16 relative">

    <!-- Glow -->
    <div class="absolute inset-0 -z-10 blur-3xl opacity-30 bg-brand-red/30 animate-pulse rounded-full"></div>

    <div class="rounded-3xl overflow-hidden shadow-2xl bg-black relative">

      <!-- Live Badge -->
      <div class="absolute top-6 left-6 z-20">
        <span id="liveStatusBadge"
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-gray-500 text-white">
          ● Checking…
        </span>
      </div>

      <!-- Player -->
      <div class="aspect-video w-full">
        <iframe
          id="liveFrame"
          src="https://www.youtube.com/embed/live_stream?channel=YOUR_CHANNEL_ID"
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <!-- SHARE BUTTON -->
    <div class="mt-8 flex justify-center relative">
      <button
        id="tlpShareBtn"
        class="group relative px-6 py-3 rounded-full bg-brand-red text-white font-semibold
               shadow-sm hover:bg-brand-red/90 hover:shadow-lg active:scale-[0.97]
               transition-all duration-300 flex items-center gap-2"
      >
        <svg 
          class="w-5 h-5 transition-transform duration-300 group-hover:-translate-y-0.5"
          fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="M8.59 13.51l6.83 3.98" />
          <path d="M15.41 6.51L8.59 10.49" />
        </svg>
        <span>Share</span>
      </button>

      <!-- Floating Tooltip (Injected by JS) -->
    </div>

  </section>

  <!-- QUICK ACTIONS -->
  <section class="max-w-5xl mx-auto px-4 pb-24">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">

      <a href="/visit/" class="rounded-3xl border-2 ring-1 ring-brand-red bg-white p-10 text-center shadow-xl hover:shadow-2xl transition-all">
        <span class="block text-2xl font-semibold text-brand-red mb-1">Plan a Visit</span>
        <span class="text-gray-700 text-lg font-medium">You’re welcome here</span>
      </a>

      <a href="/give/" class="rounded-3xl border-2 ring-1 ring-brand-red bg-white p-10 text-center shadow-xl hover:shadow-2xl transition-all">
        <span class="block text-2xl font-semibold text-brand-red mb-1">Give Online</span>
        <span class="text-gray-700 text-lg font-medium">Safe & Secure</span>
      </a>

      <a href="/prayer/" class="rounded-3xl border-2 ring-1 ring-brand-red bg-white p-10 text-center shadow-xl hover:shadow-2xl transition-all">
        <span class="block text-2xl font-semibold text-brand-red mb-1">Prayer Request</span>
        <span class="text-gray-700 text-lg font-medium">We’ll stand with you</span>
      </a>

    </div>
  </section>

  <!-- INLINE GLASS APP CARD -->
  <div
    class="mx-auto mt-16 max-w-md backdrop-blur-xl bg-white/20 border border-white/30
           shadow-2xl rounded-3xl p-8 text-center ring-1 ring-black/5 animate-floatSlow"
  >
    <img src="/expo-qr.png" alt="Download App QR" class="w-36 h-36 mx-auto mb-4 rounded-lg shadow-md" />

    <h3 class="text-2xl font-semibold text-gray-900 mb-2">Download Our App</h3>

    <p class="text-gray-600 text-sm leading-relaxed mb-5">
      Scan the QR code to open the app instantly in Expo Go.
    </p>

    <a
      href="https://expo.dev/"
      target="_blank"
      class="inline-flex items-center gap-2 rounded-full px-6 py-3
             bg-brand-red text-white font-semibold shadow-sm
             hover:bg-brand-red/90 hover:shadow-md active:scale-[0.97]
             transition-all"
    >
      Get Expo Go
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24">
        <path d="M22 2 11 13" />
        <path d="M22 2 15 22 11 13 2 9 22 2z" />
      </svg>
    </a>
  </div>


  <!-- SCRIPTS -->
  <script>
    /* -------------------------------------
       SHARE BUTTON (Native + Custom Tooltip)
    ------------------------------------- */
    const shareBtn = document.getElementById("tlpShareBtn");

    shareBtn.addEventListener("click", async () => {
      const shareData = {
        title: "The Life Place — Live",
        text: "Join us live at The Life Place",
        url: window.location.href
      };

      // Native share (iPhone / Android)
      if (navigator.share) {
        try {
          await navigator.share(shareData);
          return;
        } catch (e) {}
      }

      // Fallback (Copy + floating tooltip)
      try {
        await navigator.clipboard.writeText(window.location.href);
        tlpFloatingTooltip();
      } catch (e) {
        alert("Link copied!");
      }
    });

    function tlpFloatingTooltip() {
      const tip = document.createElement("div");
      tip.textContent = "Copied!";
      tip.className =
        "fixed px-3 py-1 text-sm font-medium text-white rounded-full shadow-lg " +
        "bg-brand-red backdrop-blur-xl border border-white/30 " +
        "tlp-fade-tooltip";

      // Position above the Share button
      const rect = shareBtn.getBoundingClientRect();
      tip.style.left = rect.left + rect.width / 2 + "px";
      tip.style.top = rect.top - 10 + "px";
      tip.style.transform = "translateX(-50%) translateY(0)";
      tip.style.transition = "all .45s cubic-bezier(.16,1,.3,1)";
      tip.style.opacity = "0";

      document.body.appendChild(tip);

      requestAnimationFrame(() => {
        tip.style.opacity = "1";
        tip.style.transform = "translateX(-50%) translateY(-16px)";
      });

      setTimeout(() => {
        tip.style.opacity = "0";
        tip.style.transform = "translateX(-50%) translateY(-4px)";
      }, 1300);

      setTimeout(() => tip.remove(), 1900);
    }


    /* -------------------------------------
       COUNTDOWN TIMER
    ------------------------------------- */
    function updateCountdown() {
      const now = new Date();
      const nextService = new Date();
      nextService.setDate(now.getDate() + ((serviceDay + 7 - now.getDay()) % 7));
      nextService.setHours(serviceHour, serviceMinute, 0, 0);

      const diff = nextService - now;

      if (diff <= 0) {
        document.getElementById("countdown").textContent = "We are live now!";
        return;
      }

      const hours = Math.floor(diff / 1000 / 60 / 60);
      const minutes = Math.floor((diff / 1000 / 60) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      document.getElementById("countdown").textContent =
        `${hours}h ${minutes}m ${seconds}s until next service`;
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();


    /* -------------------------------------
       LIVE STATUS (placeholder)
    ------------------------------------- */
    function checkLiveStatus() {
      const badge = document.getElementById("liveStatusBadge");

      const isLive = true; // replace with API later

      if (isLive) {
        badge.textContent = "🔴 Live Now";
        badge.className =
          "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-red-600 text-white";
      } else {
        badge.textContent = "● Offline";
        badge.className =
          "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-gray-500 text-white";
      }
    }
    checkLiveStatus();
  </script>

  <!-- Tooltip animation style -->
  <style>
    .tlp-fade-tooltip {
      pointer-events: none;
    }
  </style>

</BaseLayout>
