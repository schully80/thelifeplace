---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Our Values - Test">

<!-- ===== DRAMATIC HERO SECTION ===== -->
<section class="w-full min-h-screen md:min-h-[80vh] relative overflow-hidden bg-gradient-to-r from-brand-red/95 via-red-600/90 to-brand-red/95 flex items-center justify-center">
  
  <!-- Animated background elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 right-1/4 w-80 h-80 bg-brand-red/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 left-1/3 w-64 h-64 bg-brand-red/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 text-center z-10">
    
    <!-- Label -->
    <div class="mb-8 opacity-0 animate-fadeUp">
      <span class="inline-block px-4 py-2 rounded-full bg-gradient-to-r from-brand-red/20 to-red-600/10 border border-brand-red/40 text-sm md:text-base text-brand-red font-bold uppercase tracking-widest backdrop-blur-sm">
        Our Foundation
      </span>
    </div>

    <!-- Main heading -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black leading-tight text-white mb-16 opacity-0 animate-fadeUp delay-100 max-w-5xl mx-auto">
      Five Values
      <span class="block text-yellow-200 mt-4 md:mt-6">
        Shaping Our Culture
      </span>
    </h1>

    <!-- Subtitle & Attribution -->
    <p class="text-base md:text-xl text-white leading-relaxed font-medium mb-8 opacity-0 animate-fadeUp delay-200 max-w-2xl mx-auto">
      We are intentional about The Life Place being a community where all that we are and do communicates the beauty, gentleness and kindness of who Jesus is.
    </p>

    <div class="flex items-center justify-center gap-4 opacity-0 animate-fadeUp delay-300">
      <div class="w-6 h-px bg-gradient-to-r from-transparent to-yellow-200"></div>
      <p class="text-white text-base md:text-lg font-black italic tracking-wide">
        — Schulter & Genevieve Etyang
      </p>
      <div class="w-6 h-px bg-gradient-to-l from-transparent to-yellow-200"></div>
    </div>

  </div>

</section>

<!-- ===== VALUE 1: DRAMATIC FULL-WIDTH SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-white relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
      
      <!-- Left: Content -->
      <div class="opacity-0 animate-fadeUp delay-100">
        <div class="inline-block px-4 py-2 rounded-full bg-blue-100 text-blue-700 text-sm font-bold uppercase tracking-widest mb-6">
          Value 1
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-800 mb-6 leading-tight">
          Seeing <span class="text-brand-red">Jesus</span> in the Bible
        </h2>
        
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-8">
          Just as Jesus taught that everything in the Bible points to Him, we believe that every time we open the Bible, we are invited to see and meet with Him. Our commitment is to help people encounter Jesus through Scripture in a transformative way.
        </p>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">Every passage reveals His character</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">Every story shows His love and redemption</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">Every word speaks to His finished work</span>
          </li>
        </ul>
        
        <p class="text-sm text-gray-500 italic">Luke 24:47; John 1:19-35, 5:39, 46, 12:26-27, 13:3</p>
      </div>

      <!-- Right: Visual -->
      <div class="opacity-0 animate-fadeUp delay-200 relative">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 to-blue-400/20 rounded-3xl blur-2xl"></div>
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-blue-200/50 h-[500px] md:h-[600px]">
          <img src="/what-teach4.jpg" alt="Teaching and learning value at The Life Place" class="w-full h-full object-cover object-center" />
        </div>
      </div>

    </div>

  </div>

</section>

<!-- ===== VALUE 2: DARK DRAMATIC SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-br from-slate-900 via-black to-slate-900 relative overflow-hidden">
  
  <div class="absolute inset-0">
    <div class="absolute top-0 left-0 w-96 h-96 bg-green-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-brand-red/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6">
    
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
      
      <!-- Left: Visual -->
      <div class="opacity-0 animate-fadeUp delay-100 order-2 md:order-1 relative">
        <div class="absolute inset-0 bg-gradient-to-br from-green-600/20 to-green-400/20 rounded-3xl blur-2xl"></div>
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-green-600/30 h-[500px] md:h-[600px]">
          <img src="/what-community7.png" alt="Multiracial and multigenerational community at The Life Place" class="w-full h-full object-cover object-center" />
        </div>
      </div>

      <!-- Right: Content -->
      <div class="opacity-0 animate-fadeUp delay-200 order-1 md:order-2">
        <div class="inline-block px-4 py-2 rounded-full bg-green-900/50 border border-green-500/50 text-green-300 text-sm font-bold uppercase tracking-widest mb-6">
          Value 2
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-6 leading-tight">
          Diverse <span class="text-brand-red">Community</span>
        </h2>
        
        <p class="text-lg md:text-xl text-gray-300 leading-relaxed mb-8">
          The gospel creates a new kind of community—every ethnicity, tribe, people and language. Rooted in Jesus' finished work, we celebrate every story, background and culture.
        </p>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-300">Barriers of race and class are broken</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-300">We are one family in Christ</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-300">Reflecting the beauty of God's kingdom</span>
          </li>
        </ul>
        
        <p class="text-sm text-gray-500 italic">Acts 2:46–47; Romans 8:15; Galatians 4:6; Ephesians 3; Revelation 7:9</p>
      </div>

    </div>

  </div>

</section>

<!-- ===== VALUE 3: LIGHT SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-b from-white to-gray-50 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
      
      <!-- Left: Content -->
      <div class="opacity-0 animate-fadeUp delay-100">
        <div class="inline-block px-4 py-2 rounded-full bg-amber-100 text-amber-700 text-sm font-bold uppercase tracking-widest mb-6">
          Value 3
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-800 mb-6 leading-tight">
          Extravagant <span class="text-brand-red">Generosity</span>
        </h2>
        
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-8">
          Made rich by what Jesus has done, we joyfully give, share and overflow with generosity. It's not just about money—it's about sharing our time, talents, and resources freely.
        </p>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">We overflow with joy and giving</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">Jesus gave extravagantly for us</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">We give extravagantly in return</span>
          </li>
        </ul>
        
        <p class="text-sm text-gray-500 italic">1 Chronicles 29:1-9, Matthew 26:6-8, Acts 2:45; 4:35; 2 Corinthians 8:2–4, 9, 16–24; 9:1–15</p>
      </div>

      <!-- Right: Visual -->
      <div class="opacity-0 animate-fadeUp delay-200 relative">
        <div class="absolute inset-0 bg-gradient-to-br from-amber-600/20 to-amber-400/20 rounded-3xl blur-2xl"></div>
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-amber-200/50 h-[500px] md:h-[600px]">
          <img src="/what-give.jpg" alt="Extravagant generosity value at The Life Place" class="w-full h-full object-cover object-center" /

    </div>

  </div>

</section>

<!-- ===== VALUE 4: DARK DRAMATIC SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-br from-slate-900 via-black to-slate-900 relative overflow-hidden">
  
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-red/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6">
    
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
      
      <!-- Left: Visual -->
      <div class="opacity-0 animate-fadeUp delay-100 order-2 md:order-1 relative">
        <div class="absolute inset-0 bg-gradient-to-br from-purple-600/20 to-purple-400/20 rounded-3xl blur-2xl"></div>
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-purple-600/30 h-[500px] md:h-[600px]">
          <img src="/Graceful-compassion.jpg" alt="Graceful compassion value at The Life Place" class="w-full h-full object-cover object-center" />
        </div>
      </div>

      <!-- Right: Content -->
      <div class="opacity-0 animate-fadeUp delay-200 order-1 md:order-2">
        <div class="inline-block px-4 py-2 rounded-full bg-purple-900/50 border border-purple-500/50 text-purple-300 text-sm font-bold uppercase tracking-widest mb-6">
          Value 4
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-6 leading-tight">
          Graceful <span class="text-brand-red">Compassion</span>
        </h2>
        
        <p class="text-lg md:text-xl text-gray-300 leading-relaxed mb-8">
          Jesus moves us toward the widow, the orphan, the poor, the imprisoned and the immigrant with grace that mirrors His. We are called to see and serve the vulnerable.
        </p>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-300">Moving toward those in need</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-300">Grace that mirrors Jesus</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-300">Kindness and justice together</span>
          </li>
        </ul>
        
        <p class="text-sm text-gray-500 italic">Deut 10:18, 14:29; 16:11; 24:17, 19–21; Matt 25:35–40; Acts 6:1–3; Gal 2:9; James 1:27, 2:14–17; Jude 9</p>
      </div>

    </div>

  </div>

</section>

<!-- ===== VALUE 5: FINAL LIGHT SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-b from-white to-gray-50 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
      
      <!-- Left: Content -->
      <div class="opacity-0 animate-fadeUp delay-100">
        <div class="inline-block px-4 py-2 rounded-full bg-pink-100 text-pink-700 text-sm font-bold uppercase tracking-widest mb-6">
          Value 5
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-800 mb-6 leading-tight">
          Tell the <span class="text-brand-red">Story</span>
        </h2>
        
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-8">
          The story of Jesus moves through us into our city, our nation and the world. We are a sent people, carrying His life and His good news through words, lives, and actions.
        </p>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">Jesus' story moves through us</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">We are intentionally sent into the world</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-red font-bold text-xl mt-1">→</span>
            <span class="text-gray-600">Sharing His good news everywhere</span>
          </li>
        </ul>
        
        <p class="text-sm text-gray-500 italic">Luke 8:39; John 17:18; 1 Corinthians 9:23</p>
      </div>

      <!-- Right: Visual -->
      <div class="opacity-0 animate-fadeUp delay-200 relative">
        <div class="absolute inset-0 bg-gradient-to-br from-pink-600/20 to-pink-400/20 rounded-3xl blur-2xl"></div>
        <div class="relative rounded-3xl overflow-hidden shadow-2xl h-[500px] md:h-[600px] flex items-center justify-center">
          <img src="/what-sent6.jpg" alt="Sent out in the story of Jesus value at The Life Place" class="w-full h-full object-cover object-left" />

    </div>

  </div>

</section>

<!-- ===== CLOSING SCRIPTURE ===== -->
<section class="w-full py-20 md:py-28 bg-gradient-to-r from-brand-red/95 via-red-600/90 to-brand-red/95 relative overflow-hidden">
  
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/15 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-black/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-6 text-center">
    
    <blockquote class="text-3xl md:text-4xl lg:text-5xl font-black text-white leading-tight opacity-0 animate-fadeUp delay-100 mb-6">
      "I came that they may have and enjoy life and have it in abundance 
      <span class="block text-yellow-200 mt-4">(to the full, till it overflows)."</span>
    </blockquote>
    
    <p class="text-base md:text-lg text-white/90 font-medium opacity-0 animate-fadeUp delay-200">
      John 10:10 (AMP)
    </p>

  </div>

</section>

<!-- ===== FINAL CTA ===== -->
<section class="w-full py-24 md:py-32 bg-white">
  
  <div class="relative max-w-6xl mx-auto px-6 text-center">
    
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-800 mb-8 opacity-0 animate-fadeUp delay-100">
      Experience These Values
      <span class="block text-brand-red">This Sunday</span>
    </h2>

    <div class="flex flex-col md:flex-row gap-6 justify-center opacity-0 animate-fadeUp delay-300">
      
      <a href="/visit" class="inline-block px-8 py-4 bg-gradient-to-r from-brand-red to-red-600 hover:from-red-600 hover:to-red-700 text-white font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
        Plan a Visit
      </a>

      <a href="/" class="inline-block px-8 py-4 bg-gradient-to-r from-gray-800 to-gray-900 hover:from-gray-900 hover:to-black text-white font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
        Back Home
      </a>

    </div>

  </div>

</section>

<!-- Custom animations -->
<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }
  .delay-1000 { animation-delay: 1000ms; }
</style>

</BaseLayout>



<!-- Custom animations -->
<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }
  .delay-1000 { animation-delay: 1000ms; }
</style>

</BaseLayout>
