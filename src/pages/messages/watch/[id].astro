---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import messages from "../../../data/messages.json";

const { id } = Astro.params;

// Find the selected message
const message = messages.find((m) => m.id === id);

// If not found → show 404-like fallback
if (!message) {
  throw new Error(`Message with ID "${id}" not found.`);
}

// Find recommended messages (excluding current)
const recommended = messages
  .filter((m) => m.id !== id)
  .slice(0, 6);
---

<BaseLayout title={message.title}>

  <!-- HERO PLAYER -->
  <section class="max-w-6xl mx-auto px-4 pt-10">

    <div
      class="relative w-full aspect-video rounded-[34px] overflow-hidden shadow-[0_25px_60px_rgba(0,0,0,0.45)]
             bg-black scale-[0.995] hover:scale-[1] transition-all duration-700 ease-[cubic-bezier(.16,1,.3,1)]
             before:absolute before:inset-0 before:bg-gradient-to-b before:from-black/50 before:via-transparent before:to-black/40
             after:absolute after:inset-0 after:rounded-[34px] after:pointer-events-none
             after:shadow-[0_0_120px_rgba(179,40,45,0.35)] after:opacity-40 hover:after:opacity-60 after:transition-all after:duration-700"
    >
      <iframe
        class="w-full h-full relative z-10"
        src={`https://www.youtube.com/embed/${message.youtubeId}?rel=0&modestbranding=1`}
        allowfullscreen
      ></iframe>
    </div>

    <!-- TITLE + META -->
    <div class="text-center mt-6">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">{message.title}</h1>
      <p class="mt-2 text-gray-600 text-lg">
        {message.preacher} · {message.date}
      </p>
    </div>

    <!-- SHARE BUTTON -->
    <div class="mt-8 flex justify-center">
      <button
        id="tlpShareBtn"
        class="group relative px-6 py-3 rounded-full bg-brand-red text-white font-semibold
               shadow-sm hover:bg-brand-red/90 hover:shadow-lg active:scale-[0.97]
               transition-all duration-300 flex items-center gap-2"
      >
        <svg 
          class="w-5 h-5 transition-transform duration-300 group-hover:-translate-y-0.5"
          fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="M8.59 13.51l6.83 3.98" />
          <path d="M15.41 6.51L8.59 10.49" />
        </svg>
        <span>Share</span>
      </button>
    </div>

  </section>


  <!-- RECOMMENDED MESSAGES -->
  <section class="max-w-6xl mx-auto px-4 mt-16 mb-24">

    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
      Recommended Messages
    </h2>

    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">

      {recommended.map((m) => (
        <a
          href={`/messages/watch/${m.id}`}
          class="group block"
        >
          <div class="overflow-hidden rounded-2xl shadow-sm bg-white border">
            <img
              src={m.thumbnail}
              alt={m.title}
              class="w-full h-48 object-cover group-hover:scale-105 transition"
            />
          </div>

          <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">
            {m.title}
          </h3>

          <p class="text-gray-500 text-sm">{m.preacher}</p>
        </a>
      ))}

    </div>

  </section>


<!-- SHARE SCRIPT -->
<script>
  const shareBtn = document.getElementById("tlpShareBtn");

  shareBtn.addEventListener("click", async () => {
    const shareData = {
      title: document.title,
      text: "Check out this message from The Life Place!",
      url: window.location.href
    };

    // Native API
    if (navigator.share) {
      try {
        await navigator.share(shareData);
        return;
      } catch {}
    }

    // Fallback: copy link
    await navigator.clipboard.writeText(window.location.href);
    tlpCopiedToast();
  });

  function tlpCopiedToast() {
    const t = document.createElement("div");
    t.textContent = "Link copied!";
    t.className =
      "tlp-toast-red fixed bottom-6 right-6 px-4 py-2 text-white text-sm font-medium " +
      "rounded-full shadow-xl backdrop-blur-xl animate-toastSlide z-[99999]";
    document.body.appendChild(t);
    setTimeout(() => t.classList.add("toast-hide"), 1600);
    setTimeout(() => t.remove(), 2200);
  }
</script>

</BaseLayout>
