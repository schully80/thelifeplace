---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import messages from "../../../data/messages.json";
import fs from "fs";

const { id } = Astro.params;
const messages = JSON.parse(
  fs.readFileSync("src/data/messages.json", "utf-8")
);

const msg = messages.find((m) => m.id === id);

if (!msg) {
  throw new Error("Message not found");
}

const hasVideo = Boolean(message?.youtubeId);
const hasAudio = Boolean(message?.audioUrl);

const thumb =
  message?.thumbnail ||
  `/mnt/data/A_placeholder_digital_graphic_for_"The_Life_Place".png`;

---

<BaseLayout title={message?.title || "Message"}>
  <section class="max-w-4xl mx-auto px-4 py-10">

    <!-- TITLE -->
    <h1 class="text-3xl font-bold text-gray-900 mb-2">
      {message.title}
    </h1>

    <!-- META -->
    <p class="text-gray-600 mb-6">
      {message.speaker} • {message.series} • {message.date}
    </p>

    <!-- VIDEO PLAYER -->
    {hasVideo && (
      <div class="aspect-video mb-6 rounded-xl overflow-hidden shadow">
        <iframe
          src={`https://www.youtube.com/embed/${message.youtubeId}`}
          class="w-full h-full"
          frameborder="0"
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <!-- AUDIO PLAYER -->
    {!hasVideo && hasAudio && (
      <div class="mb-6 p-6 border rounded-xl shadow bg-white">
        <audio controls class="w-full">
          <source src={message.audioUrl} type="audio/mpeg" />
        </audio>
      </div>
    )}

    <!-- NO MEDIA -->
    {!hasVideo && !hasAudio && (
      <div class="border rounded-xl bg-white shadow-sm p-6 text-center">
        <img src={thumb} class="mx-auto w-64 opacity-80 mb-4" />
        <p class="text-gray-600">Media coming soon</p>
      </div>
    )}

  </section>
</BaseLayout>
