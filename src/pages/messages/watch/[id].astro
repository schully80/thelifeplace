---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const { id } = Astro.params;
const apiKey = import.meta.env.PUBLIC_YOUTUBE_API_KEY;

let video = null;

if (apiKey) {
  const qs = new URLSearchParams({
    id,
    key: apiKey,
    part: "snippet",
  });

  try {
    const res = await fetch(`https://www.googleapis.com/youtube/v3/videos?${qs.toString()}`);
    const data = await res.json();
    video = data.items?.[0] || null;
  } catch {}
}

const title = video?.snippet?.title || "Message";
const description = video?.snippet?.description || "";
const thumb = video?.snippet?.thumbnails?.high?.url;
---

<BaseLayout title={title}>
  <section class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{title}</h1>

    <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-lg border">
      <iframe
        src={`https://www.youtube.com/embed/${id}`}
        class="w-full h-full"
        allowfullscreen
      ></iframe>
    </div>

    {description && (
      <div class="mt-8 whitespace-pre-line text-gray-700 leading-relaxed">
        {description}
      </div>
    )}

    <div class="mt-8">
      <a href="/messages" class="inline-block px-4 py-2 rounded-full border text-gray-700 hover:bg-gray-50 transition">
        ← Back to Messages
      </a>
    </div>
  </section>
</BaseLayout>
