---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import messages from "../../../../data/messages.json";

const { slug } = Astro.params;

const list = messages.filter((m) => m.preacherSlug === slug);

if (list.length === 0) {
  throw new Error(`Speaker not found: ${slug}`);
}

const speakerName = list[0].preacher;
const thumbnail = list[0].thumbnail;
---

<BaseLayout title={speakerName}>

  <section class="mt-10 flex flex-col items-center text-center">
    <div class="rounded-full overflow-hidden w-40 h-40 border shadow-sm">
      <img src={thumbnail} class="w-full h-full object-cover" />
    </div>

    <h1 class="mt-6 text-3xl font-bold">{speakerName}</h1>
    <p class="text-gray-600 mt-1">{list.length} message(s)</p>
  </section>

  <section class="grid gap-10 mt-12 sm:grid-cols-2 lg:grid-cols-3">
    {list.map((msg) => (
      <a href={`/messages/watch/${msg.id}`} class="group block">
        <div class="rounded-2xl border shadow-sm overflow-hidden bg-white">
          <img
            src={msg.thumbnail}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />
        </div>

        <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">
          {msg.title}
        </h3>

        <p class="text-gray-500 text-sm">{msg.preacher}</p>
      </a>
    ))}
  </section>

  <div class="mt-10">
    <a href="/messages/speakers" class="text-brand-red font-semibold hover:underline">
      ← All Speakers
    </a>
  </div>

</BaseLayout>
