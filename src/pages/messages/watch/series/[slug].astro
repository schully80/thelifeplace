---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import messages from "../../../../data/messages.json";

const { slug } = Astro.params;

const list = messages.filter((m) => m.seriesSlug === slug);

if (list.length === 0) {
  throw new Error(`Series not found: ${slug}`);
}

const seriesName = list[0].series;
---

<BaseLayout title={seriesName}>
  <h1 class="text-3xl font-bold mt-8 text-brand-red">{seriesName}</h1>

  <p class="text-gray-600 mt-2">
    {list.length} message{list.length === 1 ? "" : "s"}
  </p>

  <section class="grid gap-10 mt-10 sm:grid-cols-2 lg:grid-cols-3">
    {list.map((msg) => (
      <a href={`/messages/watch/${msg.id}`} class="group block">
        <div class="rounded-2xl overflow-hidden border bg-white shadow-sm">
          <img
            src={msg.thumbnail}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />
        </div>

        <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">
          {msg.title}
        </h3>

        <p class="text-gray-500 text-sm">{msg.preacher}</p>
      </a>
    ))}
  </section>

  <div class="mt-10">
    <a href="/messages/series" class="text-brand-red font-semibold hover:underline">
      ← All Series
    </a>
  </div>
</BaseLayout>
