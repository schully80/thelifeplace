---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import fs from "fs";

const { series } = Astro.params;

const messages = JSON.parse(
  fs.readFileSync("src/data/messages.json", "utf-8")
);

// Filter by series
const items = messages.filter((m) => m.series === series);

if (items.length === 0) {
  throw new Error(`Series not found: ${series}`);
}
---

<BaseLayout title={series}>
  <section class="bg-gray-50 border-b py-16 text-center">
    <h1 class="text-4xl font-bold text-gray-900">{series}</h1>
    <p class="mt-2 text-gray-600">Messages from our “{series}” series</p>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">

      {items.map((msg) => (
        <a href={`/messages/watch/${msg.id}`} class="group block">
          <div class="overflow-hidden rounded-2xl border bg-white shadow-sm">
            <img
              src={msg.thumbnail}
              class="w-full h-48 object-cover group-hover:scale-105 transition"
            />
          </div>

          <h3 class="mt-3 text-lg font-semibold text-gray-900 group-hover:text-brand-red">
            {msg.title}
          </h3>

          <p class="text-sm text-gray-600">
            {msg.speaker} • {msg.date}
          </p>
        </a>
      ))}

    </div>
  </section>
</BaseLayout>
