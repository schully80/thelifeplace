---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import messages from "../../../data/messages.json";

const seriesMap = {};

messages.forEach((m) => {
  if (!seriesMap[m.seriesSlug]) {
    seriesMap[m.seriesSlug] = {
      name: m.series,
      slug: m.seriesSlug,
      thumb: m.thumbnail
    };
  }
});

const seriesList = Object.values(seriesMap);
---

<BaseLayout title="Series">
  <section class="mt-10 text-center">
    <h1 class="text-4xl font-bold text-gray-900">Message Series</h1>
    <p class="text-gray-600 mt-2">Explore teachings grouped by theme.</p>
  </section>

  <section class="grid gap-10 mt-12 sm:grid-cols-2 lg:grid-cols-3">
    {seriesList.map((s) => (
      <a href={`/messages/series/${s.slug}`} class="group block">
        <div class="rounded-2xl overflow-hidden shadow-sm border bg-white">
          <img
            src={s.thumb}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />
        </div>
        <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">
          {s.name}
        </h3>
      </a>
    ))}
  </section>
</BaseLayout>
