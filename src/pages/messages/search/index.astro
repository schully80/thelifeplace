---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import messages from "../../../data/messages.json";

const url = new URL(Astro.request.url);
const q = url.searchParams.get("q")?.toLowerCase() || "";

// Filter messages by search
const results = messages.filter((m) =>
  m.title.toLowerCase().includes(q) ||
  m.preacher.toLowerCase().includes(q) ||
  m.series.toLowerCase().includes(q)
);
---

<BaseLayout title="Search Messages">

  <section class="max-w-5xl mx-auto px-4 pt-10 text-center">
    <h1 class="text-4xl font-bold text-gray-900">Search</h1>
    <p class="text-gray-600 mt-2">
      Find messages by title, speaker, or series.
    </p>

    <div class="mt-8">
      <SearchBar />
    </div>
  </section>

  <!-- RESULTS -->
  <section class="max-w-6xl mx-auto px-4 mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">

    {results.length === 0 && (
      <p class="col-span-full text-center text-gray-500 text-lg">
        No messages found for "<strong>{q}</strong>"
      </p>
    )}

    {results.map((msg) => (
      <a
        href={`/messages/watch/${msg.id}`}
        class="group block cursor-pointer"
      >
        <div class="overflow-hidden rounded-2xl shadow-sm bg-white border">
          <img
            src={msg.thumbnail}
            alt={msg.title}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />
        </div>

        <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">
          {msg.title}
        </h3>

        <p class="text-gray-500 text-sm">
          {msg.preacher}
        </p>
      </a>
    ))}

  </section>

</BaseLayout>
