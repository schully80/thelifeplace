---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import messagesData from "../../../data/messages.json";

// 🌟 1. Build reliable series map (cannot be undefined)
const seriesMap = {};

(messagesData || []).forEach((m) => {
  if (!m.seriesSlug) return; // skip malformed entries

  if (!seriesMap[m.seriesSlug]) {
    seriesMap[m.seriesSlug] = {
      slug: m.seriesSlug,
      name: m.series,
      messages: [],
    };
  }

  seriesMap[m.seriesSlug].messages.push(m);
});

// 🌟 2. getStaticPaths → MUST export exactly for dynamic slugs
export function getStaticPaths() {
  return Object.values(seriesMap).map((series) => ({
    params: { slug: series.slug },
    props: { series }, // pass series object to page
  }));
}

// 🌟 3. Received from getStaticPaths()
const { series } = Astro.props;
---

<BaseLayout title={series.name}>

  <section class="mt-10 text-center">
    <h1 class="text-4xl font-bold text-gray-900">
      {series.name}
    </h1>
    <p class="text-gray-600 mt-2">Messages in this series</p>
  </section>

  <section class="grid gap-10 mt-12 sm:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto px-4">

    {series.messages.map((m) => (
      <a href={`/messages/watch/${m.id}`} class="group block">
        <div class="overflow-hidden rounded-2xl shadow-sm bg-white border">
          <img
            src={m.thumbnail}
            alt={m.title}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />
        </div>

        <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">
          {m.title}
        </h3>

        <p class="text-gray-500 text-sm">{m.preacher}</p>
      </a>
    ))}

  </section>

</BaseLayout>
