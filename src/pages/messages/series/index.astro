---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import messages from "../../../data/messages.json";

// Collect unique series
const seriesMap = {};

messages.forEach((m) => {
  if (!seriesMap[m.seriesSlug]) {
    seriesMap[m.seriesSlug] = {
      name: m.series,
      slug: m.seriesSlug,
      thumb: m.thumbnail,
      date: m.date
    };
  }
});

const seriesList = Object.values(seriesMap);

// Sort newest → oldest by date
seriesList.sort((a, b) => new Date(b.date) - new Date(a.date));
---

<BaseLayout title="Series">

  <!-- HEADER -->
  <section class="mt-10 text-center">
    <h1 class="text-4xl font-bold text-gray-900">Message Series</h1>
    <p class="text-gray-600 mt-2">Explore all teachings by series.</p>
  </section>

  <!-- SERIES GRID -->
  <section class="max-w-6xl mx-auto px-4 mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">

    {seriesList.map((s) => (
      <a
        href={`/messages/series/${s.slug}`}
        class="group block cursor-pointer"
      >
        <div class="overflow-hidden rounded-2xl shadow-sm bg-white border">
          <img
            src={s.thumb}
            alt={s.name}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />
        </div>

        <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">
          {s.name}
        </h3>

        <p class="text-gray-500 text-sm">
          {new Date(s.date).toLocaleDateString('en-ZA', {
            year: "numeric",
            month: "short"
          })}
        </p>
      </a>
    ))}

  </section>

</BaseLayout>
