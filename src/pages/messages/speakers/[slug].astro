---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import messages from "../../../data/messages.json";

/* ✔ Collect all unique speakers */
const speakerMap = {};
messages.forEach(m => {
  if (!speakerMap[m.preacherSlug]) {
    speakerMap[m.preacherSlug] = {
      slug: m.preacherSlug,
      name: m.preacher,
      thumb: m.thumbnail
    };
  }
});

/* ✔ Generate pages */
export async function getStaticPaths() {
  return Object.values(speakerMap).map((s) => ({
    params: { slug: s.slug },
    props: { speaker: s }
  }));
}

const { speaker } = Astro.props;

/* ✔ Messages by this speaker */
const speakerMessages = messages.filter(m => m.preacherSlug === speaker.slug);
---

<BaseLayout title={speaker.name}>

  <section class="max-w-6xl mx-auto px-4 pt-10">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-6">
      {speaker.name}
    </h1>

    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {speakerMessages.map((m) => (
        <a href={`/messages/watch/${m.id}`} class="group block">
          <div class="overflow-hidden rounded-2xl shadow-sm bg-white border">
            <img src={m.thumbnail} class="w-full h-48 object-cover group-hover:scale-105 transition" />
          </div>

          <h3 class="mt-3 font-semibold text-gray-800 group-hover:text-brand-red">{m.title}</h3>
          <p class="text-gray-500 text-sm">{m.preacher}</p>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>
