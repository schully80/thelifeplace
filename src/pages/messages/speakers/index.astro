---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import messages from "../../../data/messages.json";

// Build unique speaker list
const speakerMap = {};

messages.forEach((m) => {
  if (!speakerMap[m.preacherSlug]) {
    speakerMap[m.preacherSlug] = {
      name: m.preacher,
      slug: m.preacherSlug,
      thumb: m.thumbnail,
    };
  }
});

const speakers = Object.values(speakerMap);

// Sort A → Z
speakers.sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Speakers">

  <!-- HEADER -->
  <section class="mt-10 text-center">
    <h1 class="text-4xl font-bold text-gray-900">Speakers</h1>
    <p class="text-gray-600 mt-2">Teachings from our ministry team.</p>
  </section>

  <!-- GRID -->
  <section class="max-w-5xl mx-auto px-6 mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">

    {speakers.map((s) => (
      <a
        href={`/messages/speakers/${s.slug}`}
        class="group block text-center"
      >
        <div class="w-40 h-40 mx-auto rounded-full overflow-hidden border shadow-sm bg-gray-100">
          <img
            src={s.thumb}
            alt={s.name}
            class="w-full h-full object-cover group-hover:scale-105 transition"
          />
        </div>

        <h3 class="mt-4 font-semibold text-gray-800 group-hover:text-brand-red">
          {s.name}
        </h3>
      </a>
    ))}

  </section>

</BaseLayout>
