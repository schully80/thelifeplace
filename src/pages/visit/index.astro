---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FullBleed from "../../components/tlp/FullBleed.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";
import FormCard from "../../components/FormCard.astro";
import { site } from "../../../site.config.js";
import { getVisitLocation } from "../../content/shared-content.js";

const email = site?.contact?.email ?? "hello@thelifeplace.org";
const visitLocation = getVisitLocation();

// dev-only flag (Vite/ Astro)
const isDev = import.meta.env.MODE !== 'production';

---
<BaseLayout
  title="Plan a Visit — Come. See. Jesus. | The Life Place"
  description="The Life Place — Come. See. Jesus. Everything you need for your first Sunday: location in Craigavon AH, Sandton, service time (9:00–11:00), what to expect, parking, and how to connect."
>

{/* FULL-BLEED WRAPPER */}
<div class="w-full max-auto relative left-1/2 right-1/2 -mx-[50vw] overflow-visible">

  <!-- HERO SECTION — Clean, No Animations, No Flash -->
  <section 
    class="visit-hero relative flex h-[44svh] min-h-[320px] items-center justify-center sm:h-[38vh] md:h-[50vh] lg:h-[70vh]"
  >

    <!-- INSTANT BACKGROUND IMAGE (no fade, no opacity, no transition) -->
    <img 
      id="hero-image"
      src="/wide-strip5.jpg"
      alt="The Life Place Community Worship"
      class="absolute inset-0 w-full h-full object-cover object-center brightness-[0.55] rounded-none"
    />
    <!-- Soft overlay -->
    <div class="absolute inset-0 bg-black/20"></div>

    <!-- TEXT BLOCK (centered and stable) -->
    <div class="absolute left-1/2 top-1/2 w-full -translate-x-1/2 -translate-y-1/2 px-5 text-center sm:px-6 md:top-1/3 md:translate-y-0 md:text-right">
      
      <h3
        class="text-3xl font-extrabold text-white sm:text-4xl md:text-5xl lg:text-6xl
               leading-[1.12] md:leading-[1.2]
               tracking-normal
               max-w-4xl mx-auto drop-shadow-xl"
      >
        At the heart of everything we believe and do is<br />
        <span class="text-brand-red">Jesus</span> and His finished work.
      </h3>
    </div>

  </section>
</div>

<section class="container-x py-12 md:py-24">
  
  
  <!-- Heading block -->
  <section class="text-center max-w-6xl mx-auto space-y-4 md:space-y-6">
     <span class="font-black block">
     <h1 class="block text-5xl font-black leading-[0.95] tracking-normal sm:text-6xl md:text-7xl lg:text-8xl">
     VISIT US
    </h1>
    </span>

  </section>

  <!-- ===== SERVICE TIMES & LOCATION ===== -->
  <section class="w-full bg-white pt-14 pb-20 md:pt-32 md:pb-32">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
      
      <!-- Left: Service Info -->
      <div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-gray-800 mb-7 md:mb-8 opacity-0"
            data-animate="fade-up" data-delay="0">
          When & <span class="text-brand-red">Where</span>
        </h2>
        
        <div class="space-y-7 md:space-y-8">
          
          <!-- Sunday Service -->
          <div class="border-l-4 border-brand-red pl-4 opacity-0 sm:pl-6" data-animate="fade-up" data-delay="0">
            <h3 class="text-xl font-bold text-gray-800 mb-2 md:text-2xl">Sunday</h3>
            <p class="text-lg text-gray-600 mb-2 md:text-xl">
              <span class="font-semibold">9:00-11:00 AM</span>
            </p>
            <p class="text-gray-600">Join us for worship, prayer, and community every Sunday morning.</p>
          </div>

          <!-- Location -->
          <div class="border-l-4 border-brand-red pl-4 opacity-0 sm:pl-6" data-animate="fade-up" data-delay="100">
            <h3 class="text-xl font-bold text-gray-800 mb-2 md:text-2xl"><i class="fa-solid fa-location-dot text-brand-red mr-2"></i>Our Location</h3>
            <p class="text-lg text-gray-600 mb-2">The Life Place</p>
            <p class="text-gray-600 leading-relaxed">
              {visitLocation.addressLines.map((line) => <>{line}<br /></>)}
            </p>
          </div>

          <!-- Visitor Info -->
          <div class="border-l-4 border-brand-red pl-4 opacity-0 sm:pl-6" data-animate="fade-up" data-delay="200">
            <h3 class="text-xl font-bold text-gray-800 mb-2 md:text-2xl">First Time Visiting?</h3>
            <p class="text-gray-600 mb-4">
              We'd love to meet you! We believe in genuine community and a warm welcome for everyone.
            </p>
            <button
              id="planVisitBtn"
              type="button"
              aria-controls="planVisitForm"
              class="plan-button inline-flex min-h-12 w-full items-center justify-center gap-2 px-10 py-3 sm:w-auto sm:min-w-[260px] sm:px-8 sm:py-4 border-2 border-brand-red/40 hover:border-brand-red/60 bg-white text-gray-800 font-bold rounded-2xl shadow-md transition-[background-color,border-color,box-shadow,transform] duration-200 ease-out hover:bg-gray-50 hover:shadow-lg active:scale-[0.98]"
              onclick="window.scrollToPlanVisitForm && window.scrollToPlanVisitForm()"
            >
              Plan Your Visit
            </button>
            
            <!-- Map actions: Dropdown with popular GPS platforms (moved under Plan Your Visit) -->
            <div class="mt-4 relative block sm:inline-block">
              <button id="mapsDropdownBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="mapsDropdownMenu" class="plan-button inline-flex min-h-12 w-full items-center justify-center rounded-2xl border-2 border-brand-red/40 bg-white px-6 py-3 text-base font-bold text-gray-800 shadow-md transition-[background-color,border-color,box-shadow,transform] duration-200 ease-out hover:border-brand-red/60 hover:bg-gray-50 hover:shadow-lg active:scale-[0.98] sm:min-w-[260px] sm:px-8 sm:py-4">
                <span>Get Directions</span>
                <svg class="ml-2 h-4 w-4 transition-transform duration-200 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="mapsDropdownMenu" aria-labelledby="mapsDropdownBtn" class="absolute left-0 z-20 mt-2 min-w-[260px] max-w-[calc(100vw-3rem)] overflow-hidden rounded-2xl border border-black/10 bg-white opacity-0 shadow-xl transition-[max-height,opacity,transform] duration-200 ease-out invisible -translate-y-2 pointer-events-none" style="max-height:0px;">
                <a href={visitLocation.mapsQueryUrl} target="_blank" rel="noopener" class="flex min-h-12 items-center px-4 py-3 text-gray-800 transition-colors duration-150 hover:bg-gray-50" aria-label="Open in Google Maps">
                  <span>Google Maps</span>
                </a>
                <div class="mx-4 h-px bg-gray-200"></div>
                <a href={visitLocation.appleMapsUrl} target="_blank" rel="noopener" class="flex min-h-12 items-center px-4 py-3 text-gray-800 transition-colors duration-150 hover:bg-gray-50" aria-label="Open in Apple Maps">
                  <span>Apple Maps (iOS)</span>
                </a>
                <div class="mx-4 h-px bg-gray-200"></div>
                <a href={visitLocation.wazeUrl} target="_blank" rel="noopener" class="flex min-h-12 items-center px-4 py-3 text-gray-800 transition-colors duration-150 hover:bg-gray-50" aria-label="Open in Waze">
                  <span>Waze</span>
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right: Embedded Google Map -->
       <div class="relative h-72 overflow-hidden rounded-2xl border border-gray-200 shadow-2xl transform-gpu map-responsive sm:h-80 md:h-full md:rounded-3xl"
         data-animate="fade-up" data-delay="250" data-parallax="map">
        <iframe
          class="w-full h-full"
          src={visitLocation.mapsEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="The Life Place Location"
          allowfullscreen
        ></iframe>
      </div>

    </div>



    <!-- Registration Form -->
    <script is:inline>
      // Central cleanup registry for listeners/RAFs created on this page
      window.__tlp_cleanup = window.__tlp_cleanup || [];
      // Accessibility & reduced-motion flags
      const prefersReducedMotion = typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      (() => {
        const btn = document.getElementById('mapsDropdownBtn');
        const menu = document.getElementById('mapsDropdownMenu');
        const arrow = btn?.querySelector('svg');
        const mapEl = document.querySelector('.map-responsive');
        let dropdownScrollHandler = null;
        let dropdownKeyHandler = null;
        let dropdownFocusOutHandler = null;
        if (!btn || !menu) return;

        const isMobile = () => window.matchMedia('(max-width: 640px)').matches;

        const openMenu = () => {
          // Prepare for measurement and smooth expansion
          menu.classList.remove('invisible','opacity-0','-translate-y-2','pointer-events-none');
          menu.classList.add('visible','opacity-100','translate-y-0','pointer-events-auto','ease-out');
          // Set dynamic height for gentle roll-down
          const fullHeight = menu.scrollHeight;
          menu.style.maxHeight = fullHeight + 'px';
          btn.setAttribute('aria-expanded', 'true');
          arrow?.classList.add('rotate-180');
          // On mobile, nudge the map down so the dropdown has room
          if (isMobile() && mapEl) {
            // clear any transient transforms so the map jumps to its natural flow
            mapEl.style.transform = '';
            mapEl.classList.add('dropdown-open');
            // trigger a scroll event so the parallax handler recalculates immediately
            requestAnimationFrame(() => window.dispatchEvent(new Event('scroll')));
          }

          // Add a subtle entrance+parallax effect to the dropdown while it's open
          // Remove inline transforms first so CSS entrance can run, then attach a scroll handler
          menu.style.transform = '';
          // create parallax handler (small vertical movement based on viewport position)
          if (!prefersReducedMotion) {
            const doDropdownParallax = () => {
              if (!menu) return;
              const rect = menu.getBoundingClientRect();
              const windowH = window.innerHeight || 1;
              const progress = Math.max(0, Math.min(1, (windowH - rect.top) / (windowH + rect.height)));
              // very subtle range ~ -2px .. 2px for slowest feel
              const translate = (progress - 0.5) * -4;
              menu.style.transform = `translateY(${translate}px)`;
            };

            dropdownScrollHandler = () => { requestAnimationFrame(doDropdownParallax); };
            window.addEventListener('scroll', dropdownScrollHandler, { passive: true });
            window.addEventListener('resize', dropdownScrollHandler);
            // run once to position immediately
            dropdownScrollHandler();
          }

          // Accessibility: move focus to first focusable item inside the menu
          try {
            const first = menu.querySelector('a, button, [tabindex]:not([tabindex="-1"])');
            if (first && typeof first.focus === 'function') first.focus();

            // key handler for escape (close + return focus)
            dropdownKeyHandler = (ev) => {
              if (ev.key === 'Escape' || ev.key === 'Esc') {
                ev.preventDefault();
                closeMenu();
                try { btn.focus(); } catch (e) {}
              }
            };
            menu.addEventListener('keydown', dropdownKeyHandler);

            // focusout: if focus leaves the menu and isn't on the toggle, close it
            dropdownFocusOutHandler = (ev) => {
              setTimeout(() => {
                const active = document.activeElement;
                if (active !== btn && !menu.contains(active)) {
                  closeMenu();
                  try { btn.focus(); } catch (e) {}
                }
              }, 0);
            };
            menu.addEventListener('focusout', dropdownFocusOutHandler);
          } catch (err) {
            // fail gracefully if focus methods aren't available
            console.warn('Dropdown accessibility handlers failed', err);
          }
        };

        const closeMenu = () => {
          // Gentle roll-up and fade
          menu.classList.remove('opacity-100');
          menu.classList.add('opacity-0');
          menu.style.maxHeight = '0px';
          btn.setAttribute('aria-expanded', 'false');
          arrow?.classList.remove('rotate-180');
          if (mapEl) {
            mapEl.classList.remove('dropdown-open');
            // remove inline transform and let the parallax handler reapply the correct transform
            mapEl.style.transform = '';
            requestAnimationFrame(() => window.dispatchEvent(new Event('scroll')));
          }

          // teardown dropdown parallax handlers and clear inline transform
          if (dropdownScrollHandler) {
            window.removeEventListener('scroll', dropdownScrollHandler);
            window.removeEventListener('resize', dropdownScrollHandler);
            dropdownScrollHandler = null;
          }
          if (menu) {
            menu.style.transform = '';
          }
          // remove accessibility handlers
          try {
            if (dropdownKeyHandler) { menu.removeEventListener('keydown', dropdownKeyHandler); dropdownKeyHandler = null; }
            if (dropdownFocusOutHandler) { menu.removeEventListener('focusout', dropdownFocusOutHandler); dropdownFocusOutHandler = null; }
          } catch (err) {
            // ignore
          }
          // return focus to the toggle for keyboard users
          try { btn.focus({ preventScroll: true }); } catch (e) {}
        };

        const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

        // After height transition completes, hide from a11y and pointer events
        menu.addEventListener('transitionend', (e) => {
          if (e.propertyName === 'max-height' && !isOpen()) {
            menu.classList.add('invisible','-translate-y-2','pointer-events-none');
            menu.classList.remove('visible');
          }
        });

        const toggle = () => (isOpen() ? closeMenu() : openMenu());
        // store handlers so they can be removed during cleanup
        const btnClickHandler = (e) => { e.stopPropagation(); toggle(); };
        const docClickHandler = () => { if (isOpen()) closeMenu(); };
        const docKeydownHandler = (e) => { if (e.key === 'Escape') closeMenu(); };

        btn.addEventListener('click', btnClickHandler);
        document.addEventListener('click', docClickHandler);
        document.addEventListener('keydown', docKeydownHandler);

        // register cleanup for these handlers and any dropdown state
        window.__tlp_cleanup.push(() => {
          try { btn.removeEventListener('click', btnClickHandler); } catch (e) {}
          try { document.removeEventListener('click', docClickHandler); } catch (e) {}
          try { document.removeEventListener('keydown', docKeydownHandler); } catch (e) {}
          try { if (dropdownScrollHandler) { window.removeEventListener('scroll', dropdownScrollHandler); window.removeEventListener('resize', dropdownScrollHandler); dropdownScrollHandler = null; } } catch (e) {}
          try { if (dropdownKeyHandler) { menu.removeEventListener('keydown', dropdownKeyHandler); dropdownKeyHandler = null; } } catch (e) {}
          try { if (dropdownFocusOutHandler) { menu.removeEventListener('focusout', dropdownFocusOutHandler); dropdownFocusOutHandler = null; } } catch (e) {}
        });
      })();

      // Smooth scroll helper for Plan Your Visit button (animated + parallax)
      window.scrollToPlanVisitForm = function() {
        const el = document.getElementById('planVisitForm');
        if (!el) return;

        // detect sticky header
        const header = document.querySelector('header, .site-header, .sticky-header, [data-sticky]');
        const offset = header ? header.offsetHeight : 0;
        const padding = 20; // breathing room above the form

        const startY = window.pageYOffset;
        const targetY = Math.max(0, el.getBoundingClientRect().top + window.pageYOffset - offset - padding);
        const distance = targetY - startY;
        if (Math.abs(distance) < 4) {
          // already there
          el.setAttribute('tabindex', '-1');
          el.focus({ preventScroll: true });
          setTimeout(() => el.removeAttribute('tabindex'), 1000);
          return;
        }

        // If user prefers reduced motion, skip the animated scroll and parallax boost
        if (prefersReducedMotion) {
          window.scrollTo(0, targetY);
          el.setAttribute('tabindex', '-1');
          el.focus({ preventScroll: true });
          setTimeout(() => el.removeAttribute('tabindex'), 1000);
          return;
        }

        const duration = 850; // ms
        let startTime = null;
        const mapEl = document.querySelector('[data-parallax="map"]');

        // cubic easeInOut
        function easeInOutCubic(t) {
          return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }

        function step(ts) {
          if (!startTime) startTime = ts;
          const elapsed = ts - startTime;
          const progress = Math.min(1, elapsed / duration);
          const eased = easeInOutCubic(progress);

          window.scrollTo(0, Math.round(startY + distance * eased));

          // temporary parallax boost during the animated scroll (subtle, reduced intensity)
          if (!prefersReducedMotion && mapEl) {
            // animate extra translate between -6..6px based on eased progress
            const extra = (eased - 0.5) * -12; // reduced temporary boost for smoother motion
            mapEl.style.transform = `translateY(${extra}px)`;
          }

          if (elapsed < duration) {
            requestAnimationFrame(step);
          } else {
            // finalize
            window.scrollTo(0, targetY);
            if (el) {
              el.setAttribute('tabindex', '-1');
              el.focus({ preventScroll: true });
              setTimeout(() => el.removeAttribute('tabindex'), 1000);
            }
            // allow the regular onScroll parallax to resume
            if (mapEl) mapEl.style.transform = '';
          }
        }

        requestAnimationFrame(step);
      };

      // IntersectionObserver for reveal-on-scroll with staggered entrance
      (function() {
        const els = Array.from(document.querySelectorAll('[data-animate="fade-up"]'));
        if (!els.length || typeof IntersectionObserver === 'undefined') return;
        const io = new IntersectionObserver((entries, obs) => {
          // collect entries that became visible this tick
          const visible = entries.filter(en => en.isIntersecting).sort((a,b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (!visible.length) return;
          visible.forEach((entry, idx) => {
            const el = entry.target;
            const base = parseInt(el.getAttribute('data-delay') || '0', 10);
            const stagger = 80; // ms between items
            setTimeout(() => {
              el.classList.remove('opacity-0');
              el.classList.add('opacity-100','animate-fadeUp');
            }, base + idx * stagger);
            obs.unobserve(el);
          });
        }, { threshold: 0.12 });
        els.forEach(e => io.observe(e));
        // cleanup for IntersectionObserver
        window.__tlp_cleanup.push(() => {
          try { io.disconnect(); } catch (e) {}
        });
      })();

      // Smooth parallax for the map container (RAF-driven lerp for staggered, non-sudden motion)
      (function() {
        const mapEl = document.querySelector('[data-parallax="map"]');
        if (!mapEl) return;
        // Respect user reduced-motion preference: disable RAF parallax entirely
        if (prefersReducedMotion) {
          try { mapEl.style.transform = ''; } catch (e) {}
          return;
        }
        let target = 0;
        let current = 0;
        let rafId = null;

        function computeTarget() {
          const rect = mapEl.getBoundingClientRect();
          const windowH = window.innerHeight || 1;
          const progress = Math.max(0, Math.min(1, (windowH - rect.top) / (windowH + rect.height)));
            // reduced intensity for smooth feel (now very subtle)
            target = (progress - 0.5) * -6; // -3..3
        }

        function tick() {
          // lerp toward target (slower smoothing for very smooth motion)
          current += (target - current) * 0.06; // slower smoothing factor
          // round to sub-pixel for smoother GPU compositing
          mapEl.style.transform = `translateY(${current.toFixed(2)}px)`;
          rafId = requestAnimationFrame(tick);
        }

        // start
        computeTarget();
        tick();

        const onScrollResize = () => { computeTarget(); };
        window.addEventListener('scroll', onScrollResize, { passive: true });
        window.addEventListener('resize', onScrollResize);
        // register cleanup for parallax RAF and listeners
        window.__tlp_cleanup.push(() => {
          try { if (rafId) cancelAnimationFrame(rafId); } catch (e) {}
          try { window.removeEventListener('scroll', onScrollResize); } catch (e) {}
          try { window.removeEventListener('resize', onScrollResize); } catch (e) {}
          try { mapEl.style.transform = ''; } catch (e) {}
        });
      })();
      
        // Listen for prompt snippet inserts and apply to the Plan a Visit form if possible
        (function() {
          function tryInsertIntoForm(promptText) {
            const form = document.getElementById('planVisitForm');
            if (!form) return false;
            // prefer a textarea inside the form
            const ta = form.querySelector('textarea');
            if (ta) {
              ta.value = (ta.value ? ta.value + '\n\n' : '') + promptText;
              ta.focus();
              return true;
            }
            // fallback to text inputs
            const input = form.querySelector('input[type="text"], input:not([type])');
            if (input) {
              input.value = (input.value ? input.value + ' ' : '') + promptText;
              input.focus();
              return true;
            }
            return false;
          }

          const promptSnippetHandler = (e) => {
            try {
              const p = e.detail && e.detail.prompt ? e.detail.prompt : String(e.detail || '');
              const inserted = tryInsertIntoForm(p);
              if (!inserted) {
                // copy to clipboard as fallback and notify
                navigator.clipboard?.writeText(p).then(() => {
                  // small visual feedback
                  alert('Prompt copied to clipboard — paste into the form.');
                }).catch(() => {
                  console.log('Prompt:', p);
                  alert('Prompt ready in console.');
                });
              }
            } catch (err) {
              console.error('prompt insert handler error', err);
            }
          };
          window.addEventListener('promptSnippetInsert', promptSnippetHandler);
          // cleanup for prompt snippet handler
          window.__tlp_cleanup.push(() => {
            try { window.removeEventListener('promptSnippetInsert', promptSnippetHandler); } catch (e) {}
          });
          
          
        })();

      // Global cleanup runner: invoke registered cleanup functions on pagehide/unload
      function __tlp_runCleanup() {
        try {
          if (!window.__tlp_cleanup || !window.__tlp_cleanup.length) return;
          // call each cleanup function, swallowing errors
          for (const fn of window.__tlp_cleanup.splice(0)) {
            try { fn && fn(); } catch (err) {}
          }
        } catch (err) {
          // ignore
        }
      }
      window.addEventListener('pagehide', __tlp_runCleanup, { capture: true });
      window.addEventListener('beforeunload', __tlp_runCleanup, { capture: true });
      window.addEventListener('unload', __tlp_runCleanup, { capture: true });
    </script>
    
    <!-- Spacer between map/service block and form (increased to lower the form) -->
    <div class="h-16 md:h-28 lg:h-36"></div>
    
    <!-- Dev-only prompt snippet browser (hidden in production) -->

    <div class="mt-8 max-w-3xl mx-auto px-0 md:mt-16">
      <div id="planVisitForm" class="border border-black/5 shadow-lg shadow-black/5 bg-gray-50 rounded-2xl p-4 sm:p-6 md:p-10">
        <div class="my-8 md:my-10">
          <FormCard
            title="Plan a Visit"
            eventName="Plan a Visit"
            ctaText="Submit"
            showComingSoon={false}
            enableTurnstile={true}
            formAction="/api/register"
            successTitle="Thank you! We’ve received your visit details."
            successDescription="A confirmation email has been sent."
            duplicateTitle="You’ve already submitted this form."
            duplicateDescription="If you need to update your details, reply to your confirmation email or contact us."
          />
        </div>
      </div>
    </div>

  </div>
</section>

  <style is:inline>
    /* Landscape tweaks for small/tablet devices */
    @media (orientation: landscape) and (max-width: 1024px) {
      .visit-hero { height: 36vh !important; }
      .map-responsive { height: 48vw !important; }
      .plan-button { width: 100% !important; min-width: 0 !important; }
      /* Reduce large paddings in landscape to save vertical space */
      #planVisitForm { padding: 1rem !important; }
    }

    /* Ensure form wrapper contrasts on small screens */
    @media (max-width: 640px) {
      #planVisitForm { background-color: #f7fafc; } /* tailwind bg-gray-50 fallback */
      /* Increase spacing between the service controls and the map so the dropdown isn't blocked */
      /* Raised for iOS/Waze dropdown visibility when dropdown is open */
      .map-responsive.dropdown-open { margin-top: 9rem !important; }
      /* Ensure dropdown appears above transformed/map stacking contexts */
      #mapsDropdownMenu { z-index: 9999 !important; }
      /* Dropdown entrance animation + smooth transform transitions for parallax */
      #mapsDropdownMenu {
        transform: translateY(-8px);
        transition: transform 1000ms cubic-bezier(.2,.8,.2,1), opacity 600ms ease;
      }
      #mapsDropdownMenu.visible {
        transform: translateY(0);
      }

      /* Smooth transform transitions for the map parallax itself */
      .map-responsive {
        transition: transform 1000ms cubic-bezier(.2,.8,.2,1);
      }
    }

    /* Tablet-only: increase spacing when dropdown is open so menu isn't obscured by the form wrapper */
    @media (min-width: 641px) and (max-width: 1024px) {
      .map-responsive.dropdown-open { margin-top: 6rem !important; }
      /* also ensure dropdown sits above the form wrapper */
      #mapsDropdownMenu { z-index: 9999 !important; }
    }

    /* Respect prefers-reduced-motion: remove non-essential motion and transitions */
    @media (prefers-reduced-motion: reduce) {
      #mapsDropdownMenu,
      .map-responsive,
      .plan-button,
      .plan-button svg,
      #mapsDropdownMenu * {
        transition: none !important;
        animation: none !important;
      }
      /* ensure transforms are cleared for reduced-motion users */
