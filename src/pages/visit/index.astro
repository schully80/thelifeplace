---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FullBleed from "../components/tlp/FullBleed.astro";
import SectionWrapper from "../components/tlp/SectionWrapper.astro";
import HeroTitle from "../components/tlp/HeroTitle.astro";
import WarmBackground from "../components/tlp/WarmBackground.astro";
import FadeDivider from "../components/tlp/FadeDivider.astro";
import IconActionCard from "../components/tlp/IconActionCard.astro";
import RegisterForm from "../../components/RegisterForm.astro";
import { site } from "../../../site.config.js";

const email = site?.contact?.email ?? "hello@thelifeplace.org";
---

<BaseLayout title="Plan a Visit">
  <section class="container-x py-12 md:py-20">
    <!-- Heading -->
    <h1 class="text-3xl md:text-3xl font-semibold text-center">Plan a Visit</h1>

    <!-- Slogan -->
    <p class="mt-5 md:mt-6 text-lg sm:text-2xl text-center text-gray-700">
 <span class="Come. See. text-brand-red">Jesus</span>
    </p>

    <!-- Address -->
    <p class="mt-4 mb-6 md:mb-8 text-center text-lg md:text-2xl">
      1 Elm Avenue, Craigavon AH, 2191, Sandton
    </p>

    <!-- Email CTA -->
    <div class="text-center">
      <a class="btn btn-outline text-m md:text-xl" href={`mailto:${email}`}>
        email us: {email}
      </a>
    </div>

    <!-- Location Map -->
    <div class="mt-8 rounded-xl overflow-hidden shadow-lg">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3587.123456789!2d28.0123456!3d-26.0123456!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1e9576543210abcd%3A0xabcdef123456789!2sThe%20Life%20Place!5e0!3m2!1sen!2sza!4v1724234567890!5m2!1sen!2sza"
        width="100%"
        height="400"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </section>
</BaseLayout>
