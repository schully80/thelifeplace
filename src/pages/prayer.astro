---
import BaseLayout from "../layouts/BaseLayout.astro";
import FullBleed from "../components/tlp/FullBleed.astro";
import FadeDivider from "../components/tlp/FadeDivider.astro";
import Turnstile from "../components/ui/Turnstile.astro";

const turnstileOptional =
  import.meta.env.PRAYER_TURNSTILE_DISABLED === "true" ||
  (import.meta.env.DEV && import.meta.env.PRAYER_TURNSTILE_DISABLE_DEV === "true");
const prayerFormId = `prayer-form-${Math.random().toString(36).slice(2, 9)}`;
const prayerControllerConfig = JSON.stringify({
  root: `[data-tlp-form-root="${prayerFormId}"]`,
  successTitle: "Thank you. Your prayer request has been received.",
  successDescription: "Our prayer team will pray with care and discretion.",
  duplicateTitle: "A prayer request from this email is already active.",
  duplicateDescription: "Please wait 7 days before submitting another request, or contact us directly if it is urgent.",
  missingTurnstileTitle: "Please complete the verification challenge.",
  missingTurnstileDescription: "Then send your prayer request again.",
  turnstileOptional,
  turnstileFieldName: "cf-turnstile-response",
});
---

<BaseLayout title="Prayer Request">

<!-- Modern Hero Section (2025+) -->
<section class="relative w-full h-[40vh] md:h-[50vh] lg:h-[70vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-brand-red/10 via-white to-brand-red/5">
  <img
    src="/prayer.jpg"
    alt="Prayer Hero"
    class="absolute inset-0 w-full h-full object-cover object-center opacity-80 scale-105 blur-[2px] md:blur-2px transition-all duration-700"
    loading="eager"
    decoding="async"
  />
  <div class="relative z-10 max-w-3xl mx-auto px-6 py-16 md:py-24 text-center flex flex-col items-center justify-center">
    <!-- Heading w/ animated underline -->
  <h1 class="block text-4xl md:text-6xl lg:text-7xl text-center font-black text-white shadow-lg mb-12 tracking-tight">
  <span class="relative font-extrabold text-white premium-underline leading-relaxed">
    Jesus
  </span>
  prays for you. 
  <br />We pray for you.
</h1>
    <a href="#prayer-form" class="inline-block rounded-2xl bg-brand-red text-white text-md font-semibold px-6 py-4 shadow-lg hover:bg-brand-red/90 transition-all animate-fadeUp delay-200">
      Submit a Prayer Request
    </a>
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-white/0 pointer-events-none"></div>
</section>

<section class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-6" id="prayer-form">

      <div
        class="max-w-3xl mx-auto rounded-2xl border border-black/5 shadow-lg shadow-black/5 bg-gray-50 px-6 sm:px-10 md:px-14 py-12 md:py-14 space-y-10"
        data-tlp-form-root={prayerFormId}
      >
        <div class="text-center space-y-3">
          <p class="text-sm md:text-base font-semibold tracking-[0.08em] text-brand-red uppercase">Prayer Request</p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">Share how we can pray with you</h2>
          <p class="text-gray-600 text-base md:text-lg leading-relaxed">
            We'll keep your details private and only share with our prayer team.
          </p>
        </div>
<p class="text-sm text-gray-500 mt-3 mb-6">
  * Required fields
</p>

        <form
          action="/api/prayer"
          method="POST"
          class="space-y-8"
          data-turnstile-optional={turnstileOptional}
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="field">
              <input type="text" name="name" placeholder=" " required autocomplete="name" />
              <label>Name *</label>
              <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
            </div>

            <div class="field" data-validate="email">
              <input type="email" name="email" placeholder=" " required autocomplete="email" />
              <label>Email *</label>
              <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
              <p class="helper">We’ll send a confirmation to this email.</p>
              <p class="error-text">Valid email format</p>
            </div>
          </div>

          <div class="field" data-word-limit="75" style="position: relative;">
            <textarea name="request" rows="4" placeholder=" " required maxlength="800" style="padding-bottom: 40px;"></textarea>
            <label>Prayer Request (75 words max) *</label>
            <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
            <span
              class="word-count"
              data-word-count
              style="position: absolute; right: 14px; bottom: 12px; display: block; margin: 0; font-size: 12px; line-height: 1; text-align: right; background: rgba(255, 255, 255, 0.92); padding-left: 8px; pointer-events: none; z-index: 1;"
            >
              75 words remaining
            </span>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span class="checkbox"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
            <span class="consent-text">I consent to The Life Place using this information solely to respond to my request.</span>
          </label>

          <div class="space-y-6 pt-2">
            <div class="flex justify-center">
              <Turnstile />
            </div>

            <div class="text-center" data-tlp-action-area>
              <button
                type="submit"
                id="tlpSubmitBtn"
                class="inline-flex items-center justify-center gap-2 px-10 py-3 rounded-2xl bg-gradient-to-r from-brand-red to-red-600 text-white text-base md:text-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span class="btn-text">Submit</span>
                <svg class="spinner h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="2"></circle>
                  <path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
          </div>

          <div data-tlp-inline-message class="hidden mt-4"></div>
          

          {/* Honeypot field (hidden from users, bots will fill it) */}
          <input
            type="text"
            name="website"
            autocomplete="off"
            tabindex="-1"
            class="hidden"
            aria-hidden="true"
          />

          {/* Timestamp (anti-spam) */}
          <input type="hidden" name="tlp_start_time" id="tlp_start_time" />
        </form>
      </div>
    </div>
  </section>

  <script is:inline src="/scripts/tlp-form-controller.js"></script>
  <script is:inline data-controller-config={prayerControllerConfig}>
    (() => {
      const script = document.currentScript;
      const config = JSON.parse(script?.dataset.controllerConfig || "{}");

      const boot = () => {
        if (!window.TLPFormController) {
          window.setTimeout(boot, 50);
          return;
        }

        window.TLPFormController.init({
          ...config,
          beforeSubmit: ({ form, formData }) => {
            const requestText = (formData.get("request") || "").toString().trim();
            const words = requestText ? requestText.split(/\s+/).length : 0;
            if (words > 75) {
              return {
                ok: false,
                title: "Please keep your request within 75 words.",
                description: "Shorter requests help our team process and pray well.",
              };
            }

            const honeypot = form.querySelector("input[name='website']");
            const startField = form.querySelector("#tlp_start_time");
            const start = Number(startField?.value || 0);
            const now = Date.now();

            if (honeypot && honeypot.value.trim() !== "") {
              return {
                ok: false,
                title: "We couldn't verify your submission.",
                description: "Please refresh the page and try again.",
              };
            }

            if (!start || now - start < 1500) {
              return {
                ok: false,
                title: "Please wait a moment before submitting.",
                description: "Then send your prayer request again.",
              };
            }

            return true;
          },
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot, { once: true });
      } else {
        boot();
      }
    })();
  </script>


<!-- SUPER-SIZED QUICK ACTIONS -->
<section class="max-w-6xl mx-auto px-6 pt-10 pb-16 ">

 <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">

  <!-- PLAN A VISIT -->
  <a
    href="/visit/"
    class="rounded-3xl border border-gray-100 bg-white p-8 text-center shadow-md
           hover:shadow-lg hover:-translate-y-1 transition-all"
  >
    <i class="fa-solid fa-house text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Visit</span>
    <span class="text-gray-600 text-base font-medium">Always Welcome</span>
  </a>

  <!-- GIVE -->
  <a
    href="/give/"
    class="rounded-3xl border border-gray-100 bg-white p-8 text-center shadow-md
           hover:shadow-lg hover:-translate-y-1 transition-all"
  >
    <i class="fa-solid fa-hand-holding-heart text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Give</span>
    <span class="text-gray-600 text-base font-medium">Safe & Secure</span>
  </a>

  <!-- MESSAGES -->
  <a
    href="/live/"
    class="rounded-3xl border border-gray-100 bg-white p-8 text-center shadow-md
           hover:shadow-lg hover:-translate-y-1 transition-all"
  >
    <i class="fa-solid fa-tv text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Watch</span>
    <span class="text-gray-600 text-base font-medium">Watch our Live Services</span>
  </a>

</div>

</section>

  <!-- Final Invitation -->
<section class="py-24 md:py-32 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    
    <h2 class="text-4xl md:text-5xl font-black mb-6 text-gray-800">
      Come. See. <span class="text-brand-red">Jesus</span>
    </h2>

    <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
      Join us this Sunday.
    </p>

  </div>
</section>
</BaseLayout>

<!-- Spam Protection -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const startField = document.getElementById("tlp_start_time");
    if (startField) startField.value = Date.now();

    const requestField = document.querySelector('.field[data-word-limit]');
    const textarea = requestField?.querySelector('textarea[name="request"]');
    const counter = requestField?.querySelector('[data-word-count]');
    const limit = Number(requestField?.getAttribute('data-word-limit') || 75);

    if (!requestField || !textarea || !counter) return;

    const updateWordCount = () => {
      const text = textarea.value.trim();
      const words = text ? text.split(/\s+/).length : 0;
      const remaining = Math.max(0, limit - words);
      const overLimit = words > limit;

      counter.textContent = overLimit
        ? `${words - limit} words over`
        : `${remaining} words remaining`;
      counter.classList.toggle('is-over', overLimit);
    };

    textarea.addEventListener('input', updateWordCount);
    updateWordCount();
  });
</script>

<style>
  /* Animated gradient underline */
  .premium-underline { position: relative; display: inline-block; }
  .gradient-underline {
    position: absolute;
    left: 0; bottom: -4px; width: 100%; height: 3px;
    background: linear-gradient(90deg,
      rgba(179,40,45,0) 0%,
      rgba(179,40,45,1) 50%,
      rgba(179,40,45,0) 100%
    );
    background-size: 200% 100%;
    animation: gradientSlide 2.8s ease-in-out infinite;
    border-radius: 999px; opacity: 0.9;
  }
  @keyframes gradientSlide {
    0% { background-position: 200% 0; opacity: 0.6; }
    50% { background-position: 0% 0; opacity: 1; }
    100% { background-position: -200% 0; opacity: 0.6; }
  }

  /* Button sheen */
  .sheen::after {
    content: ""; position: absolute; top: 0; left: -120%;
    width: 80%; height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    animation: sheenMove 2.4s ease-in-out infinite;
    border-radius: inherit;
  }
  @keyframes sheenMove {
    0% { left: -120%; }
    50% { left: 120%; }
    100% { left: 120%; }
  }

  /* Fade transitions */
  .fade-out { opacity: 0; transform: translateY(-4px); }
  .fade-in { opacity: 1; transform: translateY(0); }

  #tlpSubmitBtn .spinner {
    display: none;
  }
  #tlpSubmitBtn[aria-busy="true"] .btn-text {
    display: none;
  }
  #tlpSubmitBtn[aria-busy="true"] .spinner {
    display: block;
  }

  /* Parallax scroll effect for form */
  .parallax-scroll {
    scroll-behavior: smooth;
  }

  /* Shared form styling (aligned with main form template) */
  .field {
    position: relative;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 1px solid #B3282D;
    border-radius: 0.85rem;
    padding: 14px 14px 12px;
    font-size: 15px;
    background: rgba(255,255,255,0.92);
    outline: none;
    transition: all .22s ease;
    font-family: inherit;
  }
  .field textarea { min-height: 140px; resize: vertical; }
  .field[data-word-limit] textarea {
    padding-bottom: 40px;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: #B3282D;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(179, 40, 45, 0.12);
  }
  .field label {
    position: absolute;
    left: 14px;
    top: 14px;
    font-size: 15px;
    color: #9ca3af;
    pointer-events: none;
    transition: all .2s ease;
    font-weight: 500;
    background: white;
    padding: 0 6px;
    border-radius: 10px;
  }
  .field .valid-icon {
    position: absolute;
    right: 14px;
    top: 16px;
    color: #B3282D;
    opacity: 0;
    transition: opacity .2s ease;
    font-size: 14px;
    pointer-events: none;
  }
  .field input:focus + label,
  .field textarea:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-26px) scale(0.88);
    font-size: 12px;
    color: #B3282D;
    font-weight: 700;
  }
  .field .helper {
    margin-top: 8px;
    font-size: 13px;
    color: #6b7280;
  }
  .field .word-count {
    position: absolute;
    right: 14px;
    bottom: 12px;
    display: block;
    font-size: 12px;
    color: #6b7280;
    text-align: right;
    line-height: 1;
    background: rgba(255, 255, 255, 0.92);
    padding-left: 8px;
    pointer-events: none;
    z-index: 1;
  }
  .field .word-count.is-over {
    color: #B3282D;
    font-weight: 600;
  }
  .error-text {
    font-size: 13px;
    color: #6b7280;
    margin-top: 6px;
    display: none;
    font-weight: 500;
  }
  .field.show-error .error-text {
    display: block;
  }
  .field.show-error input,
  .field.show-error textarea {
    border-color: #e5e7eb;
    background: #f9fafb;
    box-shadow: none;
  }
  .field.valid input,
  .field.valid textarea {
    border-color: #B3282D;
    box-shadow: 0 0 0 3px rgba(179, 40, 45, 0.14);
  }
  .field.valid label {
    color: #B3282D;
  }
  .field.valid .valid-icon {
    opacity: 1;
  }

  /* Consent checkbox */
  .consent {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: start;
    gap: 10px;
    font-size: 15px;
    color: #374151;
    line-height: 1.5;
    user-select: none;
  }
  .consent input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .checkbox {
    width: 22px;
    height: 22px;
    border-radius:6px;
    border: 1px solid #B3282D;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all .2s ease;
    box-shadow: 0 0 0 0 rgba(179,40,45,0);
  }
  .checkbox i {
    color: white;
    font-size: 13px;
    line-height: 1;
    opacity: 0;
    transition: opacity .2s ease;
  }
  .consent input:checked + .checkbox {
    background: #B3282D;
    box-shadow: 0 0 0 4px rgba(179,40,45,0.12);
  }
  .consent input:checked + .checkbox i {
    opacity: 1;
  }
  .consent .consent-text { grid-column: 3; }
  @media (max-width: 640px) {
    .consent { grid-template-columns: auto 1fr; }
    .consent .consent-text { grid-column: 2; }
  }
</style>
