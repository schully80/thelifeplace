---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroTitle from "../components/tlp/HeroTitle.astro";
import SectionWrapper from "../components/tlp/SectionWrapper.astro";
import FullBleed from "../components/tlp/FullBleed.astro";
import WarmBackground from "../components/tlp/WarmBackground.astro";
import FadeDivider from "../components/tlp/FadeDivider.astro";

const url = Astro.url;
const isDemoSuccess = url.searchParams.get("demo") === "success";

// Add your Formspree endpoint (e.g. https://formspree.io/f/abcd1234)
const FORMSPREE = import.meta.env.PUBLIC_FORMSPREE_PRAYER_ENDPOINT;
---

<BaseLayout title="Prayer Request">

  <!-- If in demo mode, show the Success Page instead of the form -->
  {isDemoSuccess && <SuccessPage />}

  {!isDemoSuccess && (
<section class="bg-white py-20 rounded-3xl">
    <div class="max-w-5xl mx-auto px-6">

  <!-- Heading w/ animated underline -->
  <h1 class="text-3xl text-center font-semibold text-gray-800 mb-2 tracking-tight">
  <span class="relative inline-block font-bold text-brand-red premium-underline">
    Jesus
    <span class="gradient-underline"></span>
  </span>
  prays for you. We pray for you
</h1>

      <p class="text-gray-600 text-md text-center mb-10 leading-relaxed">
        We'll keep your details private and only share with our prayer team.
      </p>

        <form
          action={FORMSPREE}
          method="POST"
          onsubmit="return window.tlpPrayerSubmit(event)"
          class="space-y-8"
        >
          <input type="hidden" name="_redirect" value="/prayer/success/" />

          <!-- Name -->
          <div class="relative validate-wrapper transition-all">
  <input
    type="text"
    name="name"
    required
    placeholder=" "
    data-validate
    class="peer block w-full px-5 py-4 rounded-full
           bg-white border border-brand-red/50 
           focus:ring-2 focus:ring-brand-red/40 focus:border-brand-red
           transition-all duration-300 outline-none
           invalid:border-red-400 invalid:ring-red-200"
  />

  <!-- Floating label -->
  <label
    class="absolute left-6 top-3 text-gray-500 bg-white px-1 rounded-full
           peer-focus:-top-2 peer-focus:text-xs peer-focus:text-brand-red
           peer-placeholder-shown:top-3 peer-placeholder-shown:text-base
           transition-all"
  >
    Name <span class="text-brand-red">*</span>

            <!-- CAPTCHA removed -->

  </label>

  <!-- Green Check -->
  <svg
    class="valid-check absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-green-500 opacity-0 transition-opacity duration-300"
    fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
  </svg>
</div>


<div class="relative validate-wrapper transition-all">
  <input
    type="email"
    name="email"
    required
    placeholder=" "
    data-validate
        class="peer block w-full px-5 py-4 rounded-full
          bg-white border border-brand-red/50 
          focus:ring-2 focus:ring-brand-red/40 focus:border-brand-red
          transition-all duration-300 outline-none
          invalid:border-red-400 invalid:ring-red-200"
  />

  <!-- Floating label -->
  <label
    class="absolute left-6 top-3 text-gray-500 bg-white px-1 rounded-full
           peer-focus:-top-2 peer-focus:text-xs peer-focus:text-brand-red
           peer-placeholder-shown:top-3 peer-placeholder-shown:text-base
           transition-all"
  >
    Email <span class="text-brand-red">*</span>
  </label>

  <!-- Helper text -->
  <p class="text-gray-500 text-sm mt-2 text-right">
    We’ll send a confirmation to this address.
  </p>

  <!-- Green Check -->
  <svg
    class="valid-check absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-green-500 opacity-0 transition-opacity duration-300"
    fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
  </svg>
</div>

          <!-- Request (rounded square) -->
<div class="relative">
  <textarea
    name="request"
    rows="4"
    required
    placeholder=" "
    maxlength="800"
    class="peer block w-full px-5 py-4 min-h-[140px]
           bg-white border border-brand-red/60 rounded-2xl 
           focus:ring-2 focus:ring-brand-red/40 focus:border-brand-red
           outline-none transition-all duration-300 resize-none"
  ></textarea>

  <label
    class="absolute left-6 top-3 text-gray-500 bg-white px-1 rounded-full
           peer-focus:-top-2 peer-focus:text-xs peer-focus:text-brand-red
           peer-placeholder-shown:top-3 peer-placeholder-shown:text-base
           transition-all"
  >
    Prayer Request (75 words max) <span class="text-brand-red">*</span>
  </label>
</div>

   <!-- Consent -->
<label class="flex items-start gap-3 text-gray-600 text-md leading-snug select-none">

  <span class="relative flex items-center justify-center">
    <input
      type="checkbox"
      name="consent"
      required
      class="
        peer h-5 w-5 appearance-none rounded-md bg-white 
        border-2 border-brand-red 
        transition-all duration-300
        cursor-pointer
        hover:border-brand-red/80
        focus:outline-none focus:ring-4 focus:ring-brand-red/30
      "
    />

    <!-- Custom Checkmark -->
    <svg
      class="absolute pointer-events-none w-4 h-4 text-brand-red 
             opacity-0 scale-75 transition-all duration-300 
             peer-checked:opacity-100 peer-checked:scale-100"
      fill="none" stroke="currentColor" stroke-width="3"
      stroke-linecap="round" stroke-linejoin="round"
      viewBox="0 0 24 24"
    >
      <path d="M5 13l4 4L19 7" />
    </svg>
  </span>

  I consent to The Life Place using this information solely to respond to my request.
</label>


           <!-- Apple-style CTA -->
            <button
          type="submit"
          id="tlpSubmitBtn"
          class="relative mx-auto px-20 py-2 rounded-full bg-brand-red text-white text-lg font-semibold
         shadow-sm flex items-center justify-center gap-2 group
         transition-all duration-300 ease-\[cubic-bezier(.25,.46,.45,.94)\];
         hover:scale-[1.03] active:scale-[0.98]
         hover:shadow-[0_0_15px_-3px_rgba(179,40,45,0.45)]
         overflow-hidden sheen"
>

  <span class="btn-text">Send</span>

  <!-- Send Icon -->
  <svg 
    class="btn-icon w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
    xmlns="http://www.w3.org/2000/svg"
    fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round"
    viewBox="0 0 24 24">
    <path d="M22 2 11 13" />
    <path d="M22 2 15 22 11 13 2 9 22 2z" />
  </svg>

  <!-- Spinner for sending -->
  <svg
    class="spinner hidden absolute w-6 h-6 animate-spin text-white"
    viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="10" stroke-opacity="0.3"></circle>
    <path d="M12 2a10 10 0 0 1 10 10" />
  </svg>

  <!-- Success check -->
  <svg
    class="success-check hidden absolute w-7 h-7 text-white"
    fill="none" stroke="currentColor" stroke-width="3"
    stroke-linecap="round" stroke-linejoin="round"
    viewBox="0 0 24 24">
    <path d="M5 13l4 4L19 7" />
  </svg>
</button>

  

<!-- INLINE GLASS APP DOWNLOAD CARD -->
<div
  class="mx-auto mt-16 max-w-md backdrop-blur-xl bg-white/20 border border-white/30
         shadow-2xl rounded-3xl p-8 text-center ring-1 ring-black/5 animate-floatSlow"
>
  <img 
    src="/expo-qr.png"
    alt="Download App QR"
    class="w-36 h-36 mx-auto mb-4 rounded-lg shadow-md"
  />

  <h3 class="text-2xl font-semibold text-gray-800 mb-2">
    Download Our App
  </h3>

  <p class="text-gray-600 text-sm leading-relaxed mb-5">
    Scan the QR code to open the app instantly in Expo Go.
  </p>

  <a
    href="https://expo.dev/"
    target="_blank"
    class="inline-flex items-center gap-2 rounded-full px-6 py-3
           bg-brand-red text-white font-semibold shadow-sm
           hover:bg-brand-red/90 hover:shadow-md active:scale-[0.97]
           transition-all"
  >
    Get Expo Go
    <svg 
      class="w-5 h-5"
      fill="none" stroke="currentColor" stroke-width="2"
      viewBox="0 0 24 24">
      <path d="M22 2 11 13" />
      <path d="M22 2 15 22 11 13 2 9 22 2z" />
    </svg>
  </a>
</div>

          <!-- Honeypot field (hidden from users, bots will fill it) -->
<input
  type="text"
  name="website"
  autocomplete="off"
  tabindex="-1"
  class="hidden"
  aria-hidden="true"
/>

<!-- Timestamp (anti-spam) -->
        <input type="hidden" name="tlp_start_time" id="tlp_start_time" />

     </form>
    </div>
  </section>
  )}
</BaseLayout>


  <!-- Word Limit verification -->
  <script>
    window.tlpPrayerSubmit = async (e) => {
      e.preventDefault();
      const form = e.target;
      const requestText = (new FormData(form).get("request") || "").toString().trim();
      const words = requestText ? requestText.split(/\s+/).length : 0;
      if (words > 75) {
        alert("Please keep your request within 75 words.");
        return false;
      }

      if (typeof window.tlpSpamCheck === 'function' && !window.tlpSpamCheck({ target: form })) {
        alert('Spam check failed.');
        return false;
      }

      // simplified submit flow: word limit + spam checks only
      try {
        form.submit();
      } catch (err) {
        console.error(err);
      }
      return false;
    };
  </script>

<!-- Spam Protection -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const startField = document.getElementById("tlp_start_time");
    startField.value = Date.now();
  });

  window.tlpSpamCheck = function (e) {
    const form = e.target;
    const honeypot = form.querySelector("input[name='website']");
    const start = parseInt(form.querySelector("#tlp_start_time").value);
    const now = Date.now();
    if (honeypot.value.trim() !== "") return false;
    if (now - start < 1500) return false;
    return true;
  };
</script>

<!-- Validation + Shake -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const fields = document.querySelectorAll("[data-validate]");
    fields.forEach((field) => {
      const wrapper = field.closest(".validate-wrapper");
      const check = wrapper.querySelector(".valid-check");

      field.addEventListener("input", () => {
        if (field.checkValidity()) {
          check.classList.remove("opacity-0");
          check.classList.add("opacity-100");
        } else {
          check.classList.remove("opacity-100");
          check.classList.add("opacity-0");
        }
      });
    });
  });
</script>

<!-- Apple CTA Button Animation -->
<script>
  let submitting = false;

  window.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("form");
    const btn = document.getElementById("tlpSubmitBtn");
    const text = btn.querySelector(".btn-text");
    const icon = btn.querySelector(".btn-icon");
    const spinner = btn.querySelector(".spinner");
    const check = btn.querySelector(".success-check");

    form.addEventListener("submit", () => {
      if (submitting) return;
      submitting = true;

      text.classList.add("fade-out");
      icon.classList.add("fade-out");

      setTimeout(() => {
        text.style.display = "none";
        icon.style.display = "none";
        spinner.classList.remove("hidden");
        spinner.classList.add("fade-in");
      }, 200);

      setTimeout(() => {
        spinner.classList.add("fade-out");
        setTimeout(() => {
          spinner.classList.add("hidden");
          check.classList.remove("hidden");
          check.classList.add("fade-in");
          btn.classList.add("bg-green-600");
        }, 250);
      }, 1000);
    });
  });
</script>

<style>
  /* Animated gradient underline */
  .premium-underline { position: relative; display: inline-block; }
  .gradient-underline {
    position: absolute;
    left: 0; bottom: -4px; width: 100%; height: 3px;
    background: linear-gradient(90deg,
      rgba(179,40,45,0) 0%,
      rgba(179,40,45,1) 50%,
      rgba(179,40,45,0) 100%
    );
    background-size: 200% 100%;
    animation: gradientSlide 2.8s ease-in-out infinite;
    border-radius: 999px; opacity: 0.9;
  }
  @keyframes gradientSlide {
    0% { background-position: 200% 0; opacity: 0.6; }
    50% { background-position: 0% 0; opacity: 1; }
    100% { background-position: -200% 0; opacity: 0.6; }
  }

  /* Button sheen */
  .sheen::after {
    content: ""; position: absolute; top: 0; left: -120%;
    width: 80%; height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    animation: sheenMove 2.4s ease-in-out infinite;
    border-radius: inherit;
  }
  @keyframes sheenMove {
    0% { left: -120%; }
    50% { left: 120%; }
    100% { left: 120%; }
  }

  /* Fade transitions */
  .fade-out { opacity: 0; transform: translateY(-4px); }
  .fade-in { opacity: 1; transform: translateY(0); }
</style>
