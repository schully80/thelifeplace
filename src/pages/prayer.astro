---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroTitle from "../components/tlp/HeroTitle.astro";
import SectionWrapper from "../components/tlp/SectionWrapper.astro";
import FullBleed from "../components/tlp/FullBleed.astro";
import WarmBackground from "../components/tlp/WarmBackground.astro";
import FadeDivider from "../components/tlp/FadeDivider.astro";
import Turnstile from "../components/ui/Turnstile.astro";

const url = Astro.url;
const isDemoSuccess = url.searchParams.get("demo") === "success";
const turnstileOptional =
  import.meta.env.PRAYER_TURNSTILE_DISABLED === "true" ||
  (import.meta.env.DEV && import.meta.env.PRAYER_TURNSTILE_DISABLE_DEV === "true");
---

<BaseLayout title="Prayer Request">

<!-- Modern Hero Section (2025+) -->
<section class="relative w-full h-[40vh] md:h-[50vh] lg:h-[70vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-brand-red/10 via-white to-brand-red/5">
  <img
    src="/prayer.jpg"
    alt="Prayer Hero"
    class="absolute inset-0 w-full h-full object-cover object-center opacity-80 scale-105 blur-[2px] md:blur-2px transition-all duration-700"
    loading="eager"
    decoding="async"
  />
  <div class="relative z-10 max-w-3xl mx-auto px-6 py-16 md:py-24 text-center flex flex-col items-center justify-center">
    <!-- Heading w/ animated underline -->
  <h1 class="block text-4xl md:text-6xl lg:text-7xl text-center font-black text-white shadow-lg mb-12 tracking-tight">
  <span class="relative font-extrabold text-white premium-underline leading-relaxed">
    Jesus
  </span>
  prays for you. 
  <br />We pray for you.
</h1>
    <a href="#prayer-form" class="inline-block rounded-2xl bg-brand-red text-white text-md font-semibold px-6 py-4 shadow-lg hover:bg-brand-red/90 transition-all animate-fadeUp delay-200">
      Submit a Prayer Request
    </a>
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-white/0 pointer-events-none"></div>
</section>

  <!-- If in demo mode, show the Success Page instead of the form -->
  {isDemoSuccess && <SuccessPage />}

  {!isDemoSuccess && (
<section class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-6" id="prayer-form">

      <div class="max-w-3xl mx-auto rounded-[28px] border border-black/5 shadow-lg shadow-black/5 bg-white/85 backdrop-blur-md px-6 sm:px-10 md:px-14 py-12 md:py-14 space-y-10">
        <div class="text-center space-y-3">
          <p class="text-sm md:text-base font-semibold tracking-[0.08em] text-brand-red uppercase">Prayer Request</p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">Share how we can pray with you</h2>
          <p class="text-gray-600 text-base md:text-lg leading-relaxed">
            We'll keep your details private and only share with our prayer team.
          </p>
        </div>

        <form
          action="/api/prayer"
          method="POST"
          onsubmit="return window.tlpPrayerSubmit(event)"
          class="space-y-8"
          data-turnstile-optional={turnstileOptional}
        >
          <input type="hidden" name="_redirect" value="/prayer/success/" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="field">
              <input type="text" name="name" placeholder=" " required autocomplete="name" />
              <label>Name *</label>
            </div>

            <div class="field">
              <input type="email" name="email" placeholder=" " required autocomplete="email" />
              <label>Email *</label>
              <p class="helper">We’ll send a confirmation to this address.</p>
            </div>
          </div>

          <div class="field">
            <textarea name="request" rows="4" placeholder=" " required maxlength="800"></textarea>
            <label>Prayer Request (75 words max) *</label>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span class="checkbox"></span>
            <span class="consent-text">I consent to The Life Place using this information solely to respond to my request.</span>
          </label>

          <div class="space-y-6 pt-2">
            <div class="flex justify-center">
              <Turnstile />
            </div>

            <div class="text-center">
              <button
                type="submit"
                id="tlpSubmitBtn"
                class="inline-flex items-center justify-center gap-2 px-10 py-3 rounded-2xl bg-gradient-to-r from-brand-red to-red-600 text-white text-base md:text-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span class="btn-text">Send</span>
                <svg class="btn-icon w-5 h-5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <path d="M22 2 11 13" />
                  <path d="M22 2 15 22 11 13 2 9 22 2z" />
                </svg>
                <svg class="spinner hidden w-5 h-5 animate-spin text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                  <path d="M12 2a10 10 0 0 1 10 10" />
                </svg>
                <svg class="success-check hidden w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" />
                </svg>
              </button>
            </div>
          </div>

          {/* Honeypot field (hidden from users, bots will fill it) */}
          <input
            type="text"
            name="website"
            autocomplete="off"
            tabindex="-1"
            class="hidden"
            aria-hidden="true"
          />

          {/* Timestamp (anti-spam) */}
          <input type="hidden" name="tlp_start_time" id="tlp_start_time" />
        </form>
      </div>
    </div>
  </section>
  )}

  <!-- Final Invitation -->
<section class="py-24 md:py-32 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    
    <h2 class="text-4xl md:text-5xl font-black mb-6 text-gray-800">
      Come. See. <span class="text-brand-red">Jesus</span>
    </h2>

    <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
      Join us this Sunday.
    </p>

  </div>
</section>
</BaseLayout>


  <!-- Word Limit verification -->
  <script>
    window.tlpPrayerSubmit = async (e) => {
      e.preventDefault();
      const form = e.target;
      const requestText = (new FormData(form).get("request") || "").toString().trim();
      const words = requestText ? requestText.split(/\s+/).length : 0;
      if (words > 75) {
        alert("Please keep your request within 75 words.");
        return false;
      }

      if (typeof window.tlpSpamCheck === 'function' && !window.tlpSpamCheck({ target: form })) {
        alert('Spam check failed.');
        return false;
      }

      // simplified submit flow: word limit + spam checks only
      try {
        form.submit();
      } catch (err) {
        console.error(err);
      }
      return false;
    };
  </script>

<!-- Spam Protection -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const startField = document.getElementById("tlp_start_time");
    startField.value = Date.now();
  });

  window.tlpSpamCheck = function (e) {
    const form = e.target;
    const honeypot = form.querySelector("input[name='website']");
    const start = parseInt(form.querySelector("#tlp_start_time").value);
    const now = Date.now();
    if (honeypot.value.trim() !== "") return false;
    if (now - start < 1500) return false;
    return true;
  };
</script>

<!-- Validation + Shake -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("#prayer-form form");
    if (!form) return;
    const btn = document.getElementById("tlpSubmitBtn");
    const text = btn?.querySelector(".btn-text");
    const icon = btn?.querySelector(".btn-icon");
    const spinner = btn?.querySelector(".spinner");
    const check = btn?.querySelector(".success-check");

    const turnstileOptional = form.dataset.turnstileOptional === "true";

    const hasToken = () => {
      if (turnstileOptional) return true;
      const el = form.querySelector('input[name="cf-turnstile-response"]');
      return !!(el && el.value && el.value.length > 0);
    };
    const setDisabled = (disabled) => {
      if (!btn) return;
      btn.disabled = disabled;
    };
    setDisabled(!hasToken());
    form.addEventListener("turnstile:verified", () => setDisabled(false));

    form.addEventListener("submit", () => {
      if (!hasToken()) {
        setDisabled(true);
        alert("Please complete the verification before submitting.");
        return;
      }
      if (btn && text && icon && spinner && check) {
        text.classList.add("fade-out");
        icon.classList.add("fade-out");
        setTimeout(() => {
          text.style.display = "none";
          icon.style.display = "none";
          spinner.classList.remove("hidden");
          spinner.classList.add("fade-in");
        }, 150);

        setTimeout(() => {
          spinner.classList.add("fade-out");
          setTimeout(() => {
            spinner.classList.add("hidden");
            check.classList.remove("hidden");
            check.classList.add("fade-in");
            btn.classList.add("bg-green-600");
          }, 220);
        }, 900);
      }
    });
  });
</script>

<!-- Apple CTA Button Animation -->
<script>
  let submitting = false;

  window.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("#prayer-form form");
    const btn = document.getElementById("tlpSubmitBtn");
    if (!form || !btn) return;

    const text = btn.querySelector(".btn-text");
    const icon = btn.querySelector(".btn-icon");
    const spinner = btn.querySelector(".spinner");
    const check = btn.querySelector(".success-check");

    form.addEventListener("submit", () => {
      if (submitting) return;
      submitting = true;

      text?.classList.add("fade-out");
      icon?.classList.add("fade-out");

      setTimeout(() => {
        if (text) text.style.display = "none";
        if (icon) icon.style.display = "none";
        spinner?.classList.remove("hidden");
        spinner?.classList.add("fade-in");
      }, 200);

      setTimeout(() => {
        spinner?.classList.add("fade-out");
        setTimeout(() => {
          spinner?.classList.add("hidden");
          check?.classList.remove("hidden");
          check?.classList.add("fade-in");
          btn.classList.add("bg-green-600");
        }, 250);
      }, 1000);
    });
  });
</script>

<style>
  /* Animated gradient underline */
  .premium-underline { position: relative; display: inline-block; }
  .gradient-underline {
    position: absolute;
    left: 0; bottom: -4px; width: 100%; height: 3px;
    background: linear-gradient(90deg,
      rgba(179,40,45,0) 0%,
      rgba(179,40,45,1) 50%,
      rgba(179,40,45,0) 100%
    );
    background-size: 200% 100%;
    animation: gradientSlide 2.8s ease-in-out infinite;
    border-radius: 999px; opacity: 0.9;
  }
  @keyframes gradientSlide {
    0% { background-position: 200% 0; opacity: 0.6; }
    50% { background-position: 0% 0; opacity: 1; }
    100% { background-position: -200% 0; opacity: 0.6; }
  }

  /* Button sheen */
  .sheen::after {
    content: ""; position: absolute; top: 0; left: -120%;
    width: 80%; height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    animation: sheenMove 2.4s ease-in-out infinite;
    border-radius: inherit;
  }
  @keyframes sheenMove {
    0% { left: -120%; }
    50% { left: 120%; }
    100% { left: 120%; }
  }

  /* Fade transitions */
  .fade-out { opacity: 0; transform: translateY(-4px); }
  .fade-in { opacity: 1; transform: translateY(0); }

  /* Parallax scroll effect for form */
  .parallax-scroll {
    scroll-behavior: smooth;
  }

  /* Shared form styling (aligned with main form template) */
  .field {
    position: relative;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 1.6px solid #e5e7eb;
    border-radius: 0.85rem;
    padding: 14px 14px 12px;
    font-size: 15px;
    background: rgba(255,255,255,0.92);
    outline: none;
    transition: all .22s ease;
    font-family: inherit;
  }
  .field textarea { min-height: 140px; resize: vertical; }
  .field input:focus,
  .field textarea:focus {
    border-color: #B3282D;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(179, 40, 45, 0.12);
  }
  .field label {
    position: absolute;
    left: 14px;
    top: 14px;
    font-size: 15px;
    color: #9ca3af;
    pointer-events: none;
    transition: all .2s ease;
    font-weight: 500;
    background: white;
    padding: 0 6px;
    border-radius: 10px;
  }
  .field input:focus + label,
  .field textarea:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-26px) scale(0.88);
    font-size: 12px;
    color: #B3282D;
    font-weight: 700;
  }
  .field .helper {
    margin-top: 8px;
    font-size: 13px;
    color: #6b7280;
  }

  /* Consent checkbox */
  .consent {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: start;
    gap: 10px;
    font-size: 15px;
    color: #374151;
    line-height: 1.5;
    user-select: none;
  }
  .consent input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .checkbox {
    width: 22px;
    height: 22px;
    border-radius: 8px;
    border: 2px solid #B3282D;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all .2s ease;
    box-shadow: 0 0 0 0 rgba(179,40,45,0);
  }
  .consent input:checked + .checkbox {
    background: #B3282D;
    box-shadow: 0 0 0 4px rgba(179,40,45,0.12);
  }
  .consent input:checked + .checkbox::after {
    content: "✓";
    color: white;
    font-size: 13px;
    font-weight: 800;
  }
  .consent .consent-text { grid-column: 3; }
  @media (max-width: 640px) {
    .consent { grid-template-columns: auto 1fr; }
    .consent .consent-text { grid-column: 2; }
  }
</style>
