---
import BaseLayout from "../layouts/BaseLayout.astro";
import FullBleed from "../components/tlp/FullBleed.astro";
import FadeDivider from "../components/tlp/FadeDivider.astro";
import Turnstile from "../components/ui/Turnstile.astro";

const turnstileOptional =
  import.meta.env.PRAYER_TURNSTILE_DISABLED === "true" ||
  (import.meta.env.DEV && import.meta.env.PRAYER_TURNSTILE_DISABLE_DEV === "true");
const prayerFormId = `prayer-form-${Math.random().toString(36).slice(2, 9)}`;
const prayerControllerConfig = JSON.stringify({
  root: `[data-tlp-form-root="${prayerFormId}"]`,
  successTitle: "Thank you. Your prayer request has been received.",
  successDescription: "Our prayer team will pray with care and discretion.",
  duplicateTitle: "A prayer request from this email is already active.",
  duplicateDescription: "Please wait 7 days before submitting another request, or contact us directly if it is urgent.",
  missingTurnstileTitle: "Please complete the verification challenge.",
  missingTurnstileDescription: "Then send your prayer request again.",
  turnstileOptional,
  turnstileFieldName: "cf-turnstile-response",
});
---

<BaseLayout title="Prayer Request">

<!-- Modern Hero Section (2025+) -->
<section class="relative flex min-h-[420px] w-full items-center justify-center overflow-hidden bg-gray-950 py-14 md:min-h-[520px] md:py-20 lg:min-h-[640px] lg:py-28">
  <img
    src="/prayer.jpg"
    alt="People gathered in prayer at The Life Place"
    class="absolute inset-0 h-full w-full scale-105 object-cover object-center opacity-80 blur-[1px]"
    loading="eager"
    decoding="async"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/25 to-black/45 pointer-events-none"></div>
  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-10 text-center sm:px-6 md:py-14">
    <!-- Heading w/ animated underline -->
  <h1 class="mb-8 block text-center text-4xl font-black leading-[1.04] tracking-normal text-white shadow-lg sm:text-5xl md:mb-10 md:text-6xl lg:text-7xl">
  <span class="relative font-extrabold premium-underline leading-tight">
    <span class="text-brand-red">Jesus</span>
  </span>
  prays for you. 
  <br />We pray for you.
</h1>
    <a href="#prayer-form" class="inline-flex min-h-12 w-full items-center justify-center rounded-2xl bg-brand-red px-6 py-3 text-base font-semibold text-white shadow-lg transition-[background-color,box-shadow,transform] duration-200 ease-out hover:bg-red-700 hover:shadow-xl active:scale-[0.98] sm:w-auto sm:px-8 sm:py-4 animate-fadeUp delay-200">
      Submit a Prayer Request
    </a>
  </div>
</section>

<section class="bg-white py-12 md:py-20 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6" id="prayer-form">

      <div
        class="mx-auto max-w-3xl rounded-2xl border border-black/5 bg-gray-50 px-4 py-8 shadow-lg shadow-black/5 sm:px-8 sm:py-10 md:px-12 md:py-12 lg:px-14 lg:py-14 space-y-8 md:space-y-10"
        data-tlp-form-root={prayerFormId}
      >
        <div class="text-center space-y-3">
          <p class="text-sm md:text-base font-semibold tracking-[0.08em] text-brand-red uppercase">Prayer Request</p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">Share how we can pray with you</h2>
          <p class="text-gray-600 text-base md:text-lg leading-relaxed">
            We'll keep your details private and only share with our prayer team.
          </p>
        </div>
<p class="mt-2 text-sm text-gray-500">
  * Required fields
</p>

        <form
          action="/api/prayer"
          method="POST"
          class="space-y-7 md:space-y-8"
          data-turnstile-optional={turnstileOptional}
        >
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div class="field">
              <input type="text" name="name" placeholder=" " required autocomplete="name" />
              <label>Name *</label>
              <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
            </div>

            <div class="field" data-validate="email">
              <input type="email" name="email" placeholder=" " required autocomplete="email" />
              <label>Email *</label>
              <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
              <p class="helper">We’ll send a confirmation to this email.</p>
              <p class="error-text">Valid email format</p>
            </div>
          </div>

          <div class="field" data-word-limit="75" style="position: relative;">
            <textarea name="request" rows="4" placeholder=" " required maxlength="800" style="padding-bottom: 40px;"></textarea>
            <label>Prayer Request (75 words max) *</label>
            <i class="valid-icon fa-solid fa-check" aria-hidden="true"></i>
            <span
              class="word-count"
              data-word-count
              style="position: absolute; right: 14px; bottom: 12px; display: block; margin: 0; font-size: 12px; line-height: 1; text-align: right; background: rgba(255, 255, 255, 0.92); padding-left: 8px; pointer-events: none; z-index: 1;"
            >
              75 words remaining
            </span>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span class="checkbox"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
            <span class="consent-text">I consent to The Life Place using this information solely to respond to my request.</span>
          </label>

          <div class="space-y-6 pt-1 md:pt-2">
            <div class="flex min-w-0 justify-center overflow-x-auto">
              <Turnstile />
            </div>

            <div class="text-center" data-tlp-action-area>
              <button
                type="submit"
                id="tlpSubmitBtn"
                class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-2xl bg-brand-red px-8 py-3 text-base font-semibold text-white shadow-lg transition-[background-color,box-shadow,transform,opacity] duration-200 ease-out hover:bg-red-700 hover:shadow-xl active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-brand-red sm:w-auto sm:min-w-[220px] md:text-lg"
              >
                <span class="btn-text">Submit</span>
                <svg class="spinner h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="2"></circle>
                  <path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
          </div>

          <div data-tlp-inline-message class="hidden mt-4"></div>
          

          {/* Honeypot field (hidden from users, bots will fill it) */}
          <input
            type="text"
            name="website"
            autocomplete="off"
            tabindex="-1"
            class="hidden"
            aria-hidden="true"
          />

          {/* Timestamp (anti-spam) */}
          <input type="hidden" name="tlp_start_time" id="tlp_start_time" />
        </form>
      </div>
    </div>
  </section>

  <script is:inline src="/scripts/tlp-form-controller.js"></script>
  <script is:inline data-controller-config={prayerControllerConfig}>
    (() => {
      const script = document.currentScript;
      const config = JSON.parse(script?.dataset.controllerConfig || "{}");

      const boot = () => {
        if (!window.TLPFormController) {
          window.setTimeout(boot, 50);
          return;
        }

        window.TLPFormController.init({
          ...config,
          beforeSubmit: ({ form, formData }) => {
            const requestText = (formData.get("request") || "").toString().trim();
            const words = requestText ? requestText.split(/\s+/).length : 0;
            if (words > 75) {
              return {
                ok: false,
                title: "Please keep your request within 75 words.",
                description: "Shorter requests help our team process and pray well.",
              };
            }

            const honeypot = form.querySelector("input[name='website']");
            const startField = form.querySelector("#tlp_start_time");
            const start = Number(startField?.value || 0);
            const now = Date.now();

            if (honeypot && honeypot.value.trim() !== "") {
              return {
                ok: false,
                title: "We couldn't verify your submission.",
                description: "Please refresh the page and try again.",
              };
            }

            if (!start || now - start < 1500) {
              return {
                ok: false,
                title: "Please wait a moment before submitting.",
                description: "Then send your prayer request again.",
              };
            }

            return true;
          },
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot, { once: true });
      } else {
        boot();
      }
    })();
  </script>


<!-- SUPER-SIZED QUICK ACTIONS -->
<section class="mx-auto max-w-6xl px-4 pt-4 pb-14 sm:px-6 md:pt-6 md:pb-20">

 <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 md:gap-6 lg:gap-8">

  <!-- PLAN A VISIT -->
  <a
    href="/visit/"
    class="flex min-h-44 flex-col items-center justify-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-[border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-1 hover:border-red-200 hover:shadow-lg active:scale-[0.99] md:rounded-3xl md:p-8"
  >
    <i class="fa-solid fa-house text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Visit</span>
    <span class="text-gray-600 text-base font-medium">Always Welcome</span>
  </a>

  <!-- GIVE -->
  <a
    href="/give/"
    class="flex min-h-44 flex-col items-center justify-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-[border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-1 hover:border-red-200 hover:shadow-lg active:scale-[0.99] md:rounded-3xl md:p-8"
  >
    <i class="fa-solid fa-hand-holding-heart text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Give</span>
    <span class="text-gray-600 text-base font-medium">Safe & Secure</span>
  </a>

  <!-- MESSAGES -->
  <a
    href="/live/"
    class="flex min-h-44 flex-col items-center justify-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-[border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-1 hover:border-red-200 hover:shadow-lg active:scale-[0.99] md:rounded-3xl md:p-8"
  >
    <i class="fa-solid fa-tv text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Watch</span>
    <span class="text-gray-600 text-base font-medium">Watch our Live Services</span>
  </a>

</div>

</section>

  <!-- Final Invitation -->
<section class="bg-white py-14 md:py-24 lg:py-28">
  <div class="max-w-4xl mx-auto px-4 text-center sm:px-6">
    
    <h2 class="mb-5 text-3xl font-black text-gray-800 sm:text-4xl md:mb-6 md:text-5xl">
      Come. See. <span class="text-brand-red">Jesus</span>
    </h2>

    <p class="mx-auto mb-8 max-w-2xl text-lg text-gray-600 md:mb-12 md:text-xl">
      Join us this Sunday.
    </p>

  </div>
</section>
</BaseLayout>

<!-- Spam Protection -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const startField = document.getElementById("tlp_start_time");
    if (startField instanceof HTMLInputElement) startField.value = String(Date.now());

    const requestField = document.querySelector('.field[data-word-limit]');
    const textarea = requestField?.querySelector('textarea[name="request"]');
    const counter = requestField?.querySelector('[data-word-count]');
    const limit = Number(requestField?.getAttribute('data-word-limit') || 75);

    if (!(requestField instanceof HTMLElement) || !(textarea instanceof HTMLTextAreaElement) || !(counter instanceof HTMLElement)) return;

    const updateWordCount = () => {
      const text = textarea.value.trim();
      const words = text ? text.split(/\s+/).length : 0;
      const remaining = Math.max(0, limit - words);
      const overLimit = words > limit;

      counter.textContent = overLimit
        ? `${words - limit} words over`
        : `${remaining} words remaining`;
      counter.classList.toggle('is-over', overLimit);
    };

    textarea.addEventListener('input', updateWordCount);
    updateWordCount();
  });
</script>

<style>
  .premium-underline { position: relative; display: inline-block; }

  /* Fade transitions */
  .fade-out { opacity: 0; transform: translateY(-4px); }
  .fade-in { opacity: 1; transform: translateY(0); }

  #tlpSubmitBtn .spinner {
    display: none;
  }
  #tlpSubmitBtn[aria-busy="true"] .btn-text {
    display: none;
  }
  #tlpSubmitBtn[aria-busy="true"] .spinner {
    display: block;
  }

  /* Parallax scroll effect for form */
  .parallax-scroll {
    scroll-behavior: smooth;
  }

  /* Shared form styling (aligned with main form template) */
  .field {
    position: relative;
  }
	  .field input,
	  .field textarea {
	    width: 100%;
	    border: 1px solid #B3282D;
	    border-radius: 0.85rem;
	    padding: 15px 14px 13px;
	    min-height: 52px;
	    font-size: 16px;
	    background: rgba(255,255,255,0.92);
	    outline: none;
	    transition: border-color 180ms ease-out, background-color 180ms ease-out, box-shadow 180ms ease-out;
	    font-family: inherit;
	  }
	  .field textarea { min-height: 160px; resize: vertical; line-height: 1.6; }
  .field[data-word-limit] textarea {
    padding-bottom: 40px;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: #B3282D;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(179, 40, 45, 0.12);
  }
  .field label {
    position: absolute;
    left: 14px;
	    top: 14px;
	    font-size: 15px;
	    color: #9ca3af;
	    pointer-events: none;
	    transition: color 180ms ease-out, transform 180ms ease-out, font-size 180ms ease-out;
	    font-weight: 500;
    background: white;
    padding: 0 6px;
    border-radius: 10px;
  }
  .field .valid-icon {
    position: absolute;
    right: 14px;
    top: 16px;
    color: #B3282D;
    opacity: 0;
	    transition: opacity 150ms ease-out;
    font-size: 14px;
    pointer-events: none;
  }
  .field input:focus + label,
  .field textarea:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-26px) scale(0.88);
    font-size: 12px;
    color: #B3282D;
    font-weight: 700;
  }
  .field .helper {
    margin-top: 8px;
    font-size: 13px;
    color: #6b7280;
  }
  .field .word-count {
    position: absolute;
    right: 14px;
    bottom: 12px;
    display: block;
    font-size: 12px;
    color: #6b7280;
    text-align: right;
    line-height: 1;
    background: rgba(255, 255, 255, 0.92);
    padding-left: 8px;
    pointer-events: none;
    z-index: 1;
  }
  .field .word-count.is-over {
    color: #B3282D;
    font-weight: 600;
  }
  .error-text {
    font-size: 13px;
    color: #6b7280;
    margin-top: 6px;
    display: none;
    font-weight: 500;
  }
  .field.show-error .error-text {
    display: block;
  }
  .field.show-error input,
  .field.show-error textarea {
    border-color: #e5e7eb;
    background: #f9fafb;
    box-shadow: none;
  }
  .field.valid input,
  .field.valid textarea {
    border-color: #B3282D;
    box-shadow: 0 0 0 3px rgba(179, 40, 45, 0.14);
  }
  .field.valid label {
    color: #B3282D;
  }
  .field.valid .valid-icon {
    opacity: 1;
  }

  /* Consent checkbox */
	  .consent {
	    display: grid;
	    grid-template-columns: auto auto 1fr;
	    align-items: start;
	    gap: 12px;
	    min-height: 44px;
	    font-size: 15px;
    color: #374151;
	    line-height: 1.5;
	    user-select: none;
	    cursor: pointer;
	  }
  .consent input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
	  .checkbox {
	    width: 24px;
	    height: 24px;
	    border-radius:6px;
	    border: 1px solid #B3282D;
    display: inline-flex;
    align-items: center;
    justify-content: center;
	    transition: background-color 160ms ease-out, box-shadow 160ms ease-out, transform 160ms ease-out;
	    box-shadow: 0 0 0 0 rgba(179,40,45,0);
	  }
  .checkbox i {
    color: white;
    font-size: 13px;
    line-height: 1;
    opacity: 0;
	    transition: opacity 150ms ease-out;
	  }
	  .consent:active .checkbox {
	    transform: scale(0.94);
	  }
	  .consent input:focus-visible + .checkbox {
	    box-shadow: 0 0 0 4px rgba(179,40,45,0.16);
	  }
  .consent input:checked + .checkbox {
    background: #B3282D;
    box-shadow: 0 0 0 4px rgba(179,40,45,0.12);
  }
  .consent input:checked + .checkbox i {
    opacity: 1;
  }
  .consent .consent-text { grid-column: 3; }
	  @media (max-width: 640px) {
	    .consent { grid-template-columns: auto 1fr; }
	    .consent .consent-text { grid-column: 2; }
	  }
</style>
