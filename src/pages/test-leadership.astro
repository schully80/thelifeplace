---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Leadership - Test">

<!-- ===== DRAMATIC HERO SECTION ===== -->
<section class="w-full min-h-screen md:min-h-[90vh] relative overflow-hidden bg-gradient-to-br from-slate-950 via-black to-slate-900 flex items-center justify-center">
  
  <!-- Animated background elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-full h-full bg-gradient-to-bl from-brand-red/15 via-transparent to-transparent"></div>
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-red/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/3 w-64 h-64 bg-brand-red/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 z-10">
    
    <div class="grid md:grid-cols-2 gap-16 items-center">
      
      <!-- Left: Image -->
      <div class="opacity-0 animate-fadeUp delay-100 order-2 md:order-1">
        <div class="relative w-full h-[400px] md:h-[500px] lg:h-[600px] rounded-3xl overflow-hidden shadow-2xl">
          <div class="absolute inset-0 bg-black/20 z-10 pointer-events-none"></div>
          <img 
            src="/founders-grayscale.jpg"
            alt="Schulter & Genevieve Etyang"
            class="w-full h-full object-cover object-center"
          />
        </div>
      </div>

      <!-- Right: Content -->
      <div class="opacity-0 animate-fadeUp delay-200 order-1 md:order-2">
        
        <!-- Label -->
        <div class="mb-8">
          <span class="inline-block px-4 py-2 rounded-full bg-gradient-to-r from-brand-red/20 to-red-600/10 border border-brand-red/40 text-sm md:text-base text-brand-red font-bold uppercase tracking-widest backdrop-blur-sm">
            Our Visionary Leaders
          </span>
        </div>

        <!-- Main heading -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight text-white mb-8">
          Schulter &
          <span class="block bg-gradient-to-r from-brand-red via-red-500 to-brand-red bg-clip-text text-transparent mt-3">
            Genevieve
          </span>
        </h1>

        <!-- Body content -->
        <div class="space-y-6 text-lg md:text-xl text-gray-300/90 leading-relaxed">
          
          <p>
            Schulter and Genevieve Etyang lead <span class="text-brand-red font-semibold">The Life Place</span> with a shared passion for Jesus and His kingdom.
          </p>

          <p>
            Fifteen years ago, the good news of who Jesus is became real to them. Since then, their lives have been shaped by one simple invitation:
          </p>

          <p class="text-xl md:text-2xl font-black text-yellow-200">
            "Come. See. Jesus."
          </p>

          <p>
            It remains the heartbeat of their lives, conversations, and the community they serve. They care deeply about people discovering how true, good, beautiful, and kind Jesus is.
          </p>

          <div class="pt-4 border-t border-white/20">
            <p class="text-xl md:text-2xl font-black text-white">
              Seeing Jesus changes everything.
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<!-- ===== VISION & MISSION SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-white relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="mb-20 text-center opacity-0 animate-fadeUp delay-100">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-800 mb-4">
        Their <span class="text-brand-red">Vision</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Leading with purpose and passion toward a thriving community in Christ</p>
    </div>

    <!-- Vision Grid -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      
      <!-- Vision Item 1 -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-blue-50 to-white border border-blue-200/50 opacity-0 animate-fadeUp delay-200 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl md:text-6xl font-black text-blue-600/20 mb-6">🙏</div>
        <h3 class="text-2xl md:text-3xl font-black text-gray-800 mb-4 group-hover:text-brand-red transition-colors">
          Gospel-Centered
        </h3>
        <p class="text-base md:text-lg text-gray-600 leading-relaxed">
          Everything they do centers on Jesus Christ and His redemptive work, allowing His grace to transform hearts and communities.
        </p>
      </div>

      <!-- Vision Item 2 -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-red-50 to-white border border-red-200/50 opacity-0 animate-fadeUp delay-300 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl md:text-6xl font-black text-red-600/20 mb-6">🌍</div>
        <h3 class="text-2xl md:text-3xl font-black text-gray-800 mb-4 group-hover:text-brand-red transition-colors">
          Community-Focused
        </h3>
        <p class="text-base md:text-lg text-gray-600 leading-relaxed">
          They are committed to building a diverse, welcoming community where every person feels valued and can encounter Jesus authentically.
        </p>
      </div>

      <!-- Vision Item 3 -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-purple-50 to-white border border-purple-200/50 opacity-0 animate-fadeUp delay-400 hover:shadow-2xl hover:border-brand-red hover:scale-105 transition-all duration-300">
        <div class="text-5xl md:text-6xl font-black text-purple-600/20 mb-6">💪</div>
        <h3 class="text-2xl md:text-3xl font-black text-gray-800 mb-4 group-hover:text-brand-red transition-colors">
          Empowering Leaders
        </h3>
        <p class="text-base md:text-lg text-gray-600 leading-relaxed">
          They invest in raising up servant leaders who are passionate about seeing Jesus transform their neighborhoods and the world.
        </p>
      </div>

    </div>

  </div>

</section>

<!-- ===== CONNECT & SUPPORT SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="mb-20 text-center opacity-0 animate-fadeUp delay-100">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-800 mb-4">
        Connect • Partner • Subscribe
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Stay connected with Schulter's writing and support The Life Place ministry</p>
    </div>

    <!-- Connection Cards Grid -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      
      <!-- Substack Card -->
      <a href="https://schulteretyang.substack.com" target="_blank" class="group p-8 md:p-10 rounded-3xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-2xl transition-all duration-300">
        <div class="opacity-0 animate-fadeUp delay-200">
          <div class="flex items-center justify-center h-32 md:h-40 mb-6 rounded-2xl bg-gradient-to-br from-orange-100 to-amber-100 border border-orange-200">
            <div class="text-5xl">📬</div>
          </div>
          
          <h3 class="text-2xl md:text-3xl font-black text-gray-800 mb-3 group-hover:text-brand-red transition-colors text-center">
            Subscribe to Schulter's Substack
          </h3>
          
          <p class="text-base text-gray-600 leading-relaxed mb-6 text-center">
            Receive regular articles and reflections exploring Jesus, the gospel of grace, the new covenant, and their meaning for everyday life.
          </p>

          <div class="flex justify-center">
            <span class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-brand-red to-red-600 text-white font-bold rounded-full group-hover:shadow-lg transition-all">
              Read & Subscribe <span>→</span>
            </span>
          </div>
        </div>
      </a>

      <!-- SnapScan Card -->
      <a href="https://pos.snapscan.io/qr/VISFNLkM" target="_blank" class="group p-8 md:p-10 rounded-3xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-2xl transition-all duration-300">
        <div class="opacity-0 animate-fadeUp delay-300">
          <div class="flex items-center justify-center h-32 md:h-40 mb-6 rounded-2xl bg-gradient-to-br from-green-100 to-emerald-100 border border-green-200">
            <div class="text-5xl">💳</div>
          </div>
          
          <h3 class="text-2xl md:text-3xl font-black text-gray-800 mb-3 group-hover:text-brand-red transition-colors text-center">
            Partner via SnapScan
          </h3>
          
          <p class="text-base text-gray-600 leading-relaxed mb-6 text-center">
            Scan the QR code or tap to open our giving portal. Your generosity fuels the ministry of The Life Place in our community.
          </p>

          <div class="flex justify-center">
            <span class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-brand-red to-red-600 text-white font-bold rounded-full group-hover:shadow-lg transition-all">
              Give Now <span>→</span>
            </span>
          </div>
        </div>
      </a>

      <!-- PayPal Card -->
      <a href="https://www.paypal.com/paypalme/thelifeplace" target="_blank" class="group p-8 md:p-10 rounded-3xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-2xl transition-all duration-300">
        <div class="opacity-0 animate-fadeUp delay-400">
          <div class="flex items-center justify-center h-32 md:h-40 mb-6 rounded-2xl bg-gradient-to-br from-blue-100 to-cyan-100 border border-blue-200">
            <div class="text-5xl">💰</div>
          </div>
          
          <h3 class="text-2xl md:text-3xl font-black text-gray-800 mb-3 group-hover:text-brand-red transition-colors text-center">
            Support via PayPal
          </h3>
          
          <p class="text-base text-gray-600 leading-relaxed mb-6 text-center">
            Donate securely through PayPal. Every gift helps us continue our mission of pointing people to Jesus.
          </p>

          <div class="flex justify-center">
            <span class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-brand-red to-red-600 text-white font-bold rounded-full group-hover:shadow-lg transition-all">
              Donate <span>→</span>
            </span>
          </div>
        </div>
      </a>

    </div>

  </div>

</section>

<!-- ===== LEADERSHIP IMPACT SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-br from-slate-900 via-black to-slate-900 relative overflow-hidden">
  
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-red/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6">
    
    <div class="mb-16 text-center opacity-0 animate-fadeUp delay-100">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-4">
        Their <span class="text-brand-red">Leadership</span> Marks
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">Key commitments that define their approach to ministry</p>
    </div>

    <!-- Leadership Marks Grid -->
    <div class="grid md:grid-cols-2 gap-8 lg:gap-10">
      
      <!-- Mark 1 -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-brand-red/20 to-red-600/10 border border-brand-red/40 opacity-0 animate-fadeUp delay-200 hover:from-brand-red/30 hover:to-red-600/20 hover:shadow-2xl hover:shadow-brand-red/20 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="text-5xl">✝️</div>
          <h3 class="text-2xl md:text-3xl font-black text-white">Christ-Exalting</h3>
        </div>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          Every message, decision, and initiative elevates Jesus Christ as Lord and Saviour. They lead with humility, recognizing that transformation comes through Him alone.
        </p>
      </div>

      <!-- Mark 2 -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-blue-500/20 to-blue-600/10 border border-blue-500/40 opacity-0 animate-fadeUp delay-300 hover:from-blue-500/30 hover:to-blue-600/20 hover:shadow-2xl hover:shadow-blue-500/20 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="text-5xl">🤝</div>
          <h3 class="text-2xl md:text-3xl font-black text-white">Servant-Hearted</h3>
        </div>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          They lead not from a position of authority, but from a heart of service. They are present with their people, listening deeply and walking alongside them.
        </p>
      </div>

      <!-- Mark 3 -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-purple-500/20 to-purple-600/10 border border-purple-500/40 opacity-0 animate-fadeUp delay-400 hover:from-purple-500/30 hover:to-purple-600/20 hover:shadow-2xl hover:shadow-purple-500/20 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="text-5xl">📖</div>
          <h3 class="text-2xl md:text-3xl font-black text-white">Scripture-Centered</h3>
        </div>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          They are committed to teaching God's Word faithfully and relevantly, helping people encounter Jesus through the Scriptures in transformative ways.
        </p>
      </div>

      <!-- Mark 4 -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-green-500/20 to-green-600/10 border border-green-500/40 opacity-0 animate-fadeUp delay-500 hover:from-green-500/30 hover:to-green-600/20 hover:shadow-2xl hover:shadow-green-500/20 transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="text-5xl">🌈</div>
          <h3 class="text-2xl md:text-3xl font-black text-white">Inclusive Leaders</h3>
        </div>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed">
          They champion a community where every person—regardless of background, culture, or story—feels welcomed and valued as part of God's family.
        </p>
      </div>

    </div>

  </div>

</section>

<!-- ===== CLOSING REFLECTION ===== -->
<section class="w-full py-20 md:py-28 bg-white">
  
  <div class="relative max-w-4xl mx-auto px-6 text-center">
    
    <blockquote class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-800 leading-tight opacity-0 animate-fadeUp delay-100 mb-8">
      "Our prayer is that through The Life Place, countless people will discover how
      <span class="block bg-gradient-to-r from-brand-red to-red-600 bg-clip-text text-transparent mt-4">
        true, good, beautiful and kind Jesus is.
      </span>
      That's what moves us every single day."
    </blockquote>
    
    <p class="text-lg text-gray-600 opacity-0 animate-fadeUp delay-200 font-medium">
      — Schulter & Genevieve Etyang
    </p>

  </div>

</section>

<!-- ===== FINAL CTA ===== -->
<section class="w-full py-24 md:py-32 bg-gradient-to-r from-brand-red/95 via-red-600/90 to-brand-red/95 relative overflow-hidden">
  
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/15 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-black/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 text-center">
    
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-8 opacity-0 animate-fadeUp delay-100">
      Join Us in Experiencing
      <span class="block">the Jesus They Know</span>
    </h2>

    <p class="text-lg md:text-xl text-white/95 max-w-2xl mx-auto mb-12 opacity-0 animate-fadeUp delay-200">
      Come experience worship, community, and transformation in Christ.
    </p>

    <div class="flex flex-col md:flex-row gap-6 justify-center opacity-0 animate-fadeUp delay-300">
      
      <a href="/visit" class="inline-block px-8 py-4 bg-white hover:bg-gray-100 text-brand-red font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
        Plan Your Visit
      </a>

      <a href="/" class="inline-block px-8 py-4 bg-gradient-to-r from-white/20 to-white/10 hover:from-white/30 hover:to-white/20 text-white font-bold rounded-full border border-white/30 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 backdrop-blur-sm">
        Back to Home
      </a>

    </div>

  </div>

</section>

<!-- Custom animations -->
<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }
  .delay-600 { animation-delay: 600ms; }
  .delay-700 { animation-delay: 700ms; }
  .delay-800 { animation-delay: 800ms; }
  .delay-900 { animation-delay: 900ms; }
  .delay-1000 { animation-delay: 1000ms; }
</style>

</BaseLayout>
