    /* Kids sliding bar — JS controls width + translateX */
    #kidsActiveBar {
      width: 0%;
    }

    /* Hero + cinematic zoom (global to avoid jump) */
    .cine-zoom-smooth {
      transform-origin: center center;
      transform: scale(1.05);               /* base state = first keyframe */
      animation: cineZoomSmooth 2.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform;
    }

    @keyframes cineZoomSmooth {
      0% {
        opacity: 1;
        transform: scale(1.05);             /* same as base → no jump */
      }
      50% {
        transform: scale(1.12);             /* smooth cinematic push-in */
      }
      100% {
        transform: scale(1.02);             /* gentle settle */
      }
    }

    /* APPLE-STYLE ULTRA-ELEGANT ZOOM (non-hover, if you want to apply later) */
    .cine-zoom-apple {
      animation: cineZoomApple 2.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      transform-origin: center center;
    }

    @keyframes cineZoomApple {
      0% {
        opacity: 1;
        transform: scale(1.02);
      }
      50% {
        transform: scale(1.06);
      }
      100% {
        transform: scale(1.01);
      }
    }

    /* Apple-style hover zoom */
    .cine-zoom-apple-hover {
      transform: scale(1);
      transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
      transform-origin: center center;
    }

    .cine-zoom-apple-hover:hover {
      transform: scale(1.06);
    }

    /* Apple-style horizontal bar hover (if you ever use it) */
    .cine-zoom-apple-bar {
      transform: scaleX(1);
      transform-origin: center center;
      transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cine-zoom-apple-bar:hover {
      transform: scaleX(1.12);
    }

    @keyframes fingerBounce {
      0%, 100% { transform: translateY(-50%) translateX(0); }
      50%      { transform: translateY(-50%) translateX(-10px); }
    }

    .finger-pointer {
      animation: fingerBounce 1.8s ease-in-out infinite;
