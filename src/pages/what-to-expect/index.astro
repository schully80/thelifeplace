  </style>

 <script>
document.addEventListener("DOMContentLoaded", () => {

  /* -----------------------------------
     1 — Kids carousel
  ----------------------------------- */
  const slidesEl = document.getElementById("kidsSlides");
  const activeBar = document.getElementById("kidsActiveBar");

  if (slidesEl && activeBar) {
    const totalSlides = slidesEl.children.length;
    let index = 0;
    const segment = 100 / totalSlides;

    function updateProgressBar() {
      activeBar.style.width = `${segment}%`;
      activeBar.style.transform = `translateX(${index * segment}%)`;
    }

    function updateSlide() {
      slidesEl.style.transform = `translateX(-${index * 100}%)`;
      updateProgressBar();
    }

    function nextSlide() {
      index = (index + 1) % totalSlides;
      updateSlide();
    }

    updateSlide();
    setInterval(nextSlide, 2600);
  }

  /* -----------------------------------
     2 — HERO IMAGE LOADING (NO FLASH)
     Blur placeholder → real image swap
  ----------------------------------- */
  const heroImg = document.getElementById("hero-image");
  const heroBlur = document.getElementById("hero-blur");

  const showRealHero = () => {
    if (!heroImg || !heroBlur) return;

    // Show real image
    heroImg.style.opacity = "1";

    // Fade out blur placeholder
    heroBlur.style.transition = "opacity 400ms ease-out";
    heroBlur.style.opacity = "0";
  };

  if (heroImg) {
    if (heroImg.complete) {
      showRealHero();
    } else {
      heroImg.addEventListener("load", showRealHero);
    }
  }

});

const cards = document.querySelectorAll(".motion-card");

function revealCards() {
  const trigger = window.innerHeight * 0.88;
  cards.forEach(card => {
    const rect = card.getBoundingClientRect();
    if (rect.top < trigger) card.classList.add("visible");
  });
}

window.addEventListener("scroll", revealCards);
window.addEventListener("load", revealCards);
</script>

<script>
  const bar = document.getElementById("progress-bar");

  function updateProgressBar() {
    const scrollY = window.scrollY;
    const pageHeight = document.body.scrollHeight - window.innerHeight;
    const progress = (scrollY / pageHeight) * 100;
    bar.style.width = progress + "%";
  }

  window.addEventListener("scroll", updateProgressBar);
  window.addEventListener("load", updateProgressBar);
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const slides = document.getElementById("leadersSlides");
    const bar = document.getElementById("leadersActiveBar");

    const totalSlides = slides.children.length;
    let index = 0;

    function moveCarousel() {
      index = (index + 1) % totalSlides;
      slides.style.transform = `translateX(-${index * 100}%)`;
      bar.style.width = `${(index + 1) * (100 / totalSlides)}%`;
    }

    setInterval(moveCarousel, 4000); // same timing as kids carousel
  });
</script>


<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll(".faq-item");

    items.forEach((item) => {
      const summary = item.querySelector(".faq-summary");
      const content = item.querySelector(".faq-content");
      const icon = summary.querySelector("svg");

      summary.addEventListener("click", () => {
        const isOpen = content.style.maxHeight && content.style.maxHeight !== "0px";

        // Close all
        items.forEach((other) => {
          const otherContent = other.querySelector(".faq-content");
          const otherIcon = other.querySelector("svg");
          if (otherContent) otherContent.style.maxHeight = null;
          if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
          other.classList.remove("open");
        });

        // Open clicked one
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + "px";
          if (icon) icon.style.transform = "rotate(180deg)";
          item.classList.add("open");
        }
      });
    });
  });
</script>

