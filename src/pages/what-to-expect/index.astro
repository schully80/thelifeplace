---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FadeDivider from "../../components/tlp/FadeDivider.astro";

---

<BaseLayout 
  title="What to Expect — Come. See. Jesus. | The Life Place"
  description="The Life Place — Come. See. Jesus. Discover what happens on a Sunday, our approach to worship and teaching, how we connect, and what we believe about living out faith."
>

{/* FULL-BLEED WRAPPER */}
<div class="w-screen max-w-none relative left-1/2 right-1/2 -mx-[50vw]">

  <!-- HERO SECTION — Clean, No Animations, No Flash -->
  <section 
    class="relative h-[70vh] md:h-[80vh] lg:h-[90vh] overflow-hidden flex items-center justify-center cine-zoom-apple-hover"
  >

    <!-- INSTANT BACKGROUND IMAGE (no fade, no opacity, no transition) -->
    <img 
      id="hero-image"
      src="/wide-strip4.jpg"
      alt="The Life Place Community Worship"
      class="absolute inset-0 w-full h-full object-cover object-center brightness-[0.55]"
    />

    <!-- Soft overlay -->
    <div class="absolute inset-0 bg-black/20"></div>

    <!-- TEXT BLOCK (centered and stable) -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-full px-6 text-right">
      
      <h3
        class="text-white text-3xl md:text-5xl lg:text-6xl font-extrabold cine-zoom-smooth
               leading-snug md:leading-[1.3]
               tracking-[0.02em] md:tracking-[0.04em]
               max-w-4xl mx-auto drop-shadow-xl"
      >
        At the heart of everything we believe and do is<br />
        <span class="text-brand-red">Jesus</span> and His finished work.
      </h3>
    </div>

  </section>
</div>


  <!-- INTRO SECTION — Overlapping Minimal Block -->
  <section class="w-full bg-white py-20 md:py-28 -mt-28 md:-mt-40 relative z-[5] rounded-3xl">
     
    <div class="max-w-4xl mx-auto px-6 text-center">
    
      <h2 class="font-Inter text-3xl md:text-7xl font-extrabold text-gray-900 leading-tight">
        What to Expect
      </h2>
    </div>
  </section>


 <!-- FADE DIVIDER -->
<FadeDivider mt="mt-0" mb="mb-24" />
  

  <!-- SECTION — Massive Left Image + Right Banner Text -->
  <section class="w-full pt-20 pb-28 md:pt-28 md:pb-40 bg-white ">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-0 items-center px-6 -mt-6 md:-mt-16 ">

      <!-- LEFT IMAGE -->
      <div class="relative w-full h-[420px] md:h-[520px] lg:h-[620px] overflow-hidden rounded-3xl shadow-lg cine-zoom-apple-hover">
        <img 
          src="/what-teach4.jpg"
          alt="Teaching at The Life Place"
          class="absolute inset-0 w-full h-full object-cover object-center tlp-grayscale"
        />
      </div>

      <!-- RIGHT BANNER TEXT -->
      <div class="flex items-center justify-center md:pl-12 lg:pl-20 mt-10 md:-mt-16">
      
        <h2 class="text-4xl md:text-6xl lg:text-6xl font-extrabold text-gray-900 leading-tight max-w-xl text-center">
          We open our bibles<br />
          to see <span class="text-brand-red">Jesus</span><br />
          and hear the<br />
          good news.
        </h2>
      </div>

    </div>
  </section>

  <!-- ⭐ SLOGAN BLOCK -->
  <div id="slogan-block" class="w-full text-center py-2 md:py-6 bg-white relative -mt-10 md:-mt-16">
     
    <p class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 inline-block relative">

      Come. See.

      <span class="relative inline-block font-extrabold mx-2">

        <!-- JESUS PILL -->
          <!-- Retro sign with nails -->
          <span class="relative inline-block px-3 py-0 rounded-[9px] bg-[#B3282D] text-white font-bold border-4 border-white shadow-lg drop-shadow-xl tracking-wide rotate-[-2deg] cine-zoom-apple-hover">
            Jesus
            <!-- Left nail -->
            <span
              class="absolute top-1 left-1 w-2 h-2 rounded-full border border-gray-700 shadow"
              style="background: radial-gradient(circle at 30% 30%, #f0f0f0, #a0a0a0 60%, #5a5a5a);"
            />
            <!-- Right nail -->
            <span
              class="absolute top-1 right-1 w-2 h-2 rounded-full border border-gray-700 shadow"
              style="background: radial-gradient(circle at 30% 30%, #f0f0f0, #a0a0a0 60%, #5a5a5a);"
            />

        <!-- ARROW POINTER TO JESUS (chunky triple arrow, pointing down-left, animated) -->
        <span class="finger-pointer absolute top-1/2 -translate-y-1/2 right-[-80px] md:right-[-140px]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-20 h-20 md:w-28 md:h-28 text-brand-red rotate-90"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 7l7 7 7-7" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7 7 7-7" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7 7 7-7" />
          </svg>
        </span>

      </span>
    </p>
  </div>
  <!-- END SLOGAN BLOCK -->

<!-- COMMUNITY — Full-Width Banner with Headline -->
<div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen my-24">
  <section class="relative h-[60vh] md:h-[70vh] lg:h-[80vh] overflow-hidden cine-zoom-apple-hover">

  <img 
  src="/what-community7.png"
  alt="Community at The Life Place" 
  class="absolute inset-0 w-full h-full object-cover brightness-[0.55] scale-110 z-0 tlp-grayscale"
/>
<div class="absolute inset-0 z-0"></div>


    <div class="relative z-10 flex flex-col items-center justify-center w-full h-full px-6 text-center">

      <!-- MAIN HEADER (matching YOUR OUR WELCOME style) -->
      
      <h1 class="text-white text-5xl md:text-7xl leading-tight font-extrabold 
                 drop-shadow-[0_4px_10px_rgba(0,0,0,0.45)] mb-8 md:mb-12">
        Community
      </h1>

   <!-- SUBTEXT LINES -->
<div class="relative z-[5] flex flex-col items-center text-center
            text-white font-bold
            text-2xl md:text-4xl lg:text-6xl
            space-y-1 md:space-y-2
            drop-shadow-xl">

  <p class="text-white">Multiracial</p>
  <p class="text-white">Multiethnic</p>
  <p class="text-white">Multigenerational</p>

</div>



  </section>
</div>

  </div>

  <!-- SECTION — Larger Photo, Left Image, Right Text -->
  <section class="w-full py-20 md:py-24 bg-gray-50">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center px-6">

      <!-- BIG HEADLINE -->
      <div class="order-2 md:order-1 max-w-4xl mx-auto px-6 text-center mt-10 md:-mt-16">
        
        <h3 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight">
          With music and dancing, we celebrate <span class="text-brand-red">Jesus</span> with joy, 
          beauty, and wonder.
        </h3>
      </div>

      <!-- LARGE IMAGE -->
      <div class=" order-1 md:order-2 cine-zoom-apple-hover w-full h-[420px] md:h-[520px] lg:h-[620px] overflow-hidden rounded-3xl shadow-lg">
        <img 
          src="/what-worship.jpg"
          alt="Worship at The Life Place"
          class="w-full h-full object-cover tlp-grayscale"
        />
      </div>

    </div>
  </section>

  <!-- SECTION — Big Headline Over Two Photos (Full-Bleed) -->
  <div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen mt-16 md:mt-24 mb-20">
     
    <section class="relative h-[60vh] md:h-[75vh] lg:h-[85vh] overflow-hidden rounded-none cine-zoom-apple-hover tlp-grayscale">
>
      <!-- TWO-PHOTO BACKGROUND (side-by-side) -->
      <div class="absolute inset-0 grid grid-cols-2">
        <img 
          src="/what-give.jpg"
          alt="Extravagant Generosity"
          class="w-full h-full object-cover rounded-none"
        />
        <img 
          src="/what-family3.jpg"
          alt="Helping Others Passionately"
          class="w-full h-full object-cover rounded-none"
        />
      </div>

    

      <!-- Soft overlay for readability -->
      <div class="absolute inset-0 bg-black/40"></div>

      <!-- CENTERED HEADLINE -->
      <div class="relative z-10 flex items-center justify-center w-full h-full px-6 text-center">
       
        <h2
          class="text-white text-4xl md:text-5xl lg:text-6xl font-extrabold
                 leading-snug md:leading-[1.3]
                 tracking-[0.02em] md:tracking-[0.04em]
                 max-w-4xl mx-auto drop-shadow-xl"
        >
          We give extravagantly.<br />
          <span class="block mt-3 md:mt-4">We help others passionately.</span>
        </h2>
      </div>

    </section>
  </div>

  <!-- SECTION — Cinematic Communion Banner -->
  <section class="w-full py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center px-6">

      <!-- LEFT: COMMUNION PHOTO -->
      <div class="cine-zoom-apple-hover w-full h-[420px] md:h-[550px] lg:h-[650px] -mt-14 mb-20 overflow-hidden rounded-3xl shadow-xl">
        <img 
          src="/what-table2.jpg"
          alt="The Lord’s Table"
          class="w-full h-full object-cover object-center scale-105 tlp-grayscale"
        />
      </div>

      <!-- RIGHT: MASSIVE TEXT -->
      <div class="flex items-center justify-center text-center md:text-left -mt-14 mb-20">
      
        <h2 class="text-center text-4xl md:text-6xl lg:text-7xl font-extrabold text-gray-900 leading-tight max-w-xl">
          At <br /> the Lord&rsquo;s Table<br />
          we remember<br />
          <span class="text-brand-red">Jesus</span> and His finished work<br />
        </h2>
      </div>

    </div>
  </section>

  <!-- FINAL SECTION — Sent Out Banner (Full-Bleed) -->
  <div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen -mt-14 mb-20">
    <section class="relative h-[60vh] md:h-[75vh] lg:h-[85vh] overflow-hidden cine-zoom-apple-hover">

      <!-- BACKGROUND IMAGE -->
      <img 
        src="/what-sent5.jpg"
        alt="Sent Out in the Story of Jesus"
        class="absolute inset-0 w-full h-full object-cover brightness-[0.55] scale-110 tlp-grayscale"
      />

      <!-- SOFT OVERLAY -->
      <div class="absolute inset-0 bg-black/10"></div>

      <!-- TEXT, SHIFTED LEFT -->
      <div
        class="relative z-10 flex items-center justify-start w-full h-full px-6 md:px-12 pb-10 md:pb-16 text-left"
      >
     
        <h2
          class="text-white text-4xl md:text-5xl lg:text-6xl font-extrabold
                 leading-snug md:leading-[1.3]
                 tracking-[0.02em] md:tracking-[0.04em]
                 max-w-4xl mr-auto drop-shadow-xl"
        >
          We are sent out to live<br />
          <span class="text-brand-red">Jesus'</span> story <br />in our city,<br />
          our nation, <br /> and the world.
        </h2>
      </div>

    </section>
  </div>

  <!-- KIDS SECTION WRAPPER -->
  <section class="w-full bg-gray-50 py-24 md:py-32">

    <!-- TITLE BLOCK — Apple Minimal -->
    <div class="text-center px-6 mb-16 -mt-10 md:-mt-16">


      <p class="text-6xl md:text-6xl text-gray-900 font-extrabold mb-4">
        Kids @ The Life Place
      </p>

      <h2 class="text-2xl md:text-4xl font-semibold text-gray-900 leading-tight">
        A Place for Children to Come. See. <span class="text-brand-red">Jesus</span>
      </h2>

      <p class="mt-8 text-lg md:text-2xl text-gray-600 leading-relaxed max-w-3xl mx-auto">
        Currently we don't have a kiddies church. As <span class="text-brand-red">Jesus</span> supplies the resources, we will launch one where our children too will
        experience His truth, goodness, beauty, and kindness.
      </p>

      <div class="w-full flex justify-center text-center mt-16">
      
        <p class="text-2xl md:text-3xl lg:text-4xl font-semibold max-w-3xl leading-tight tracking-tight text-gray-900">
          Children are welcome to remain with their parents during service.
        </p>
      </div>

    </div>

    <!-- CAROUSEL BOX -->
    <div class="max-w-5xl mx-auto px-6">

      <div class="relative mx-auto rounded-3xl overflow-hidden shadow-2xl w-full aspect-[5/4] bg-gray-200 cine-zoom-apple-hover">

        <!-- SLIDES WRAPPER -->
        <div id="kidsSlides" class="flex h-full w-full transition-transform duration-[900ms] ease-in-out">
          <img src="/what-kids.jpg" class="kids-slide-img" />
          <img src="/what-kids2.jpg" class="kids-slide-img" />
          <img src="/what-kids3.jpg" class="kids-slide-img" />
          <img src="/what-kids.jpg" class="kids-slide-img" />
          <img src="/what-kids2.jpg" class="kids-slide-img" />
          <img src="/what-kids3.jpg" class="kids-slide-img" />
        </div>

      </div>

      <!-- SLIDING BAR INDICATOR -->
      <div class="relative w-full flex justify-center mt-8">
        <div class="relative w-40 h-2 bg-gray-300 rounded-full overflow-hidden shadow-inner">
          <div 
            id="kidsActiveBar" 
            class="absolute top-0 left-0 h-full bg-black rounded-full transition-all duration-500">
          </div>
        </div>
      </div>

    </div>

  </section>

  <!-- NEXT STEPS — Apple Cinematic CTA Rows -->
  <section class="w-full py-18 md:py-[10rem] bg-white">

    
    <div class="max-w-5xl mx-auto px-6 space-y-28">

      <!-- WATCH MESSAGES CTA ROW -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-10 border-b border-gray-900 pb-16">

     
        <div class="text-center md:text-left max-w-xl -mt-14 mb-20">

     
          <h3 class="text-4xl md:text-5xl font-semibold text-gray-900 leading-tight">
            Watch Live
          </h3>

          <p class="mt-5 text-xl md:text-2xl text-gray-600 leading-relaxed">
            Hear gospel-rich, <span class="text-brand-red">Jesus</span>-centred teaching from our Sunday gatherings.
          </p>
        </div>

        <a
          href="/live/"
          class="mx-auto md:mx-0 inline-flex items-center gap-4 text-brand-red font-bold tracking-wide text-2xl md:text-5xl hover:opacity-85 transition cine-zoom-apple-hover -mt-14 mb-20"
        >
          Watch
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 md:w-12 md:h-12"
               fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>

      </div>

      <!-- GENEROSITY CTA ROW -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 py-2 md:py-3">

        <div class="text-center md:text-left max-w-xl">
          <h3 class="text-4xl md:text-5xl font-semibold text-gray-900 leading-tight">
            Generosity
          </h3>

          <p class="mt-2 text-xl md:text-2xl text-gray-600 leading-snug">
            Made rich by what <span class="text-brand-red">Jesus</span> has done, we are extravagant in our generosity and share in all things.
          </p>
        </div>

        <a
          href="/give/"
          class="mx-auto md:mx-0 inline-flex items-center gap-2 text-brand-red font-bold tracking-wide text-2xl md:text-5xl hover:opacity-85 transition cine-zoom-apple-hover"
        >
          Give
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10"
               fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>


    
    <!-- FADE DIVIDER -->
<FadeDivider mt="mt-40" mb="mb-20" />

<!-- First-Time Guest FAQ -->
<section class="max-w-4xl mx-auto px-6 mt-32 mb-40" data-faq-accordion>
  <!-- Header -->
  <div class="text-center mb-12">
    <h2 class="text-3xl md:text-6xl font-extrabold tracking-tight text-gray-900">
      First-Time Guest FAQs
    </h2>
    <p class="mt-4 text-xl text-gray-600">
      Helpful guidance for your first visit to The Life Place.
    </p>
  </div>

  <!-- FAQ Accordion -->
  <div class="space-y-4">

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-xl font-semibold text-gray-900">
        What time should I arrive?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-xl text-gray-600 leading-relaxed">
          Arrive 10–15 minutes early to settle in, find seating, and enjoy the atmosphere before service begins.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-xl font-semibold text-gray-900">
        What should I wear?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-xl text-gray-600 leading-relaxed">
          Wear what you’re comfortable in — casual, smart, or in-between. Come as you are.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-xl font-semibold text-gray-900">
        What about my children?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-xl text-gray-600 leading-relaxed">
          Children are welcome to remain with their parents during the service. A dedicated kids space will launch soon.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-xl font-semibold text-gray-900">
        How long is the service?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-xl text-gray-600 leading-relaxed">
          Our gatherings run for about 90 minutes, including worship, teaching, and ministry moments.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-xl font-semibold text-gray-900">
        Will I be singled out as a first-time guest?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-xl text-gray-600 leading-relaxed">
          No — you won't be asked to stand or introduce yourself. We’re honoured to have you, quietly and sincerely.
        </p>
      </div>
    </div>

    <!-- FAQ ITEM -->
    <div class="faq-item rounded-3xl border border-black/10 bg-white/80 backdrop-blur-xl p-6">
      <button class="faq-summary flex w-full cursor-pointer items-center justify-between text-xl font-semibold text-gray-900">
        Do I need to register?
        <span class="ml-4 flex items-center justify-center text-gray-400 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
      <div class="faq-content overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out">
        <p class="mt-4 text-xl text-gray-600 leading-relaxed">
          No registration needed. Simply come. If an event ever requires registration, we’ll make it clear.
        </p>
      </div>
    </div>

  </div><!-- NEXT STEPS — CINEMATIC MINIMAL TYPOGRAPHY -->
<section class="w-full py-[10rem] md:py-[14rem] bg-white">

  <div class="max-w-6xl mx-auto px-6">

    <!-- GIANT HEADLINE -->
    <h2 class="text-5xl md:text-7xl lg:text-8xl font-extrabold leading-[1.05] text-gray-900 mb-[6rem]">
      Step deeper into<br />
      the story of who we are.
    </h2>

    <!-- STACKED CTA COLUMNS -->
    <div class="space-y-[8rem]">

      <!-- ABOUT US BLOCK -->
      <div class="group cine-zoom-apple-hover">
        <p class="text-xl md:text-2xl text-gray-600 max-w-2xl leading-relaxed mb-10">
          Learn who we are, why we exist, and how everything at The Life Place revolves
          around the person and finished work of <span class="text-brand-red font-semibold">Jesus</span>.
        </p>

        <a
          href="/about-us/"
          class="inline-flex items-center gap-4 text-brand-red font-bold text-3xl md:text-4xl tracking-tight hover:opacity-80 transition"
        >
          Learn More
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-14 md:h-14"
               fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- PLAN A VISIT BLOCK -->
      <div class="group cine-zoom-apple-hover">
        <p class="text-xl md:text-2xl text-gray-600 max-w-2xl leading-relaxed mb-10">
          Find service times, parking, what to expect, and how to feel at home the moment
          you walk in.
        </p>

