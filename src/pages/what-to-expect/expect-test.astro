  /* AUTO-ANIMATE — clean version (no conflicts) */
  .pulse-auto {
    animation: heroCinematicZoom 1.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 1;
  }

  @keyframes heroCinematicZoom {
    0% {
      opacity: 0.85;
      transform: scale(0.96);
    }
    55% {
      opacity: 1;
      transform: scale(1.08); /* overshoot */
    }
    100% {
      opacity: 1;
      transform: scale(1.02); /* settle — softer cinematic */
    }
  }

 /* BIG-MOTION CINEMATIC ZOOM (no loop, no snap) */
.cine-zoom {
  animation: cineZoom 2.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  transform-origin: center center;
}

@keyframes cineZoom {
  0% {
    opacity: 1;
    transform: scale(1.05); /* match real starting look = NO jump */
  }
  50% {
    transform: scale(1.15); /* BIG cinematic push-in */
  }
  100% {
    transform: scale(1.02); /* settle smoothly */
  }
}


  /* SMOOTH CINEMATIC ZOOM — no loop, no snap */
.cine-zoom-smooth {
  animation: cineZoomSmooth 2.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  transform-origin: center center;
}

@keyframes cineZoomSmooth {
  0% {
    opacity: 1;
    transform: scale(1.05);  /* matches natural object-cover scaling → no jump */
  }
  50% {
    transform: scale(1.12);  /* smooth cinematic push-in */
  }
  100% {
    transform: scale(1.02);  /* gentle settle */
  }
}

/* APPLE-STYLE ULTRA-ELEGANT ZOOM (very smooth, no loop) */
.cine-zoom-apple {
  animation: cineZoomApple 2.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  transform-origin: center center;
}

@keyframes cineZoomApple {
  0% {
    opacity: 1;
    transform: scale(1.02);  /* tiny start zoom, NO jump */
  }
  50% {
    transform: scale(1.06);  /* elegant tiny push-in */
  }
  100% {
    transform: scale(1.01);  /* gentle settle */
  }
}

/* Base state — perfectly still */
.cine-zoom-apple-hover {
  transform: scale(1);
  transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  transform-origin: center center;
}

/* Hover state — elegant Apple push-in */
.cine-zoom-apple-hover:hover {
  transform: scale(1.06);
}

/* Apple-style smooth horizontal push-in */
.cine-zoom-apple-bar {
  transform: scaleX(1);
