<script>
document.addEventListener("DOMContentLoaded", () => {

  /* ----------------------------------------------------
      1) PULSE-IN ANIMATION
  ---------------------------------------------------- */
  const pulseItems = document.querySelectorAll(".pulse-in");

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) entry.target.classList.add("visible");
    });
  }, { threshold: 0.35 });

  pulseItems.forEach((item) => observer.observe(item));


  /* ----------------------------------------------------
      SCROLL-BASED PARALLAX ENGINE (one listener only)
  ---------------------------------------------------- */
  window.addEventListener("scroll", () => {
    const viewportH = window.innerHeight;

    /* -------------------------------
        2) TITLE LAYER PARALLAX
    -------------------------------- */
    const bg = document.querySelector(".parallax-title-bg");
    const fg = document.querySelector(".parallax-title-fg");

    if (bg && fg) {
      const rect = fg.getBoundingClientRect();

      if (rect.top < viewportH && rect.bottom > 0) {
        bg.style.transform = `translateY(${rect.top * 0.12}px)`;
        fg.style.transform = `translateY(${rect.top * 0.30}px)`;
      }
    }


    /* -------------------------------
        3) SPLIT-LINE PARALLAX
    -------------------------------- */
    const lines = document.querySelectorAll(".split-line");
    lines.forEach((line) => {
      const rect = line.getBoundingClientRect();
      const speed = parseFloat(line.dataset.speed || 0.2);

      if (rect.top < viewportH && rect.bottom > 0) {
        line.style.transform = `translateY(${rect.top * speed}px)`;
      }
    });


    /* -------------------------------
        4) MULTIPLE PARALLAX TEXTS
    -------------------------------- */
    const textEls = document.querySelectorAll(".parallax-text");
    textEls.forEach((text) => {
      const rect = text.getBoundingClientRect();
      if (rect.top < viewportH && rect.bottom > 0) {
        const speed = 0.23;
        const zoom = 1.02;
        text.style.transform =
          `translateY(${rect.top * speed}px) scale(${zoom})`;
      }
    });


    /* -------------------------------
        5) MULTIPLE PARALLAX IMAGES
    -------------------------------- */
    const imageEls = document.querySelectorAll(".parallax-image img");
    imageEls.forEach((img) => {
      const rect = img.getBoundingClientRect();
      if (rect.top < viewportH && rect.bottom > 0) {
        const speed = 0.15;
        img.style.transform =
          `translateY(${rect.top * speed}px) scale(1.05)`;
      }
    });

  });
});
</script>
