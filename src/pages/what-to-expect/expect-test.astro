<script>
  const slidesEl = document.getElementById('kidsSlides');
  const totalSlides = slidesEl.children.length;
  let index = 0;

  // Sliding bar indicator
  const activeBar = document.getElementById("kidsActiveBar");
  const segment = 100 / totalSlides;

  function updateProgressBar() {
    activeBar.style.width = `${segment}%`;
    activeBar.style.transform = `translateX(${index * segment}%)`;
  }

  function updateSlide() {
    slidesEl.style.transform = `translateX(-${index * 100}%)`;
    updateProgressBar();
  }

  function nextSlide() {
    index = (index + 1) % totalSlides;
    updateSlide();
  }

  let interval = setInterval(nextSlide, 2600);

  function resetAuto() {
    clearInterval(interval);
    interval = setInterval(nextSlide, 2600);
  }

  // Init first slide
  updateSlide();

  document.addEventListener("scroll", () => {
    const box = document.querySelector(".parallax-teach");
    const bg = document.querySelector(".parallax-bg");

    if (!box || !bg) return;

    const rect = box.getBoundingClientRect();
    const viewportHeight = window.innerHeight;

    // Only animate when visible
    if (rect.top < viewportHeight && rect.bottom > 0) {
      const scrollPercent = (viewportHeight - rect.top) / (viewportHeight + rect.height);

      // Strong parallax strength (0–40px)
      const offset = scrollPercent * 40; 

      bg.style.transform = `translateY(${offset}px)`;
    }
  });

 window.addEventListener("scroll", () => {
    const textEl = document.querySelector(".parallax-text");
    if (!textEl) return;

    const speed = 0.25;       // scroll depth
    const zoom = 0.02;        // 2% zoom
    const rect = textEl.getBoundingClientRect();

    // Only animate when visible on screen
    if (rect.top < window.innerHeight && rect.bottom > 0) {
      const offset = rect.top * speed;
      const scale = 1 + zoom;

      textEl.style.transform =
        `translateY(${offset}px) scale(${scale})`;
    }
  });
</script>

