---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Slogan from "../../components/Slogan.astro";
---

<BaseLayout title="TLP Design System">

<!-- ========= HERO ========= -->
<section class="w-screen max-w-none left-1/2 -mx-[50vw] relative h-[55vh] md:h-[65vh] flex items-center justify-center
                bg-gradient-to-b from-[#FAF7F2] via-[#F3ECE5] to-[#E9E2DB] overflow-hidden">
  
  <!-- subtle warm overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/5 via-transparent to-black/5 opacity-[0.06]"></div>

  <div class="relative z-10 text-center px-6">
    <h1 class="heading-1">
      The Life Place  
      <span class="block text-brand-red mt-2">Design System</span>
    </h1>

    <Slogan class="mt-4" size="md" />
  </div>
</section>


<!-- ========= SECTION WRAPPER ========= -->
<section class="max-w-6xl mx-auto px-6 py-20 space-y-32">

<!-- ===================================================== -->
<!-- 1. COLOUR PALETTE -->
<!-- ===================================================== -->

<div>
  <h2 class="heading-2 mb-10">1. Colour Palette</h2>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
    <!-- BRAND RED -->
    <div class="text-center">
      <div class="h-24 rounded-2xl bg-[#B3282D] shadow-md"></div>
      <p class="mt-3 text-gray-600 font-semibold">Brand Red</p>
      <p class="text-sm text-gray-500">#B3282D</p>
    </div>

    <!-- RED LIGHT -->
    <div class="text-center">
      <div class="h-24 rounded-2xl bg-[#E47478] shadow-md"></div>
      <p class="mt-3 text-gray-600 font-semibold">Brand Red Light</p>
      <p class="text-sm text-gray-500">#E47478</p>
    </div>

    <!-- WARM WHITE -->
    <div class="text-center">
      <div class="h-24 rounded-2xl bg-[#FAF7F2] shadow-md border"></div>
      <p class="mt-3 text-gray-600 font-semibold">Warm White</p>
      <p class="text-sm text-gray-500">#FAF7F2</p>
    </div>

    <!-- PAPER TAUPE -->
    <div class="text-center">
      <div class="h-24 rounded-2xl bg-[#E3DED5] shadow-md"></div>
      <p class="mt-3 text-gray-600 font-semibold">Paper Taupe Mid</p>
      <p class="text-sm text-gray-500">#E3DED5</p>
    </div>
  </div>
</div>



<!-- ===================================================== -->
<!-- 2. TYPOGRAPHY -->
<!-- ===================================================== -->

<div>
  <h2 class="heading-2 mb-10">2. Typography</h2>

  <div class="space-y-10">
    <div>
      <h1 class="text-6xl font-black">Heading One (H1)</h1>
      <p class="text-gray-500 mt-2">Inter / Montserrat, 700–900</p>
    </div>

    <div>
      <h2 class="text-5xl font-black">Heading Two (H2)</h2>
      <p class="text-gray-500 mt-2">Strong page section titles</p>
    </div>

    <div>
      <h3 class="text-3xl font-bold">Heading Three (H3)</h3>
      <p class="text-gray-500 mt-2">Subsection headings</p>
    </div>

    <div>
      <p class="text-xl font-light text-gray-600">
        Lead paragraph — warm, pastoral, welcoming.
      </p>
    </div>

    <p class="text-gray-600">
      Standard paragraph — body text for teaching, values, or explanations.
    </p>
  </div>
</div>



<!-- ===================================================== -->
<!-- 3. BUTTONS -->
<!-- ===================================================== -->

<div>
  <h2 class="heading-2 mb-10">3. Buttons</h2>

  <div class="flex flex-wrap gap-6">
    <button class="px-8 py-4 bg-brand-red text-white rounded-full shadow-md hover:bg-red-700 transition">
      Primary Button
    </button>

    <button class="px-8 py-4 border border-brand-red text-brand-red rounded-full hover:bg-brand-red hover:text-white transition">
      Outline Button
    </button>

    <button class="px-8 py-4 bg-gray-900 text-white rounded-full hover:bg-black transition">
      Dark Button
    </button>
  </div>
</div>



<!-- ===================================================== -->
<!-- 4. CARDS -->
<!-- ===================================================== -->

<div>
  <h2 class="heading-2 mb-10">4. Cards</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <div
      class="p-10 rounded-3xl bg-white/70 backdrop-blur-md shadow-[0_8px_40px_rgba(0,0,0,0.12)] cine-zoom-apple-hover"
    >
      <h3 class="text-2xl font-bold mb-4">Frosted Glass Card</h3>
      <p class="text-gray-600 leading-relaxed">Used in the Values sections.</p>
    </div>

    <div
      class="p-10 rounded-3xl bg-[#FAF7F2] shadow-md"
    >
      <h3 class="text-2xl font-bold mb-4">Warm Card</h3>
      <p class="text-gray-600 leading-relaxed">Used for devotionals, ministries, or events.</p>
    </div>
  </div>
</div>



<!-- ===================================================== -->
<!-- 5. MOTION SYSTEM -->
<!-- ===================================================== -->

<div>
  <h2 class="heading-2 mb-10">5. Motion System</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

    <!-- scroll reveal -->
    <div class="p-10 rounded-3xl bg-white shadow-md">
      <h3 class="text-xl font-bold mb-3">Scroll Reveal</h3>
      <p class="text-gray-600 mb-4">Fade + lift + scale.</p>

      <div class="motion-demo opacity-0 translate-y-6 scale-[0.97] transition-all duration-\[1200ms\]">
        <div class="p-6 bg-gray-100 rounded-2xl">Scroll to see me animate.</div>
      </div>
    </div>

    <!-- hover effect -->
    <div class="p-10 rounded-3xl bg-white shadow-md">
      <h3 class="text-xl font-bold mb-3">Cine Zoom Hover</h3>
      <p class="text-gray-600 mb-4">Used on all value cards.</p>

      <div class="p-6 bg-gray-100 rounded-2xl cine-zoom-apple-hover">
        Hover me
      </div>
    </div>
  </div>
</div>



<!-- ===================================================== -->
<!-- 6. SIGNATURE ELEMENTS -->
<!-- ===================================================== -->

<div>
  <h2 class="heading-2 mb-10">6. Signature TLP Elements</h2>

  <ul class="space-y-6 text-lg text-gray-600">
    <li>• Jesus emphasis (auto-styled in red)</li>
    <li>• Slogan component — “Come. See. Jesus.”</li>
    <li>• Full-bleed hero sections</li>
    <li>• Warm, cinematic gradients</li>
    <li>• Frosted, floating glass cards</li>
    <li>• Particle-based background effects</li>
    <li>• Parallax movement overlays</li>
    <li>• Leadership Quote Bar</li>
  </ul>
</div>

</section>


<!-- Scroll Motion Script -->
<script>
  document.addEventListener("scroll", () => {
    const demo = document.querySelector(".motion-demo");
    if (!demo) return;

    const rect = demo.getBoundingClientRect();
    if (rect.top < window.innerHeight * 0.8) {
      demo.classList.remove("opacity-0", "translate-y-6", "scale-[0.97]");
    }
  });
</script>

</BaseLayout>
