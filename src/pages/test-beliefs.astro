---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatWeBelieveSection from "../components/WhatWeBelieveSection.astro";
---

<BaseLayout title="What We Believe - Test">

<!-- ===== DRAMATIC HERO SECTION ===== -->
<section class="w-full min-h-screen md:min-h-[80vh] relative overflow-hidden bg-gradient-to-br from-slate-950 via-black to-slate-900 flex items-center justify-center">
  
  <!-- Animated background elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-full h-full bg-gradient-to-bl from-brand-red/15 via-transparent to-transparent"></div>
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-red/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/3 w-64 h-64 bg-brand-red/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 text-center z-10">
    
    <!-- Label -->
    <div class="mb-8 opacity-0 animate-fadeUp">
      <span class="inline-block px-4 py-2 rounded-full bg-gradient-to-r from-brand-red/20 to-red-600/10 border border-brand-red/40 text-sm md:text-base text-brand-red font-bold uppercase tracking-widest backdrop-blur-sm">
        Our Doctrinal Foundation
      </span>
    </div>

    <!-- Main heading -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black leading-tight text-white mb-8 opacity-0 animate-fadeUp delay-100 max-w-5xl mx-auto">
      What We
      <span class="block bg-gradient-to-r from-brand-red via-red-500 to-brand-red bg-clip-text text-transparent mt-4 md:mt-6">
        Believe
      </span>
    </h1>

    <!-- Subtitle & Context -->
    <p class="text-base md:text-lg text-white leading-relaxed font-medium opacity-0 animate-fadeUp delay-200 mb-8 max-w-2xl mx-auto">
      Sound doctrine isn't about rules; it's about Jesus—who He is, what He has done, and how His finished work shapes what we believe and how we live.
    </p>

  </div>

</section>

<!-- ===== THEOLOGICAL FRAMEWORK SECTION ===== -->
<section class="w-full py-24 md:py-40 bg-gradient-to-br from-slate-900 via-black to-slate-900 relative overflow-hidden">
  
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-red/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6">
    
    <div class="mb-20 text-center opacity-0 animate-fadeUp delay-100">
      <div class="inline-block px-4 py-2 rounded-full bg-gradient-to-r from-brand-red/20 to-red-600/10 border border-brand-red/40 text-sm md:text-base text-brand-red font-bold uppercase tracking-widest backdrop-blur-sm mb-6">
        Theological Foundation
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-4">
        Our <span class="text-yellow-200">Three Pillars</span>
      </h2>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">The foundational principles that shape how we understand Scripture and live out our faith</p>
    </div>

    <!-- Framework Grid -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      
      <!-- Pentecostal Charismatic -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-brand-red/20 to-red-600/10 border border-brand-red/40 opacity-0 animate-fadeUp delay-200 hover:bg-gradient-to-br hover:from-brand-red/40 hover:to-red-600/20 hover:shadow-2xl hover:shadow-brand-red/30 hover:scale-105 transition-all duration-300 hover:border-brand-red/60">
        <div class="text-6xl md:text-7xl font-black text-brand-red/30 mb-6 group-hover:text-brand-red/50 transition-colors duration-300">🔥</div>
        <h3 class="text-2xl md:text-3xl font-black text-white mb-3 group-hover:text-yellow-200 transition-colors duration-300">Pentecostal<br/>Charismatic</h3>
        <p class="text-base md:text-lg text-gray-200 leading-relaxed">
          Joyfully dependent on the present and active work of the Holy Spirit, who gives gifts as He wills, forms Christ in us, and empowers us for faithful witness.
        </p>
      </div>

      <!-- Covenant Theology -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-blue-500/20 to-blue-600/10 border border-blue-500/40 opacity-0 animate-fadeUp delay-300 hover:bg-gradient-to-br hover:from-blue-500/40 hover:to-blue-600/20 hover:shadow-2xl hover:shadow-blue-500/30 hover:scale-105 transition-all duration-300 hover:border-blue-500/60">
        <div class="text-6xl md:text-7xl font-black text-blue-400/30 mb-6 group-hover:text-blue-400/50 transition-colors duration-300">📖</div>
        <h3 class="text-2xl md:text-3xl font-black text-white mb-3 group-hover:text-yellow-200 transition-colors duration-300">Covenant<br/>Theology</h3>
        <p class="text-base md:text-lg text-gray-200 leading-relaxed">
          Reading the Bible as one unified redemptive story of God's grace, fulfilled in Jesus Christ rather than fragmented into isolated texts.
        </p>
      </div>

      <!-- Incarnational -->
      <div class="group p-8 md:p-10 rounded-3xl bg-gradient-to-br from-purple-500/20 to-purple-600/10 border border-purple-500/40 opacity-0 animate-fadeUp delay-400 hover:bg-gradient-to-br hover:from-purple-500/40 hover:to-purple-600/20 hover:shadow-2xl hover:shadow-purple-500/30 hover:scale-105 transition-all duration-300 hover:border-purple-500/60">
        <div class="text-6xl md:text-7xl font-black text-purple-400/30 mb-6 group-hover:text-purple-400/50 transition-colors duration-300">🤝</div>
        <h3 class="text-2xl md:text-3xl font-black text-white mb-3 group-hover:text-yellow-200 transition-colors duration-300">Incarnational<br/>Posture</h3>
        <p class="text-base md:text-lg text-gray-200 leading-relaxed">
          Shaped by the way Jesus entered real places, real cultures, and real lives. The gospel is embodied among people, not merely proclaimed from a distance.
        </p>
      </div>

    </div>

  </div>

</section>


</section>

<WhatWeBelieveSection />

<!-- Historical Creeds Section -->
<section class="w-full py-24 md:py-40 bg-gradient-to-br from-gray-50 to-white relative overflow-hidden">

  <div class="max-w-6xl mx-auto px-6">

    <!-- Section Title -->
    <h2 class="heading-2 text-center mb-6">
      <span class="text-gray-600">HISTORICAL</span>
      <span class="text-brand-red">CREEDS</span>
    </h2>

    <!-- Subtle divider -->
    <div class="mx-auto mt-6 mb-12 h-[3px] w-16 rounded-full bg-brand-red/90"></div>

    <!-- Intro -->
    <p class="text-center text-lg md:text-xl text-gray-600 leading-relaxed mb-12 max-w-3xl mx-auto">
      Our beliefs connect us to centuries of Christian witnesses who have articulated the unchanging gospel.
    </p>

    <!-- Creed Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Apostles Creed -->
      <a href="https://www.ccel.org/creeds/apostles.creed.html" target="_blank" class="group p-8 md:p-10 rounded-3xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-2xl transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">A</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Apostles' Creed</h3>
            <p class="text-sm text-gray-500 mt-1">Earliest summary of apostolic faith</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          The foundational declaration of Christian belief, covering God the Father, Jesus Christ, the Holy Spirit, the church, and eternal life.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

      <!-- Nicene Creed -->
      <a href="https://www.ccel.org/creeds/nicene.creed.html" target="_blank" class="group p-8 md:p-10 rounded-3xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-2xl transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">N</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Nicene Creed</h3>
            <p class="text-sm text-gray-500 mt-1">A.D. 325/381</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          Defining the deity of Christ and the doctrine of the Trinity. A crucial affirmation that Jesus Christ is of one substance with the Father.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

      <!-- Chalcedonian Creed -->
      <a href="https://thewestminsterstandard.org/the-chalcedonian-creed/" target="_blank" class="group p-8 md:p-10 rounded-3xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-2xl transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">C</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Chalcedonian Creed</h3>
            <p class="text-sm text-gray-500 mt-1">A.D. 451</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          Affirming that Jesus Christ is fully God and fully man in one person. The definitive statement on the nature of Christ's incarnation.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

      <!-- Westminster Confession -->
      <a href="https://westminsterstandards.org/westminster-confession-of-faith/" target="_blank" class="group p-8 md:p-10 rounded-3xl bg-white border border-gray-200 hover:border-brand-red hover:shadow-2xl transition-all duration-300">
        <div class="flex items-start gap-6 mb-6">
          <div class="h-14 w-14 rounded-full bg-gradient-to-br from-brand-red/20 to-red-600/10 border-2 border-brand-red flex items-center justify-center flex-shrink-0">
            <span class="text-brand-red font-black text-2xl">W</span>
          </div>
          <div>
            <h3 class="text-2xl md:text-3xl font-black text-gray-800 group-hover:text-brand-red transition-colors">Westminster Confession</h3>
            <p class="text-sm text-gray-500 mt-1">A.D. 1646</p>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed">
          A rich summary of Reformed theology and Christian doctrine. A comprehensive guide to biblical faith and practice for believers and churches.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 text-brand-red font-bold group-hover:gap-3 transition-all">
          Read More <span>→</span>
        </div>
      </a>

    </div>

  </div>

</section>

<!-- ===== CLOSING CTA ===== -->
<section class="w-full py-24 md:py-32 bg-white">
  
  <div class="relative max-w-6xl mx-auto px-6 text-center">
    
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-800 mb-8 opacity-0 animate-fadeUp delay-100">
      Experience These Beliefs
      <span class="block text-brand-red">In Community</span>
    </h2>

    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-12 opacity-0 animate-fadeUp delay-200">
      Join us on Sundays to worship with a community that takes Scripture seriously and joyfully follows Jesus.
    </p>

    <div class="flex flex-col md:flex-row gap-6 justify-center opacity-0 animate-fadeUp delay-300">
      
      <a href="/visit" class="inline-block px-8 py-4 bg-gradient-to-r from-brand-red to-red-600 hover:from-red-600 hover:to-red-700 text-white font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
        Plan a Visit
      </a>

      <a href="/" class="inline-block px-8 py-4 bg-gradient-to-r from-gray-800 to-gray-900 hover:from-gray-900 hover:to-black text-white font-bold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
        Back Home
      </a>

    </div>

  </div>

</section>

<!-- Custom animations -->
<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeUp {
    animation: fadeUp 0.6s ease-out forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }
  .delay-600 { animation-delay: 600ms; }
  .delay-700 { animation-delay: 700ms; }
  .delay-800 { animation-delay: 800ms; }
  .delay-900 { animation-delay: 900ms; }
  .delay-1000 { animation-delay: 1000ms; }
</style>

</BaseLayout>
