---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Prayer Request Received">

<!-- CLEAN SECTION (no cinematic background, keeps underline working) -->
<section
  class="relative min-h-screen flex items-center justify-center px-6 py-24 bg-white"
>

  <!-- SUCCESS CARD -->
  <div
    class="relative max-w-xl mx-auto bg-white rounded-3xl p-10 md:p-12 text-center
           shadow-xl border border-gray-100 animate-fadeUp"
  >

    <!-- Success Icon -->
    <div
      class="mx-auto mb-6 w-20 h-20 flex items-center justify-center rounded-full
             bg-brand-red text-white shadow-md animate-iconRise"
    >
      <svg
        class="w-10 h-10"
        fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round"
        viewBox="0 0 24 24">
        <path d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <!-- Heading -->
    <h1 class="heading-1 text-gray-800 mb-3">
      Thank You
    </h1>

    <!-- Subtitle -->
    <p class="text-center text-gray-600 text-lg leading-relaxed mb-10">
      Your prayer request has been received.<br />
      <span class="relative inline-block premium-underline font-semibold text-brand-red">
        Jesus
      </span>
      is praying for you. We are praying for you.
    </p>

    <!-- CTA -->
    <a
      href="/prayer/"
      class="group relative w-full text-center py-4 rounded-2xl bg-brand-red text-white font-semibold
             hover:bg-brand-red/90 active:scale-[0.98] transition-all duration-300
             flex items-center justify-center gap-2 shadow-sm hover:shadow-xl"
    >
      <span>Back to Prayer Request</span>

    </a>

  </div>

</section>


<!-- SUPER-SIZED QUICK ACTIONS -->
<section class="max-w-6xl mx-auto px-6 py-20 ">

 <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">

  <!-- PLAN A VISIT -->
  <a
    href="/visit/"
    class="rounded-3xl border border-gray-100 bg-white p-8 text-center shadow-md
           hover:shadow-lg hover:-translate-y-1 transition-all"
  >
    <i class="fa-solid fa-house text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Visit</span>
    <span class="text-gray-600 text-base font-medium">Always Welcome</span>
  </a>

  <!-- GIVE -->
  <a
    href="/give/"
    class="rounded-3xl border border-gray-100 bg-white p-8 text-center shadow-md
           hover:shadow-lg hover:-translate-y-1 transition-all"
  >
    <i class="fa-solid fa-hand-holding-heart text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Give</span>
    <span class="text-gray-600 text-base font-medium">Safe & Secure</span>
  </a>

  <!-- MESSAGES -->
  <a
    href="/live/"
    class="rounded-3xl border border-gray-100 bg-white p-8 text-center shadow-md
           hover:shadow-lg hover:-translate-y-1 transition-all"
  >
    <i class="fa-solid fa-tv text-brand-red text-4xl mx-auto mb-4" aria-hidden="true"></i>
    <span class="block text-2xl font-semibold text-gray-800 mb-1">Watch</span>
    <span class="text-gray-600 text-base font-medium">Watch our Live Services</span>
  </a>

</div>

</section>

<!-- Final Invitation -->
<section class="py-24 md:py-32 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    
    <h2 class="text-3xl md:text-5xl font-black mb-6 text-gray-800">
      Come. See. <span class="text-brand-red">Jesus</span>
    </h2>

    <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
      Join us this Sunday.
    </p>

  </div>

</section>


<!-- ANIMATIONS -->
<style>
  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(25px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeUp { animation: fadeUp .8s ease-out both; }

  @keyframes iconRise {
    0% { transform: translateY(30px) scale(0.8); opacity: 0; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }
  .animate-iconRise { animation: iconRise .9s cubic-bezier(.25,.46,.45,.94) forwards; }

  .gradient-underline {
    position:absolute; left:0; bottom:-4px;
    width:100%; height:3px; border-radius:999px;
    background:linear-gradient(90deg, transparent 0%, #B3282D 50%, transparent 100%);
    background-size:200% 100%;
    animation: gradientSlide 2.8s ease-in-out infinite;
  }
  @keyframes gradientSlide {
    0% { background-position:200% 0; }
    50% { background-position:0% 0; }
    100% { background-position:-200% 0; }
  }
</style>

</BaseLayout>
