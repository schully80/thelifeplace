---
import BaseLayout from "../layouts/BaseLayout.astro";
import { devotionals } from "../content/shared-content.js";

const todayIndex = (new Date().getDate() - 1) % devotionals.length;
const featured = devotionals[todayIndex];
const archive = devotionals.filter((item) => item.id !== featured.id);
---

<BaseLayout
  title="Devotionals — Come. See. Jesus. | The Life Place"
  description="Short daily readings to help you see Jesus and live from His finished work."
>
  <section class="bg-white py-20 md:py-28">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-sm md:text-base font-semibold uppercase tracking-[0.2em] text-brand-red">Daily Reading</p>
      <h1 class="mt-4 text-4xl md:text-6xl font-black text-gray-900">Devotionals</h1>
      <p class="mt-6 text-lg md:text-2xl text-gray-600 max-w-3xl mx-auto">
        Short readings to help you come, see, and rest in Jesus.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 grid gap-8">
      <article class="rounded-[2rem] border border-black/10 bg-white p-8 md:p-10 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-red">Featured Today</p>
        <h2 class="mt-4 text-3xl md:text-4xl font-extrabold text-gray-900">{featured.title}</h2>
        <p class="mt-3 text-base md:text-lg font-semibold text-brand-red">{featured.scripture}</p>

        <div class="mt-6 space-y-4 text-gray-700 leading-relaxed">
          {featured.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        {featured.prayer && (
          <div class="mt-8 rounded-3xl bg-gray-50 p-6">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-500">Prayer</p>
            <p class="mt-3 text-gray-700 leading-relaxed">{featured.prayer}</p>
          </div>
        )}

        {featured.action && (
          <div class="mt-4 rounded-3xl bg-brand-red/5 p-6">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-red">Today</p>
            <p class="mt-3 text-gray-700 leading-relaxed">{featured.action}</p>
          </div>
        )}
      </article>

      <div class="grid gap-6 md:grid-cols-2">
        {archive.map((item) => (
          <article class="rounded-3xl border border-black/10 bg-white p-6 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-red">{item.scripture}</p>
            <h3 class="mt-3 text-2xl font-extrabold text-gray-900">{item.title}</h3>
            <p class="mt-4 text-gray-600 leading-relaxed">{item.body[0]}</p>
            {item.action && <p class="mt-4 text-sm font-medium text-gray-500">{item.action}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
