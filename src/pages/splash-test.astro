---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Splash Screen Test">

  <!-- Premium Splash Screen -->
  <div
    id="splash-screen"
    class="fixed inset-0 z-[2147483647] flex items-center justify-center bg-white pointer-events-none"
  >

<!-- 🔥 TOP PILL BAR (left → right) -->
    <div
      class="absolute top-4 left-4 w-0 h-[4px] bg-brand-red rounded-full
             animate-topPillGrow z-[2147483600]"
    ></div>

    <!-- 🔥 RIGHT PILL BAR (bottom → top) -->
    <div
      class="absolute bottom-4 right-4 h-0 w-[4px] bg-brand-red rounded-full
             animate-rightPillGrowUp z-[2147483600]"
    ></div>

    <!-- Main splash content -->
    <div id="splash-inner" class="relative flex items-center justify-center z-[2147483400]">

      <!-- Flash effect -->
      <div
        id="splash-flash"
        class="absolute inset-0 bg-brand-red opacity-0 rounded-full scale-75 z-[2147483300]"
      ></div>

      <!-- Logo -->
      <img
        src="/logo.png"
        alt="The Life Place"
        class="relative h-28 w-auto opacity-0 z-[2147483390]"
        id="splash-logo"
      />
    </div>
  </div>

  <!-- Test Page Content -->
  <section class="max-w-3xl mx-auto px-4 py-20 text-center">
    <h1 class="text-4xl font-bold mb-4">Splash Screen Test Page</h1>
    <p class="text-lg text-gray-600">
      Refresh to replay the full splash animation sequence.
    </p>
  </section>

  <!-- Splash Animations -->
  <style>
    /* Logo enter */
    @keyframes splash-logo-in {
      0% { opacity: 0; transform: scale(0.85); }
      60% { opacity: 1; transform: scale(1); }
      100% { opacity: 1; }
    }

    /* Flash pulse */
    @keyframes splash-flash-pulse {
      0% { opacity: 0; transform: scale(0.7); }
      30% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.3); }
    }

    /* Glow bar animation */
    @keyframes glowIn {
      0% { opacity: 0; transform: translateY(-10px); }
      60% { opacity: 1; transform: translateY(0); }
      100% { opacity: 1; }
    }

    /* Capsule animation */
    @keyframes capsuleIn {
      0% { opacity: 0; transform: translate(20px, -50%); }
      60% { opacity: 1; transform: translate(0, -50%); }
      100% { opacity: 1; }
    }

    .animate-glowIn {
      animation: glowIn 0.8s ease-out forwards;
      animation-delay: 0.2s;
    }

    .animate-capsuleIn {
      animation: capsuleIn 0.8s ease-out forwards;
      animation-delay: 0.35s;
    }

    /* ABSOLUTE OVERRIDE – splash is ALWAYS above header */
    #splash-screen {
      z-index: 2147483647 !important;
    }


    /* Capsule full-height growth */
@keyframes capsuleGrow {
  0% {
    height: 20px;             /* starting small capsule */
    top: 50%;
    transform: translateY(-50%);
  }

  50% {
    height: 70vh;             /* expand up + down */
    top: 50%;
    transform: translateY(-50%);
  }

  100% {
    height: 100vh;            /* full height */
    top: 0;
    transform: translateY(0);
  }
}

.animate-capsuleGrow {
  animation: capsuleGrow 1.4s cubic-bezier(0.4, 0.0, 0.2, 1) forwards;
  animation-delay: 0.25s;     /* appears after glow bar */
}

/* Simple progress bar: left → right */
@keyframes progressGrow {
  0% {
    width: 0%;
    opacity: 1;
  }
  100% {
    width: 100%;
    opacity: 1;
  }
}

.animate-progressGrow {
  animation: progressGrow 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: 0.1s; /* start early */
}

/* Thin vertical progress bar: center → full height */
@keyframes capsuleGrowThin {
  0% {
    height: 20px;
    width: 2.5px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
  }

  25% {
    opacity: 1;
  }

  50% {
    height: 60vh;
    width: 2.5px;
    top: 50%;
    transform: translateY(-50%);
  }

  100% {
    height: 100vh;
    width: 2px;        /* stays thin */
    top: 0;
    transform: translateY(0);
  }
}

.animate-capsuleGrowThin {
  animation: capsuleGrowThin 1.4s cubic-bezier(0.22,1,0.36,1) forwards;
  animation-delay: 0.25s;
}


/* TOP BAR: grows left → right */
    @keyframes topPillGrow {
      0%   { width: 0; }
      100% { width: calc(100% - 2rem); } /* left-4 + right-4 */
    }

    /* RIGHT BAR: grows bottom → top */
    @keyframes rightPillGrowUp {
      0%   { height: 0; }
      100% { height: calc(100% - 2rem); } /* top-4 + bottom-4 */
    }

    .animate-topPillGrow {
      animation: topPillGrow 0.8s cubic-bezier(0.4, 0.0, 0.2, 1) forwards;
    }

    .animate-rightPillGrowUp {
      animation: rightPillGrowUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      animation-delay: 0.15s;
    }


  </style>

  <!-- Splash Timing -->
  <script>
    window.addEventListener("load", () => {
      const screen = document.getElementById("splash-screen");
      const logo = document.getElementById("splash-logo");
      const flash = document.getElementById("splash-flash");

      // 0.10s — logo animation
      setTimeout(() => {
        logo.style.animation = "splash-logo-in 0.9s ease-out forwards";
      }, 100);

      // 0.70s — flash pulse
      setTimeout(() => {
        flash.style.animation = "splash-flash-pulse 0.35s ease-out forwards";
      }, 700);

      // 2.40s — fade out splash
      setTimeout(() => {
        screen.style.transition = "opacity 0.6s ease-out";
        screen.style.opacity = "0";
      }, 2400);

      // 3.00s — remove splash entirely
      setTimeout(() => {
        screen.style.display = "none";
      }, 3000);
    });
  </script>

</BaseLayout>
