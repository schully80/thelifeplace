---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Splash Screen Test">

  <!-- Premium Splash Screen -->
  <div id="splash-screen"
    class="fixed inset-0 z-[9999] flex items-center justify-center bg-white pointer-events-none">

    <!-- IMPORTANT: give this a stacking context -->
    <div id="splash-inner" class="relative flex items-center justify-center z-10">
      
      <!-- Flash background (BEHIND logo but still animates) -->
      <div id="splash-flash"
        class="absolute inset-0 bg-brand-red opacity-0 rounded-full scale-75 z-0">
      </div>

      <!-- Logo (ABOVE flash) -->
      <img
        src="/logo.png"
        alt="The Life Place"
        class="relative h-28 w-auto opacity-0 z-20"
        id="splash-logo"
      />

    </div>
  </div>

  <!-- Test Page Content -->
  <section class="max-w-3xl mx-auto px-4 py-20 text-center">
    <h1 class="text-4xl font-bold mb-4">Splash Screen Test Page</h1>
    <p class="text-lg text-gray-600">
      Splash with flash + logo working exactly as original.
      Refresh to replay the full 2-second sequence.
    </p>
  </section>

  <!-- Splash Screen Animations (UNCHANGED) -->
  <style>
    #splash-screen.fade-out {
      opacity: 0;
      transition: opacity 0.8s ease-out;
    }

    /* Logo enter animation */
    @keyframes splash-logo-in {
      0% { opacity: 0; transform: scale(0.85); }
      60% { opacity: 1; transform: scale(1); }
      100% { opacity: 1; }
    }

    /* Flash pulse */
    @keyframes splash-flash-pulse {
      0% { opacity: 0; transform: scale(0.7); }
      30% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.3); }
    }
  </style>

  <!-- 2.0s Cinematic Timing (UNCHANGED) -->
  <script>
    window.addEventListener("load", () => {
      const screen = document.getElementById("splash-screen");
      const logo = document.getElementById("splash-logo");
      const flash = document.getElementById("splash-flash");

      // 0.10s — Logo fade + scale (0.90s duration)
      setTimeout(() => {
        logo.style.animation = "splash-logo-in 0.9s ease-out forwards";
      }, 100);

      // 0.70s — Red flash pulse (0.35s)
      setTimeout(() => {
        flash.style.animation = "splash-flash-pulse 0.35s ease-out forwards";
      }, 700);

      // 1.20s — Fade out entire splash (0.80s duration)
      setTimeout(() => {
        screen.style.transition = "opacity 0.8s ease-out";
        screen.style.opacity = "0";
      }, 1200);

      // 2.00s — Remove splash entirely
      setTimeout(() => {
        screen.style.display = "none";
      }, 2000);
    });
  </script>

</BaseLayout>
