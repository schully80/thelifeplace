{
  "name": "thelifeplace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4322 --host 0.0.0.0",
    "dev:force": "sh -c 'PID=$(lsof -ti tcp:4322); if [ -n \"$PID\" ]; then kill -9 $PID; fi; astro dev --port 4322 --host 0.0.0.0'",
    "build": "astro build",
    "preview": "astro preview --port 4322 --host 0.0.0.0",
    "gemini": "gemini"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "astro": "^5.16.6",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2",
    "qr-code-styling": "^1.9.2"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@google/gemini-cli": "^0.11.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19"
  }
}
