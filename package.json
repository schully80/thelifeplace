{
  "name": "thelifeplace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4322 --host 0.0.0.0",
    "dev:force": "sh -c 'PID=$(lsof -ti tcp:4322); if [ -n \"$PID\" ]; then kill -9 $PID; fi; astro dev --port 4322 --host 0.0.0.0'",
    "audit:website:monid": "node ./src/scripts/audit-website-monid.js",
    "import:youtube:monid": "node ./src/scripts/import-youtube-monid.js",
    "test:monid-audit": "node --test ./tests/audit-website-monid.test.mjs",
    "test:dropdown": "node ./tests/check-dropdown.js",
    "test:contracts": "node --test ./tests/shared-contracts.test.mjs",
    "test:monid-import": "node --test ./tests/import-youtube-monid.test.mjs",
    "build": "astro build",
    "preview": "astro preview --port 4322 --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/canvas-confetti": "^1.9.0",
    "astro": "5.17.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.563.0",
    "node-fetch": "^3.3.2",
    "qr-code-styling": "^1.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "autoprefixer": "^10.4.23",
    "playwright": "^1.41.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.68.1"
  }
}
