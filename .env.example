# Example env placeholders for local development — DO NOT commit secrets to source control
# Copy this file to `.env` for local testing and replace values with your keys.

# Cloudflare Turnstile (public key used by client)
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAACfg9tPI9K5HByKf

# Some files reference PUBLIC_TURNSTILE_SITE_KEY (underscore); include both for compatibility
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACfg9tPI9K5HByKf

# Cloudflare Turnstile secret used by server-side verification
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Toggle to enable Turnstile features (true/false)
PUBLIC_ENABLE_TURNSTILE=true

# Example Formspree endpoint used by prayer form (replace with your own)
PUBLIC_FORMSPREE_PRAYER_ENDPOINT=https://formspree.io/f/your_form_id_here
