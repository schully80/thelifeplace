# Turnstile
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# Prayer form feature flags
PRAYER_TURNSTILE_DISABLED=false
PRAYER_TURNSTILE_DISABLE_DEV=false
PRAYER_EMAIL_DISABLED=false
PRAYER_EMAIL_DISABLE_DEV=false

# Mail (defaults in code: mystory@thelifeplace.org)
MAIL_FROM=mystory@thelifeplace.org
MAIL_TO=mystory@thelifeplace.org

# Astro/Node
NODE_ENV=development
