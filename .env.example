# Turnstile
PUBLIC_TURNSTILE_SITEKEY=your-public-turnstile-sitekey
TURNSTILE_SECRET_KEY=your-secret-turnstile-key

# Prayer form feature flags
PRAYER_TURNSTILE_DISABLED=false
PRAYER_TURNSTILE_DISABLE_DEV=false
PRAYER_EMAIL_DISABLED=false
PRAYER_EMAIL_DISABLE_DEV=false

# Prayer mail routing
PRAYER_MAIL_FROM=prayer@thelifeplace.org
PRAYER_MAIL_TO=mystory@thelifeplace.org

# Optional Resend fallback (if MailChannels fails or is unavailable)
RESEND_API_KEY=your-resend-api-key
# Override From address when using Resend (use a verified address on your Resend domain).
PRAYER_RESEND_FROM=prayer@thelifeplace.org
# Dev-only override (otherwise falls back to onboarding@resend.dev)
PRAYER_RESEND_FROM_DEV=prayer@thelifeplace.org

# Astro/Node
NODE_ENV=development
# Server-only YouTube integration
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# Visit / registration form email + bot protection
# Fill these for local/dev testing
RESEND_FROM_VISIT=visit@thelifeplace.org
VISIT_TEAM_EMAIL=hello@thelifeplace.org
