/*
  Global security & sitemap headers
  Cloudflare Pages (_headers) syntax:
  - path on its own line
  - header lines indented by two spaces
*/

/*
  Default: apply to all routes
*/
 /*
  If you already had CSP/security headers, add them back here (below this line),
  but keep the sitemap rules as written further down.
*/
 /*
/* If you don't need global headers yet, you can leave this section empty. */
*/

/*
  --- SITEMAPS + ROBOTS (important for Search Console) ---
*/
 /sitemap.xml
  Content-Type: application/xml; charset=utf-8

 /sitemap-index.xml
  Content-Type: application/xml; charset=utf-8

 /robots.txt
  Content-Type: text/plain; charset=utf-8
